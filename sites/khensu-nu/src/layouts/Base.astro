---
import { CARDS, PREVIEWS, cardFor, previewFor } from '../data/og';
import { PATH_TO_PRODUCT, PRODUCTS } from '../data/hosts';
import Crescent from '../components/khensu/Crescent.astro';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Name from '../components/khensu/Name.astro';
import Net from '../components/khensu/Net.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** A product's own web manifest (nu.waves installs as its own app). */
  manifest?: string;
}

const SITE_NAME = 'khėnsu.ñü';
const DEFAULT_DESC =
  'khėnsu.ñü is a post-quantum private messenger on a network run by people: messages, calls, feeds, forums, sites and private payments, with private AI that runs only on your device.';

const { title, description = DEFAULT_DESC, noindex = false, manifest = '/site.webmanifest' } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — webË, private by design. Post-quantum. Run profitably by the people.`;
const pathForCanon = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = PATH_TO_PRODUCT[pathForCanon]
  ? new URL(PATH_TO_PRODUCT[pathForCanon])
  : new URL(Astro.url.pathname, Astro.site);
const card = cardFor(Astro.url.pathname);
const ogImage = new URL(`/og/${card}.jpg`, Astro.site);
const preview = previewFor(card);
const previewMeta = preview ? PREVIEWS[preview] : undefined;
// Landscape H.264 for og:video (Apple Messages + Android); square HEVC for nu:preview (indra.md).
const previewSquareUrl = preview ? `https://khensu.nu/og/${preview}-square.mp4` : undefined;
const previewWideUrl =
  preview && previewMeta?.wideBytes ? `https://khensu.nu/og/${preview}.mp4` : previewSquareUrl;
const ogVideoW = previewMeta?.wideBytes ? '1200' : '1080';
const ogVideoH = previewMeta?.wideBytes ? '630' : '1080';
const ogAlt = CARDS[card].alt;

const nav = [
  { href: PRODUCTS.avatars, label: 'avatars' },
  { href: PRODUCTS.aura, label: 'aura' },
  { href: PRODUCTS.bi, label: 'bi' },
  { href: PRODUCTS.create, label: 'create' },
  { href: PRODUCTS.devices, label: 'devices' },
  { href: PRODUCTS.eyes, label: 'eyes' },
  { href: PRODUCTS.fi, label: 'Fi' },
  { href: PRODUCTS.getApps, label: 'get.apps' },
  { href: PRODUCTS.nuGlass, label: 'glass' },
  { href: PRODUCTS.indra, label: 'indra.og' },
  { href: PRODUCTS.kronos, label: 'kronos' },
  { href: PRODUCTS.media, label: 'media' },
  { href: PRODUCTS.moments, label: 'moments' },
  { href: PRODUCTS.network, label: 'network' },
  { href: PRODUCTS.memory, label: 'ral' },
  { href: PRODUCTS.skillsMusicTheory, label: 'skills.music.theory' },
  { href: PRODUCTS.sla, label: 'sla' },
  { href: PRODUCTS.vegan, label: 'vegan' },
  { href: PRODUCTS.void, label: 'void' },
  { href: PRODUCTS.waves, label: 'waves' },
  { href: PRODUCTS.shield, label: 'suñůlink.shield' },
  { href: PRODUCTS.webe, label: 'webË' },
  { href: PRODUCTS.compliance, label: 'Compliance', minor: true },
  { href: `${PRODUCTS.webe}#run-a-node-section`, label: 'Run a node' },
  { href: PRODUCTS.security, label: 'Security', minor: true },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentProduct = PATH_TO_PRODUCT[path];
const navCurrent = (href: string) => {
  const base = href.split('#')[0];
  if (currentProduct && base === currentProduct) return 'page' as const;
  if (base === path) return 'page' as const;
  return undefined;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0A0B0D" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={manifest} />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {preview && previewMeta && previewWideUrl && previewSquareUrl && (
      <>
        <meta property="og:video" content={previewWideUrl} />
        <meta property="og:video:secure_url" content={previewWideUrl} />
        <meta property="og:video:type" content="video/mp4" />
        <meta property="og:video:width" content={ogVideoW} />
        <meta property="og:video:height" content={ogVideoH} />
        {/* IETF link-preview-media profile: H.264 landscape for broad unfurlers. */}
        <meta property="preview:url" content={previewWideUrl} />
        <meta property="preview:type" content="video/mp4; codecs=avc1" />
        <meta property="preview:duration" content={String(previewMeta.duration)} />
        <meta property="preview:size" content={`${ogVideoW}x${ogVideoH}`} />
        <meta
          property="preview:bytes"
          content={String(previewMeta.wideBytes ?? previewMeta.bytes)}
        />
        {previewMeta.wideHash && <meta property="preview:hash" content={previewMeta.wideHash} />}
        <meta property="preview:policy" content="mute loop autoplay" />
        {/* webË / Apple-quality square (WEBE.md 7.1); synonym of preview:* when clients prefer it. */}
        <meta property="nu:preview" content={previewSquareUrl} />
        <meta property="nu:preview:type" content="video/mp4; codecs=hvc1" />
        <meta property="nu:preview:duration" content={String(previewMeta.duration)} />
        <meta property="nu:preview:size" content="1080x1080" />
        <meta property="nu:preview:bytes" content={String(previewMeta.bytes)} />
        <meta property="nu:preview:hash" content={previewMeta.hash} />
        <meta property="nu:preview:effect" content="ripple" />
      </>
    )}

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: SITE_NAME,
        operatingSystem: 'iOS 26, iPadOS 26, macOS 26',
        applicationCategory: 'CommunicationApplication',
        url: 'https://khensu.nu',
        publisher: { '@type': 'Organization', name: 'Elliott Wave LLC', url: 'https://elliottwave.studio' },
      })}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="khėnsu.ñü, home">
          <img class="seal" src="/seal-128.webp" alt="" width="26" height="26" />
          <span><Name /></span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {nav.map((n) => (
              <li class:list={[n.minor && 'minor']}>
                <a href={n.href} aria-current={navCurrent(n.href)}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>
    <!-- The relay network pulses behind the first hero of every page. Hero.astro places its own; this one moves into
         the first [data-hero] or .page-head before the network's script runs (a <template> would leave that script inert). -->
    <div id="hero-net-src" hidden><Net class="hero-net" nodes={72} /></div>
    <script is:inline>
      (() => {
        const src = document.getElementById('hero-net-src');
        if (!src) return;
        const net = src.firstElementChild;
        const hero = document.querySelector('[data-hero], .page-head');
        if (net && hero && !hero.querySelector('.net') && !document.querySelector('.k-hero')) {
          hero.classList.add('has-hero-net');
          hero.prepend(net);
        }
        src.remove();
      })();
    </script>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="foot-brand"><Name /></p>
          <p class="foot-tag">The first app on webe. From <a href="https://elliottwave.studio">elliottwave.studio lab</a>.</p>
        </div>
        <ul class="foot-links">
          <li><a href={PRODUCTS.webe}>webË</a></li>
          <li><a href={PRODUCTS.void}>ñü.vœîð</a></li>
          <li><a href={PRODUCTS.avatars}>ñü.ævätåřş</a></li>
          <li><a href={PRODUCTS.aura}>ñü.åůřâ</a></li>
          <li><a href={PRODUCTS.devices}>nu.devices</a></li>
          <li><a href={PRODUCTS.eyes}>ñü.êýêš</a></li>
          <li><a href={PRODUCTS.vegan}>nu.vegan</a></li>
          <li><a href={PRODUCTS.media}>ñü.media</a></li>
          <li><a href={PRODUCTS.moments}>ñü.mømëntš</a></li>
          <li><a href={PRODUCTS.memory}>ñü.řåł</a></li>
          <li><a href={PRODUCTS.create}>ñü.ċřêæțẽ</a></li>
          <li><a href={PRODUCTS.waves}>ñü.ŵævẽš</a></li>
          <li><a href={PRODUCTS.indra}>îňðřæ.ōġ</a></li>
          <li><a href={PRODUCTS.fi}>ñũ.Fî</a></li>
          <li><a href={PRODUCTS.kronos}>Kronos</a></li>
          <li><a href={PRODUCTS.nuGlass}>nu.glass</a></li>
          <li><a href={PRODUCTS.skillsMusicTheory}>skills.music.theory</a></li>
          <li><a href={PRODUCTS.sla}>SLA</a></li>
          <li><a href={PRODUCTS.getApps}>Get the apps</a></li>
          <li><a href={PRODUCTS.shield}>suñůlink.shield</a></li>
          <li><a href="/transfer">Send big files</a></li>
          <li><a href="/quality">How we measure</a></li>
          <li><a href={PRODUCTS.network}>ñü.ñetwork</a></li>
          <li><a href={PRODUCTS.bi}>ñũ.Bî basic income</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/compliance">Compliance</a></li>
          <li><a href="https://dev.khensu.nu">Developers</a></li>
          <li><a href="https://dev.khensu.nu/shell">suñůlink.shield specs</a></li>
          <li><a href="/security">Security</a></li>
          <li><a href="https://elliottwave.studio">elliottwave.studio lab</a></li>
        </ul>
      </div>
      <div class="wrap legal">
        <p>
          © 2026 Elliott Wave LLC. All rights reserved. khėnsu.ñü™ and elliottwave.studio lab™ are trademarks of Elliott Wave LLC.
          Apple, the Apple logo, Apple Intelligence, iPhone, iPad, Mac and Liquid Glass are trademarks of Apple Inc., registered in the U.S. and other countries. App Store is a service mark of Apple Inc. Google Play and the Google Play logo are trademarks of Google LLC. khensu.nu is not affiliated with or endorsed by Apple or Google.
        </p>
        <p>Elliott Wave LLC, founded and solely owned by Elliott, owns all intellectual property in its projects, the open-source projects included.</p>
      </div>
    </footer>
    <script>
      import '../scripts/section-links.ts';
      import '../../../_shared/aura-buttons.ts';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--accent);
    color: var(--bg);
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .brand:hover {
    color: var(--text);
  }
  nav ul {
    display: flex;
    gap: clamp(0.75rem, 1.6vw, 1.6rem);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav ul::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 1439px) {
    nav li.minor {
      display: none;
    }
  }
  nav a {
    font-size: 0.86rem;
    letter-spacing: -0.005em;
    text-decoration: none;
    color: var(--text-dim);
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page']::after {
    content: '';
    display: block;
    height: 1px;
    background: var(--accent);
    margin-top: 2px;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 3.5rem 0 2.5rem;
    margin-top: 2rem;
    background: var(--bg-sunk);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }
  .foot-brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 0 0 0.25rem;
  }
  .foot-tag {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .foot-links {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 0.5rem 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
  }
  .foot-links a {
    color: var(--text-dim);
    text-decoration: none;
  }
  .legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .legal p {
    font-size: 0.8rem;
    color: var(--text-faint);
    max-width: none;
    margin: 0;
  }
  .legal p + p {
    margin-top: 0.4rem;
  }
  nav {
    min-width: 0;
  }
  nav a {
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    nav ul {
      mask-image: linear-gradient(90deg, #000 85%, transparent);
      padding-right: 1.5rem;
    }
  }
  @media (max-width: 560px) {
    .brand span {
      display: none;
    }
    .foot-links {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
