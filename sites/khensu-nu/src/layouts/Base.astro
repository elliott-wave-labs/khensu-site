---
import { CARDS, cardFor } from '../data/og';
import Crescent from '../components/khensu/Crescent.astro';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const SITE_NAME = 'khensu.ñü';
const DEFAULT_DESC =
  'khensu.ñü is a post-quantum private messenger on a network run by people: messages, calls, feeds, forums, sites and private payments, with private AI that runs only on your device.';

const { title, description = DEFAULT_DESC, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — webË, private by design. Post-quantum. Run profitably by the people.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const card = cardFor(Astro.url.pathname);
const ogImage = new URL(`/og/${card}.jpg`, Astro.site);
const ogAlt = CARDS[card].alt;

const nav = [
  { href: '/webe', label: 'webË' },
  { href: '/media', label: 'ñü.media' },
  { href: '/memory', label: 'Memory' },
  { href: '/creators', label: 'Creators' },
  { href: '/sounds', label: 'ñü.sounds' },
  { href: '/nufi', label: 'ñüFi' },
  { href: '/shield', label: 'suñůlink.shield' },
  { href: '/network', label: 'ñü.ñetwork' },
  { href: '/compliance', label: 'Compliance' },
  { href: '/security', label: 'Security' },
  { href: '/webe#run-a-node-section', label: 'Run a node' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0A0B0D" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: SITE_NAME,
        operatingSystem: 'iOS 26, iPadOS 26, macOS 26',
        applicationCategory: 'CommunicationApplication',
        url: 'https://khensu.nu',
        publisher: { '@type': 'Organization', name: 'Elliott Wave LLC', url: 'https://elliottwave.studio' },
      })}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="khensu.ñü, home">
          <img class="seal" src="/seal-128.webp" alt="" width="26" height="26" />
          <span>khensu.ñü</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="foot-brand">khensu.ñü</p>
          <p class="foot-tag">The first app on webË. From <a href="https://elliottwave.studio">elliottwave.studio lab</a>.</p>
        </div>
        <ul class="foot-links">
          <li><a href="/webe">webË</a></li>
          <li><a href="/media">ñü.media</a></li>
          <li><a href="/memory">Memory</a></li>
          <li><a href="/creators">Creators</a></li>
          <li><a href="/sounds">ñü.sounds</a></li>
          <li><a href="/nufi">ñüFi</a></li>
          <li><a href="/shield">suñůlink.shield</a></li>
          <li><a href="/transfer">Send big files</a></li>
          <li><a href="/quality">How we measure</a></li>
          <li><a href="/network">Network</a></li>
          <li><a href="/bi">ñü.bi basic income</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/compliance">Compliance</a></li>
          <li><a href="https://dev.khensu.nu">Developers</a></li>
          <li><a href="https://dev.khensu.nu/shell">suñůlink.shield specs</a></li>
          <li><a href="/security">Security</a></li>
          <li><a href="https://elliottwave.studio">elliottwave.studio lab</a></li>
        </ul>
      </div>
      <div class="wrap legal">
        <p>
          © 2026 Elliott Wave LLC. All rights reserved. khensu.ñü™ and elliottwave.studio lab™ are trademarks of Elliott Wave LLC.
          Apple, the Apple logo, Apple Intelligence, iPhone, iPad, Mac and Liquid Glass are trademarks of Apple Inc., registered in the U.S. and other countries. App Store is a service mark of Apple Inc. Google Play and the Google Play logo are trademarks of Google LLC. khensu.nu is not affiliated with or endorsed by Apple or Google.
        </p>
        <p>Elliott Wave LLC, founded and solely owned by Elliott, owns all intellectual property in its projects, the open-source projects included.</p>
      </div>
    </footer>
    <script>
      import '../scripts/section-links.ts';
      import '../../../_shared/aura-buttons.ts';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--accent);
    color: var(--bg);
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .brand:hover {
    color: var(--text);
  }
  nav ul {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-dim);
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page']::after {
    content: '';
    display: block;
    height: 1px;
    background: var(--accent);
    margin-top: 2px;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 3.5rem 0 2.5rem;
    margin-top: 2rem;
    background: var(--bg-sunk);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }
  .foot-brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 0 0 0.25rem;
  }
  .foot-tag {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .foot-links {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 0.5rem 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
  }
  .foot-links a {
    color: var(--text-dim);
    text-decoration: none;
  }
  .legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .legal p {
    font-size: 0.8rem;
    color: var(--text-faint);
    max-width: none;
    margin: 0;
  }
  .legal p + p {
    margin-top: 0.4rem;
  }
  nav {
    min-width: 0;
  }
  nav a {
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    nav ul {
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
      padding-right: 1.5rem;
    }
    nav ul::-webkit-scrollbar {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .brand span {
      display: none;
    }
    .foot-links {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
