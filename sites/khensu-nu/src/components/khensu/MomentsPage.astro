<script>
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.mo-reel, .mo-reel-phone, .fx video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }

  const samples = document.querySelectorAll<HTMLVideoElement>('.mo-tpl video');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const el = e.target as HTMLVideoElement;
          if (e.isIntersecting) el.play().catch(() => {});
          else el.pause();
        }
      },
      { rootMargin: '120px 0px', threshold: 0.25 },
    );
    samples.forEach((el) => io.observe(el));
  }

  const cats = document.querySelectorAll<HTMLButtonElement>('.mo-cats button');
  cats.forEach((btn) =>
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat ?? '';
      cats.forEach((b) => b.classList.toggle('on', b === btn));
      document.querySelectorAll<HTMLLIElement>('.mo-tpl li').forEach((li) => {
        li.hidden = cat !== '' && li.dataset.cat !== cat;
      });
    }),
  );
</script>
