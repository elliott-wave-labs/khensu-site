    position: relative;
    min-height: 150vh;
    border-top: 0;
  }
  .vx-stage {
    position: sticky;
    top: 64px;
    min-height: calc(100vh - 64px);
    display: grid;
    align-items: start;
    overflow: visible;
  }
  .vx-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ring {
    position: absolute;
    left: 50%;
    top: 74%;
    width: min(980px, 88%);
    height: min(340px, 42vh);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    translate: -50% -50%;
    scale: calc(0.82 + var(--p) * 0.18);
    background:
      radial-gradient(closest-side, transparent 68%, rgba(255, 255, 255, 0.03) 69%, transparent 74%);
  }
  .piece {
    position: absolute;
    left: calc((50% + (var(--x) - 50) * var(--p) * 1%));
    top: calc((74% + (var(--y) - 74) * var(--p) * 1%));
