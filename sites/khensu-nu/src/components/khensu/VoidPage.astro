    font-size: clamp(2.6rem, 6.4vw, 5.4rem);
    line-height: 1.15;
    letter-spacing: -0.045em;
    font-weight: 500;
    margin: 0 0 1.1rem;
    max-width: 12ch;
    translate: 0 calc(var(--p) * -1.1rem);
  }
