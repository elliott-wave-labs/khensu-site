---
// suñůlink.shield in <ew-viewer> (elliottwave.studio lab's viewer, on Google's <model-viewer>): auto-rotate,
// drag to turn and "View in your space" AR on by default. The GLBs come from tools/shield/glb.py, one per
// finish, inlay tier and mode (shield alone or on the iPhone). The page picks one with a `shield:finish`
// event { finish, tier }; see pages/buy.astro.
const GLB = '/khensu/shell/3d/glb';
const first = `${GLB}/maroon-standard-shield.glb`;
// iPhone 18 Pro colours for the "On iPhone" mode. "Match" follows the shield's finish.
const phones = [
  { id: 'match', name: 'Match the shield' },
  { id: 'burgundy', name: 'Burgundy', hex: '#5a1f2a' },
  { id: 'glacier', name: 'Glacier', hex: '#b9c8d4' },
  { id: 'silver', name: 'Silver', hex: '#d4d5d7' },
  { id: 'black', name: 'Black', hex: '#2b2c2f' },
];
---

<div class="viewer" data-glb={GLB}>
  <ew-viewer
    src={first}
    alt="suñůlink.shield, a maroon titanium shield for iPhone with the khensu.nu mark inlaid in stone and platinum on the back"
    ar
    ar-label="View in your space"
    camera-controls
    auto-rotate
    rotation-per-second="18deg"
    shadow-intensity="1.2"
    exposure="1.1"
    camera-orbit="25deg 78deg auto"
    loading="eager"
    height="100%"
  ></ew-viewer>
  <div class="modes" role="group" aria-label="Show">
    <button type="button" class="on" data-mode="shield" aria-pressed="true">Shield</button>
    <button type="button" data-mode="phone" aria-pressed="false">On iPhone</button>
  </div>
  <div class="phone-colours" role="group" aria-label="iPhone colour" hidden>
    {phones.map((p, i) => (
      <button type="button" class:list={{ on: i === 0 }} data-phone={p.id} data-hex={p.hex} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={p.name} title={p.name}>
        {p.hex ? <span style={`background:${p.hex}`}></span> : <span class="match">Match</span>}
      </button>
    ))}
  </div>
</div>

<script is:inline type="module" src="/vendor/ew-viewer/ew-viewer.min.js"></script>

<script>
  type Finish = { finish: string; tier: 'standard' | 'moldavite' };
  const host = document.querySelector<HTMLElement>('.viewer')!;
  const viewer = host.querySelector('ew-viewer')!;
  const state = { finish: 'maroon', tier: 'standard', mode: 'shield', phone: 'match' };
  const colours = host.querySelector<HTMLElement>('.phone-colours')!;

  // The shield finishes as iPhone colours, for "Match": [hex, metalness, roughness].
  const MATCH: Record<string, [string, number, number]> = {
    maroon: ['#5e1a24', 0.6, 0.34],
    gold: ['#c9a564', 0.85, 0.3],
    black: ['#232427', 0.6, 0.34],
    brass: ['#ecd59c', 1, 0.26],
  };
  const linear = (hex: string) =>
    [1, 3, 5].map((i) => {
      const c = parseInt(hex.slice(i, i + 2), 16) / 255;
      return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    });

  type Pbr = { setBaseColorFactor(c: number[]): void; setMetallicFactor(v: number): void; setRoughnessFactor(v: number): void };
  type ModelViewer = HTMLElement & { model?: { getMaterialByName(n: string): { pbrMetallicRoughness: Pbr } | null } };
  const paintPhone = () => {
    if (state.mode !== 'phone') return;
    const mv = (viewer as unknown as { modelViewer: ModelViewer }).modelViewer;
    const pbr = mv.model?.getMaterialByName('iPhone')?.pbrMetallicRoughness;
    if (!pbr) return;
    const pick = colours.querySelector<HTMLElement>(`[data-phone="${state.phone}"]`);
    const [hex, metal, rough] = state.phone === 'match' ? MATCH[state.finish] ?? MATCH.black : [pick!.dataset.hex!, 0.85, 0.32];
    pbr.setBaseColorFactor([...linear(hex), 1]);
    pbr.setMetallicFactor(metal);
    pbr.setRoughnessFactor(rough);
  };
  customElements.whenDefined('ew-viewer').then(() => {
    (viewer as unknown as { modelViewer: HTMLElement }).modelViewer.addEventListener('load', paintPhone);
  });

  const show = () => {
    viewer.setAttribute('src', `${host.dataset.glb}/${state.finish}-${state.tier}-${state.mode}.glb`);
  };
  addEventListener('shield:finish', (e) => {
    const d = (e as CustomEvent<Finish>).detail;
    state.finish = d.finish;
    state.tier = d.tier;
    show();
  });
  const choose = (group: Element, b: Element) => {
    for (const x of group.querySelectorAll('button')) {
      x.classList.toggle('on', x === b);
      x.setAttribute('aria-pressed', String(x === b));
    }
  };
  for (const b of host.querySelectorAll<HTMLButtonElement>('.modes button')) {
    b.addEventListener('click', () => {
      choose(b.parentElement!, b);
      state.mode = b.dataset.mode!;
      colours.hidden = state.mode !== 'phone';
      show();
    });
  }
  for (const b of colours.querySelectorAll<HTMLButtonElement>('button')) {
    b.addEventListener('click', () => {
      choose(colours, b);
      state.phone = b.dataset.phone!;
      paintPhone();
    });
  }
</script>

<style>
  .viewer {
    position: relative;
    height: min(72vh, 620px);
    border-radius: 28px;
    background: radial-gradient(70% 60% at 50% 40%, rgba(139, 123, 255, 0.14), transparent 70%), #060608;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  ew-viewer { display: block; width: 100%; height: 100%; }
  .modes {
    position: absolute;
    top: 14px;
    left: 50%;
    translate: -50% 0;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px) saturate(160%);
  }
  .modes button {
    padding: 0.35rem 0.9rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
    background: none;
    cursor: pointer;
  }
  .modes button.on { color: #fff; background: rgba(255, 255, 255, 0.16); }
  .phone-colours {
    position: absolute;
    bottom: 14px;
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px) saturate(160%);
  }
  .phone-colours[hidden] { display: none; }
  .phone-colours button {
    display: grid;
    place-items: center;
    min-width: 30px;
    height: 30px;
    padding: 3px;
    border: 1.5px solid transparent;
    border-radius: 999px;
    background: none;
    cursor: pointer;
  }
  .phone-colours button.on { border-color: #fff; }
  .phone-colours span { display: block; width: 20px; height: 20px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25); }
  .phone-colours .match { width: auto; height: auto; padding: 0 0.55rem; font-size: 0.75rem; color: rgba(255, 255, 255, 0.85); box-shadow: none; }
</style>
