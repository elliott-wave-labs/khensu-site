---
// nu-media charts. Photo figures from khensu-specs design/nu-media.md (nu-media values are design
// targets). Video figures are measured: data/iphone-*.json is khensu-specs bench/iphone-*.json, with
// H.264 and HEVC encoded on an iPhone Air and AV1 on a Mac (the iPhone has no AV1 encoder).
// Each card draws from its own --e (scripts/scenes.ts, reveal); without the script they show complete.
import reel from '../../data/iphone-reel.json';
import aurora from '../../data/iphone-aurora.json';
import g720 from '../../data/iphone-720p.json';

type Point = { actual_kbps: number; vmaf: number };
type Run = { codecs: Record<string, { points: Point[] }>; grid: { want_kbps: number; codecs: Record<string, Point> } };
type P = { k: number; v: number };

const pts = (run: Run, key: string, scale = 1): P[] =>
  run.codecs[key].points.map((p) => ({ k: p.actual_kbps * scale, v: p.vmaf })).sort((a, b) => a.k - b.k);

// Targets and estimates, all scaled from measured curves (see the footnote).
const NU_TARGET = 0.6; // nu-media design target: 40% fewer bits than hardware HEVC
const AV2 = 0.7; // AOMedia: about 30% fewer bits than AV1
const LEARNED = 0.65; // DCVC-RT, from its published gain over H.266

const series = (run: Run) => [
  { name: 'H.264, iPhone hardware', cls: 'c264', ps: pts(run, 'h264-hw') },
  { name: 'HEVC, iPhone hardware', cls: 'c265', ps: pts(run, 'hevc-hw') },
  { name: 'AV1 software, real time', cls: 'cav1rt', ps: pts(run, 'av1-svt-rt') },
  { name: 'nu-media base layer only', cls: 'cnub', ps: pts(run, 'nu-base') },
  { name: 'nu-media target', cls: 'cnu', ps: pts(run, 'hevc-hw', NU_TARGET), est: true },
  { name: 'AV2, published estimate', cls: 'cav2', ps: pts(run, 'av1-svt-rt', AV2), est: true },
  { name: 'Learned codec (DCVC-RT), estimate', cls: 'cml', ps: pts(run, 'av1-svt-rt', LEARNED), est: true },
];

// Rate-quality chart geometry: log bitrate across, VMAF up.
const W = 560, H = 300, L = 40, R = 548, T = 12, B = 262;
const chart = (run: Run, x0: number, x1: number, y0: number, step: number, ticks: number[]) => {
  const x = (k: number) => L + ((Math.log(k) - Math.log(x0)) / (Math.log(x1) - Math.log(x0))) * (R - L);
  const y = (v: number) => B - ((v - y0) / (100 - y0)) * (B - T);
  const lines = series(run).map((l) => ({
    ...l,
    d: l.ps.map((p, i) => `${i ? 'L' : 'M'}${x(p.k).toFixed(1)} ${y(p.v).toFixed(1)}`).join(' '),
    dots: l.est ? [] : l.ps.map((p) => ({ cx: x(p.k), cy: y(p.v) })),
  }));
  const gy = Array.from({ length: Math.round((100 - y0) / step) + 1 }, (_, i) => y0 + step * i).map((v) => ({ v, y: y(v) }));
  const gx = ticks.map((k) => ({ k, x: x(k), label: k < 1000 ? `${k}k` : `${k / 1000}M` }));
  return { lines, gy, gx };
};
const charts = [
  { title: '720p video, iPhone Air', sub: '720 × 1280 portrait, 30 fps', ...chart(reel as Run, 150, 2500, 20, 20, [250, 500, 1000, 2000]) },
  { title: '4K video, iPhone Air', sub: '3840 × 2160, 30 fps, NASA aurora', ...chart(aurora as Run, 1000, 20000, 75, 5, [2000, 4000, 8000, 16000]) },
];
const key = series(reel as Run);

// Bitrate each codec needs for VMAF 80 on the 720p clip, interpolated on log bitrate.
const at = (ps: P[], target: number) => {
  for (let i = 1; i < ps.length; i++) {
    if (ps[i - 1].v <= target && ps[i].v >= target) {
      const f = (target - ps[i - 1].v) / (ps[i].v - ps[i - 1].v);
      return Math.round(Math.exp(Math.log(ps[i - 1].k) + f * (Math.log(ps[i].k) - Math.log(ps[i - 1].k))));
    }
  }
  return Math.round(ps[ps.length - 1].k);
};
const r = reel as Run;
const need = [
  { name: 'H.264', note: 'iPhone hardware', kbps: at(pts(r, 'h264-hw'), 80), rt: 'Yes, hardware' },
  { name: 'nu-media base layer', note: 'HEVC at half size, no enhancement', kbps: at(pts(r, 'nu-base'), 80), rt: 'Yes, hardware', ours: true },
  { name: 'AV1, real time', note: 'SVT-AV1 on a Mac', kbps: at(pts(r, 'av1-svt-rt'), 80), rt: 'No AV1 encoder on iPhone' },
  { name: 'HEVC', note: 'iPhone hardware', kbps: at(pts(r, 'hevc-hw'), 80), rt: 'Yes, hardware' },
  { name: 'AV2', note: 'Published estimate', kbps: at(pts(r, 'av1-svt-rt', AV2), 80), rt: 'No: no hardware yet', est: true },
  { name: 'Learned codec', note: 'DCVC-RT, estimate', kbps: at(pts(r, 'av1-svt-rt', LEARNED), 80), rt: 'No: datacenter GPU', est: true },
  { name: 'nu-media target', note: 'With Neural Engine enhancement', kbps: at(pts(r, 'hevc-hw', NU_TARGET), 80), rt: 'Yes, Neural Engine', ours: true, est: true },
].sort((a, b) => b.kbps - a.kbps);
const needMax = Math.max(...need.map((n) => n.kbps));

const rg = r.grid.codecs;
const at500 = [
  { name: 'H.264', note: 'iPhone hardware', vmaf: rg['h264-hw'].vmaf },
  { name: 'HEVC', note: 'iPhone hardware', vmaf: rg['hevc-hw'].vmaf },
  { name: 'AV1', note: 'Software, on a Mac', vmaf: rg['av1-svt-rt'].vmaf },
  { name: 'nu-media', note: 'Base layer only, before the Neural Engine', vmaf: rg['nu-base'].vmaf, ours: true },
];

const rate = (k: number) => (k < 1000 ? `${Math.round(k)} kbit/s` : `${(k / 1000).toFixed(1)} Mbit/s`);
const tileSet = (run: Run, src: string, half: string) => {
  const g = run.grid.codecs;
  const v = (k: string) => `${rate(g[k].actual_kbps)} · VMAF ${g[k].vmaf.toFixed(0)}`;
  return [
    { name: 'Original', note: src },
    { name: 'nu-media base', note: `HEVC at ${half} · ${v('nu-base')}`, ours: true },
    { name: 'HEVC', note: `iPhone hardware · ${v('hevc-hw')}` },
    { name: 'AV1', note: `Mac software · ${v('av1-svt-rt')}` },
    { name: 'H.264', note: `iPhone hardware · ${v('h264-hw')}` },
    { name: 'nu-media base, AV1', note: `${half} · ${v('nu-base-av1')}`, ours: true },
  ];
};
const t720 = g720.tiles as Record<string, { vmaf: number; actual_kbps: number }>;
const v720 = (k: string) => `${rate(t720[k].actual_kbps)} · VMAF ${t720[k].vmaf.toFixed(0)}`;
const videos = [
  {
    title: '5× smaller than Instagram’s own file',
    sub: 'Every codec at 500 kbit/s, 720p. Top row encoded on an iPhone Air, bottom row on a Mac, since iPhone has no encoder for them. 1:1 crops of 720 × 1280 frames.',
    stats: [
      { big: `${(2437.958 / 500).toFixed(1)}×`, small: 'fewer bytes than Instagram serves' },
      { big: `${(2437.958 / 500).toFixed(1)}×`, small: 'faster to arrive on the same connection' },
      { big: 'Same look', small: 'nu-media’s quality target at this size' },
    ],
    src: '/khensu/codec/compare-720p.mp4', poster: '/khensu/codec/compare-720p.jpg', w: 1440, h: 1280, cols: 4, rows: 2, maxw: '46rem',
    mobile: '/khensu/codec/compare-720p-m.mp4',
    tiles: [
      { name: 'Original', note: 'Instagram · 720 × 1280 · 2.44 Mbit/s · 30 fps' },
      { name: 'nu-media', note: `Neural Engine · ${v720('nu-media')}`, ours: true },
      { name: 'HEVC (H.265)', note: `iPhone hardware · ${v720('hevc-hw')}` },
      { name: 'HEVC (x265)', note: `Software, slow · ${v720('hevc-x265')}` },
      { name: 'AV1', note: `Real time · ${v720('av1-rt')}` },
      { name: 'AV1', note: `Best, not live · ${v720('av1-best')}` },
      { name: 'H.264', note: `iPhone hardware · ${v720('h264-hw')}` },
      { name: 'VP9', note: `Real time · ${v720('vp9-rt')}` },
    ],
    credit: `Source: @deemsterhotline on Instagram, used with thanks: H.264 High profile, 720 × 1280 at 30 fps, 2.44 Mbit/s video (2.51 Mbit/s with audio), so every tile here uses about a fifth of the bits Instagram serves. nu-media is the iPhone’s hardware HEVC at 360 × 640 plus Apple’s low-latency super resolution on the Neural Engine, our first prototype of the enhancement layer. It looks sharper but scores VMAF ${t720['nu-media'].vmaf.toFixed(0)}, below a plain upscale (${(g720.tiles as any)['nu-base-lanczos'].vmaf.toFixed(0)}), because it adds texture the original doesn’t have; nu-media’s own trained network replaces it.`,
  },
  {
    title: '4K at 4 Mbit/s, encoded on iPhone Air',
    sub: '1:1 crops of 3840 × 2160 frames, every codec at the same bitrate',
    src: '/khensu/codec/compare-aurora.mp4', poster: '/khensu/codec/compare-aurora.jpg', w: 2880, h: 1080, cols: 3, rows: 2, maxw: 'none',
    tiles: tileSet(aurora as Run, '3840 × 2160 · 180 Mbit/s · 30 fps', '1920 × 1080'),
    credit: 'The nu-media tiles are the base layer only, upscaled with a plain filter; the Neural Engine enhancement isn’t in this video yet. Aurora during the November 2025 geomagnetic storm, photographed from the International Space Station. NASA Scientific Visualization Studio.',
  },
];

const photo = [
  { name: 'JPEG', note: 'ImageIO', bits: '5.06 Mbit', size: '618 KB', w: 100 },
  { name: 'HEIC', note: 'ImageIO, hardware HEVC', bits: '2.53 Mbit', size: '309 KB', w: 50 },
  { name: 'nu-media', note: 'Neural Engine', bits: '0.33 Mbit', size: '40 KB', w: 6.5, ours: true },
];

const live = [
  { name: 'HEIC + HEVC', note: 'Apple’s Live Photo pair', bits: '11.2 Mbit', size: '1.4 MB', w: 100 },
  { name: 'nu-media Live', note: 'Neural Engine, motion from the still', bits: '1.6 Mbit', size: '200 KB', w: 14, ours: true },
];

const heicTicks = 52;
const nuTicks = 7;

const chips = [
  { name: 'A13', cores: 8 },
  { name: 'A14', cores: 16 },
  { name: 'A15', cores: 16 },
  { name: 'A16', cores: 16 },
  { name: 'A17 Pro', cores: 16 },
  { name: 'A18', cores: 16 },
  { name: 'A19', cores: 16 },
  { name: 'A20 Pro', cores: 32, ours: true },
];
---

<section class="section numedia" aria-labelledby="numedia-title">
  <div class="wrap">
    <p class="eyebrow">nu-media</p>
    <h2 id="numedia-title" class="big">Less data. Same picture.</h2>
    <p class="lede">
      Our own image and video codec runs on your iPhone’s Neural Engine. Photos and video take a fraction of the data,
      keep their resolution and HDR, and still travel inside the stealth rhythm.
    </p>

    <div class="charts">
      <figure class="card wide" data-scene="reveal">
        <figcaption><b>One full-screen photo</b><span>Size on the wire</span></figcaption>
        <ul class="bars" role="list">
          {photo.map((r, i) => (
            <li class:list={[{ ours: r.ours }]} style={`--w:${r.w};--i:${i}`}>
              <span class="label"><b>{r.name}</b> <small>{r.note}</small></span>
              <span class="track"><span class="fill" /></span>
              <span class="value"><b>{r.size}</b> <small>{r.bits}</small></span>
            </li>
          ))}
        </ul>
        <p class="saves"><span><b>15×</b> smaller than JPEG</span><span><b>94%</b> less data</span><span><b>$49</b> saved per million views</span></p>
        <figcaption class="sub-cap"><b>One Live Photo</b><span>The still plus 3 seconds of motion and sound</span></figcaption>
        <ul class="bars" role="list">
          {live.map((r, i) => (
            <li class:list={[{ ours: r.ours }]} style={`--w:${r.w};--i:${i + 3}`}>
              <span class="label"><b>{r.name}</b> <small>{r.note}</small></span>
              <span class="track"><span class="fill" /></span>
              <span class="value"><b>{r.size}</b> <small>{r.bits}</small></span>
            </li>
          ))}
        </ul>
        <p class="saves"><span><b>7×</b> smaller than Apple’s pair</span><span><b>86%</b> less data</span><span><b>$102</b> saved per million views</span></p>
        <p class="saves-note">Bandwidth priced at $0.085 per GB, Amazon CloudFront’s US list price for the first 10 TB a month. Against HEIC, a nu-media photo is 7.7× smaller, 87% less, $23 saved per million views.</p>
      </figure>

      <figure class="card" data-scene="reveal">
        <figcaption><b>Time to arrive</b><span>Each square is one 2-second stealth tick</span></figcaption>
        <div class="ticks-row">
          <span class="label"><b>HEIC</b> <small>309 KB · 104 s</small></span>
          <div class="ticks" aria-hidden="true">
            {Array.from({ length: heicTicks }, (_, i) => <i style={`--i:${i}`} />)}
          </div>
        </div>
        <div class="ticks-row ours">
          <span class="label"><b>nu-media</b> <small>40 KB · 14 s</small></span>
          <div class="ticks" aria-hidden="true">
            {Array.from({ length: nuTicks }, (_, i) => <i style={`--i:${i}`} />)}
          </div>
        </div>
        <p class="note">A preview lands in the first tick and sharpens as the rest arrive. A nu-media Live Photo (200 KB) shows its still in 14 s and starts moving at about 70 s, all inside the ticks.</p>
      </figure>

      <figure class="card">
        <figcaption><b>Progressive</b><span>Preview first, full detail in seconds</span></figcaption>
        <div class="prog">
        <span class="timer" aria-hidden="true"></span>
        <svg class="scene" viewBox="0 0 320 180" role="img" aria-label="A photo of the Portara on Naxos at dawn, sharpening as it arrives">
          <defs>
            <linearGradient id="nm-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2b1e4a" />
              <stop offset="0.55" stop-color="#d9786a" />
              <stop offset="1" stop-color="#f6c48a" />
            </linearGradient>
            <linearGradient id="nm-sea" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3a4f7a" />
              <stop offset="1" stop-color="#121a33" />
            </linearGradient>
          </defs>
          <g class="sharpen">
            <rect width="320" height="120" fill="url(#nm-sky)" />
            <circle cx="214" cy="112" r="22" fill="#ffe2a8" />
            <rect y="112" width="320" height="68" fill="url(#nm-sea)" />
            <path d="M0 124 L70 110 L130 118 L190 108 L250 120 L320 114 L320 132 L0 132 Z" fill="#1b2240" />
            <path d="M96 132 V70 H164 V132 H150 V84 H110 V132 Z" fill="#0d1022" />
            <path d="M206 136 h70 M190 146 h40 M240 152 h56" stroke="#ffd9a0" stroke-opacity="0.5" stroke-width="2" />
          </g>
        </svg>
        </div>
        <p class="note">1 slot: preview. 20 slots, 7 ticks, 14 s: full screen, in HDR.</p>
      </figure>

      <figure class="card" data-scene="reveal">
        <figcaption><b>Video calls, same data</b><span>Quality at 500 kbit/s, 720p, encoded on iPhone Air</span></figcaption>
        <ul class="q500" role="list">
          {at500.map((r, i) => (
            <li class:list={[{ ours: r.ours }]} style={`--w:${r.vmaf};--i:${i}`}>
              <span class="label"><b>{r.name}</b> <small>{r.note}</small></span>
              <span class="track"><span class="fill" /></span>
              <span class="value"><b>{r.vmaf.toFixed(0)}</b></span>
            </li>
          ))}
        </ul>
        <p class="note"><a href="https://github.com/Netflix/vmaf">VMAF</a> is Netflix’s open video quality score: it compares each video with the original and predicts how people would rate it, 0 to 100. Above 70 looks good on a phone. nu-media sends a half-size base layer; the receiving iPhone’s Neural Engine restores the rest.</p>
      </figure>

      <figure class="card wide" data-scene="reveal">
        <figcaption><b>Quality for every bitrate</b><span>Higher and further left is better. nu-media in colour, everything else in grey. Solid lines measured, dashed lines are targets and estimates.</span></figcaption>
        <div class="rds">
          {charts.map((c, ci) => (
            <div class="rdw">
              <p class="rdt"><b>{c.title}</b> <small>{c.sub}</small></p>
              <svg class="rd" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Rate-quality curves, ${c.title}`}>
                {c.gy.map((g) => (
                  <g class="gy">
                    <line x1={L} x2={R} y1={g.y} y2={g.y} />
                    <text x={L - 8} y={g.y + 4}>{g.v.toFixed(0)}</text>
                  </g>
                ))}
                {c.gx.map((g) => (
                  <g class="gx">
                    <line x1={g.x} x2={g.x} y1={T} y2={B} />
                    <text x={g.x} y={B + 18}>{g.label}</text>
                  </g>
                ))}
                <defs>
                  <linearGradient id={`nug${ci}`} gradientUnits="userSpaceOnUse" x1={L} y1="0" x2={R} y2="0">
                    <stop offset="0" stop-color="#8b7bff" /><stop offset="1" stop-color="#4fd1c5" />
                  </linearGradient>
                </defs>
                <clipPath id={`rdc${ci}`}><rect x={L} y={T - 4} width={R - L} height={B - T + 8} /></clipPath>
                <g clip-path={`url(#rdc${ci})`}>
                  <g class="plot">
                    {c.lines.map((l) => (
                      <g class:list={['line', l.cls, { est: l.est }]} style={l.cls.startsWith('cnu') ? `--c:url(#nug${ci})` : undefined}>
                        <path d={l.d} />
                        {l.dots.map((d) => <circle cx={d.cx} cy={d.cy} r="3.2" />)}
                      </g>
                    ))}
                  </g>
                </g>
                <text class="axis" x={(L + R) / 2} y={B + 36}>bits per second</text>
              </svg>
            </div>
          ))}
        </div>
        <ul class="key" role="list">
          {key.map((l) => (
            <li class:list={[l.cls, { est: l.est }]}><i />{l.name}</li>
          ))}
        </ul>
      </figure>

      {videos.map((v) => (
        <figure class="card wide" data-scene="reveal">
          <figcaption><b>{v.title}</b><span>{v.sub}</span></figcaption>
          {v.stats && (
            <ul class="stats" role="list">
              {v.stats.map((x) => <li><b>{x.big}</b><small>{x.small}</small></li>)}
            </ul>
          )}
          <div class:list={['cmp', { 'has-m': v.mobile }]} style={`max-width:${v.maxw}`}>
            <video poster={v.poster} width={v.w} height={v.h} autoplay muted loop playsinline preload="auto"
              aria-label={`${v.title}: the original and each codec side by side`}>
              {v.mobile && <source src={v.mobile} type="video/mp4" media="(max-width: 640px)" />}
              <source src={v.src} type="video/mp4" />
            </video>
            <ol class:list={['tiles', { many: v.cols > 3 }]} role="list" style={`--cols:${v.cols};--rows:${v.rows}`}>
              {v.tiles.map((t) => (
                <li class:list={[{ ours: t.ours }]}><b>{t.name}</b> <small>{t.note}</small></li>
              ))}
            </ol>
          </div>
          <p class="note">{v.credit}</p>
        </figure>
      ))}

      <figure class="card wide" data-scene="reveal">
        <figcaption><b>Bits for a good picture</b><span>Bitrate each codec needs to reach VMAF 80 on the 720p clip, and whether an iPhone can do it live</span></figcaption>
        <ul class="need" role="list">
          {need.map((r, i) => (
            <li class:list={[{ ours: r.ours, est: r.est }]} style={`--w:${(r.kbps / needMax) * 100};--i:${i}`}>
              <span class="label"><b>{r.name}</b> <small>{r.note}</small></span>
              <span class="track"><span class="fill" /></span>
              <span class="value"><b>{r.kbps.toLocaleString('en-US')}</b> <small>kbit/s</small></span>
              <span class="rt">{r.rt}</span>
            </li>
          ))}
        </ul>
        <p class="note">On iPhone Air, Apple’s hardware HEVC matches real-time AV1 software at a fraction of the power, so it carries nu-media’s base layer. The Neural Engine has to beat it by 40% to meet our target.</p>
      </figure>

      <figure class="card wide" data-scene="reveal">
        <figcaption><b>Runs on every iPhone with iOS 26</b><span>Neural Engine cores, A13 Bionic to A20 Pro</span></figcaption>
        <ul class="chips" role="list">
          {chips.map((c, i) => (
            <li class:list={[{ ours: c.ours }]} style={`--h:${c.cores / 32};--i:${i}`}>
              <span class="col"><span class="bar" /></span>
              <b>{c.name}</b>
              <small>{c.cores === 32 ? '2 × 16' : c.cores}</small>
            </li>
          ))}
        </ul>
        <p class="note">Tuned for A20 Pro’s dual 16-core Neural Engine: highest resolution and frame rate. Earlier chips run the same format, with less enhancement. Also on Apple silicon iPad and Mac.</p>
      </figure>
    </div>

    <p class="footnote">
      Photo sizes for one full-screen iPhone 18 Pro image (2622 × 1206). JPEG and HEIC are typical ImageIO results;
      nu-media photo figures are design targets. Live Photo sizes are at the same screen size: the HEIC + HEVC pair is a
      typical estimate for 3 s of motion with sound, and the nu-media Live Photo is a design target. Video is measured with VMAF (4K model for 4K) on 6-second clips:
      H.264 and HEVC encoded by the hardware encoder of an iPhone Air (iOS 26.6.1) at live-call settings; AV1 with
      SVT-AV1 at real-time settings on an Apple M1 Pro, because iPhone has no AV1 encoder; nu-media as its half-size base
      layer without the Neural Engine. The nu-media target (40% fewer bits than hardware HEVC), AV2 (about 30% fewer than
      AV1, per AOMedia) and DCVC-RT (from its authors’ published gain over H.266; real time only on an NVIDIA A100) are
      scaled from the measured curves, not measured. Neural Engine core counts from Apple.
      <a href="/khensu/codec/results-reel.json">720p results</a> · <a href="/khensu/codec/results-aurora.json">4K results</a>.
    </p>
  </div>
</section>

<style>
  .charts {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 2.5rem;
  }
  @media (min-width: 960px) {
    .charts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card {
    margin: 0;
    padding: 1.6rem;
    display: grid;
    align-content: start;
    gap: 1.1rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
  }
  .card.wide {
    grid-column: 1 / -1;
  }
  .saves { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0; }
