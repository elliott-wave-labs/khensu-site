---
// Side view at the camera end, to scale from the CAD model (khensu-specs/hardware/shell/out/summary.json):
// the iPhone alone, then with the Wrap, whose outer face finishes level with the lens tops.
// SVG units are millimetres; z is height above the front glass. The shell drops on with --e from the
// reveal scene in scripts/scenes.ts.
const DEPTH = 8.75; // phone body
const PLATEAU = 3.0; // camera plateau above the back
const LENS = 4.2; // lens rings above the back
const WRAP = 4.2; // Wrap and Fill thickness
const TOP = DEPTH + LENS;
const LEN = 92; // length of phone shown, from the top edge
const y = (z: number) => 17 - z;
const lenses = [
  [7.1, 22.3],
  [15.9, 31.1],
  [24.7, 39.9],
];
const views = [
  { id: 'alone', title: 'iPhone 18 Pro', note: `${TOP.toFixed(2)} mm at the camera`, shell: false },
  { id: 'with-shell', title: 'With the khensu Wrap', note: `${TOP.toFixed(2)} mm. +0 mm at the thickest point`, shell: true },
];
---

<section class="section side" data-scene="reveal" aria-labelledby="side-title">
  <div class="wrap">
    <p class="eyebrow">Side view</p>
    <h2 id="side-title" class="big">No thicker than your iPhone. <em>The camera already set the line.</em></h2>
    <p class="lede">
      Your iPhone is already as thick as its camera. The Wrap and Fill finish exactly level with the lenses and never
      go past them, so the back turns flat and the phone is no thicker at its thickest point than before. The bump
      goes away; nothing is added on top.
    </p>

    <div class="views">
      {views.map((v) => (
        <figure class:list={['view', v.id]}>
          <svg viewBox={`-2 0 ${LEN + 30} 19`} role="img" aria-label={`${v.title}, side view: ${v.note}`}>
            <line class="guide" x1="-2" x2={LEN + 6} y1={y(TOP)} y2={y(TOP)} />
            <rect class="body" x="0" y={y(DEPTH)} width={LEN + 4} height={DEPTH} rx="2.2" />
            <rect class="glass" x="0.6" y={y(0.5)} width={LEN + 4} height="0.5" rx="0.25" />
            <rect class="plateau" x="3.5" y={y(DEPTH + PLATEAU)} width="40" height={PLATEAU + 0.4} rx="1.4" />
            {lenses.map(([a, b]) => (
              <rect class="lens" x={a} y={y(TOP)} width={b - a} height={LENS - PLATEAU + 0.3} rx="0.7" />
            ))}
            {v.shell && (
              <g class="shell">
                <path
                  d={`M 0.4 ${y(DEPTH)} L 0.4 ${y(TOP) + 1.6} Q 0.4 ${y(TOP)} 2 ${y(TOP)} L ${LEN + 4} ${y(TOP)} L ${LEN + 4} ${y(DEPTH)} Z`}
                />
              </g>
            )}
            <g class="dim">
              <line x1={LEN + 10} x2={LEN + 10} y1={y(0)} y2={y(TOP)} />
              <line x1={LEN + 8.5} x2={LEN + 11.5} y1={y(0)} y2={y(0)} />
              <line x1={LEN + 8.5} x2={LEN + 11.5} y1={y(TOP)} y2={y(TOP)} />
              <text x={LEN + 13} y={y(TOP / 2) + 0.7}>{TOP.toFixed(2)} mm</text>
            </g>
          </svg>
          <figcaption><span>{v.title}</span>{v.note}</figcaption>
        </figure>
      ))}
    </div>

    <dl class="stats">
      <div><dt>+0 mm</dt><dd>Wrap and Fill: level with the lens tops, a flat back with only the lenses showing</dd></div>
      <div><dt>+1 mm</dt><dd>Card: sits on MagSafe below the camera, 1 mm past the lens tops</dd></div>
      <div><dt>+3 mm</dt><dd>Wrap XL: past the lenses on purpose, for twice the battery (13 Wh)</dd></div>
    </dl>
    <p class="footnote">
      To scale, from the CAD model on placeholder iPhone 18 Pro geometry until Apple’s accessory drawings are available.
      Thickest point means the phone at its camera lenses. iPhone is a trademark of Apple Inc.
    </p>
  </div>
</section>

<style>
  .side {
    --e: 1;
  }
  .views {
    display: grid;
    gap: 2.5rem;
    margin-top: 3rem;
  }
  .view {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .body {
    fill: #2b2c31;
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 0.15;
  }
  .glass {
    fill: rgba(255, 255, 255, 0.12);
  }
  .plateau {
    fill: #34363c;
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 0.12;
  }
  .lens {
    fill: #16171a;
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 0.18;
  }
  .guide {
    stroke: var(--accent);
    stroke-width: 0.12;
    stroke-dasharray: 0.8 0.6;
    opacity: 0.8;
  }
  .shell {
    translate: 0 calc((1 - var(--e)) * -9px);
    opacity: clamp(0, calc(var(--e) * 1.5), 1);
  }
  .shell path {
    fill: color-mix(in srgb, var(--accent) 22%, #1b1c20);
    fill-opacity: 0.88;
    stroke: var(--accent);
    stroke-width: 0.18;
  }
  .dim line {
    stroke: var(--text-dim);
    stroke-width: 0.12;
  }
  .dim text {
    fill: var(--text);
    font-size: 1.9px;
    font-family: var(--mono, ui-monospace, monospace);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  figcaption span {
    color: var(--text);
  }
  .stats {
    display: grid;
    gap: 1.5rem 2.5rem;
    margin: 3rem 0 0;
  }
  @media (min-width: 760px) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .stats dt {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .stats dd {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .footnote {
    margin-top: 2rem;
  }
</style>
