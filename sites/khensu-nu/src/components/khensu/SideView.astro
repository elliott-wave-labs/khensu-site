---
// Side view at the camera end, rendered live with three.js from the CAD dimensions
// (khensu-specs/hardware/shell/shell.py, iPhone 18 Pro placeholder geometry): the iPhone alone, then with the
// shell, whose outer face finishes level with the lens tops. Units are millimetres; z is height above the front
// glass. The shell's lower edge starts where the phone's back edge ends and rounds over on top, so the two read
// as one shape. It drops on with --e from the reveal scene in scripts/scenes.ts.
const TOP = 8.75 + 4.2;
const views = [
  { id: 'alone', title: 'iPhone 18 Pro', note: `${TOP.toFixed(2)} mm at the camera` },
  { id: 'with-shell', title: 'With the khensu shell', note: `${TOP.toFixed(2)} mm. +0 mm at the thickest point` },
];
---

<section class="section side" data-scene="reveal" aria-labelledby="side-title">
  <div class="wrap">
    <p class="eyebrow">Side view</p>
    <h2 id="side-title" class="big">No thicker than your iPhone. <em>The camera already set the line.</em></h2>
    <p class="lede">
      Your iPhone is already as thick as its camera. The khensu shell finishes exactly level with the lenses and never
      goes past them, so the back turns flat and the phone is no thicker at its thickest point than before. The bump
      goes away; nothing is added on top.
    </p>
    <p class="lede">
      Each shell is CNC-machined from titanium for a precise fit, following the iPhone 18 Pro’s own edge curve, so
      the shell picks up where the phone’s edge leaves off. No step, no lip, one seamless shape.
    </p>

    <div class="views">
      {views.map((v) => (
        <figure class="view">
          <div class="render" data-side={v.id} role="img" aria-label={`${v.title}, side view: ${v.note}`}>
            <canvas></canvas>
            <span class="dim" aria-hidden="true">{TOP.toFixed(2)} mm</span>
          </div>
          <figcaption><span>{v.title}</span>{v.note}</figcaption>
        </figure>
      ))}
    </div>

    <dl class="stats">
      <div><dt>+0 mm</dt><dd>at the iPhone’s thickest point. A flat back, with only the lenses showing.</dd></div>
    </dl>
    <p class="footnote">
      Rendered to scale from the CAD model on placeholder iPhone 18 Pro geometry until Apple’s accessory drawings are
      available. Thickest point means the phone at its camera lenses. iPhone is a trademark of Apple Inc.
    </p>
  </div>
</section>

<script>
  import {
    ACESFilmicToneMapping,
    BufferGeometry,
    CircleGeometry,
    Color,
    CylinderGeometry,
    DirectionalLight,
    Float32BufferAttribute,
    Group,
    Line,
    LineDashedMaterial,
    Mesh,
    MeshPhysicalMaterial,
    PerspectiveCamera,
    PMREMGenerator,
    Scene,
    SRGBColorSpace,
    Vector3,
    WebGLRenderer,
  } from 'three';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  // iPhone 18 Pro placeholder geometry from shell.py, in mm. Plan x is across the phone, y along it (camera end +y).
  const W = 71.9;
  const H = 150;
  const R = 10;
  const DEPTH = 8.75;
  const PLATEAU = 3.0;
  const LENS = 4.2;
  const TOP = DEPTH + LENS;
  const INSET = 0.4; // the shell never overhangs the phone's outline
  const BUMP = { x0: 3.5, y0: 3.5, w: 64.9, h: 40, r: 8 };
  const SENSORS: [number, number, number][] = [
    // x, y from the plateau's top-left corner, ring radius
    [11.2, 11.2, 7.6],
    [11.2, 28.8, 7.6],
    [26.4, 20.0, 7.6],
  ];
  const SMALL: [number, number, number][] = [
    [54.5, 12.0, 2.8],
    [54.5, 28.0, 3.6],
  ];

  // A point on a rounded rectangle's outline at parameter t (0..1), so rings at different insets line up.
  function outline(w: number, h: number, r: number, t: number): [number, number] {
    const sx = w - 2 * r;
    const sy = h - 2 * r;
    const arc = (Math.PI / 2) * r;
    const per = 2 * sx + 2 * sy + 4 * arc;
    let d = t * per;
    const seg = (len: number) => {
      if (d <= len) return true;
      d -= len;
      return false;
    };
    const hw = w / 2;
    const hh = h / 2;
    if (seg(sx)) return [-sx / 2 + d, -hh];
    if (seg(arc)) return corner(sx / 2, -sy / 2, -Math.PI / 2 + d / r);
    if (seg(sy)) return [hw, -sy / 2 + d];
    if (seg(arc)) return corner(sx / 2, sy / 2, d / r);
    if (seg(sx)) return [sx / 2 - d, hh];
    if (seg(arc)) return corner(-sx / 2, sy / 2, Math.PI / 2 + d / r);
    if (seg(sy)) return [-hw, sy / 2 - d];
    return corner(-sx / 2, -sy / 2, Math.PI + Math.min(d, arc) / r);
    function corner(cx: number, cy: number, a: number): [number, number] {
      return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
    }
  }

  // A slab whose edge follows a profile of (inset, z) pairs from bottom to top, capped flat at both ends.
  function slab(w: number, h: number, r: number, profile: [number, number][], n = 240) {
    const pos: number[] = [];
    const idx: number[] = [];
    for (const [o, z] of profile) {
      for (let i = 0; i < n; i++) {
        const [x, y] = outline(w - 2 * o, h - 2 * o, Math.max(0.01, r - o), i / n);
        pos.push(x, y, z);
      }
    }
    for (let k = 0; k < profile.length - 1; k++) {
      for (let i = 0; i < n; i++) {
        const a = k * n + i;
        const b = k * n + ((i + 1) % n);
        const c = a + n;
        const d = b + n;
        idx.push(a, b, d, a, d, c);
      }
    }
    const cap = (k: number, up: boolean) => {
      const z = profile[k][1];
      const centre = pos.length / 3;
      pos.push(0, 0, z);
      for (let i = 0; i < n; i++) {
        const a = k * n + i;
        const b = k * n + ((i + 1) % n);
        if (up) idx.push(centre, a, b);
        else idx.push(centre, b, a);
      }
    };
    cap(0, false);
    cap(profile.length - 1, true);
    const g = new BufferGeometry();
    g.setAttribute('position', new Float32BufferAttribute(pos, 3));
    g.setIndex(idx);
    g.computeVertexNormals();
    return g;
  }

  // Quarter-circle edge between (inset r at z0) and (inset 0 at z0 ± r).
  function round(r: number, z0: number, dir: 1 | -1, steps = 10): [number, number][] {
    const out: [number, number][] = [];
    for (let i = 0; i <= steps; i++) {
      const a = (i / steps) * (Math.PI / 2);
      out.push([r * (1 - Math.sin(a)), z0 + dir * r * (1 - Math.cos(a))]);
    }
    return out;
  }

  const plateauCentre = new Vector3(-W / 2 + BUMP.x0 + BUMP.w / 2, H / 2 - BUMP.y0 - BUMP.h / 2, 0);
  const sensorAt = (x: number, y: number) => new Vector3(-W / 2 + BUMP.x0 + x, H / 2 - BUMP.y0 - y, 0);

  function build(withShell: boolean) {
    const group = new Group();
    const phoneMat = new MeshPhysicalMaterial({ color: new Color('#5c1c27'), metalness: 0.75, roughness: 0.32, clearcoat: 0.3 });
    const shellMat = new MeshPhysicalMaterial({ color: new Color('#521823'), metalness: 0.35, roughness: 0.58 });
    const ringMat = new MeshPhysicalMaterial({ color: new Color('#3a2a2e'), metalness: 1, roughness: 0.22 });
    const glassMat = new MeshPhysicalMaterial({ color: new Color('#050608'), metalness: 0.2, roughness: 0.05, clearcoat: 1 });
    const frontMat = new MeshPhysicalMaterial({ color: new Color('#08090b'), metalness: 0.1, roughness: 0.08, clearcoat: 1 });

    // Phone: rounded front edge, a slight round on the back edge that ends exactly at the shell's inset.
    const phone = slab(W, H, R, [...round(1.6, 1.6, -1).reverse().map(([o, z]) => [o, z] as [number, number]), ...round(INSET, DEPTH - INSET, 1)]);
    group.add(new Mesh(phone, phoneMat));
    const glass = slab(W - 1.2, H - 1.2, R - 0.6, [[0, -0.05], [0, 0.3]]);
    group.add(new Mesh(glass, frontMat));

    const plateau = slab(BUMP.w, BUMP.h, BUMP.r, [[0, 0], ...round(0.8, PLATEAU - 0.8, 1)]);
    const pm = new Mesh(plateau, phoneMat);
    pm.position.set(plateauCentre.x, plateauCentre.y, DEPTH);
    group.add(pm);

    for (const [x, y, r] of SENSORS) {
      const p = sensorAt(x, y);
      const ring = new Mesh(new CylinderGeometry(r, r, LENS - PLATEAU, 64), ringMat);
      ring.rotation.x = Math.PI / 2;
      ring.position.set(p.x, p.y, DEPTH + PLATEAU + (LENS - PLATEAU) / 2);
      group.add(ring);
      const lens = new Mesh(new CircleGeometry(r * 0.72, 64), glassMat);
      lens.position.set(p.x, p.y, TOP + 0.02);
      group.add(lens);
    }
    for (const [x, y, r] of SMALL) {
      const p = sensorAt(x, y);
      const dot = new Mesh(new CircleGeometry(r, 48), glassMat);
      dot.position.set(p.x, p.y, DEPTH + PLATEAU + 0.02);
      group.add(dot);
    }

    let shell: Group | null = null;
    if (withShell) {
      shell = new Group();
      const t = TOP - DEPTH;
      const body = slab(W - 2 * INSET, H - 2 * INSET, R - INSET, [[0, 0], ...round(2.2, t - 2.2, 1)]);
      shell.add(new Mesh(body, shellMat));
      // The lens rings and glass show through the camera plate, flush with its face.
      for (const [x, y, r] of SENSORS) {
        const p = sensorAt(x, y);
        const ring = new Mesh(new CircleGeometry(r, 64), ringMat);
        ring.position.set(p.x, p.y, t + 0.01);
        shell.add(ring);
        const lens = new Mesh(new CircleGeometry(r * 0.72, 64), glassMat);
        lens.position.set(p.x, p.y, t + 0.02);
        shell.add(lens);
      }
      for (const [x, y, r] of SMALL) {
        const p = sensorAt(x, y);
        const dot = new Mesh(new CircleGeometry(r, 48), glassMat);
        dot.position.set(p.x, p.y, t + 0.02);
        shell.add(dot);
      }
      shell.position.z = DEPTH;
      group.add(shell);
    }

    // The line both views share: the top of the lenses.
    const guide = new BufferGeometry().setFromPoints([new Vector3(W / 2 + 0.5, -H / 2 - 30, TOP), new Vector3(W / 2 + 0.5, H / 2 + 12, TOP)]);
    const line = new Line(guide, new LineDashedMaterial({ color: 0x18e0c8, dashSize: 2, gapSize: 1.4, transparent: true, opacity: 0.85 }));
    line.computeLineDistances();
    group.add(line);
    return { group, shell };
  }

  function mount(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const section = root.closest<HTMLElement>('.side')!;
    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'low-power' });
    } catch {
      return;
    }
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = SRGBColorSpace;
    renderer.toneMapping = ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;

    const scene = new Scene();
    const pmrem = new PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    const key = new DirectionalLight(0xffffff, 1.4);
    key.position.set(120, 40, 160);
    scene.add(key);

    const { group, shell } = build(root.dataset.side === 'with-shell');
    scene.add(group);

    // Looking at the long edge from slightly above, so the flat top and the lenses both read.
    const camera = new PerspectiveCamera(9, 1, 10, 4000);
    camera.up.set(0, 0, 1);
    const target = new Vector3(0, 18, 6.5);
    camera.position.set(560, 18 + 60, 120);
    camera.lookAt(target);

    let visible = false;
    let last = -1;
    const draw = () => {
      const e = Number(section.style.getPropertyValue('--e') || 1);
      if (shell) shell.position.z = DEPTH + (1 - e) * 9;
      renderer.render(scene, camera);
      last = e;
    };
    const resize = () => {
      const w = root.clientWidth;
      const h = root.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      draw();
    };
    const loop = () => {
      if (!visible) return;
      const e = Number(section.style.getPropertyValue('--e') || 1);
      if (e !== last) draw();
      requestAnimationFrame(loop);
    };
    new ResizeObserver(resize).observe(root);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) requestAnimationFrame(loop);
    }).observe(root);
    resize();
  }

  document.querySelectorAll<HTMLElement>('.side .render').forEach(mount);
</script>

<style>
  .side {
    --e: 1;
  }
  .views {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }
  .view {
    margin: 0;
  }
  .render {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 5;
    border-radius: 22px;
    overflow: hidden;
    background: radial-gradient(ellipse 70% 90% at 50% 60%, rgba(255, 255, 255, 0.06), transparent 70%);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dim {
    position: absolute;
    right: 1.2rem;
    top: 1rem;
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 0.78rem;
    color: var(--accent);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  figcaption span {
    color: var(--text);
  }
  .stats {
    display: grid;
    gap: 1.5rem 2.5rem;
    margin: 3rem 0 0;
  }
  .stats dt {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .stats dd {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .footnote {
    margin-top: 2rem;
  }
</style>
