---
// Side view at the long edge, path-traced from the CAD (khensu-specs/hardware/sunu/render_layers.py, iPhone 18 Pro
// placeholder geometry): the iPhone alone, then with the shell, whose outer face finishes level with the lens tops.
// The camera is orthographic, so dropping the shell layer by a fixed amount is a true vertical move in millimetres.
// It drops on with --e from the reveal scene in scripts/scenes.ts.
import side from '../../../public/khensu/shell/side.json';

const [W, H] = side.res;
const TOP = side.top_mm.toFixed(2);
const drop = ((9 * side.px_per_mm_z) / H) * 100;
const views = [
  { id: 'alone', title: 'iPhone 18 Pro', note: `${TOP} mm at the camera` },
  { id: 'with-shell', title: 'With suñůlink', note: `${TOP} mm. +0 mm at the thickest point` },
];
---

<section class="section side" data-scene="reveal" aria-labelledby="side-title" style={`--drop:${drop.toFixed(2)}%`}>
  <div class="wrap">
    <p class="eyebrow">Side view</p>
    <h2 id="side-title" class="big">No thicker than your iPhone. <em>The camera already set the line.</em></h2>
    <p class="lede">
      Your iPhone is already as thick as its camera. suñůlink finishes exactly level with the lenses and never
      goes past them, so the back turns flat and the phone is no thicker at its thickest point than before. The bump
      goes away; nothing is added on top.
    </p>
    <p class="lede">
      Each suñůlink is CNC-machined from titanium for a precise fit, following the iPhone 18 Pro’s own edge curve, so
      suñůlink picks up where the phone’s edge leaves off. No step, no lip, one seamless shape.
    </p>

    <div class="views">
      {views.map((v) => (
        <figure class="view">
          <div class="render" role="img" aria-label={`${v.title}, side view: ${v.note}`} style={`aspect-ratio:${W}/${H}`}>
            <img src="/khensu/shell/side_phone_burgundy.png" alt="" width={W} height={H} loading="lazy" decoding="async" />
            {v.id === 'with-shell' && (
              <>
                <img class="shell" src="/khensu/shell/side_shell_burgundy.png" alt="" width={W} height={H} loading="lazy" decoding="async" />
                <img class="lenses" src="/khensu/shell/side_camera.png" alt="" width={W} height={H} loading="lazy" decoding="async" />
              </>
            )}
            <span class="dim" aria-hidden="true">{TOP} mm</span>
          </div>
          <figcaption><span>{v.title}</span>{v.note}</figcaption>
        </figure>
      ))}
    </div>

    <dl class="stats">
      <div><dt>+0 mm</dt><dd>at the iPhone’s thickest point. A flat back, with only the lenses showing.</dd></div>
    </dl>
    <p class="footnote">
      Path-traced to scale from the CAD model on placeholder iPhone 18 Pro geometry until Apple’s accessory drawings
      are available. Thickest point means the phone at its camera lenses. iPhone is a trademark of Apple Inc.
    </p>
  </div>
</section>

<style>
  .side {
    --e: 1;
  }
  .views {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }
  .view {
    margin: 0;
  }
  .render {
    position: relative;
    width: 100%;
    border-radius: 22px;
    overflow: hidden;
    background: radial-gradient(ellipse 70% 90% at 50% 60%, rgba(255, 255, 255, 0.06), transparent 70%);
  }
  .render img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .shell {
    translate: 0 calc((var(--e) - 1) * var(--drop));
    opacity: clamp(0, calc(var(--e) * 3), 1);
  }
  /* The lenses show through the shell's openings only once it's seated. */
  .lenses {
    opacity: clamp(0, calc(var(--e) * 40 - 39), 1);
  }
  .dim {
    position: absolute;
    right: 1.2rem;
    top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  figcaption span {
    color: var(--text);
  }
  .stats {
    display: grid;
    gap: 1.5rem 2.5rem;
    margin: 3rem 0 0;
  }
  .stats dt {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .stats dd {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .footnote {
    margin-top: 2rem;
  }
</style>
