---
// Paired stills. The left frame is the picture arriving. The right frame is what plays.
// A clear picture is the same on both sides. A flagged picture stays sharp on the left and is blurred on the right.
// The pictures are flat colour. Nothing here is a person.
const beats = [
  { scene: 'day', name: 'plays', flag: false },
  { scene: 'dusk', name: 'plays', flag: false },
  { scene: 'mark', name: 'nudity. blurred before you see it.', flag: true },
  { scene: 'night', name: 'plays', flag: false },
  { scene: 'bars', name: 'gore and violence. blurred before you see it.', flag: true },
];
---

<figure class="pass">
  <div class="lane">
    <div class="stage">
      <p class="eyebrow">the frame</p>
      <div class="window" aria-hidden="true">
        {beats.map((b) => <div class:list={['beat', b.scene]} />)}
      </div>
    </div>

    <div class="stage mid">
      <p class="eyebrow">the violet flame</p>
      <p class="where">on this device</p>
    </div>

    <div class="stage">
      <p class="eyebrow">what you see</p>
      <div class="window" aria-hidden="true">
        {beats.map((b) => <div class:list={['beat', b.scene, { covered: b.flag }]} />)}
      </div>
      <p class="chips" aria-hidden="true">
        {beats.map((b) => <span class:list={['chip', { flag: b.flag }]}>{b.name}</span>)}
      </p>
    </div>
  </div>
  <figcaption>
    Each frame of a live stream goes through the violet flame on this device, Apple’s Sensitive Content Analysis, before it is shown.
    A clear frame plays, the same picture you would have seen. A frame that may contain nudity, or gore and violence, is blurred on the way out.
    Gore and violence detection is on iOS 27, iPadOS 27 and macOS 27.
  </figcaption>
</figure>

<style>
  .pass {
    margin: clamp(1.8rem, 4vw, 3rem) 0 0;
  }
  .lane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(0.8rem, 2vw, 1.6rem);
    align-items: center;
    padding: clamp(1rem, 2vw, 1.4rem);
    border-radius: 28px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }
  .stage {
    min-width: 0;
  }
  .eyebrow {
    margin: 0 0 0.55rem;
  }
  .window {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #0b0b0d;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .beat {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: show 12s linear infinite;
  }
  .window .beat:nth-child(1),
  .chip:nth-child(1) { animation-delay: 0s; }
  .window .beat:nth-child(2),
  .chip:nth-child(2) { animation-delay: -9.6s; }
  .window .beat:nth-child(3),
  .chip:nth-child(3) { animation-delay: -7.2s; }
  .window .beat:nth-child(4),
  .chip:nth-child(4) { animation-delay: -4.8s; }
  .window .beat:nth-child(5),
  .chip:nth-child(5) { animation-delay: -2.4s; }
  .day {
    background:
      radial-gradient(circle at 78% 28%, #ffe56a 0 9%, transparent 9.2%),
      linear-gradient(#2f7dff 0 58%, #1ea35a 58% 100%);
  }
  .dusk {
    background:
      linear-gradient(#ffd7a8 0 8%, transparent 8%) 18% 62% / 22% 38% no-repeat,
      linear-gradient(#c9b6ff 0 8%, transparent 8%) 62% 70% / 14% 30% no-repeat,
      linear-gradient(#6a4adf 0 62%, #243044 62% 100%);
  }
  .night {
    background:
      radial-gradient(circle at 22% 30%, #fff 0 1.1%, transparent 1.3%),
      radial-gradient(circle at 70% 22%, #fff 0 0.8%, transparent 1%),
      radial-gradient(circle at 48% 40%, #fff 0 0.7%, transparent 0.9%),
      linear-gradient(#071426 0 70%, #102033 70% 100%);
  }
  .mark {
    background:
      linear-gradient(#fff 0 0) 50% 46% / 28% 62% no-repeat,
      linear-gradient(#ff4d8d 0 0) 50% 28% / 22% 16% no-repeat,
      linear-gradient(#1a1020 0 0);
  }
  .bars {
    background:
      linear-gradient(#e10600 0 0) 0 0 / 18% 100% no-repeat,
      linear-gradient(#e10600 0 0) 41% 0 / 18% 100% no-repeat,
      linear-gradient(#e10600 0 0) 82% 0 / 18% 100% no-repeat,
      #1a120c;
  }
  .covered {
    filter: blur(28px) brightness(0.72);
    transform: scale(1.35);
  }
  .mid {
    text-align: center;
    padding: 0.9rem 1rem;
    border-radius: 22px;
    background: rgba(16, 16, 20, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    animation: gate 12s linear infinite;
  }
  .mid .eyebrow {
    margin: 0;
    max-width: 12rem;
  }
  .where {
    margin: 0.35rem 0 0;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .chips {
    position: relative;
    height: 2.6rem;
    margin-top: 0.55rem;
  }
  .chip {
    position: absolute;
    inset: 0;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.3;
    opacity: 0;
    animation: show 12s linear infinite;
  }
  .chip.flag {
    color: #fff;
  }
  figcaption {
    margin: 0.85rem 0 0;
    max-width: 68ch;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  @keyframes show {
    0%, 19.9% { opacity: 1; }
    20%, 100% { opacity: 0; }
  }
  @keyframes gate {
    0%, 39.9% { border-color: rgba(255, 255, 255, 0.16); }
    40%, 59.9% { border-color: rgba(139, 92, 255, 0.95); }
    60%, 79.9% { border-color: rgba(255, 255, 255, 0.16); }
    80%, 100% { border-color: rgba(139, 92, 255, 0.95); }
  }
  @media (max-width: 800px) {
    .lane {
      grid-template-columns: 1fr;
    }
    .mid .eyebrow {
      max-width: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .beat,
    .chip,
    .mid {
      animation: none;
    }
    .beat,
    .chip {
      opacity: 0;
    }
    .window .beat:nth-child(3),
    .chip:nth-child(3) {
      opacity: 1;
    }
    .mid {
      border-color: rgba(139, 92, 255, 0.95);
    }
  }
</style>
