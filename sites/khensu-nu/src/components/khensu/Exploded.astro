---
// The khensu shell comes apart and back together as the page scrolls past.
// Each layer is a render from the CAD model (khensu-specs/hardware/shell/render_layers.py), drawn
// from one fixed camera, so stacking the images reproduces the assembly and a vertical offset
// explodes it. --e (0 assembled, 1 exploded) comes from scripts/scenes.ts.
const layers = [
  { file: 'phone', label: 'Your iPhone', short: 'iPhone' },
  { file: 'suction_film', label: 'Micro-suction film', short: 'Suction film' },
  { file: 'base', label: 'Base plate', short: 'Base' },
  { file: 'magnet_ring', label: 'MagSafe-compatible magnets', short: 'Magnets' },
  { file: 'pcb', label: 'Node computer and network guard', short: 'Node board' },
  { file: 'battery', label: 'Its own cells', short: 'Cells' },
  { file: 'window_inserts', label: 'Antenna band in the edge', short: 'Antenna band' },
  { file: 'housing', label: 'Titanium battleproof shell', short: 'Battleproof shell' },
];
---

<section class="explode" data-scene="explode" aria-labelledby="shell-title">
  <div class="sticky">
    <div class="wrap scene-grid">
      <div class="copy">
        <p class="eyebrow">khensu shell</p>
        <h2 id="shell-title">Your phone becomes <em>part of the network.</em></h2>
        <p class="lede">
          A titanium battleproof shell for iPhone 18 Pro, finished to match your iPhone, that turns the phone into a node. It carries traffic for the people around
          you, keeps your messages flowing when Apple’s push service can’t be trusted, and earns while it works.
        </p>
        <dl class="facts">
          <div><dt>Flat</dt><dd>one flat back, no camera bump, only the lenses showing</dd></div>
          <div><dt>13 Wh</dt><dd>in the XL, about 11 hours as a node on its own</dd></div>
          <div><dt>USB-C</dt><dd>charges the shell and passes power to your iPhone</dd></div>
        </dl>
      </div>
      <div class="stage" role="img" aria-label="Exploded view of the khensu shell for iPhone 18 Pro: titanium battleproof shell, antenna band, cells, node board, magnets, base plate and suction film above an iPhone.">
        <img class="shadow" src="/khensu/shell/shadow.png" alt="" width="1600" height="1600" loading="lazy" decoding="async" />
        {layers.map((l, i) => (
          <img class="layer" src={`/khensu/shell/${l.file}.png`} alt="" width="1600" height="1600" style={`--i:${i}`} loading="lazy" decoding="async" />
        ))}
        <img class="camera" src="/khensu/shell/camera.png" alt="" width="1600" height="1600" loading="lazy" decoding="async" />
        <ol class="labels" aria-hidden="true">
          {layers.map((l, i) => (
            <li style={`--i:${i}`}><span class="long">{l.label}</span><span class="short">{l.short}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .explode {
    --e: 1;
    position: relative;
    height: 360vh;
  }
  .sticky {
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .scene-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  @media (min-width: 960px) {
    .scene-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 2rem 0 0;
  }
  .facts dt {
    font-size: 1.9rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .facts dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-dim);
    max-width: 16ch;
  }
  .stage {
    container-type: inline-size;
    position: relative;
    width: min(100%, 64vh, 560px);
    aspect-ratio: 1 / 1.45;
    margin-inline: auto;
    translate: -6% 0;
  }
  .stage img {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  .layer {
    translate: 0 calc(var(--e) * var(--i) * -6.2cqw);
    will-change: translate;
  }
  .shadow {
    opacity: calc(1 - var(--e) * 0.5);
  }
  /* The lenses sit in front of the shell's far wall once it's on; hidden as soon as it lifts. */
  .camera {
    opacity: clamp(0, calc(1 - var(--e) * 40), 1);
  }
  .labels {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    left: 84%;
    bottom: 0;
    width: 13rem;
    height: 100%;
    opacity: clamp(0, calc((var(--e) - 0.75) * 4), 1);
  }
  .labels li {
    position: absolute;
    left: 0;
    bottom: calc(63cqw + var(--i) * 6.2cqw);
    font-size: 0.78rem;
    line-height: 1;
    color: var(--text-dim);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .labels li::before {
    content: '';
    width: 2.2rem;
    height: 1px;
    background: var(--line-strong);
  }
  .short {
    display: none;
  }
  @media (max-width: 959px) {
    .explode {
      height: 300vh;
    }
    .copy .lede,
    .facts {
      display: none;
    }
    .stage {
      width: min(70vw, 48vh);
      translate: -14% 0;
    }
    .labels li {
      font-size: 0.7rem;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .labels li::before {
      width: 1rem;
    }
  }
</style>
