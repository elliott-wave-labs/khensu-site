---
/* The relay network as a slowly turning 3D web. Pulses travel along the lines and forward on arrival; on top of them,
   sparks fade in at a node, fade out, and at once fade in at another node far away, like a portal rather than a wire.
   Colours drift through the aurora palette and every node breathes brighter and dimmer on its own rhythm.
   Ported from MOQOM Cloud's IndrasNet, coloured like an aurora: green low, through teal and blue,
   to violet and magenta high, with the bands drifting slowly. Fills its positioned parent behind the content unless
   `contained` is set, in which case it is a square block in the flow. `closeup` puts the camera inside the web,
   with near nodes large and soft and far ones fading into the dark. */
interface Props {
  contained?: boolean;
  closeup?: boolean;
  nodes?: number;
  label?: string;
  class?: string;
}
const { contained = false, closeup = false, nodes = 96, label, class: cls } = Astro.props;
---

<div
  class:list={['net', { contained, closeup }, cls]}
  data-nodes={nodes}
  data-closeup={closeup ? '' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <canvas></canvas>
</div>

<script>
  import {
    AdditiveBlending,
    BufferAttribute,
    BufferGeometry,
    Color,
    Fog,
    Group,
    LineBasicMaterial,
    LineSegments,
    PerspectiveCamera,
    Points,
    Scene,
    ShaderMaterial,
    Vector3,
    WebGLRenderer,
  } from 'three';

  const NEIGHBOURS = 3;
  const SPARKS = 22;
  const PULSES = 36;
  const SPEED = 0.9;

  // Aurora palette, bottom of the curtain to the top.
  const AURORA = ['#22f59a', '#18e0c8', '#3b9dff', '#8b5cff', '#ff4fd8'];

  const POINT_VERT = /* glsl */ `
    attribute float size;
    attribute float glow;
    attribute vec3 col;
    uniform vec2 fog;
    varying float vGlow;
    varying vec3 vCol;
    varying float vFog;
    void main() {
      vGlow = glow;
      vCol = col;
      vec4 mv = modelViewMatrix * vec4(position, 1.0);
      vFog = 1.0 - smoothstep(fog.x, fog.y, -mv.z);
      gl_PointSize = min(size * (1.0 + glow * 1.6) * (300.0 / -mv.z), 90.0);
      gl_Position = projectionMatrix * mv;
    }
  `;
  const POINT_FRAG = /* glsl */ `
    uniform vec3 hot;
    varying float vGlow;
    varying vec3 vCol;
    varying float vFog;
    void main() {
      float d = length(gl_PointCoord - 0.5);
      float core = smoothstep(0.5, 0.0, d);
      float a = pow(core, 2.2);
      gl_FragColor = vec4(mix(vCol, hot, vGlow * 0.55), a * (0.6 + vGlow * 0.4) * vFog);
    }
  `;

  function mount(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NODES = Number(root.dataset.nodes) || 96;
    const closeup = root.dataset.closeup !== undefined;

    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'low-power' });
    } catch {
      root.remove();
      return;
    }
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

    const scene = new Scene();
    const camera = new PerspectiveCamera(closeup ? 70 : 50, 1, 0.1, 100);
    camera.position.set(0, 0, closeup ? 4.5 : 9);
    const fogRange = closeup ? [4, 12] : [40, 60];
    scene.fog = new Fog(0x000000, fogRange[0], fogRange[1] + 4);
    const net = new Group();
    scene.add(net);

    const hot = new Color('#ffffff');
    const palette = AURORA.map((c) => new Color(c));
    const sample = (t: number, out: Color) => {
      const m = ((t % 2) + 2) % 2;
      const x = Math.min(m > 1 ? 2 - m : m, 0.9999) * (palette.length - 1);
      const i = Math.floor(x);
      return out.copy(palette[i]).lerp(palette[i + 1], x - i);
    };

    // Nodes on a Fibonacci shell plus a sparse inner cloud; in close-up, a deep field around the camera.
    const pos: Vector3[] = [];
    const shell = closeup ? 0 : Math.round(NODES * 0.7);
    if (closeup) {
      while (pos.length < NODES) {
        pos.push(new Vector3((Math.random() - 0.5) * 8, (Math.random() - 0.5) * 7, 2.6 - Math.random() * 9));
      }
    }
    for (let i = 0; i < shell; i++) {
      const y = 1 - (i / (shell - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const t = i * Math.PI * (3 - Math.sqrt(5));
      pos.push(new Vector3(Math.cos(t) * r, y, Math.sin(t) * r).multiplyScalar(3.4));
    }
    while (pos.length < NODES) {
      const v = new Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5);
      pos.push(v.normalize().multiplyScalar(0.8 + Math.random() * 1.9));
    }

    // Edges: each node to its nearest neighbours, deduplicated.
    const adj: number[][] = pos.map(() => []);
    const seen = new Set<string>();
    const edges: [number, number][] = [];
    pos.forEach((p, i) => {
      pos
        .map((q, j) => [j, p.distanceToSquared(q)] as const)
        .filter(([j]) => j !== i)
        .sort((a, b) => a[1] - b[1])
        .slice(0, NEIGHBOURS)
        .forEach(([j]) => {
          const key = i < j ? `${i}-${j}` : `${j}-${i}`;
          if (seen.has(key)) return;
          seen.add(key);
          edges.push([i, j]);
          adj[i].push(j);
          adj[j].push(i);
        });
    });

    const lineGeo = new BufferGeometry();
    const linePos = new Float32Array(edges.length * 6);
    edges.forEach(([a, b], k) => {
      pos[a].toArray(linePos, k * 6);
      pos[b].toArray(linePos, k * 6 + 3);
    });
    lineGeo.setAttribute('position', new BufferAttribute(linePos, 3));
    const lineCol = new Float32Array(edges.length * 6);
    lineGeo.setAttribute('color', new BufferAttribute(lineCol, 3));
    net.add(
      new LineSegments(
        lineGeo,
        new LineBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.55, blending: AdditiveBlending, depthWrite: false }),
      ),
    );

    const pointMaterial = () =>
      new ShaderMaterial({
        uniforms: { hot: { value: hot }, fog: { value: fogRange } },
        vertexShader: POINT_VERT,
        fragmentShader: POINT_FRAG,
        transparent: true,
        depthWrite: false,
        blending: AdditiveBlending,
      });

    const nodeGeo = new BufferGeometry();
    const nodePos = new Float32Array(NODES * 3);
    pos.forEach((p, i) => p.toArray(nodePos, i * 3));
    const nodeSize = new Float32Array(NODES).map(() => (closeup ? 0.14 : 0.22) + Math.random() * 0.16);
    const nodeGlow = new Float32Array(NODES);
    nodeGeo.setAttribute('position', new BufferAttribute(nodePos, 3));
    nodeGeo.setAttribute('size', new BufferAttribute(nodeSize, 1));
    nodeGeo.setAttribute('glow', new BufferAttribute(nodeGlow, 1));
    const nodeCol = new Float32Array(NODES * 3);
    nodeGeo.setAttribute('col', new BufferAttribute(nodeCol, 3));
    net.add(new Points(nodeGeo, pointMaterial()));

    // Each spark lives at one node for `dur` seconds, fading in and out, then reappears at once somewhere else.
    type Spark = { node: number; t: number; dur: number };
    const spark = (t = 0): Spark => ({ node: (Math.random() * NODES) | 0, t, dur: 1.4 + Math.random() * 1.6 });
    const sparks: Spark[] = Array.from({ length: SPARKS }, () => spark(Math.random()));
    const sparkGeo = new BufferGeometry();
    const sparkPos = new Float32Array(SPARKS * 3);
    const sparkSize = new Float32Array(SPARKS);
    const sparkGlow = new Float32Array(SPARKS);
    sparkGeo.setAttribute('position', new BufferAttribute(sparkPos, 3));
    sparkGeo.setAttribute('size', new BufferAttribute(sparkSize, 1));
    sparkGeo.setAttribute('glow', new BufferAttribute(sparkGlow, 1));
    const sparkCol = new Float32Array(SPARKS * 3);
    sparkGeo.setAttribute('col', new BufferAttribute(sparkCol, 3));
    net.add(new Points(sparkGeo, pointMaterial()));

    type Pulse = { from: number; to: number; t: number; live: boolean };
    const pulses: Pulse[] = Array.from({ length: PULSES }, () => ({ from: 0, to: 0, t: 0, live: false }));
    const pulseGeo = new BufferGeometry();
    const pulsePos = new Float32Array(PULSES * 3);
    const pulseSize = new Float32Array(PULSES);
    const pulseGlow = new Float32Array(PULSES).fill(0.6);
    pulseGeo.setAttribute('position', new BufferAttribute(pulsePos, 3));
    pulseGeo.setAttribute('size', new BufferAttribute(pulseSize, 1));
    pulseGeo.setAttribute('glow', new BufferAttribute(pulseGlow, 1));
    const pulseCol = new Float32Array(PULSES * 3);
    pulseGeo.setAttribute('col', new BufferAttribute(pulseCol, 3));
    net.add(new Points(pulseGeo, pointMaterial()));

    // Height up the curtain, with slow waves running sideways through the bands.
    const c = new Color();
    const tone = (p: Vector3, time: number) =>
      (p.y + 3.4) / 6.8 + time * 0.04 + 0.22 * Math.sin(p.x * 0.9 + time * 0.3) + 0.12 * Math.sin(p.z * 1.3 - time * 0.21);
    const phase = pos.map(() => Math.random() * Math.PI * 2);
    const rate = pos.map(() => 0.4 + Math.random() * 0.7);
    const paint = (time: number) => {
      pos.forEach((p, i) => {
        const breathe = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(time * rate[i] + phase[i]));
        sample(tone(p, time), c).multiplyScalar(breathe).toArray(nodeCol, i * 3);
      });
      edges.forEach(([a, b], k) => {
        for (let j = 0; j < 3; j++) {
          lineCol[k * 6 + j] = nodeCol[a * 3 + j];
          lineCol[k * 6 + 3 + j] = nodeCol[b * 3 + j];
        }
      });
      sparks.forEach((p, i) => sample(tone(pos[p.node], time) + 0.5, c).toArray(sparkCol, i * 3));
      pulses.forEach((p, i) => {
        for (let j = 0; j < 3; j++) pulseCol[i * 3 + j] = nodeCol[p.from * 3 + j];
      });
      nodeGeo.attributes.col.needsUpdate = true;
      lineGeo.attributes.color.needsUpdate = true;
      sparkGeo.attributes.col.needsUpdate = true;
      pulseGeo.attributes.col.needsUpdate = true;
    };
    paint(0);

    // A new node at least a few units away, so a spark visibly jumps rather than creeping along.
    const elsewhere = (from: number) => {
      for (let k = 0; k < 8; k++) {
        const n = (Math.random() * NODES) | 0;
        if (n !== from && pos[n].distanceToSquared(pos[from]) > 6) return n;
      }
      return (from + 1 + ((Math.random() * (NODES - 1)) | 0)) % NODES;
    };

    const fire = (from: number) => {
      const slot = pulses.find((p) => !p.live);
      const next = adj[from];
      if (!slot || next.length === 0) return;
      slot.from = from;
      slot.to = next[(Math.random() * next.length) | 0];
      slot.t = 0;
      slot.live = true;
    };

    const tmp = new Vector3();
    const step = (dt: number) => {
      for (let i = 0; i < NODES; i++) nodeGlow[i] *= Math.exp(-dt * 3);
      for (const p of pulses) {
        if (!p.live) continue;
        p.t += (dt * SPEED) / Math.max(pos[p.from].distanceTo(pos[p.to]), 0.4);
        if (p.t >= 1) {
          p.live = false;
          nodeGlow[p.to] = Math.max(nodeGlow[p.to], 0.6);
          if (Math.random() < 0.72) fire(p.to);
          if (Math.random() < 0.2) fire(p.to);
        }
      }
      if (Math.random() < dt * 2) fire((Math.random() * NODES) | 0);
      pulses.forEach((p, i) => {
        if (p.live) tmp.lerpVectors(pos[p.from], pos[p.to], p.t).toArray(pulsePos, i * 3);
        pulseSize[i] = p.live ? 0.17 : 0;
      });
      pulseGeo.attributes.position.needsUpdate = true;
      pulseGeo.attributes.size.needsUpdate = true;
      sparks.forEach((p, i) => {
        p.t += dt / p.dur;
        if (p.t >= 1) {
          p.node = elsewhere(p.node);
          p.t -= 1;
          p.dur = 1.4 + Math.random() * 1.6;
        }
        const a = Math.sin(Math.PI * p.t) ** 2;
        pos[p.node].toArray(sparkPos, i * 3);
        sparkSize[i] = (closeup ? 0.36 : 0.3) * a;
        sparkGlow[i] = a;
        nodeGlow[p.node] = Math.max(nodeGlow[p.node], a);
      });
      nodeGeo.attributes.glow.needsUpdate = true;
      sparkGeo.attributes.position.needsUpdate = true;
      sparkGeo.attributes.size.needsUpdate = true;
      sparkGeo.attributes.glow.needsUpdate = true;
    };

    const resize = () => {
      const { width, height } = root.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / Math.max(height, 1);
      if (!closeup) camera.position.z = camera.aspect < 1 ? 12 : 9;
      camera.updateProjectionMatrix();
      if (reduced) renderer.render(scene, camera);
    };
    new ResizeObserver(resize).observe(root);
    resize();

    for (let i = 0; i < 6; i++) fire((Math.random() * NODES) | 0);

    const pointer = { x: 0, y: 0 };
    addEventListener(
      'pointermove',
      (e) => {
        pointer.x = e.clientX / innerWidth - 0.5;
        pointer.y = e.clientY / innerHeight - 0.5;
      },
      { passive: true },
    );

    if (reduced) {
      step(0.4);
      paint(0);
      net.rotation.set(0.25, 0.6, 0);
      renderer.render(scene, camera);
      return;
    }

    let visible = false;
    let last = performance.now();
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      last = performance.now();
    }).observe(root);

    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (!visible || document.hidden) {
        last = now;
        return;
      }
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      step(dt);
      paint(now / 1000);
      if (closeup) {
        net.rotation.y = Math.sin(now / 21000) * 0.35 + pointer.x * 0.25;
        net.rotation.x += (pointer.y * 0.2 - net.rotation.x) * dt * 1.5;
        net.position.z = Math.sin(now / 9000) * 0.9;
      } else {
        net.rotation.y += dt * 0.06;
        net.rotation.x += (pointer.y * 0.35 + 0.18 - net.rotation.x) * dt * 1.5;
        net.position.x += (pointer.x * 0.6 - net.position.x) * dt * 1.5;
      }
      net.position.y = Math.sin(now / 2600) * 0.12;
      renderer.render(scene, camera);
    };
    requestAnimationFrame(frame);
  }

  document.querySelectorAll<HTMLElement>('.net').forEach(mount);
</script>

<style>
  .net {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 75% 70% at var(--net-at, 50% 45%), #000 40%, transparent 85%);
  }
  .net.contained {
    position: relative;
    inset: auto;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin-inline: auto;
    mask-image: radial-gradient(circle at 50% 50%, #000 45%, transparent 72%);
  }
  .net.contained.closeup {
    max-width: 640px;
    aspect-ratio: 4 / 5;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 50%, transparent 100%);
  }
  canvas {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* A soft aurora glow behind the web. */
  .net::before {
    content: '';
    position: absolute;
    inset: 10% 5%;
    background:
      radial-gradient(40% 30% at 30% 70%, rgba(34, 245, 154, 0.3), transparent 70%),
      radial-gradient(35% 28% at 55% 45%, rgba(24, 224, 200, 0.22), transparent 70%),
      radial-gradient(38% 30% at 72% 28%, rgba(139, 92, 255, 0.28), transparent 70%),
      radial-gradient(30% 22% at 45% 20%, rgba(255, 79, 216, 0.2), transparent 70%);
    filter: blur(36px) saturate(1.3);
    animation: aurora 18s ease-in-out infinite alternate;
  }
  @keyframes aurora {
    to {
      transform: translate3d(4%, -3%, 0) scale(1.08) skewX(-6deg);
      opacity: 0.75;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .net::before {
      animation: none;
    }
  }
  @media (forced-colors: active) {
    .net {
      display: none;
    }
  }
</style>
