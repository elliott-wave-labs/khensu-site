---
/* The relay network as a slowly turning 3D web. Each pulse fades in somewhere along a line, travels, vanishes partway
   and at once reappears on a line somewhere else, the way relays switch mid-conversation; sparks do the same at nodes.
   Colours drift through the aurora palette and every node breathes brighter and dimmer on its own rhythm.
   Ported from MOQOM Cloud's IndrasNet, coloured like an aurora: green low, through teal and blue,
   to violet and magenta high, with the bands drifting slowly. Fills its positioned parent behind the content unless
   `contained` is set, in which case it is a square block in the flow. `closeup` puts the camera inside the web,
   with near nodes large and soft and far ones fading into the dark. `coins` sends small spinning gold coins along some
   pulses, from fan nodes to a few creator nodes, with an occasional burst of coins landing on a creator. */
interface Props {
  contained?: boolean;
  closeup?: boolean;
  nodes?: number;
  label?: string;
  class?: string;
  coins?: boolean;
}
const { contained = false, closeup = false, nodes = 96, label, class: cls, coins = false } = Astro.props;
---

<div
  class:list={['net', { contained, closeup }, cls]}
  data-nodes={nodes}
  data-closeup={closeup ? '' : undefined}
  data-coins={coins ? '' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <canvas></canvas>
</div>

<script>
  import {
    AdditiveBlending,
    BufferAttribute,
    BufferGeometry,
    Color,
    Fog,
    Group,
    LineBasicMaterial,
    LineSegments,
    PerspectiveCamera,
    Points,
    Scene,
    ShaderMaterial,
    Vector3,
    WebGLRenderer,
  } from 'three';

  const NEIGHBOURS = 3;
  const SPARKS = 18;
  const PULSES = 36;
  const SPEED = 0.9;

  // Aurora palette, bottom of the curtain to the top.
  const AURORA = ['#22f59a', '#18e0c8', '#3b9dff', '#8b5cff', '#ff4fd8'];

  const POINT_VERT = /* glsl */ `
    attribute float size;
    attribute float glow;
    attribute vec3 col;
    uniform vec2 fog;
    varying float vGlow;
    varying vec3 vCol;
    varying float vFog;
    void main() {
      vGlow = glow;
      vCol = col;
      vec4 mv = modelViewMatrix * vec4(position, 1.0);
      vFog = 1.0 - smoothstep(fog.x, fog.y, -mv.z);
      gl_PointSize = min(size * (1.0 + glow * 1.6) * (300.0 / -mv.z), 90.0);
      gl_Position = projectionMatrix * mv;
    }
  `;
  const POINT_FRAG = /* glsl */ `
    uniform vec3 hot;
    varying float vGlow;
    varying vec3 vCol;
    varying float vFog;
    void main() {
      float d = length(gl_PointCoord - 0.5);
      float core = smoothstep(0.5, 0.0, d);
      float a = pow(core, 2.2);
      gl_FragColor = vec4(mix(vCol, hot, vGlow * 0.55), a * (0.6 + vGlow * 0.4) * vFog);
    }
  `;

  // Coins: a disc squashed sideways by its spin, gold shading from top to bottom, a darker rim and a moving glint.
  const COIN_VERT = /* glsl */ `
    attribute float size;
    attribute float spin;
    attribute float alpha;
    uniform vec2 fog;
    varying float vSpin;
    varying float vA;
    void main() {
      vSpin = spin;
      vec4 mv = modelViewMatrix * vec4(position, 1.0);
      vA = alpha * (1.0 - smoothstep(fog.x, fog.y, -mv.z));
      gl_PointSize = min(size * (300.0 / -mv.z), 60.0);
      gl_Position = projectionMatrix * mv;
    }
  `;
  const COIN_FRAG = /* glsl */ `
    varying float vSpin;
    varying float vA;
    void main() {
      vec2 p = gl_PointCoord - 0.5;
      float c = cos(vSpin);
      float w = max(abs(c), 0.12);
      float e = length(vec2(p.x / w, p.y)) * 2.0;
      if (e > 1.0 || vA < 0.01) discard;
      vec3 dark = vec3(0.47, 0.29, 0.05);
      vec3 mid = vec3(0.86, 0.62, 0.18);
      vec3 light = vec3(1.0, 0.88, 0.52);
      float shade = clamp(0.55 - p.y * 1.4 + c * 0.25 * p.x / w, 0.0, 1.0);
      vec3 col = mix(dark, mix(mid, light, shade), smoothstep(0.0, 0.7, shade));
      col *= mix(1.0, 0.62, smoothstep(0.72, 0.86, e));
      float band = p.x / w * 0.8 + p.y * 0.6 - sin(vSpin * 1.7) * 0.45;
      col += vec3(1.0, 0.95, 0.8) * exp(-band * band * 60.0) * (0.35 + 0.65 * abs(c));
      float a = (1.0 - smoothstep(0.9, 1.0, e)) * vA;
      gl_FragColor = vec4(col, a);
    }
  `;

  function mount(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NODES = Number(root.dataset.nodes) || 96;
    const closeup = root.dataset.closeup !== undefined;
    const withCoins = root.dataset.coins !== undefined;

    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'low-power' });
    } catch {
      root.remove();
      return;
    }
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

    const scene = new Scene();
    const camera = new PerspectiveCamera(closeup ? 70 : 50, 1, 0.1, 100);
    camera.position.set(0, 0, closeup ? 4.5 : 9);
    const fogRange = closeup ? [4, 12] : [40, 60];
    scene.fog = new Fog(0x000000, fogRange[0], fogRange[1] + 4);
    const net = new Group();
    scene.add(net);

    const hot = new Color('#ffffff');
    const palette = AURORA.map((c) => new Color(c));
    const sample = (t: number, out: Color) => {
      const m = ((t % 2) + 2) % 2;
      const x = Math.min(m > 1 ? 2 - m : m, 0.9999) * (palette.length - 1);
      const i = Math.floor(x);
      return out.copy(palette[i]).lerp(palette[i + 1], x - i);
    };

    // Nodes on a Fibonacci shell plus a sparse inner cloud; in close-up, a deep field around the camera.
    const pos: Vector3[] = [];
    const shell = closeup ? 0 : Math.round(NODES * 0.7);
    if (closeup) {
      while (pos.length < NODES) {
        pos.push(new Vector3((Math.random() - 0.5) * 8, (Math.random() - 0.5) * 7, 2.6 - Math.random() * 9));
      }
    }
    for (let i = 0; i < shell; i++) {
      const y = 1 - (i / (shell - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const t = i * Math.PI * (3 - Math.sqrt(5));
      pos.push(new Vector3(Math.cos(t) * r, y, Math.sin(t) * r).multiplyScalar(3.4));
    }
    while (pos.length < NODES) {
      const v = new Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5);
      pos.push(v.normalize().multiplyScalar(0.8 + Math.random() * 1.9));
    }

    // Edges: each node to its nearest neighbours, deduplicated.
    const adj: number[][] = pos.map(() => []);
    const seen = new Set<string>();
    const edges: [number, number][] = [];
    pos.forEach((p, i) => {
      pos
        .map((q, j) => [j, p.distanceToSquared(q)] as const)
        .filter(([j]) => j !== i)
        .sort((a, b) => a[1] - b[1])
        .slice(0, NEIGHBOURS)
        .forEach(([j]) => {
          const key = i < j ? `${i}-${j}` : `${j}-${i}`;
          if (seen.has(key)) return;
          seen.add(key);
          edges.push([i, j]);
          adj[i].push(j);
          adj[j].push(i);
        });
    });

    const lineGeo = new BufferGeometry();
    const linePos = new Float32Array(edges.length * 6);
    edges.forEach(([a, b], k) => {
      pos[a].toArray(linePos, k * 6);
      pos[b].toArray(linePos, k * 6 + 3);
    });
    lineGeo.setAttribute('position', new BufferAttribute(linePos, 3));
    const lineCol = new Float32Array(edges.length * 6);
    lineGeo.setAttribute('color', new BufferAttribute(lineCol, 3));
    net.add(
      new LineSegments(
        lineGeo,
        new LineBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.55, blending: AdditiveBlending, depthWrite: false }),
      ),
    );

    const pointMaterial = () =>
      new ShaderMaterial({
        uniforms: { hot: { value: hot }, fog: { value: fogRange } },
        vertexShader: POINT_VERT,
        fragmentShader: POINT_FRAG,
        transparent: true,
        depthWrite: false,
        blending: AdditiveBlending,
      });

    const nodeGeo = new BufferGeometry();
    const nodePos = new Float32Array(NODES * 3);
    pos.forEach((p, i) => p.toArray(nodePos, i * 3));
    const nodeSize = new Float32Array(NODES).map(() => (closeup ? 0.14 : 0.22) + Math.random() * 0.16);
    const nodeGlow = new Float32Array(NODES);
    nodeGeo.setAttribute('position', new BufferAttribute(nodePos, 3));
    nodeGeo.setAttribute('size', new BufferAttribute(nodeSize, 1));
    nodeGeo.setAttribute('glow', new BufferAttribute(nodeGlow, 1));
    const nodeCol = new Float32Array(NODES * 3);
    nodeGeo.setAttribute('col', new BufferAttribute(nodeCol, 3));
    net.add(new Points(nodeGeo, pointMaterial()));

    // Each spark lives at one node for `dur` seconds, fading in and out, then reappears at once somewhere else.
    type Spark = { node: number; t: number; dur: number };
    const spark = (t = 0): Spark => ({ node: (Math.random() * NODES) | 0, t, dur: 1.4 + Math.random() * 1.6 });
    const sparks: Spark[] = Array.from({ length: SPARKS }, () => spark(Math.random()));
    const sparkGeo = new BufferGeometry();
    const sparkPos = new Float32Array(SPARKS * 3);
    const sparkSize = new Float32Array(SPARKS);
    const sparkGlow = new Float32Array(SPARKS);
    sparkGeo.setAttribute('position', new BufferAttribute(sparkPos, 3));
    sparkGeo.setAttribute('size', new BufferAttribute(sparkSize, 1));
    sparkGeo.setAttribute('glow', new BufferAttribute(sparkGlow, 1));
    const sparkCol = new Float32Array(SPARKS * 3);
    sparkGeo.setAttribute('col', new BufferAttribute(sparkCol, 3));
    net.add(new Points(sparkGeo, pointMaterial()));

    type Pulse = { from: number; to: number; t: number; t0: number; t1: number };
    const pulses: Pulse[] = Array.from({ length: PULSES }, () => ({ from: 0, to: 0, t: 0, t0: 0, t1: 1 }));
    const pulseGeo = new BufferGeometry();
    const pulsePos = new Float32Array(PULSES * 3);
    const pulseSize = new Float32Array(PULSES);
    const pulseGlow = new Float32Array(PULSES);
    pulseGeo.setAttribute('position', new BufferAttribute(pulsePos, 3));
    pulseGeo.setAttribute('size', new BufferAttribute(pulseSize, 1));
    pulseGeo.setAttribute('glow', new BufferAttribute(pulseGlow, 1));
    const pulseCol = new Float32Array(PULSES * 3);
    pulseGeo.setAttribute('col', new BufferAttribute(pulseCol, 3));
    net.add(new Points(pulseGeo, pointMaterial()));

    // Coins ride the first COIN_RIDERS pulses, which run from a fan node into one of a few creator nodes; BURST more
    // gather onto a creator now and then. Only with `coins`.
    const COIN_RIDERS = withCoins ? 14 : 0;
    const BURST = withCoins ? 26 : 0;
    const COINS = COIN_RIDERS + BURST;
    const creators = withCoins
      ? pos.map((_, i) => i).filter((i) => adj[i].length >= 2).sort(() => Math.random() - 0.5).slice(0, 7)
      : [];
    type Fly = { node: number; sx: number; sy: number; sz: number; t: number; dur: number };
    const flies: Fly[] = Array.from({ length: BURST }, () => ({ node: 0, sx: 0, sy: 0, sz: 0, t: 1, dur: 1 }));
    const coinGeo = new BufferGeometry();
    const coinPos = new Float32Array(COINS * 3);
    const coinSize = new Float32Array(COINS);
    const coinSpin = new Float32Array(COINS).map(() => Math.random() * 6.28);
    const coinRate = new Float32Array(COINS).map(() => 3 + Math.random() * 4);
    const coinAlpha = new Float32Array(COINS);
    coinGeo.setAttribute('position', new BufferAttribute(coinPos, 3));
    coinGeo.setAttribute('size', new BufferAttribute(coinSize, 1));
    coinGeo.setAttribute('spin', new BufferAttribute(coinSpin, 1));
    coinGeo.setAttribute('alpha', new BufferAttribute(coinAlpha, 1));
    if (withCoins) {
      net.add(
        new Points(
          coinGeo,
          new ShaderMaterial({
            uniforms: { fog: { value: fogRange } },
            vertexShader: COIN_VERT,
            fragmentShader: COIN_FRAG,
            transparent: true,
            depthWrite: false,
          }),
        ),
      );
    }
    const burst = (node: number) => {
      let n = 0;
      for (const f of flies) {
        if (f.t < 1 || n >= 13) continue;
        const a = Math.random() * Math.PI * 2;
        const b = Math.acos(Math.random() * 2 - 1);
        const r = (closeup ? 0.7 : 0.9) + Math.random() * 0.7;
        f.node = node;
        f.sx = pos[node].x + Math.sin(b) * Math.cos(a) * r;
        f.sy = pos[node].y + Math.sin(b) * Math.sin(a) * r + 0.4;
        f.sz = pos[node].z + Math.cos(b) * r;
        f.t = -Math.random() * 0.35;
        f.dur = 0.9 + Math.random() * 0.5;
        n++;
      }
    };
    let nextBurst = 1.2;

    // Height up the curtain, with slow waves running sideways through the bands.
    const c = new Color();
    const tone = (p: Vector3, time: number) =>
      (p.y + 3.4) / 6.8 + time * 0.04 + 0.22 * Math.sin(p.x * 0.9 + time * 0.3) + 0.12 * Math.sin(p.z * 1.3 - time * 0.21);
    const phase = pos.map(() => Math.random() * Math.PI * 2);
    const rate = pos.map(() => 0.4 + Math.random() * 0.7);
    const paint = (time: number) => {
      pos.forEach((p, i) => {
        const breathe = 0.28 + 0.72 * (0.5 + 0.5 * Math.sin(time * rate[i] + phase[i]));
        sample(tone(p, time), c).multiplyScalar(breathe).toArray(nodeCol, i * 3);
      });
      edges.forEach(([a, b], k) => {
        for (let j = 0; j < 3; j++) {
          lineCol[k * 6 + j] = nodeCol[a * 3 + j];
          lineCol[k * 6 + 3 + j] = nodeCol[b * 3 + j];
        }
      });
      sparks.forEach((p, i) => sample(tone(pos[p.node], time) + 0.5, c).toArray(sparkCol, i * 3));
      pulses.forEach((p, i) => {
        for (let j = 0; j < 3; j++) pulseCol[i * 3 + j] = nodeCol[p.from * 3 + j];
      });
      nodeGeo.attributes.col.needsUpdate = true;
      lineGeo.attributes.color.needsUpdate = true;
      sparkGeo.attributes.col.needsUpdate = true;
      pulseGeo.attributes.col.needsUpdate = true;
    };
    paint(0);

    // A new node at least a few units away, so a light visibly jumps rather than creeping along.
    const elsewhere = (from: number) => {
      for (let k = 0; k < 8; k++) {
        const n = (Math.random() * NODES) | 0;
        if (n !== from && pos[n].distanceToSquared(pos[from]) > 6) return n;
      }
      return (from + 1 + ((Math.random() * (NODES - 1)) | 0)) % NODES;
    };

    // Put a pulse on a line that starts somewhere else in the network.
    // Each visit covers a random stretch of its line: it may start partway along and vanish before the end.
    const hop = (p: Pulse, warm = false) => {
      const rider = pulses.indexOf(p) < COIN_RIDERS && creators.length > 0;
      if (rider) {
        const to = creators[(Math.random() * creators.length) | 0];
        p.from = adj[to][(Math.random() * adj[to].length) | 0];
        p.to = to;
        p.t0 = 0;
        p.t1 = 1;
        p.t = warm ? Math.random() : 0;
        return;
      }
      const from = elsewhere(p.from);
      const next = adj[from];
      p.from = from;
      p.to = next.length ? next[(Math.random() * next.length) | 0] : from;
      p.t0 = Math.random() < 0.5 ? 0 : Math.random() * 0.45;
      p.t1 = Math.min(1, p.t0 + 0.3 + Math.random() * 0.6);
      p.t = warm ? p.t0 + Math.random() * (p.t1 - p.t0) : p.t0;
    };

    const tmp = new Vector3();
    const step = (dt: number) => {
      for (let i = 0; i < NODES; i++) nodeGlow[i] *= Math.exp(-dt * 3);
      pulses.forEach((p, i) => {
        p.t += (dt * SPEED) / Math.max(pos[p.from].distanceTo(pos[p.to]), 0.4);
        if (p.t >= p.t1) {
          if (i < COIN_RIDERS) {
            nodeGlow[p.to] = 1;
            if (Math.random() < 0.18) burst(p.to);
          }
          hop(p);
        }
        const u = (p.t - p.t0) / (p.t1 - p.t0);
        const a = Math.min(u / 0.2, 1) * Math.min((1 - u) / 0.25, 1);
        tmp.lerpVectors(pos[p.from], pos[p.to], p.t).toArray(pulsePos, i * 3);
        pulseSize[i] = 0.19 * a;
        pulseGlow[i] = 0.7 * a;
        if (i < COIN_RIDERS) {
          coinPos[i * 3] = pulsePos[i * 3];
          coinPos[i * 3 + 1] = pulsePos[i * 3 + 1];
          coinPos[i * 3 + 2] = pulsePos[i * 3 + 2];
          coinSize[i] = closeup ? 0.5 : 0.62;
          coinAlpha[i] = Math.min(u / 0.12, 1) * Math.min((1 - u) / 0.12, 1);
        }
      });
      if (withCoins) {
        nextBurst -= dt;
        if (nextBurst <= 0) {
          burst(creators[(Math.random() * creators.length) | 0]);
          nextBurst = 2.6 + Math.random() * 2.4;
        }
        flies.forEach((f, k) => {
          const j = COIN_RIDERS + k;
          f.t += dt / f.dur;
          const t = Math.max(0, Math.min(f.t, 1));
          const e = t * t * (3 - 2 * t);
          const q = pos[f.node];
          coinPos[j * 3] = f.sx + (q.x - f.sx) * e;
          coinPos[j * 3 + 1] = f.sy + (q.y - f.sy) * e - Math.sin(Math.PI * e) * 0.15;
          coinPos[j * 3 + 2] = f.sz + (q.z - f.sz) * e;
          coinSize[j] = (closeup ? 0.42 : 0.52) * (1 - 0.4 * e);
          coinAlpha[j] = f.t <= 0 || f.t >= 1 ? 0 : Math.min(t / 0.15, 1) * Math.min((1 - t) / 0.12, 1);
          if (f.t >= 1 && f.t - dt / f.dur < 1) nodeGlow[f.node] = 1;
        });
        for (let j = 0; j < COINS; j++) coinSpin[j] += dt * coinRate[j];
        coinGeo.attributes.position.needsUpdate = true;
        coinGeo.attributes.size.needsUpdate = true;
        coinGeo.attributes.spin.needsUpdate = true;
        coinGeo.attributes.alpha.needsUpdate = true;
      }
      pulseGeo.attributes.position.needsUpdate = true;
      pulseGeo.attributes.size.needsUpdate = true;
      pulseGeo.attributes.glow.needsUpdate = true;
      sparks.forEach((p, i) => {
        p.t += dt / p.dur;
        if (p.t >= 1) {
          p.node = elsewhere(p.node);
          p.t -= 1;
          p.dur = 1.4 + Math.random() * 1.6;
        }
        const a = Math.sin(Math.PI * p.t) ** 2;
        pos[p.node].toArray(sparkPos, i * 3);
        sparkSize[i] = (closeup ? 0.36 : 0.3) * a;
        sparkGlow[i] = a;
        nodeGlow[p.node] = Math.max(nodeGlow[p.node], a);
      });
      nodeGeo.attributes.glow.needsUpdate = true;
      sparkGeo.attributes.position.needsUpdate = true;
      sparkGeo.attributes.size.needsUpdate = true;
      sparkGeo.attributes.glow.needsUpdate = true;
    };

    const resize = () => {
      const { width, height } = root.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / Math.max(height, 1);
      if (!closeup) camera.position.z = camera.aspect < 1 ? 12 : 9;
      camera.updateProjectionMatrix();
      if (reduced) renderer.render(scene, camera);
    };
    new ResizeObserver(resize).observe(root);
    resize();

    pulses.forEach((p) => hop(p, true));

    const pointer = { x: 0, y: 0 };
    addEventListener(
      'pointermove',
      (e) => {
        pointer.x = e.clientX / innerWidth - 0.5;
        pointer.y = e.clientY / innerHeight - 0.5;
      },
      { passive: true },
    );

    if (reduced) {
      step(0.4);
      paint(0);
      net.rotation.set(0.25, 0.6, 0);
      renderer.render(scene, camera);
      return;
    }

    let visible = false;
    let last = performance.now();
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      last = performance.now();
    }).observe(root);

    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (!visible || document.hidden) {
        last = now;
        return;
      }
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      step(dt);
      paint(now / 1000);
      if (closeup) {
        net.rotation.y = Math.sin(now / 21000) * 0.35 + pointer.x * 0.25;
        net.rotation.x += (pointer.y * 0.2 - net.rotation.x) * dt * 1.5;
        net.position.z = Math.sin(now / 9000) * 0.9;
      } else {
        net.rotation.y += dt * 0.06;
        net.rotation.x += (pointer.y * 0.35 + 0.18 - net.rotation.x) * dt * 1.5;
        net.position.x += (pointer.x * 0.6 - net.position.x) * dt * 1.5;
      }
      net.position.y = Math.sin(now / 2600) * 0.12;
      renderer.render(scene, camera);
    };
    requestAnimationFrame(frame);
  }

  document.querySelectorAll<HTMLElement>('.net').forEach(mount);
</script>

<style>
  .net {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 75% 70% at var(--net-at, 50% 45%), #000 40%, transparent 85%);
  }
  .net.contained {
    position: relative;
    inset: auto;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin-inline: auto;
    mask-image: radial-gradient(circle at 50% 50%, #000 45%, transparent 72%);
  }
  .net.contained.closeup {
    max-width: 640px;
    aspect-ratio: 4 / 5;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 50%, transparent 100%);
  }
  /* Behind a page's hero (Base.astro puts one in every hero that has none): under the text, over the background,
     a little dimmer, and without the aurora glow where the hero brings its own picture (`plain`). */
  .net.hero-net {
    z-index: -1;
    opacity: 0.85;
    mask-image: radial-gradient(ellipse 80% 75% at var(--net-at, 50% 50%), #000 35%, transparent 85%);
  }
  .net.plain::before {
    display: none;
  }
  /* Behind a section's text: the web fills the whole section and stays dim enough to read over. */
  .net.closeup.behind {
    opacity: 0.8;
    mask-image: radial-gradient(ellipse 85% 80% at 60% 50%, #000 35%, transparent 95%);
  }
  canvas {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* A soft aurora glow behind the web. */
  .net::before {
    content: '';
    position: absolute;
