---
// With and without suñůlink.shield: two iPhones whose screens go from the app to the home screen and back on a 12 s
// loop, over a traffic timeline of one bar per 2 s tick (one minute shown). Without the shield the bars stop while
// iOS has the app suspended; with it, the shield keeps them going. Sources: khensu-specs PLAN.md (Stealth, iOS
// limits), PROTOCOL.md 8.8, design/mesh.md 3, hardware/sunu/SPEC.md (power budget).
import MemPhone from './MemPhone.astro';

const N = 30;
const BG = [14, 24];
const pulses = Array.from({ length: N }, (_, i) => ({ i, bg: i >= BG[0] && i < BG[1] }));
const WAKE = 18;
const sides = [
  {
    id: 'plain',
    title: 'iPhone on its own',
    img: '/khensu/memory/phone_burgundy.webp',
    alt: 'The back of a burgundy iPhone 18 Pro with nothing attached',
    on: 'Cover on',
    off: 'Cover paused while closed',
  },
  {
    id: 'shield',
    title: 'iPhone with suñůlink.shield',
    img: '/khensu/memory/assembled_burgundy.webp',
    alt: 'The back of a burgundy iPhone 18 Pro with suñůlink.shield attached',
    on: 'Cover on',
    off: 'Cover on, from the shield',
  },
];
---

<figure class="msh" aria-labelledby="msh-cap">
  <div class="msh-cols">
    {sides.map((s) => (
      <div class:list={['msh-col', s.id]}>
        <p class="msh-title">{s.title}</p>
        <div class="msh-stage">
          <img class="msh-back" src={s.img} alt={s.alt} width="1000" height="1000" loading="lazy" decoding="async" />
          <MemPhone screen="foryou" cycle class="msh-phone" label={`${s.title}: the app is open, then goes to the background, then opens again`} />
        </div>
        <p class="msh-state" aria-hidden="true">
          <span class="st-on"><i></i>{s.on}</span>
          <span class="st-off"><i></i>{s.off}</span>
        </p>
        <div class="msh-time" role="img" aria-label={s.id === 'plain'
          ? 'Traffic over one minute without the shield: a burst every 2 seconds while the app is open, nothing while it is in the background except one push wake-up, then bursts again.'
          : 'Traffic over one minute with the shield: a burst every 2 seconds the whole time, from the phone while the app is open and from the shield while it is in the background.'}>
          <div class="msh-track">
            {pulses.map((p) => (
              (s.id === 'plain' && p.bg)
                ? (p.i === WAKE ? <i class="wake" style={`--i:${p.i}`}></i> : <i class="gap" style={`--i:${p.i}`}></i>)
                : <i class:list={{ fromshield: s.id === 'shield' && p.bg }} style={`--i:${p.i}`}></i>
            ))}
            <span class="msh-head"></span>
          </div>
          <div class="msh-phases" aria-hidden="true">
            <span style={`--a:${BG[0]};--b:0`}>App open</span>
            <span style={`--a:${BG[1] - BG[0]};--b:${BG[0]}`} class="mid">App closed</span>
            <span style={`--a:${N - BG[1]};--b:${BG[1]}`}>Open</span>
          </div>
          {s.id === 'plain' && <p class="msh-note"><i class="wake-k"></i> A push wake-up: the extension fetches your messages in one standard burst.</p>}
          {s.id === 'shield' && <p class="msh-note"><i class="sh-k"></i> Bursts from the shield’s own radio and battery.</p>}
        </div>
      </div>
    ))}
  </div>
  <figcaption id="msh-cap">One bar for each 2-second tick, one minute of traffic. Every burst is the same size, whatever it carries.</figcaption>
</figure>

<style>
  .msh {
    margin: 3rem 0 0;
  }
  .msh-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }
  .msh-col {
    display: grid;
    align-content: start;
    gap: 1.2rem;
    padding: clamp(1rem, 3vw, 1.8rem);
    border-radius: 30px;
    background: radial-gradient(80% 60% at 60% 30%, rgba(139, 123, 255, 0.12), transparent 70%), #08080a;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .msh-col.shield {
    background: radial-gradient(80% 60% at 60% 30%, rgba(47, 224, 200, 0.12), transparent 70%), #08080a;
  }
  .msh-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .msh-stage {
    position: relative;
    height: clamp(340px, 46vw, 520px);
  }
  .msh-back {
    position: absolute;
    right: -6%;
    top: 0;
    width: 78%;
    height: auto;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6));
  }
  .msh-stage :global(.msh-phone) {
    --phone-w: clamp(150px, 19vw, 230px);
    position: absolute;
    left: 2%;
    bottom: 0;
  }
  .msh-state {
    display: grid;
    margin: 0 0 -0.4rem;
    font-size: 0.8rem;
  }
  .msh-state span {
    grid-area: 1 / 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px) saturate(160%);
    white-space: nowrap;
  }
  .msh-state i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #30d158;
    box-shadow: 0 0 8px #30d158;
  }
  .plain .st-off i {
    background: #8a8f98;
    box-shadow: none;
  }
  .st-off {
    opacity: 0;
    animation: st-off 12s linear infinite;
  }
  .st-on {
    animation: st-on 12s linear infinite;
  }
  @keyframes st-off {
    0%, 46% { opacity: 0; }
    47.5%, 79% { opacity: 1; }
    80.5%, 100% { opacity: 0; }
  }
  @keyframes st-on {
    0%, 46% { opacity: 1; }
    47.5%, 79% { opacity: 0; }
    80.5%, 100% { opacity: 1; }
  }

  .msh-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(30, minmax(0, 1fr));
    align-items: end;
    gap: 3px;
    height: 54px;
    padding: 6px 8px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .msh-track i {
    height: 100%;
    border-radius: 2px;
    background: rgba(242, 241, 236, 0.85);
    animation: tick-flash 12s linear infinite;
    animation-delay: calc(var(--i) * 0.4s);
  }
  .msh-track i.fromshield {
    background: rgba(47, 224, 200, 0.9);
  }
  .msh-track i.gap {
    height: 2px;
    background: rgba(255, 255, 255, 0.18);
    animation: none;
  }
  .msh-track i.wake {
    height: 100%;
    background: rgba(255, 255, 255, 0.35);
    border: 1px dashed rgba(255, 255, 255, 0.7);
  }
  @keyframes tick-flash {
    0% { opacity: 1; filter: brightness(1.4); }
    6%, 100% { opacity: 0.55; filter: none; }
  }
  .msh-head {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 8px;
    width: 2px;
    border-radius: 1px;
    background: #fff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
    animation: head 12s linear infinite;
  }
  @keyframes head {
    from { left: 8px; }
    to { left: calc(100% - 10px); }
  }
  .msh-phases {
    display: grid;
    grid-template-columns: repeat(30, minmax(0, 1fr));
    margin-top: 0.5rem;
    font-size: 0.74rem;
    color: var(--text-faint);
    padding: 0 8px;
  }
  .msh-phases span {
    grid-column: calc(var(--b) + 1) / span var(--a);
    padding-top: 0.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .msh-phases .mid {
    color: var(--text-dim);
  }
  .msh-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .wake-k,
  .sh-k {
    flex: none;
    width: 10px;
    height: 16px;
    border-radius: 2px;
  }
  .wake-k {
    background: rgba(255, 255, 255, 0.35);
    border: 1px dashed rgba(255, 255, 255, 0.7);
  }
  .sh-k {
    background: rgba(47, 224, 200, 0.9);
  }
  .msh figcaption {
    margin-top: 1.2rem;
    font-size: 0.86rem;
    color: var(--text-dim);
  }
  @media (max-width: 760px) {
    .msh-cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .msh-stage {
      height: clamp(380px, 100vw, 460px);
    }
    .msh-stage :global(.msh-phone) {
      --phone-w: clamp(160px, 46vw, 210px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .msh-track i,
    .st-on,
    .st-off {
      animation: none;
    }
    .msh-head {
      display: none;
    }
    .st-off {
      opacity: 0;
    }
  }
</style>
