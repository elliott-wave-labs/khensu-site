---
// A wordmark set in ñü.Føňt as inline SVG, one <path> per stroke, so the ė dot can pulse and phase through the
// ñü.aura on its own while every other stroke keeps its normal fill. `aura` fills the letters with the drifting
// house gradient instead of the current colour. The text stays in the page for readers and search.
import { MARKS, MARK_TEXT } from '../../data/nufont-marks';

interface Props { name: keyof typeof MARKS; aura?: boolean; class?: string; still?: boolean }
const { name, aura = false, class: cls, still = false } = Astro.props;
const id = `nf-aura-${name}-${Math.random().toString(36).slice(2, 8)}`;
let svg = MARKS[name];
if (aura) {
  const width = Number(svg.match(/viewBox="0 -?\d+ (\d+)/)?.[1] ?? 1000);
  const defs =
    `<defs><linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="${width}" y2="0" spreadMethod="repeat">` +
    `<stop offset="0" stop-color="var(--aura-green)"/><stop offset="0.33" stop-color="var(--aura-blue)"/>` +
    `<stop offset="0.66" stop-color="var(--aura-purple)"/><stop offset="1" stop-color="var(--aura-green)"/>` +
    `<animateTransform attributeName="gradientTransform" type="translate" from="0 0" to="${width} 0" dur="9s" repeatCount="indefinite"/>` +
    `</linearGradient></defs>`;
  svg = svg.replace('<g>', `${defs}<g fill="url(#${id})">`);
}
---

<span class:list={['nf-word', cls, still && 'still']} set:html={svg + `<span class="sr">${MARK_TEXT[name]}</span>`} />
