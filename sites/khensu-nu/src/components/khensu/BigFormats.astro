  .fmt li { display: grid; grid-template-columns: 17rem 1fr 11rem; gap: 1rem; align-items: center; }
  .xfer li { display: grid; grid-template-columns: 17rem 1fr 6rem; gap: 0.3rem 1rem; align-items: center; }
  .xfer .how { grid-column: 1 / -1; color: var(--text-dim); }
  .label small, .value small { display: block; color: var(--text-dim); font-size: 0.8rem; }
  .value { text-align: right; }
  .track { height: 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); overflow: hidden; }
  .fill { display: block; height: 100%; width: calc(var(--w) * 1%); min-width: 4px; border-radius: inherit; background: rgba(255, 255, 255, 0.35);
          transform-origin: left; transform: scaleX(clamp(0, calc((var(--e, 1) - var(--i) * 0.06) / 0.6), 1)); }
  .del .fill { background: rgba(255, 255, 255, 0.55); }
  .ours .fill { background: linear-gradient(90deg, #8b7bff, #4fd1c5); }
  .est .fill { background: repeating-linear-gradient(135deg, rgba(139, 123, 255, 0.85) 0 6px, rgba(79, 209, 197, 0.25) 6px 12px); }
  .ours b { color: #b9b0ff; }
  .sub { margin-top: 1.4rem; }
  .note { margin: 0; font-size: 0.92rem; color: var(--text-dim); }
  @media (max-width: 760px) {
    .fmt li, .xfer li { grid-template-columns: 1fr auto; gap: 0.3rem 0.8rem; }
    .fmt .track, .xfer .track { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
