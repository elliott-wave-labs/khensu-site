---
// One link-preview card. 1200 x 630 by default; square (1080 x 1080) when the viewport is square. `overlay` draws
// only the words on a transparent page, so tools/og.sh can lay them over video for the animated versions.
import Name from './Name.astro';
import type { Card } from '../../data/og';

interface Props { c: Card; overlay?: boolean }
const { c, overlay = false } = Astro.props;
---

<main class:list={['card', { product: (c.product || c.screen) && !overlay, overlay, thumb: c.thumb }]} style={c.bg && !overlay ? `--bg-img:url(${c.bg})` : undefined}>
  {c.product && !overlay && <img class="shot" src={c.product} alt="" />}
  {c.screen && !overlay && <img class="screen" src={c.screen} alt="" />}
  <div class="front">
    <p class="brand">{!c.thumb && <span class="mark"><img src="/seal.webp" alt="" /></span>}<Name /></p>
    <h1>{c.title}{c.em && <em>{c.em}</em>}</h1>
    <p class="line">{c.line}</p>
    {c.note && <p class="note">{c.note}</p>}
    {c.foot && <p class="foot">{c.foot.map((f) => <span>{f}</span>)}</p>}
  </div>
</main>

<style>
  .card {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 64px 72px;
    box-sizing: border-box;
    color: #f2f1ec;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.45) 55%, rgba(0, 0, 0, 0.1) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%),
      var(--bg-img, radial-gradient(60% 70% at 75% 50%, rgba(139, 123, 255, 0.25), transparent 70%)) center / cover,
      #050507;
  }
  .card.overlay {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.45) 55%, rgba(0, 0, 0, 0.1) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%);
  }
  .shot {
    position: absolute;
    right: 48px;
    top: 50%;
    height: 420px;
    translate: 0 -50%;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.7));
  }
  .screen {
    position: absolute;
    right: 96px;
    top: 50%;
    height: 480px;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    translate: 0 -50%;
    border-radius: 44px;
    border: 10px solid #111;
    outline: 1.5px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.75);
  }
  .front {
    position: relative;
    max-width: 760px;
  }
  .product .front,
  .overlay .front {
    max-width: 640px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 22px;
    font: 600 56px/1 var(--font-display);
    letter-spacing: -0.02em;
    color: rgba(242, 241, 236, 0.9);
  }
  .brand :global(.tld) {
    font-weight: 300;
  }
  .brand .mark {
    width: 52px;
    height: 52px;
    display: inline-block;
  }
  .brand .mark img {
    width: 100%;
    height: 100%;
    display: block;
  }
  h1 {
    margin: 0;
    font: 600 80px/1 var(--font-display);
    letter-spacing: -0.02em;
  }
  h1 em {
    display: block;
    font-style: normal;
    font-weight: 300;
    color: rgba(242, 241, 236, 0.82);
    margin-top: 12px;
    font-size: 54px;
  }
  .line {
    margin: 22px 0 0;
    font: 500 30px/1.3 var(--font-display);
    color: rgba(242, 241, 236, 0.9);
  }
  .note {
    margin: 16px 0 0;
    font: 300 22px/1.35 Inter, sans-serif;
    color: rgba(242, 241, 236, 0.8);
  }
  .foot {
    margin: 14px 0 0;
    display: grid;
    gap: 4px;
    font: 700 16px/1.3 Inter, sans-serif;
    color: rgba(242, 241, 236, 0.85);
  }
  .foot span {
    display: block;
  }
  @media (aspect-ratio: 1 / 1) {
    .card {
      padding: 64px 72px 60px;
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 40%, rgba(0, 0, 0, 0) 64%),
        var(--bg-img, radial-gradient(60% 70% at 50% 35%, rgba(139, 123, 255, 0.25), transparent 70%)) center / cover,
        #050507;
    }
    .card.overlay {
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 40%, rgba(0, 0, 0, 0) 64%);
    }
    .shot {
      right: auto;
      left: 50%;
      top: 72px;
      height: 420px;
      translate: -50% 0;
    }
    .screen {
      right: auto;
      left: 50%;
      top: 80px;
      height: 480px;
      translate: -50% 0;
    }
    .front,
    .product .front,
    .overlay .front {
      max-width: none;
    }
    .brand {
      font-size: 56px;
      margin-bottom: 18px;
    }
    h1 {
      font-size: 84px;
    }
    h1 em {
      font-size: 54px;
    }
    .line {
      font-size: 30px;
    }
    .note {
      font-size: 23px;
    }
    .foot {
      font-size: 17px;
    }
    .thumb {
      padding: 0 60px 70px;
      text-align: center;
    }
    .thumb .shot {
      top: 56px;
      height: 400px;
      filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.7));
    }
    .thumb .front {
      width: 100%;
    }
    .thumb .brand {
      justify-content: center;
      font-size: 120px;
      margin-bottom: 22px;
    }
    .thumb h1 {
      font-size: 92px;
    }
    .thumb .line {
      margin-top: 18px;
      font-size: 44px;
      line-height: 1.15;
    }
  }
</style>
