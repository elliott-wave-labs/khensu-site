---
// Glass social credit cards: branded marks for Favorited, Instagram and YouTube;
// any other link uses the page’s meta share image as a circular avatar the same size.
export type SocialKind = 'favorited' | 'instagram' | 'youtube' | 'other';
export type SocialCredit = {
  href: string;
  /** Shown after “credit: ” */
  credit: string;
  kind?: SocialKind;
  /** Optional avatar for kind "other"; falls back to fallbackAvatar. */
  avatar?: string;
};

interface Props {
  items: SocialCredit[];
  /** Page og:image (or similar) used when a non-branded link has no avatar. */
  fallbackAvatar: string;
  class?: string;
}

const { items, fallbackAvatar, class: className } = Astro.props;

const kindOf = (item: SocialCredit): SocialKind => {
  if (item.kind) return item.kind;
  try {
    const h = new URL(item.href).hostname.replace(/^www\./, '');
    if (h === 'favorited.app' || h === 'favorited.com' || h.endsWith('.favorited.app')) return 'favorited';
    if (h === 'instagram.com' || h === 'instagr.am') return 'instagram';
    if (h === 'youtube.com' || h === 'youtu.be' || h === 'm.youtube.com') return 'youtube';
  } catch { /* keep other */ }
  return 'other';
};
---

<ul class:list={['soc', className]} role="list">
  {items.map((item) => {
    const kind = kindOf(item);
    const branded = kind !== 'other';
    const avatar = item.avatar || fallbackAvatar;
    return (
      <li>
        <a class="soc-card" href={item.href} rel="noopener noreferrer" target="_blank">
          <span class:list={['soc-mark', kind]} aria-hidden="true">
            {kind === 'instagram' && (
              <svg viewBox="0 0 24 24" width="18" height="18">
                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7" />
                <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7" />
                <circle cx="17.2" cy="6.8" r="1.15" fill="currentColor" />
              </svg>
            )}
            {kind === 'youtube' && (
              <svg viewBox="0 0 24 24" width="18" height="18">
                <rect x="2.5" y="6" width="19" height="12" rx="3.2" fill="currentColor" opacity="0.92" />
                <path d="M10.4 9.2v5.6L15.6 12z" fill="#0a0b0d" />
              </svg>
            )}
            {kind === 'favorited' && (
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path
                  d="M12 3.2 14.4 9l6.3.5-4.8 4.1 1.5 6.1L12 16.6 6.6 19.7l1.5-6.1L3.3 9.5 9.6 9z"
                  fill="currentColor"
                />
              </svg>
            )}
            {!branded && <img src={avatar} alt="" width="18" height="18" loading="lazy" decoding="async" />}
          </span>
          <span class="soc-txt"><span class="k">credit:</span> {item.credit}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .soc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .soc-card {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem 0.55rem 0.55rem;
    border-radius: 18px;
    text-decoration: none;
    color: #fff;
    background: rgba(28, 28, 34, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 12px 28px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .soc-card:hover {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(36, 36, 44, 0.72);
    transform: translateY(-1px);
  }
  .soc-mark {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }
  .soc-mark.instagram {
    background: radial-gradient(circle at 30% 110%, #fccc63, #fbad50 20%, #e95950 45%, #cd486b 65%, #8a3ab9 90%);
    border-color: transparent;
  }
  .soc-mark.youtube {
    background: #ff1a1a;
    border-color: transparent;
    color: #fff;
  }
  .soc-mark.favorited {
    background: linear-gradient(135deg, #7c5cff, #ff4d9a);
    border-color: transparent;
  }
  .soc-mark.other img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .soc-txt {
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .soc-txt .k {
    color: rgba(255, 255, 255, 0.55);
    font-weight: 400;
  }
</style>
