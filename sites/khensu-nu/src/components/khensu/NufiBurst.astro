---
// Pledges as particles: a glowing pool bursts apart as the section scrolls, and every dot flies into place as a bar
// of pledges per day for the example campaign. The canvas runs only while on screen. Without JS or with reduced
// motion the finished chart shows as a static SVG and the section is normal height.
import { BACKERS, DAILY_MET, DAYS, total, usd } from '../../data/nufi-campaign';

interface Props { id?: string }
const { id } = Astro.props;

const peak = Math.max(...DAILY_MET);
const SW = 600;
const SH = 220;
const slot = SW / DAYS;
const sum = total(DAILY_MET);
const steps = [
  'Every pledge is shielded on the backer’s own device: amount, sender and reward choice, sealed.',
  'Pledges cross the network as same-size packets on the mixnet, among everyone else’s traffic.',
  'They land in the campaign’s escrow. The creator sees the totals, not who gave them.',
];
---

<section class="fb" id={id} aria-labelledby="nufi-burst-title" data-daily={JSON.stringify(DAILY_MET)}>
  <div class="fb-stick">
    <div class="wrap fb-copy">
      <p class="eyebrow">private by default</p>
      <h2 id="nufi-burst-title">Every pledge, sealed.<br /><em>One total, and no names.</em></h2>
      <ol class="fb-steps">
        {steps.map((s, i) => <li data-step={i}>{s}</li>)}
      </ol>
    </div>

    <canvas class="fb-canvas" aria-hidden="true"></canvas>

    <figure class="wrap fb-static">
      <svg viewBox={`0 0 ${SW} ${SH + 24}`} role="img" aria-label={`Example: pledges per day over a ${DAYS}-day campaign, ${usd(sum)} from ${BACKERS.toLocaleString('en-US')} backers, strongest on the first and last days.`}>
        {DAILY_MET.map((v, i) => {
          const h = (v / peak) * SH;
          return <rect x={(i * slot + slot * 0.19).toFixed(1)} y={(SH - h).toFixed(1)} width={(slot * 0.62).toFixed(1)} height={h.toFixed(1)} rx="2" />;
        })}
        <line x1="0" x2={SW} y1={SH + 0.5} y2={SH + 0.5} />
        <text x="0" y={SH + 18}>Day 1</text>
        <text x={SW} y={SH + 18} text-anchor="end">Day {DAYS}</text>
      </svg>
    </figure>

    <div class="wrap fb-total">
      <p><b>{usd(sum)}</b> pledged over {DAYS} days, from {BACKERS.toLocaleString('en-US')} backers <small>example</small></p>
      <p class="fb-none">Backer names on the creator’s screen: <b>none</b>.</p>
    </div>
  </div>
</section>

<script>
  type P = { sx: number; sy: number; bx: number; by: number; tx: number; ty: number; d: number; r: number; w: number };
  const sec = document.querySelector<HTMLElement>('.fb');
  // The pinned scene needs room for the heading, all three steps and the chart; phones get the static layout.
  const roomy = matchMedia('(min-width: 701px) and (min-height: 640px)').matches;
  if (sec && roomy && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const canvas = sec.querySelector<HTMLCanvasElement>('.fb-canvas')!;
    const ctx = canvas.getContext('2d')!;
    const daily: number[] = JSON.parse(sec.dataset.daily || '[]');
    const peak = Math.max(...daily);
    sec.classList.add('live');

    const copy = sec.querySelector<HTMLElement>('.fb-copy')!;
    const totalEl = sec.querySelector<HTMLElement>('.fb-total')!;
    let parts: P[] = [];
    let W = 0, H = 0, dpr = 1, dot = 2, cx = 0, cy = 0;
    let chart = { x: 0, y: 0, w: 0, h: 0 };
    let progress = 0;
    let visible = false;
    let raf = 0;

    let seed = 11;
    const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const layout = () => {
      const box = canvas.getBoundingClientRect();
      dpr = Math.min(2, devicePixelRatio || 1);
      W = box.width;
      H = box.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      const narrow = W < 700;
      const cw = Math.min(W - 40, 1100);
      const top = copy.getBoundingClientRect().bottom - box.top + (narrow ? 20 : 36);
      const bottom = totalEl.getBoundingClientRect().top - box.top - (narrow ? 18 : 28);
      chart = { x: (W - cw) / 2, y: top, w: cw, h: Math.max(80, bottom - top) };
      const slot = chart.w / daily.length;
      const barW = slot * 0.62;
      const cols = narrow ? 2 : 3;
      const pitch = barW / cols;
      dot = Math.max(0.9, pitch * 0.38);
      const rows = Math.floor(chart.h / pitch);
      const unit = peak / (rows * cols);
      cx = W / 2;
      cy = chart.y + chart.h * 0.5;
      const reach = Math.min(W, H) * 0.55;
      seed = 11;
      parts = [];
      daily.forEach((v, i) => {
        const n = Math.max(1, Math.round(v / unit));
        const x0 = chart.x + i * slot + (slot - barW) / 2 + pitch / 2;
        for (let k = 0; k < n; k++) {
          const a = rnd() * Math.PI * 2;
          const orb = Math.sqrt(rnd()) * 34;
          const far = reach * (0.35 + rnd() * 0.75);
          parts.push({
            sx: cx + Math.cos(a) * orb,
            sy: cy + Math.sin(a) * orb,
            bx: cx + Math.cos(a) * far * 1.4,
            by: cy + Math.sin(a) * far * 0.8,
            tx: x0 + (k % cols) * pitch,
            ty: chart.y + chart.h - pitch / 2 - Math.floor(k / cols) * pitch,
            d: rnd(),
            r: 0.6 + rnd() * 0.8,
            w: rnd() * Math.PI * 2,
          });
        }
      });
    };

    const measure = () => {
      const r = sec.getBoundingClientRect();
      progress = clamp(-r.top / Math.max(1, r.height - innerHeight));
      const step = progress < 0.3 ? 0 : progress < 0.62 ? 1 : 2;
      sec.dataset.step = String(step);
      sec.classList.toggle('settled', progress > 0.86);
    };

    const draw = (t: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      const a = ease(clamp((progress - 0.04) / 0.3));
      const settle = ease(clamp((progress - 0.62) / 0.24));
      // Axis appears as the bars form.
      ctx.globalAlpha = settle * 0.5;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(chart.x, chart.y + chart.h + 3, chart.w, 1);
      ctx.globalAlpha = 1;
      if (a < 1) {
        const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, 170);
        g.addColorStop(0, `rgba(191, 245, 228, ${0.42 * (1 - a)})`);
        g.addColorStop(1, 'rgba(94, 230, 192, 0)');
        ctx.fillStyle = g;
        ctx.fillRect(cx - 170, cy - 170, 340, 340);
      }
      const time = t / 1000;
      for (const p of parts) {
        const b = ease(clamp((progress - 0.34 - p.d * 0.2) / 0.36));
        const wob = (1 - b) * (3 + 5 * (1 - a));
        const x0 = p.sx + (p.bx - p.sx) * a + Math.cos(time * 1.3 + p.w) * wob;
        const y0 = p.sy + (p.by - p.sy) * a + Math.sin(time * 1.1 + p.w) * wob;
        const x = x0 + (p.tx - x0) * b;
        const y = y0 + (p.ty - y0) * b;
        const size = dot * (b > 0.98 ? 1 : (p.r + (1 - p.r) * b) * (0.55 + 0.45 * Math.max(a, b)));
        const glow = (1 - b) * 0.55;
        ctx.globalAlpha = 0.45 + 0.55 * Math.max(b, a * 0.6);
        ctx.fillStyle = b > 0.98 ? '#bff5e4' : glow > 0.3 ? '#e9fff8' : '#d6f7ec';
        ctx.beginPath();
        ctx.arc(x, y, size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = (t: number) => {
      draw(t);
      raf = visible ? requestAnimationFrame(loop) : 0;
    };
    const start = () => { if (!raf) raf = requestAnimationFrame(loop); };

    layout();
    measure();
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) { layout(); start(); }
    }).observe(sec);
    addEventListener('scroll', measure, { passive: true });
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { layout(); measure(); draw(performance.now()); }, 120); });
  }
</script>

<style>
  .fb {
    position: relative;
    background: #000;
    border-top: 1px solid var(--line);
  }
  .fb-stick {
    position: relative;
    padding: clamp(4rem, 9vw, 7.5rem) 0;
  }
  .fb-copy {
    position: relative;
    z-index: 1;
  }
  .fb h2 {
    font-size: clamp(2rem, 4.6vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    max-width: none;
  }
  .fb-steps {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 46rem;
    counter-reset: fb;
  }
  .fb-steps li {
    position: relative;
    padding-left: 2.2rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(0.98rem, 1.4vw, 1.12rem);
    line-height: 1.45;
    counter-increment: fb;
    transition: opacity 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.6s;
  }
  .fb-steps li::before {
    content: counter(fb, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .fb-canvas {
    display: none;
  }
  .fb-static {
    margin-top: 2.5rem;
    margin-bottom: 0;
  }
  .fb-static svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .fb-static rect {
    fill: #bff5e4;
    opacity: 0.85;
  }
  .fb-static line {
    stroke: rgba(255, 255, 255, 0.3);
  }
  .fb-static text {
    fill: var(--text-faint);
    font: 11px var(--font-mono);
  }
  .fb-total {
    position: relative;
    z-index: 1;
    margin-top: 1.4rem;
  }
  .fb-total p {
    margin: 0;
    color: var(--text-dim);
    max-width: none;
  }
  .fb-total p b {
    color: #fff;
    font-weight: 600;
  }
  .fb-total p:first-child b {
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    margin-right: 0.3rem;
  }
  .fb-total small {
    margin-left: 0.4rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .fb-none {
    margin-top: 0.3rem !important;
  }

  /* Scroll-driven version */
  .fb.live {
    height: 320vh;
  }
  .fb.live .fb-stick {
    position: sticky;
    top: 64px;
    height: calc(100svh - 64px);
    padding: clamp(5rem, 11vh, 7rem) 0 0;
    overflow: hidden;
  }
  .fb.live .fb-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fb.live .fb-static {
    display: none;
  }
  .fb.live .fb-steps li {
    opacity: 0.28;
  }
  .fb.live[data-step='0'] .fb-steps li[data-step='0'],
  .fb.live[data-step='1'] .fb-steps li[data-step='1'],
  .fb.live[data-step='2'] .fb-steps li[data-step='2'] {
    opacity: 1;
  }
  .fb.live .fb-total {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.4rem, 5vh, 3rem);
    margin: 0 auto;
    opacity: 0;
    translate: 0 16px;
    transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fb.live.settled .fb-total {
    opacity: 1;
    translate: 0 0;
  }
  @media (max-width: 700px) {
    .fb.live .fb-steps li:not([data-step]) {
      display: none;
    }
    .fb.live .fb-steps {
      gap: 0.4rem;
    }
    .fb.live .fb-steps li {
      font-size: 0.92rem;
    }
  }
</style>
