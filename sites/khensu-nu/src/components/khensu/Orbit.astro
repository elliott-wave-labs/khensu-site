---
// A node at sea on satellite internet: a live WebGL ocean at night, a low-orbit shell of satellites
// drifting past, and a dish on a sailboat that rides the swell, beaming up.
const sats = Array.from({ length: 14 }, (_, i) => i);
---

<div class="orbit">
  <canvas class="sea" aria-hidden="true"></canvas>
  <svg viewBox="0 0 800 460" role="img" aria-label="A sailboat with a satellite dish on a moonlit ocean, linked to a satellite passing overhead in low Earth orbit.">
    <defs>
      <linearGradient id="beam" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#f2f1ec" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#f2f1ec" stop-opacity="0.05"></stop>
      </linearGradient>
    </defs>

    <circle cx="400" cy="1380" r="1140" fill="none" stroke="var(--line-strong)" stroke-dasharray="3 7"></circle>

    <g class="sats">
      {sats.map((i) => (
        <g transform={`rotate(${-34 + i * 5.2} 400 1380)`}>
          <g transform="translate(400 240)">
            <rect x="-3" y="-3" width="6" height="6" fill="#c9ccd2"></rect>
            <rect x="-16" y="-1.2" width="10" height="2.4" fill="#6b7079"></rect>
            <rect x="6" y="-1.2" width="10" height="2.4" fill="#6b7079"></rect>
          </g>
        </g>
      ))}
    </g>

    <circle class="ping" cx="404" cy="252" r="8" fill="none" stroke="#f2f1ec"></circle>
    <g class="ride">
      <path class="beam" d="M437 362 L404 252" stroke="url(#beam)" stroke-width="2" fill="none"></path>
      <g class="boat">
        <path d="M396 304 V376" stroke="#c9ccd2" stroke-width="2"></path>
        <path d="M399 306 L399 372 L436 372 Z" fill="#c9ccd2" fill-opacity="0.9"></path>
        <path d="M393 312 L393 372 L364 372 Z" fill="#8f949c" fill-opacity="0.85"></path>
        <path d="M352 376 H448 L438 390 H364 Z" fill="#15171b" stroke="#3a3e46"></path>
        <path d="M437 376 V364" stroke="#c9ccd2" stroke-width="1.5"></path>
        <rect x="430" y="359" width="14" height="4" rx="1" transform="rotate(-18 437 361)" fill="#c9ccd2"></rect>
        <circle class="node" cx="378" cy="383" r="2.6" fill="#f2f1ec"></circle>
      </g>
    </g>
  </svg>
</div>

<script>
  const VERT = `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`;

  // Swell is shared with the boat below, so the hull rides the same water the shader draws.
  const FRAG = `
precision highp float;
uniform vec2 res;
uniform float t;

const float CAM_Y = 1.6;
const float FOCAL = 1.4;
const float HORIZON = -0.2;

float swell(vec2 p) {
  return 0.22 * sin(dot(p, vec2(0.6, 0.8)) * 0.9 + t * 1.1)
       + 0.14 * sin(dot(p, vec2(-0.7, 0.7)) * 1.3 + t * 1.4)
       + 0.09 * sin(dot(p, vec2(0.95, -0.3)) * 1.9 + t * 1.8);
}

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
}

float height(vec2 p, int octaves) {
  float h = swell(p);
  float a = 0.09;
  vec2 q = p * 1.6;
  mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
  for (int i = 0; i < 5; i++) {
    if (i >= octaves) break;
    float fi = float(i);
    float n = noise(q + vec2(t * (0.5 + 0.25 * fi), t * 0.35));
    float m2 = noise(q * 1.1 - vec2(t * 0.4, t * (0.45 + 0.2 * fi)));
    float c = 1.0 - abs((n + m2) - 1.0);
    h += a * pow(c, 3.0);
    q = m * q;
    a *= 0.48;
  }
  return h;
}

const vec3 MOON = vec3(0.0, 0.16, 0.99);
const vec3 HAZE = vec3(0.105, 0.14, 0.2);
const vec3 ZENITH = vec3(0.035, 0.04, 0.05);

vec3 sky(vec3 d) {
  float y = max(d.y, 0.0);
  vec3 c = mix(HAZE, ZENITH, pow(y, 0.45));
  float m = max(dot(d, normalize(MOON)), 0.0);
  c += vec3(0.95, 0.94, 0.9) * (pow(m, 900.0) * 3.0 + pow(m, 60.0) * 0.12 + pow(m, 8.0) * 0.03);
  return c;
}

void main() {
  vec2 uv = (gl_FragCoord.xy - 0.5 * res) / res.y;
  vec3 ro = vec3(0.0, CAM_Y, 0.0);
  vec3 rd = normalize(vec3(uv.x, uv.y - HORIZON, FOCAL));

  if (rd.y >= -0.002) {
    float a = 1.0 - smoothstep(0.0, 0.32, rd.y);
    gl_FragColor = vec4(sky(rd) * a, a);
    return;
  }

  float d = (CAM_Y - 0.55) / -rd.y;
  for (int i = 0; i < 28; i++) {
    vec3 p = ro + rd * d;
    float h = p.y - height(p.xz, 3);
    if (abs(h) < 0.002 * d) break;
    d += h * 0.6;
  }
  vec3 p = ro + rd * d;
  int oct = d < 25.0 ? 5 : 3;
  float e = 0.004 + d * 0.0015;
  float hc = height(p.xz, oct);
  vec3 n = normalize(vec3(
    height(p.xz - vec2(e, 0.0), oct) - height(p.xz + vec2(e, 0.0), oct),
    2.0 * e,
    height(p.xz - vec2(0.0, e), oct) - height(p.xz + vec2(0.0, e), oct)));
  n = normalize(mix(n, vec3(0.0, 1.0, 0.0), smoothstep(10.0, 90.0, d)));

  vec3 r = reflect(rd, n);
  r.y = abs(r.y);
  float fres = 0.03 + 0.97 * pow(1.0 - max(dot(n, -rd), 0.0), 5.0);
  vec3 deep = vec3(0.008, 0.02, 0.035);
  vec3 body = deep + vec3(0.02, 0.07, 0.09) * pow(max(hc + 0.2, 0.0), 2.0) * max(dot(n, normalize(MOON)), 0.0);
  vec3 col = mix(body, sky(r), fres);

  float glitter = pow(max(dot(r, normalize(MOON)), 0.0), 1400.0) * 6.0;
  col += vec3(1.0, 0.98, 0.92) * glitter;

  col = mix(col, HAZE, 1.0 - exp(-d * 0.018));
  col = pow(col, vec3(0.92));
  gl_FragColor = vec4(col, 1.0);
}`;

  const CAM_Y = 1.6;
  const FOCAL = 1.4;
  const HORIZON = -0.2;
  const BOAT_Y = 385 / 460;

  function swell(x: number, z: number, t: number) {
    return (
      0.22 * Math.sin((x * 0.6 + z * 0.8) * 0.9 + t * 1.1) +
      0.14 * Math.sin((-x * 0.7 + z * 0.7) * 1.3 + t * 1.4) +
      0.09 * Math.sin((x * 0.95 - z * 0.3) * 1.9 + t * 1.8)
    );
  }

  function mount(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas.sea')!;
    const ride = root.querySelector<SVGGElement>('.ride')!;
    const gl = canvas.getContext('webgl', { premultipliedAlpha: true, antialias: false, alpha: true });
    if (!gl) return;

    const shader = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, shader(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, 'res');
    const uT = gl.getUniformLocation(prog, 't');
    root.classList.add('live');

    const boatUvY = (1 - BOAT_Y) - 0.5;
    const dirY = boatUvY - HORIZON;
    const boatZ = (CAM_Y / -dirY) * FOCAL;
    const unitsPerWorld = (FOCAL / boatZ) * 460;

    const resize = () => {
      const scale = Math.min(window.devicePixelRatio || 1, 1.5);
      const w = Math.round(canvas.clientWidth * scale);
      const h = Math.round(canvas.clientHeight * scale);
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    };

    const draw = (t: number) => {
      resize();
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uT, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      const h = swell(0, boatZ, t);
      const slope = (swell(0.6, boatZ, t) - swell(-0.6, boatZ, t)) / 1.2;
      const lift = -h * unitsPerWorld * 0.55;
      const tilt = Math.atan(slope) * 57.3 * 0.9;
      ride.setAttribute('transform', `translate(0 ${lift.toFixed(2)}) rotate(${tilt.toFixed(2)} 400 388)`);
    };

    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still) {
      draw(4);
      return;
    }

    let raf = 0;
    let visible = false;
    const t0 = performance.now();
    const loop = (now: number) => {
      draw((now - t0) / 1000);
      raf = requestAnimationFrame(loop);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible) raf = requestAnimationFrame(loop);
    }).observe(root);
    window.addEventListener('resize', () => visible || draw((performance.now() - t0) / 1000));
  }

  document.querySelectorAll<HTMLElement>('.orbit').forEach(mount);
</script>

<style>
  .orbit {
    position: relative;
    width: 100%;
    aspect-ratio: 800 / 460;
    border-radius: 28px;
    overflow: hidden;
  }
  .sea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    background: linear-gradient(to bottom, transparent 0 62%, #1a2230 70%, #070a10 100%);
  }
  .orbit.live .sea {
    background: none;
  }
  .orbit svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .sats {
    transform-origin: 400px 1380px;
    animation: drift 60s linear infinite;
  }
  @keyframes drift {
    from { rotate: -6deg; }
    to { rotate: 6deg; }
  }
  .beam {
    stroke-dasharray: 6 6;
    animation: flow 1.2s linear infinite;
  }
  @keyframes flow {
    to { stroke-dashoffset: -24; }
  }
  .ping {
    transform-origin: 404px 252px;
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    from { scale: 0.4; opacity: 0.9; }
    to { scale: 2.4; opacity: 0; }
  }
  .orbit:not(.live) .boat {
    transform-origin: 400px 388px;
    animation: rock 5s ease-in-out infinite;
  }
  @keyframes rock {
    0%, 100% { rotate: -2deg; translate: 0 0; }
    50% { rotate: 2deg; translate: 0 1.5px; }
  }
  .node {
    animation: blink 2s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0.25; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sats, .beam, .ping, .node, .boat {
      animation: none !important;
    }
  }
</style>
