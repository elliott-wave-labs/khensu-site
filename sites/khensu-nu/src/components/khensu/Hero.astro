---
// khėnsu.ñü hero: three app screens fan out from one phone as the page scrolls (--e from scenes.ts).
import AppScreen from './AppScreen.astro';
import Name from './Name.astro';
import Net from './Net.astro';

interface Props {
  eyebrow?: string;
  heading?: 'h1' | 'h2';
  cta?: boolean;
  links?: { href: string; label: string; badge?: string; icon?: 'apple' }[];
}
const {
  eyebrow = 'Flagship 00000000',
  heading = 'h1',
  cta = true,
  links = [
    { href: '/khensu', label: 'Explore khėnsu.ñü' },
    { href: 'https://khensu.nu', label: 'Visit khėnsu.ñü' },
  ],
} = Astro.props;
const H = heading;
---

<section class="k-hero khensu" data-scene="fan" aria-labelledby="k-hero-title">
  <div class="sticky">
    <div class="hero-video" aria-hidden="true">
      <video autoplay muted loop playsinline preload="auto" poster="/khensu/hero/earth.jpg">
        <source src="/khensu/hero/earth-720.mp4" type="video/mp4" media="(max-width: 820px)" />
        <source src="/khensu/hero/earth-1080.mp4" type="video/mp4" />
      </video>
    </div>
    <Net class="hero-net plain" nodes={80} />
    <div class="wrap head">
      <p class="eyebrow">
        {eyebrow.split('webË').map((part, i) => (
          <>
            {i > 0 && <span class="name-case">webË</span>}
            {part}
          </>
        ))}
      </p>
      <H id="k-hero-title" class="title"><Name /></H>
      <p class="tag">webË, private by design. <em>Post-quantum.</em><br /><em>Run profitably by the people.</em></p>
      {cta && (
        <div class="btn-row">
          {links.map((l, i) =>
            l.badge ? (
              <a class="store-badge" href={l.href}><img src={l.badge} alt={l.label} height="48" /></a>
            ) : (
              <a class:list={['btn', i === 0 && 'primary', l.icon && 'with-icon']} href={l.href}>
                {l.icon === 'apple' && (
                  <svg class="glass-apple" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <defs>
                      <linearGradient id="glass-apple-fill" x1="0" y1="0" x2="0.4" y2="1">
                        <stop offset="0" stop-color="#fff" stop-opacity="0.98" />
                        <stop offset="0.55" stop-color="#fff" stop-opacity="0.62" />
                        <stop offset="1" stop-color="#fff" stop-opacity="0.82" />
                      </linearGradient>
                      <linearGradient id="glass-apple-shine" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#fff" stop-opacity="0.9" />
                        <stop offset="0.45" stop-color="#fff" stop-opacity="0" />
                      </linearGradient>
                    </defs>
                    <path fill="url(#glass-apple-fill)" stroke="rgba(255,255,255,0.75)" stroke-width="0.35" d="M16.37 12.6c-.03-2.68 2.19-3.97 2.29-4.03-1.25-1.82-3.19-2.07-3.88-2.1-1.65-.17-3.22.97-4.06.97-.84 0-2.13-.95-3.5-.92-1.8.03-3.46 1.05-4.39 2.66-1.87 3.25-.48 8.05 1.34 10.69.89 1.29 1.95 2.74 3.34 2.69 1.34-.05 1.85-.87 3.47-.87 1.62 0 2.08.87 3.5.84 1.44-.02 2.36-1.31 3.24-2.61 1.02-1.5 1.44-2.95 1.47-3.02-.03-.01-2.81-1.08-2.82-4.3zM13.7 4.73c.74-.9 1.24-2.14 1.1-3.38-1.07.04-2.36.71-3.12 1.6-.68.79-1.28 2.06-1.12 3.27 1.19.09 2.4-.6 3.14-1.49z" />
                    <path fill="url(#glass-apple-shine)" d="M7.2 7.7c-1.4.3-2.6 1.3-3.2 2.7-.6 1.5-.5 3.3 0 5 .9-2.6 2.4-5.1 5.6-6.9-.8-.5-1.6-.9-2.4-.8z" />
                  </svg>
                )}
                {l.label}
              </a>
            ),
          )}
        </div>
      )}
    </div>
    <div class="fan" aria-hidden="true">
      <AppScreen screen="chats" class="ph left" />
      <AppScreen screen="feed" class="ph right" />
      <AppScreen screen="chat" class="ph mid" />
    </div>
  </div>
</section>

<style>
  .with-icon { display: inline-flex; align-items: center; gap: 0.45rem; }
  .glass-apple { margin-top: -2px; filter: drop-shadow(0 1px 1.5px rgba(0, 0, 0, 0.35)) drop-shadow(0 0 6px rgba(255, 255, 255, 0.35)); }

  .k-hero {
    --e: 1;
    position: relative;
    height: 210vh;
    background:
      radial-gradient(60% 50% at 50% 70%, rgba(242, 241, 236, 0.08), transparent 70%),
      var(--bg);
  }
  .sticky {
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    padding-top: clamp(1.5rem, 5vh, 3.5rem);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: calc(1 - var(--e) * 0.5);
  }
  .sticky {
    isolation: isolate;
  }
  .hero-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .hero-video::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 45% at 50% 28%, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 75%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 55%, var(--bg) 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video video { display: none; }
    .hero-video { background: url('/khensu/hero/earth.jpg') 50% 30% / cover; }
  }
  .head {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: calc(1 - var(--e) * 0.35);
    translate: 0 calc(var(--e) * -2vh);
  }
  .head .eyebrow {
    margin-bottom: 1rem;
  }
  .title {
    font-size: clamp(3.4rem, 10vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin: 0;
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .title :global(.tld) {
    font-weight: 300;
  }
  .tag {
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    color: var(--text-dim);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.85), 0 0 2px rgba(0, 0, 0, 0.6);
    margin: 0.8rem 0 0;
    max-width: none;
  }
  .head .btn-row {
    justify-content: center;
    margin-top: 1.4rem;
  }
  .fan {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: clamp(1.5rem, 4vh, 3rem);
    --phone-w: clamp(190px, min(21vw, 30vh), 290px);
  }
  .fan :global(.ph) {
    position: absolute;
    top: 0;
    transition: none;
  }
  .fan :global(.mid) {
    z-index: 2;
    translate: 0 calc((1 - var(--e)) * 6vh);
  }
  .fan :global(.left),
  .fan :global(.right) {
    --spread: calc(0.18 + var(--e) * 0.82);
    opacity: calc(0.35 + var(--e) * 0.65);
  }
  .fan :global(.left) {
    translate: calc(var(--spread) * -78%) calc(4vh + (1 - var(--e)) * 6vh);
    rotate: calc(var(--spread) * -7deg);
    scale: 0.92;
  }
  .fan :global(.right) {
    translate: calc(var(--spread) * 78%) calc(4vh + (1 - var(--e)) * 6vh);
    rotate: calc(var(--spread) * 7deg);
    scale: 0.92;
  }
  @media (max-width: 640px) {
    .k-hero {
      height: 170vh;
    }
    .fan {
      --phone-w: min(52vw, 30vh);
    }
  }
  /* Store badges: unmodified artwork, at least 40 px tall, with a quarter of their height clear around them. */
  .store-badge { display: inline-flex; align-items: center; margin: 12px; }
  .store-badge img { display: block; height: 48px; width: auto; }
</style>
