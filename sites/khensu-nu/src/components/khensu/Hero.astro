---
// khensu.nu hero: three app screens fan out from one phone as the page scrolls (--e from scenes.ts).
import AppScreen from './AppScreen.astro';
import Crescent from './Crescent.astro';

interface Props {
  eyebrow?: string;
  heading?: 'h1' | 'h2';
  cta?: boolean;
  links?: { href: string; label: string; badge?: string }[];
}
const {
  eyebrow = 'Flagship 00000000',
  heading = 'h1',
  cta = true,
  links = [
    { href: '/khensu', label: 'Explore khensu.nu' },
    { href: 'https://khensu.nu', label: 'Visit khensu.nu' },
  ],
} = Astro.props;
const H = heading;
---

<section class="k-hero khensu" data-scene="fan" aria-labelledby="k-hero-title">
  <div class="sticky">
    <div class="hero-video" aria-hidden="true">
      <video autoplay muted loop playsinline preload="auto" poster="/khensu/hero/earth.jpg">
        <source src="/khensu/hero/earth-720.mp4" type="video/mp4" media="(max-width: 820px)" />
        <source src="/khensu/hero/earth-1080.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="wrap head">
      <p class="eyebrow">
        {eyebrow.split('webË').map((part, i) => (
          <>
            {i > 0 && <span class="name-case">webË</span>}
            {part}
          </>
        ))}
      </p>
      <div class="mark"><Crescent size="100%" /></div>
      <H id="k-hero-title" class="title">khensu<span>.nu</span></H>
      <p class="tag">webË, private by design. <em>Post-quantum.</em><br /><em>Run profitably by the people.</em></p>
      {cta && (
        <div class="btn-row">
          {links.map((l, i) =>
            l.badge ? (
              <a class="store-badge" href={l.href}><img src={l.badge} alt={l.label} height="48" /></a>
            ) : (
              <a class:list={['btn', i === 0 && 'primary']} href={l.href}>{l.label}</a>
            ),
          )}
        </div>
      )}
    </div>
    <div class="fan" aria-hidden="true">
      <AppScreen screen="chats" class="ph left" />
      <AppScreen screen="feed" class="ph right" />
      <AppScreen screen="chat" class="ph mid" />
    </div>
  </div>
</section>

<style>
  .k-hero {
    --e: 1;
    position: relative;
    height: 210vh;
    background:
      radial-gradient(60% 50% at 50% 70%, rgba(242, 241, 236, 0.08), transparent 70%),
      var(--bg);
  }
  .sticky {
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    padding-top: clamp(1.5rem, 5vh, 3.5rem);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    opacity: calc(1 - var(--e) * 0.5);
  }
  .hero-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .hero-video::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 45% at 50% 28%, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 75%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 55%, var(--bg) 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video video { display: none; }
    .hero-video { background: url('/khensu/hero/earth.jpg') 50% 30% / cover; }
  }
  .head {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: calc(1 - var(--e) * 0.35);
    translate: 0 calc(var(--e) * -2vh);
  }
  .head .eyebrow {
    margin-bottom: 1rem;
  }
  .mark {
    width: clamp(2.6rem, 5vw, 3.6rem);
    aspect-ratio: 1;
    color: var(--khensu);
    margin-bottom: 0.6rem;
  }
  .title {
    font-size: clamp(3.4rem, 10vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin: 0;
    background: linear-gradient(180deg, #ffffff, #9aa0a9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .title span {
    font-weight: 300;
  }
  .tag {
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    color: var(--text-dim);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.85), 0 0 2px rgba(0, 0, 0, 0.6);
    margin: 0.8rem 0 0;
    max-width: none;
  }
  .head .btn-row {
    justify-content: center;
    margin-top: 1.4rem;
  }
  .fan {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: clamp(1.5rem, 4vh, 3rem);
    --phone-w: clamp(190px, min(21vw, 30vh), 290px);
  }
  .fan :global(.ph) {
    position: absolute;
    top: 0;
    transition: none;
  }
  .fan :global(.mid) {
    z-index: 2;
    translate: 0 calc((1 - var(--e)) * 6vh);
  }
  .fan :global(.left),
  .fan :global(.right) {
    --spread: calc(0.18 + var(--e) * 0.82);
    opacity: calc(0.35 + var(--e) * 0.65);
  }
  .fan :global(.left) {
    translate: calc(var(--spread) * -78%) calc(4vh + (1 - var(--e)) * 6vh);
    rotate: calc(var(--spread) * -7deg);
    scale: 0.92;
  }
  .fan :global(.right) {
    translate: calc(var(--spread) * 78%) calc(4vh + (1 - var(--e)) * 6vh);
    rotate: calc(var(--spread) * 7deg);
    scale: 0.92;
  }
  @media (max-width: 640px) {
    .k-hero {
      height: 170vh;
    }
    .fan {
      --phone-w: min(52vw, 30vh);
    }
  }
  /* Store badges: unmodified artwork, at least 40 px tall, with a quarter of their height clear around them. */
  .store-badge { display: inline-flex; align-items: center; margin: 12px; }
  .store-badge img { display: block; height: 48px; width: auto; }
</style>
