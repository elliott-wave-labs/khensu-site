---
// Creators hero: a creator's reel playing in an iPhone, with payments floating in at different depths as it scrolls.
import Phone from './Phone.astro';
import Net from '../khensu/Net.astro';
import StatStrip from '../khensu/StatStrip.astro';
const V = '/khensu/creators';
// Headline words, split here so each can rise in on its own and drift with scroll.
const lines = [
  { em: false, words: 'Your fans pay you.'.split(' ') },
  { em: true, words: 'You keep all of it.'.split(' ') },
];
let wi = 0;
const head = lines.map((l) => ({ ...l, words: l.words.map((w) => ({ w, i: wi++ })) }));
const stats = [
  { n: 0, unit: '%', label: 'platform cut on creator subscriptions, tickets and sales' },
  { n: 100, unit: '%', label: 'of every view and tip, gift or payment, to you' },
  { n: '0.42', pre: '$', label: 'minimum payout, paid out instantly' },
  { n: 10, pre: '$', label: 'per 1,000 plays, all of it to you' },
];
const floats = [
  { cls: 'f1', k: 'Tip', v: '+$20.00', s: '100% to you' },
  { cls: 'f2', k: 'New subscriber', v: '$4.99 a month', s: 'No platform cut' },
  { cls: 'f3', k: 'Paid out', v: 'Instantly', s: '42¢ minimum' },
  { cls: 'f4', k: 'Your work', v: 'All rights yours', s: 'No licence taken' },
];
---

<section class="crh" id="for-creators-section" data-hero data-par aria-labelledby="crh-title">
  <div class="crh-net"><Net coins nodes={110} /></div>
  <img class="crh-glow" src={`${V}/hero-4k.webp`} alt="" width="1080" height="1920" aria-hidden="true" fetchpriority="high" />
  <div class="wrap crh-grid">
    <div class="crh-copy">
      <p class="eyebrow">for creators</p>
      <h1 id="crh-title">
        {head.map((l, k) => (
          <>
            {l.em ? (
              <em>{l.words.map((x) => <><span class="w" style={`--i:${x.i}`}>{x.w}</span>{' '}</>)}</em>
            ) : (
              l.words.map((x) => <><span class="w" style={`--i:${x.i}`}>{x.w}</span>{' '}</>)
            )}
          </>
        ))}
      </h1>
      <StatStrip class="crh-stats" items={stats} />
      <p class="crh-lede">Paid straight to your wallet, and every right to your work stays yours, like nowhere else.</p>
      <div class="crh-cta">
        <a class="btn primary" href="#creator-pay-section">See what you keep</a>
        <a class="btn" href="#sounds-section">Hear Sounds</a>
      </div>
    </div>

    <div class="crh-stage">
      <div class="crh-phone">
        <Phone label="A creator’s reel playing in the khensu.ñü app, with Subscribe and Tip buttons">
          <div class="hwipe" data-wipe style="--x:50%">
            <video class="reel" src={`${V}/hero-4k.mp4`} poster={`${V}/hero-4k.webp`} muted loop playsinline autoplay preload="auto" data-loop width="1080" height="1920" aria-label="4K, upscaled from 720p by ñü.media on the Neural Engine, zoomed in 2×"></video>
            <video class="reel b" src={`${V}/hero-720.mp4`} poster={`${V}/hero-720.webp`} muted loop playsinline autoplay preload="auto" width="1080" height="1920" aria-label="The 720p original, zoomed in 2×"></video>
            <span class="hw-l l" aria-hidden="true"><b>720p</b>original</span>
            <span class="hw-l r" aria-hidden="true"><b>4K</b>ñü upscale</span>
            <span class="hw-bar" aria-hidden="true"><i></i></span>
            <label class="hw-range">
              <span class="sr">Compare the 720p original with the 4K ñü upscale, zoomed in 2×</span>
              <input type="range" min="0" max="100" value="50" step="1" />
            </label>
          </div>
          <div class="reel-ui" aria-hidden="true">
            <span class="reel-who"><i></i><b>you.khensu.nu</b><span class="tick"></span></span>
            <span class="reel-rail">
              <span class="rb"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg><small>18k</small></span>
              <span class="rb tip">$<small>Tip</small></span>
              <span class="rb"><svg viewBox="0 0 24 24"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8M5 12v8h14v-8" /></svg><small>Share</small></span>
            </span>
            <span class="reel-sub">Subscribe · $4.99 a month</span>
          </div>
        </Phone>
      </div>
      {floats.map((f) => (
        <span class:list={['float', f.cls]} aria-hidden="true"><small>{f.k}</small><b>{f.v}</b><span>{f.s}</span></span>
      ))}
    </div>
  </div>
  <p class="wrap crh-credit">Video: @deemsterhotline on Instagram, used with thanks. The phone shows a 2× zoom of the 720p original and its 4K ñü.media upscale, made on the Neural Engine.</p>
</section>

<style>
  .crh {
    --v: 0;
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 6rem) 0 2rem;
    background: #000;
    min-height: min(100svh, 980px);
    display: grid;
    align-content: center;
  }
  .crh-net {
    position: absolute;
    inset: -10% 0;
    translate: 0 calc(var(--v) * 160px);
    opacity: calc(0.9 - max(var(--v), 0) * 0.6);
    --net-at: 62% 45%;
  }
  .crh-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 140%;
    height: 140%;
    object-fit: cover;
    translate: -50% calc(-50% + var(--v) * 120px);
    filter: blur(90px) saturate(1.5);
    opacity: 0.34;
    pointer-events: none;
    mask-image: radial-gradient(closest-side, #000 30%, transparent 100%);
  }
  .crh-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .crh-copy {
    position: relative;
    z-index: 2;
    translate: 0 calc(var(--v) * -60px);
  }
  .w {
    display: inline-block;
    translate: 0 calc(max(var(--v), 0) * var(--i) * -9px);
    opacity: calc(1 - max(var(--v), 0) * (0.4 + var(--i) * 0.12));
    animation: word-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.08s + var(--i) * 0.07s);
  }
  h1 em .w {
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes word-in {
    from { opacity: 0; transform: translateY(0.45em); filter: blur(8px); }
  }
  .crh-copy :global(.crh-stats) {
    margin: 0 0 1.4rem;
  }
  .crh-copy :global(.crh-stats ul) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.4rem;
  }
  .crh-copy :global(.crh-stats li) {
    padding-top: 0.8rem;
    gap: 0.25rem;
    animation-delay: calc(0.5s + var(--i) * 90ms);
  }
  .crh-copy :global(.crh-stats b) {
    font-size: clamp(1.7rem, 3.2vw, 2.7rem);
    font-weight: 700;
    white-space: nowrap;
  }
  .crh-copy :global(.crh-stats .unit) {
    font-size: 1em;
    font-weight: inherit;
    letter-spacing: inherit;
    color: inherit;
    margin-left: -0.18em;
  }
  .crh-copy :global(.crh-stats .cap) {
    font-size: 0.88rem;
    line-height: 1.35;
    max-width: 30ch;
  }
  .crh-copy :global(.crh-stats .kind) {
    color: #18e0c8;
  }
  @media (max-width: 520px) {
    .crh-copy :global(.crh-stats li:last-child b) { font-size: 1.45rem; }
  }
  h1 {
    font-size: clamp(2.8rem, 4.7vw, 4.8rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    margin-bottom: 1.6rem;
  }
  h1 em {
    background: none;
    color: inherit;
  }
  .crh-lede {
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.56);
    max-width: 30em;
  }
  .crh-lede strong {
    color: #fff;
    font-weight: 500;
  }
  .crh-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .crh-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 640px;
  }
  .crh-phone {
    --phone-w: min(330px, 74vw);
    translate: 0 calc(var(--v) * -30px);
    rotate: -4deg;
    filter: drop-shadow(0 40px 80px rgba(139, 123, 255, 0.25));
  }
  .reel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hwipe {
    --x: 50%;
    position: absolute;
    inset: 0;
    user-select: none;
  }
  .reel.b {
    clip-path: inset(0 calc(100% - var(--x)) 0 0);
  }
  .hw-l {
    position: absolute;
    top: 15cqw;
    z-index: 3;
    display: grid;
    padding: 1.4cqw 2.6cqw;
    border-radius: 3.6cqw;
    font-size: 2.8cqw;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.78);
    background: rgba(20, 20, 26, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
  }
  .hw-l b {
    font-size: 3.8cqw;
    color: #fff;
  }
  .hw-l.l { left: 4cqw; }
  .hw-l.r { right: 4cqw; text-align: right; }
  .hw-l.r b {
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hw-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    z-index: 3;
    width: 2px;
    margin-left: -1px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }
  .hw-bar i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11cqw;
    height: 11cqw;
    translate: -50% -50%;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .hw-bar i::before,
  .hw-bar i::after {
    content: '';
    position: absolute;
    top: 50%;
    margin-top: -1.2cqw;
    border: 1.2cqw solid transparent;
  }
  .hw-bar i::before { left: 1.6cqw; border-right-color: #fff; }
  .hw-bar i::after { right: 1.6cqw; border-left-color: #fff; }
  .hw-range {
    position: absolute;
    inset: 0;
    z-index: 4;
  }
  .hw-range input {
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .hwipe:has(input:focus-visible) .hw-bar i {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .reel-ui {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 32%);
  }
  .reel-who {
    position: absolute;
    left: 5cqw;
    bottom: 22cqw;
    display: flex;
    align-items: center;
    gap: 2cqw;
    font-size: 3.9cqw;
  }
  .reel-who i {
    width: 8cqw;
    height: 8cqw;
    border-radius: 50%;
    background: linear-gradient(135deg, #b9b0ff, #18e0c8);
    box-shadow: 0 0 0 0.6cqw rgba(255, 255, 255, 0.9);
  }
  .tick {
    width: 3.6cqw;
    height: 3.6cqw;
    border-radius: 50%;
    background: #8b7bff;
  }
  .reel-rail {
    position: absolute;
    right: 3.5cqw;
    bottom: 34cqw;
    display: grid;
    gap: 4cqw;
    justify-items: center;
  }
  .rb {
    display: grid;
    justify-items: center;
    gap: 0.6cqw;
    font-size: 6cqw;
    font-weight: 700;
  }
  .rb svg {
    width: 8cqw;
    height: 8cqw;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rb small {
    font-size: 2.7cqw;
    font-weight: 500;
  }
  .rb.tip {
    width: 11cqw;
    height: 11cqw;
    place-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    line-height: 1;
  }
  .rb.tip small {
    position: absolute;
    translate: 0 9.5cqw;
  }
  .reel-sub {
    position: absolute;
    left: 5cqw;
    right: 5cqw;
    bottom: 8cqw;
    display: grid;
    place-items: center;
    height: 10.5cqw;
    border-radius: 6cqw;
    font-weight: 600;
    font-size: 3.8cqw;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(16px) saturate(170%);
  }

  .float {
    --d: 1;
    position: absolute;
    z-index: 3;
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 1rem;
    min-width: 10.5rem;
    border-radius: 18px;
    background: rgba(28, 28, 34, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 20px 40px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    translate: 0 calc(var(--v) * var(--d) * -140px);
    animation: float-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.3s + var(--n, 0) * 0.15s);
  }
  .float small {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .float b {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .float span {
    font-size: 0.78rem;
    color: #b9b0ff;
  }
  .f1 { --d: 1.6; --n: 0; top: 12%; left: 0; }
  .f2 { --d: 0.9; --n: 1; top: 30%; right: -2%; }
  .f3 { --d: 2.1; --n: 2; bottom: 24%; left: -4%; }
  .f4 { --d: 1.2; --n: 3; bottom: 8%; right: 2%; }
  .f4 span { color: #18e0c8; }
  @keyframes float-in {
    from { opacity: 0; transform: translateY(24px) scale(0.96); }
  }
  .crh-credit {
    position: relative;
    margin-top: 1.5rem;
    max-width: none;
    font-size: 0.74rem;
    color: var(--text-faint);
  }

  @media (max-width: 860px) {
    .crh-grid { grid-template-columns: 1fr; }
    .crh-stage { min-height: 600px; }
    .float { min-width: 0; padding: 0.6rem 0.8rem; }
    .float b { font-size: 1rem; }
    .f1 { left: 0; }
    .f3 { left: 0; }
    .f2, .f4 { right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .float, .w { animation: none; }
  }
</style>
