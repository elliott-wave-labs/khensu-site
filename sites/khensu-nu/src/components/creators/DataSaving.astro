---
// Same reel, same data: H.264 against ñü.media at 351 kbit/s, a drag-to-compare wipe, and the measured quality
// ladder drawing itself in. Every figure is from src/data/iphone-ladder-reel.json (benchmark).
import run from '../../data/iphone-ladder-reel.json';
const V = '/khensu/creators';
type Pt = { actual_kbps: number; vmaf: number; dropped: number };
const codecs = (run as any).codecs as Record<string, { points: Pt[] }>;
const at = (run as any).tiles.rates['500'];
const nu = at['nu-media'];
const h264 = at['h264-hw'];
const hevc = at['hevc-hw'];
const r1 = (v: number) => Math.round(v);

// Video bitrate of the 720p source file from Instagram, measured with ffprobe.
const ORIGINAL_KBPS = 2438;
const less = Math.round((1 - nu.actual_kbps / ORIGINAL_KBPS) * 100);

const SERIES = [
  { k: 'nu-media', name: 'ñü.media', cls: 'nu' },
  { k: 'hevc-hw', name: 'HEVC, iPhone hardware', cls: 'hevc' },
  { k: 'h264-hw', name: 'H.264, iPhone hardware', cls: 'h264' },
  { k: 'av1-svt-rt', name: 'AV1, software on a Mac', cls: 'av1' },
];
const W = 720, H = 360, L = 58, R = 700, T = 16, B = 310;
const kmin = 40, kmax = 2400;
const x = (k: number) => L + ((Math.log(k) - Math.log(kmin)) / (Math.log(kmax) - Math.log(kmin))) * (R - L);
const y = (v: number) => B - (v / 100) * (B - T);
const lines = SERIES.map((s) => {
  const ps = [...codecs[s.k].points].sort((a, b) => a.actual_kbps - b.actual_kbps);
  const uniq = ps.filter((p, i) => !i || p.actual_kbps !== ps[i - 1].actual_kbps);
  return {
    ...s,
    d: uniq.map((p, i) => `${i ? 'L' : 'M'}${x(p.actual_kbps).toFixed(1)} ${y(p.vmaf).toFixed(1)}`).join(' '),
    dots: uniq.map((p) => ({ cx: x(p.actual_kbps), cy: y(p.vmaf) })),
  };
});
const ticks = [64, 125, 250, 500, 1000, 2000];
const tl = (k: number) => (k < 1000 ? `${k} kbit/s` : `${k / 1000} Mbit/s`);
const bars = [
  { name: 'ñü.media', v: nu.vmaf, cls: 'nu' },
  { name: 'HEVC', v: hevc.vmaf, cls: 'hevc' },
  { name: 'H.264', v: h264.vmaf, cls: 'h264' },
];
const chartLabel =
  'Quality (VMAF) against bitrate for the reel, measured: ' +
  lines.map((l) => `${l.name}: ` + codecs[l.k].points.map((p) => `${r1(p.actual_kbps)} kbit/s VMAF ${r1(p.vmaf)}`).join(', ')).join('; ') + '.';
---

<section class="ds" id="data-saving-section" aria-labelledby="ds-title">
  <div class="wrap">
    <div class="ds-head">
      <p class="eyebrow">ñü.media</p>
      <h2 id="ds-title">Same reel. Same data.<em>Nearly twice the picture.</em></h2>
      <p class="ds-lede">
        Both sides are sent at <strong>{r1(nu.actual_kbps)} kbit/s</strong>. Drag to compare H.264 with nu.media.
      </p>
    </div>

    <figure class="wipe" data-wipe style="--x:50%">
      <video class="wv a" src={`${V}/compare-nu.mp4`} poster={`${V}/compare-nu.webp`} muted loop playsinline preload="none" data-loop width="540" height="960" aria-label="ñü.media at 351 kbit/s"></video>
      <video class="wv b" src={`${V}/compare-h264.mp4`} poster={`${V}/compare-h264.webp`} muted loop playsinline preload="none" width="540" height="960" aria-label="H.264 at 351 kbit/s, 720p with no ñü upscaling"></video>
      <span class="wl l" aria-hidden="true"><b>H.264 · 720p</b><span>no ñü upscaling</span><span>{r1(h264.actual_kbps)} kbit/s · VMAF {r1(h264.vmaf)}</span></span>
      <span class="wl r" aria-hidden="true"><b>ñü.media</b>{r1(nu.actual_kbps)} kbit/s · VMAF {r1(nu.vmaf)}</span>
      <span class="wbar" aria-hidden="true"><i></i></span>
      <label class="wrange">
        <span class="sr">Compare H.264 and nu.media: move left to see more nu.media</span>
        <input type="range" min="0" max="100" value="50" step="1" />
      </label>
      <figcaption class="tag">benchmark</figcaption>
    </figure>

    <div class="ds-grid">
      <figure class="ds-card" data-scene="reveal">
        <figcaption><b>Quality at {r1(nu.actual_kbps)} kbit/s</b><span>VMAF, 0 to 100, against the original. Benchmark</span></figcaption>
        <ul class="qbars" role="list">
          {bars.map((b, i) => (
            <li class={b.cls} style={`--w:${b.v};--i:${i}`}>
              <span class="qn">{b.name}</span>
              <span class="qt"><span class="qf"></span></span>
              <b class="qv">{r1(b.v)}</b>
            </li>
          ))}
        </ul>
      </figure>
      <div class="ds-card big">
        <b class="ds-big" data-count data-to={less} data-suf="%">{less}%</b>
        <span>less data than the 720p original</span>
        <small>
          Instagram’s 720p file of this reel carries {(ORIGINAL_KBPS / 1000).toFixed(1)} Mbit/s of video. nu.media sends
          {r1(nu.actual_kbps)} kbit/s, and the fan’s device rebuilds the picture. Benchmark
        </small>
      </div>
    </div>

    <figure class="ds-card chart" data-scene="reveal">
      <figcaption><b>A sharper picture from less data</b><span>Higher means a sharper picture. Further left means less data sent. Each line is one way of sending the whole {Math.round((run as any).seconds)}-second reel from an iPhone Air, and nu.media’s is highest at almost every point. Benchmark</span></figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={chartLabel}>
        {[0, 25, 50, 75, 100].map((v) => (
          <g class="gy"><line x1={L} x2={R} y1={y(v)} y2={y(v)} /><text x={L - 8} y={y(v) + 4}>{v}</text></g>
        ))}
        {ticks.map((k) => (
          <g class="gx"><line x1={x(k)} x2={x(k)} y1={T} y2={B} /><text x={x(k)} y={B + 20}>{tl(k)}</text></g>
        ))}
        {lines.map((l, i) => (
          <g class:list={['ln', l.cls]} style={`--i:${i}`}>
            <path d={l.d} pathLength="1" />
            {l.dots.map((d, j) => <circle cx={d.cx} cy={d.cy} r="4" style={`--j:${j}`} />)}
          </g>
        ))}
        <text class="axis" x={(L + R) / 2} y={B + 44}>data sent per second</text>
        <text class="axis" transform={`translate(14 ${(T + B) / 2}) rotate(-90)`}>picture quality, 0 to 100</text>
      </svg>
      <ul class="key" role="list">
        {SERIES.map((s) => <li class={s.cls}><i></i>{s.name}</li>)}
      </ul>
      <p class="note">
        Measured 11 October 2026 with VMAF {(run as any).vmaf_model}. nu.media sends a smaller picture where that looks
        better and the receiving device rebuilds it; AV1 runs in software on a Mac, because iPhone has no AV1 encoder.
        Full results on the <a href="https://media.khensu.nu">nu.media</a> page. Source: @deemsterhotline on Instagram, used with thanks.
      </p>
    </figure>
  </div>
</section>

<style>
  .ds {
    padding: clamp(5rem, 11vw, 9rem) 0;
    background: #000;
    border-top: 1px solid var(--line);
  }
  .ds-head {
    text-align: center;
    display: grid;
    justify-items: center;
  }
  h2 {
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    font-weight: 600;
  }
  h2 em {
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
  }
  .ds-lede {
    color: rgba(255, 255, 255, 0.56);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
  }
  .ds-lede strong {
    color: #fff;
    font-weight: 500;
  }

  .wipe {
    --x: 50%;
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 9 / 16;
    margin: 2.5rem auto 0;
    border-radius: 28px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12), 0 40px 90px -30px rgba(139, 123, 255, 0.45);
    user-select: none;
  }
  .wv {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wv.b {
    clip-path: inset(0 calc(100% - var(--x)) 0 0);
  }
  .wl {
    position: absolute;
    top: 14px;
    z-index: 2;
    display: grid;
    gap: 0.05rem;
    padding: 0.45rem 0.75rem;
    border-radius: 14px;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(20, 20, 26, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    font-variant-numeric: tabular-nums;
  }
  .wl > span { display: block; }
  .wl b {
    font-size: 0.92rem;
    color: #fff;
  }
  .wl.l { left: 14px; }
  .wl.r { right: 14px; text-align: right; }
  .wl.r b { color: #c9c0ff; }
  .wbar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    z-index: 2;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }
  .wbar i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .wbar i::before,
  .wbar i::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    margin-top: -5px;
    border: 5px solid transparent;
  }
  .wbar i::before { left: 7px; border-right-color: #fff; }
  .wbar i::after { right: 7px; border-left-color: #fff; }
  .wrange {
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  .wrange input {
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .wipe:has(input:focus-visible) .wbar i {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .tag {
    position: absolute;
    left: 50%;
    bottom: 14px;
    z-index: 2;
    translate: -50% 0;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #18e0c8;
    background: rgba(0, 0, 0, 0.55);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .ds-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }
  .ds-card {
    margin: 0;
    padding: clamp(1.3rem, 3vw, 2rem);
    display: grid;
    gap: 1.2rem;
    align-content: start;
    border-radius: 26px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
  }
  .ds-card figcaption {
    display: grid;
    gap: 0.2rem;
  }
  .ds-card figcaption b {
    font-size: 1.2rem;
    font-weight: 500;
  }
  .ds-card figcaption span {
    color: var(--text-dim);
    font-size: 0.88rem;
  }
  .ds-card.big {
    align-content: end;
    gap: 0.4rem;
    background: radial-gradient(120% 100% at 0% 0%, rgba(24, 224, 200, 0.2), transparent 60%), rgba(255, 255, 255, 0.04);
  }
  .ds-big {
    font-size: clamp(4rem, 9vw, 7rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .ds-card.big span {
    font-size: 1.2rem;
    font-weight: 500;
  }
  .ds-card.big small {
    color: var(--text-faint);
    font-size: 0.78rem;
  }
  .qbars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .qbars li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) 2.6rem;
    align-items: center;
    gap: 0.9rem;
  }
  .qn {
    font-weight: 500;
  }
  .qt {
    height: 22px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .qf {
    display: block;
    height: 100%;
    width: calc(var(--w) * 1%);
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.32);
    transform-origin: left;
    transform: scaleX(clamp(0, calc((var(--e, 1) - var(--i) * 0.1) / 0.6), 1));
  }
  .qv {
    text-align: right;
    font-size: 1.4rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .qbars .nu .qf {
    background: linear-gradient(90deg, #8b7bff, #18e0c8);
    box-shadow: 0 0 18px rgba(24, 224, 200, 0.4);
  }
  .qbars .nu .qn,
  .qbars .nu .qv {
    color: #c9c0ff;
  }
  .qbars .hevc .qf { background: rgba(255, 255, 255, 0.45); }

  .chart {
    margin-top: 1rem;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .gy line,
  .gx line {
    stroke: rgba(255, 255, 255, 0.07);
  }
  .gy text,
  .gx text,
  .axis {
    fill: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-family: var(--font-mono);
  }
  .gy text { text-anchor: end; }
  .gx text,
  .axis { text-anchor: middle; }
  .ln path {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - clamp(0, (var(--e, 1) - var(--i) * 0.08) / 0.7, 1));
  }
  .ln circle {
    opacity: clamp(0, calc((var(--e, 1) - 0.3 - var(--j) * 0.08) / 0.2), 1);
  }
  .ln.nu path { stroke: #b9b0ff; stroke-width: 4; filter: drop-shadow(0 0 6px rgba(139, 123, 255, 0.8)); }
  .ln.nu circle { fill: #b9b0ff; }
  .ln.hevc path { stroke: rgba(255, 255, 255, 0.7); }
  .ln.hevc circle { fill: rgba(255, 255, 255, 0.7); }
  .ln.h264 path { stroke: rgba(255, 255, 255, 0.4); }
  .ln.h264 circle { fill: rgba(255, 255, 255, 0.4); }
  .ln.av1 path { stroke: #18e0c8; opacity: 0.75; }
  .ln.av1 circle { fill: #18e0c8; opacity: 0.75; }
  .key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .key li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .key i {
    width: 18px;
    height: 4px;
    border-radius: 2px;
  }
  .key .nu { color: #c9c0ff; }
  .key .nu i { background: #b9b0ff; }
  .key .hevc i { background: rgba(255, 255, 255, 0.7); }
  .key .h264 i { background: rgba(255, 255, 255, 0.4); }
  .key .av1 i { background: #18e0c8; }
  .note {
    margin: 0;
    max-width: none;
    font-size: 0.76rem;
    color: var(--text-faint);
  }
  .note a { color: var(--text-dim); }
  @media (max-width: 760px) {
    .ds-grid { grid-template-columns: 1fr; }
    .qbars li { grid-template-columns: 4.6rem minmax(0, 1fr) 2.2rem; }
  }
</style>
