---
import { PREVIEWS } from '../../data/og';
import { PATH_TO_PRODUCT } from '../../data/hosts';

// Mute-loop non-interactive preview player for unfurls / embeds:
// - Video has pointer-events: none (hit-test false), no controls, no fullscreen, no PiP, no download.
// - Tapping anywhere on the preview opens the target link immediately.
const raw = Astro.url.searchParams.get('src') || 'waves';
const slug = raw in PREVIEWS ? raw : 'waves';
const src = `/og/${slug}.mp4`;
const poster = `/og/${slug}.jpg`;
const pathKey = slug === 'home' ? '/' : slug === 'nufi' ? '/nufi' : `/${slug}`;
const targetHref = Astro.url.searchParams.get('href') || PATH_TO_PRODUCT[pathKey] || `https://khensu.nu${pathKey === '/' ? '/' : pathKey}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>khėnsu.ñü preview</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #0a0b0d;
        overflow: hidden;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
      }
      .preview-hit {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        cursor: pointer;
        text-decoration: none;
      }
      video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        background: #0a0b0d;
        pointer-events: none;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
      }
    </style>
  </head>
  <body oncontextmenu="return false">
    <a class="preview-hit" href={targetHref} target="_top" rel="noopener" aria-label="Open link">
      <video
        src={src}
        poster={poster}
        muted
        autoplay
        loop
        playsinline
        webkit-playsinline
        disablepictureinpicture
        disableremoteplayback
        controlslist="nodownload nofullscreen noremoteplayback"
      ></video>
    </a>
  </body>
</html>
