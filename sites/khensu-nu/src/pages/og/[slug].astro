---
// A 1200 x 630 link-preview card; `tools/og.sh` screenshots every one to public/og/<slug>.jpg.
import Crescent from '../../components/khensu/Crescent.astro';
import { CARDS } from '../../data/og';
import '@fontsource/inter/300.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../../styles/global.css';

export function getStaticPaths() {
  return Object.keys(CARDS).map((slug) => ({ params: { slug } }));
}
const c = CARDS[Astro.params.slug as string];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{c.title}</title>
  </head>
  <body>
    <main class:list={['card', { product: c.product || c.screen }]} style={c.bg ? `--bg-img:url(${c.bg})` : undefined}>
      {c.product && <img class="shot" src={c.product} alt="" />}
      {c.screen && <img class="screen" src={c.screen} alt="" />}
      <div class="front">
        <p class="brand"><span class="mark"><img src="/seal.webp" alt="" /></span><span>khensu<span class="dot">.ñü</span></span></p>
        <h1>{c.title}{c.em && <em>{c.em}</em>}</h1>
        <p class="line">{c.line}</p>
      </div>
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    background: #000;
  }
  .card {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 64px 72px;
    box-sizing: border-box;
    color: #f2f1ec;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.45) 55%, rgba(0, 0, 0, 0.1) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%),
      var(--bg-img, radial-gradient(60% 70% at 75% 50%, rgba(139, 123, 255, 0.25), transparent 70%)) center / cover,
      #050507;
  }
  .shot {
    position: absolute;
    right: 40px;
    top: 56%;
    height: 540px;
    translate: 0 -50%;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.7));
  }
  .screen {
    position: absolute;
    right: 96px;
    top: 50%;
    height: 520px;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    translate: 0 -50%;
    border-radius: 44px;
    border: 10px solid #111;
    outline: 1.5px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.75);
  }
  .front {
    position: relative;
    max-width: 760px;
  }
  .product .front {
    max-width: 640px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 28px;
    font: 600 34px/1 Inter, sans-serif;
    letter-spacing: -0.03em;
  }
  .brand .mark {
    width: 48px;
    height: 48px;
    display: inline-block;
  }
  .brand .mark img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .brand .dot {
    font-weight: 300;
    opacity: 0.75;
  }
  h1 {
    margin: 0;
    font: 600 84px/1 Inter, sans-serif;
    letter-spacing: -0.045em;
  }
  h1 em {
    display: block;
    font-style: normal;
    font-weight: 300;
    color: rgba(242, 241, 236, 0.78);
    margin-top: 10px;
    font-size: 60px;
  }
  .line {
    margin: 24px 0 0;
    font: 300 30px/1.3 Inter, sans-serif;
    color: rgba(242, 241, 236, 0.8);
  }
  /* Square, 1080 x 1080, for Instagram link pages: product above, words below. */
  @media (aspect-ratio: 1 / 1) {
    .card {
      padding: 72px 80px 84px;
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.55) 38%, rgba(0, 0, 0, 0) 62%),
        var(--bg-img, radial-gradient(60% 70% at 50% 35%, rgba(139, 123, 255, 0.25), transparent 70%)) center / cover,
        #050507;
    }
    .shot {
      right: auto;
      left: 50%;
      top: 60px;
      height: 600px;
      translate: -50% 0;
    }
    .screen {
      right: auto;
      left: 50%;
      top: 56px;
      height: 560px;
      translate: -50% 0;
    }
    .front,
    .product .front {
      max-width: none;
    }
    h1 {
      font-size: 96px;
    }
    h1 em {
      font-size: 66px;
    }
    .line {
      font-size: 32px;
    }
  }
</style>
