---
// A 1200 x 630 link-preview card; `tools/og.sh` screenshots every one to public/og/<slug>.jpg.
import OgCard from '../../components/khensu/OgCard.astro';
import { CARDS } from '../../data/og';
import '@fontsource/inter/300.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '../../styles/global.css';

export function getStaticPaths() {
  return Object.keys(CARDS).map((slug) => ({ params: { slug } }));
}
const c = CARDS[Astro.params.slug as string];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{c.title}</title>
  </head>
  <body>
    <OgCard c={c} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    background: #000;
  }
</style>
