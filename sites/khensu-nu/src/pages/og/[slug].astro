---
// A 1200 x 630 link-preview card; `tools/og.sh` screenshots every one to public/og/<slug>.jpg.
import Crescent from '../../components/khensu/Crescent.astro';
import { CARDS } from '../../data/og';
import '@fontsource/inter/300.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../../styles/global.css';

export function getStaticPaths() {
  return Object.keys(CARDS).map((slug) => ({ params: { slug } }));
}
const c = CARDS[Astro.params.slug as string];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{c.title}</title>
  </head>
  <body>
    <main class:list={['card', { product: c.product }]} style={c.bg ? `--bg-img:url(${c.bg})` : undefined}>
      {c.product && <img class="shot" src={c.product} alt="" />}
      <div class="front">
        <p class="brand"><span class="mark"><Crescent size="100%" /></span><span>khensu<span class="dot">.ñü</span></span></p>
        <h1>{c.title}{c.em && <em>{c.em}</em>}</h1>
        <p class="line">{c.line}</p>
      </div>
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    background: #000;
  }
  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 64px 72px;
    box-sizing: border-box;
    color: #f2f1ec;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.45) 55%, rgba(0, 0, 0, 0.1) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%),
      var(--bg-img, radial-gradient(60% 70% at 75% 50%, rgba(139, 123, 255, 0.25), transparent 70%)) center / cover,
      #050507;
  }
  .shot {
    position: absolute;
    right: 40px;
    top: 56%;
    height: 540px;
    translate: 0 -50%;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.7));
  }
  .front {
    position: relative;
    max-width: 760px;
  }
  .product .front {
    max-width: 640px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 28px;
    font: 600 34px/1 Inter, sans-serif;
    letter-spacing: -0.03em;
  }
  .brand .mark {
    width: 40px;
    height: 40px;
    display: inline-block;
  }
  .brand .dot {
    font-weight: 300;
    opacity: 0.75;
  }
  h1 {
    margin: 0;
    font: 600 84px/1 Inter, sans-serif;
    letter-spacing: -0.045em;
  }
  h1 em {
    display: block;
    font-style: normal;
    font-weight: 300;
    color: rgba(242, 241, 236, 0.78);
    margin-top: 10px;
    font-size: 60px;
  }
  .line {
    margin: 24px 0 0;
    font: 300 30px/1.3 Inter, sans-serif;
    color: rgba(242, 241, 236, 0.8);
  }
</style>
