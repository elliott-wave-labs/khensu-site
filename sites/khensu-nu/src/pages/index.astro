---
import { APP_STORE_ID, APP_STORE_URL, GOOGLE_PLAY_ID, GOOGLE_PLAY_URL } from '../data/app';
import Base from '../layouts/Base.astro';
import Hero from '../components/khensu/Hero.astro';
import AppScreen from '../components/khensu/AppScreen.astro';
import Exploded from '../components/khensu/Exploded.astro';
import Finishes from '../components/khensu/Finishes.astro';
import SideView from '../components/khensu/SideView.astro';
import PatentNotice from '../components/khensu/PatentNotice.astro';
import Net from '../components/khensu/Net.astro';
import Orbit from '../components/khensu/Orbit.astro';
import Icon from '../components/khensu/Icon.astro';
import NuMedia from '../components/khensu/NuMedia.astro';
import Creators from '../components/khensu/Creators.astro';
import RingCode from '../components/khensu/RingCode.astro';
import Economics from '../components/khensu/Economics.astro';
import PerAnkh from '../components/khensu/PerAnkh.astro';

const highlights = [
  { icon: 'lock', title: 'Post-quantum, end to end', body: 'Every message, call and payment uses encryption built for the age of quantum computers. Not an option you switch on. The only way it works.' },
  { icon: 'shield', title: 'Full stealth mode, beyond a VPN', body: 'Not the network, not the people who run it, not someone watching the whole internet. Your phone looks the same whether you’re talking or not, and the relays carrying you keep switching, so none of them sees a whole conversation.' },
  { icon: 'feed', title: 'Feeds, forums and sites', body: 'Follow people, join forums, publish a site and stream live, on the same private network. Posters sign what they publish; readers stay anonymous.' },
  { icon: 'wallet', title: 'Pay privately', body: 'Send money in a chat with the amount hidden and no lasting record. The same payments keep the network running.' },
  { icon: 'sparkle', title: 'Private AI, only for you', body: 'Search, summaries and answers run on your own device. There are no AI nodes or servers for your data to leak to. We can’t sell your data because we don’t have it. Only you do.' },
  { icon: 'live', title: 'Runs on any connection', body: 'Fibre, cable, 5G, satellite. And where there’s no internet at all, nearby nodes reach each other directly.' },
] as const;

const screens = [
  { screen: 'chats', title: 'Chats', body: 'Liquid Glass, stock iOS 26 controls, folders and disappearing messages.' },
  { screen: 'chat', title: 'Conversation', body: 'Messages, voice, files and shielded payments in one thread.' },
  { screen: 'feed', title: 'Feed', body: 'People, forums, sites and live streams. Signed posts, anonymous readers.' },
  { screen: 'call', title: 'Calls', body: 'Post-quantum voice and video. The route changes as you talk.' },
  { screen: 'ask', title: 'Ask khensu', body: 'Local private AI for you alone: recall anything you’ve been told, with sources. No AI servers ever see it.' },
  { screen: 'wallet', title: 'Wallet and node', body: 'A private balance, and the node that carries traffic for people nearby.' },
] as const;

const statement = 'Every phone keeps the same quiet rhythm, all day. Typing, idle or asleep, it looks identical from outside. Even connecting looks like visiting an ordinary website.'.split(' ');

const specs = [
  { name: '14 hours', body: 'Relaying on a full charge of its own 14 Wh battery (estimate). When that runs out, it sips a little of your iPhone’s over the short cable in the box (iPhone 15 or later).' },
  { name: '25 min', body: 'To 50% over its own USB-C, full in about 75 (design targets). Or set it on any Qi2 charger. Your iPhone’s port stays open.' },
  { name: '+3 mm', body: 'Above the lens tops, below the camera, its top edge angled so no lens ever sees it.' },
  { name: '121 g', body: 'In titanium. Solid brass is about 148 g.' },
];

---

<Base>
  <Hero
    eyebrow="The first app on webË"
    links={[
      APP_STORE_ID
        ? { href: APP_STORE_URL, label: 'Download on the App Store', badge: '/badges/download-on-the-app-store-black.svg' }
        : { href: APP_STORE_URL, label: 'App Store · Coming soon' },
      ...(GOOGLE_PLAY_ID ? [{ href: GOOGLE_PLAY_URL, label: 'Get it on Google Play', badge: '/badges/get-it-on-google-play.png' }] : []),
      { href: '#run-a-node', label: 'Run a node' },
      { href: 'https://dev.khensu.nu', label: 'Developer docs' },
    ]}
  />

  <div class="khensu">
    <section class="section intro">
      <div class="wrap">
        <p class="eyebrow">The first app on <span class="name-case">webË</span></p>
        <h2 class="big">A messenger with no company in the middle. <em>Because there isn’t one.</em></h2>
        <p class="lede">
          khensu.nu runs on a network of small computers in people’s homes, not on a company’s servers. No one can read
          what you send, see who you send it to, or switch it off. It is the first app on webË, a people-run internet
          that sits on the one you already use.
        </p>
        <div class="btn-row">
          <a class="btn primary" href="#run-a-node">Run a node</a>
          <a class="btn" href="https://dev.khensu.nu">Developer docs</a>
        </div>
      </div>
    </section>

    <section class="section" id="highlights">
      <div class="wrap">
        <p class="eyebrow">Highlights</p>
        <ul class="highlights">
          {highlights.map((h) => (
            <li class="hl">
              <h3><Icon name={h.icon} size="1.35rem" /><span>{h.title}</span></h3>
              <p>{h.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section net-host webe-sec" id="webe" aria-labelledby="webe-title">
      <Net />
      <div class="wrap">
        <p class="eyebrow">The new internet</p>
        <h2 id="webe-title" class="webe-name"><span class="name-case">webË</span></h2>
        <p class="webe-sub">A new internet, alongside the one you use.</p>
        <p class="lede webe-lede">
          Same connection, same apps. Everything on it is post-quantum encrypted, hidden inside ordinary HTTPS and run
          by the people who use it. Stealth is always on.
        </p>
        <ul class="webe" role="list">
          <li><b>Alongside the internet</b><span>Works wherever the web does. Nothing to replace.</span></li>
          <li><b>Looks like HTTPS</b><span>Post-quantum inside: ML-KEM-1024 and ML-DSA-87.</span></li>
          <li><b>Always stealth</b><span>No setting, no visible mode. Nobody sees who reads what.</span></li>
          <li><b>Messages and calls</b><span>One to one and in large groups.</span></li>
          <li><b>Feeds and content</b><span>Posts, forums, videos, photos, reels and music.</span></li>
          <li><b>Sites and live</b><span>Publish at your-name.khensu.nu. Stream to a room or a crowd.</span></li>
          <li><b>Global social</b><span>Follow anyone in any country, translated on your phone. Posts keep spreading phone to phone when the internet is cut.</span></li>
          <li><b>Private AI and feeds</b><span>Summaries, search and your recommendations run only on your device. What you read and watch never leaves it.</span></li>
        </ul>
        <div class="btn-row webe-links">
          <a class="btn primary" href="https://dev.khensu.nu/webe">webË specification</a>
          <a class="btn" href="https://dev.khensu.nu/webe#build">Build an app on webË</a>
          <a class="btn" href="https://dev.khensu.nu/webe#extend">Extend khensu.nu</a>
        </div>
      </div>
    </section>

    <NuMedia />

    <section class="section" aria-labelledby="vpn-title">
      <div class="wrap">
        <p class="eyebrow">Replaces your VPN</p>
        <h2 id="vpn-title" class="big webe-title">Better than a VPN. Nothing to switch on.</h2>
        <p class="lede">
          A VPN moves your trust from your internet provider to one VPN company, which then sees your address and
          everything you open. On webË, nobody holds both.
        </p>
        <ul class="webe" role="list">
          <li><b>No one sees both ends</b><span>The first relay knows who you are but not what you open. The last knows what, not who. They’re run by different operators in different countries.</span></li>
          <li><b>Looks like a normal website</b><span>VPN protocols are easy to recognise and block. webË traffic is ordinary HTTPS.</span></li>
          <li><b>Hides when, not just where</b><span>A VPN still shows when and how much you use it. khensu.nu keeps the same rhythm all day.</span></li>
          <li><b>Nothing to log</b><span>“No logs” is a VPN’s promise. Relays never see your content or both ends, so there’s nothing to hand over.</span></li>
          <li><b>Post-quantum only</b><span>ML-KEM-1024 and ML-DSA-87, so traffic recorded today can’t be decrypted later.</span></li>
          <li><b>No off switch, no leaks</b><span>No kill switch needed: there is no unprotected mode to fall back to.</span></li>
        </ul>
        <p class="footnote">
          This covers everything on webË today: messages, calls, payments, feeds, forums, sites and live streams. For the
          rest of the internet, webË exit is planned: a VPN profile for iPhone, iPad and Mac that sends all your traffic
          through two relays from different operators, under the same rules.
        </p>
        <div class="btn-row webe-links">
          <a class="btn" href="https://dev.khensu.nu/webe#vpn">How it compares to a VPN</a>
        </div>
      </div>
    </section>

    <section class="section design" aria-labelledby="design-title">
      <div class="wrap">
        <p class="eyebrow">App design</p>
        <h2 id="design-title" class="big">Feels like iOS. <em>Because it is.</em></h2>
        <p class="lede">
          Built only from Apple’s own Liquid Glass controls on iOS, iPadOS and macOS 26, so it looks like it shipped
          with your iPhone. Scroll through the screens.
        </p>
      </div>
      <ul class="gallery" tabindex="0" aria-label="App screens">
        {screens.map((s) => (
          <li>
            <AppScreen screen={s.screen} label={`${s.title} screen`} />
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <RingCode />

    <PerAnkh />

    <section class="statement" data-scene="reveal" aria-label="Stealth by default">
      <div class="wrap">
        <p class="eyebrow">Stealth by default</p>
        <p class="words">
          {statement.map((w, i) => (
            <span style={`--i:${i};--n:${statement.length}`}>{w} </span>
          ))}
        </p>
        <div class="pulse" aria-hidden="true">
          {['Typing a message', 'Idle', 'Asleep in a pocket', 'Battery at 5%'].map((label) => (
            <div class="pulse-row">
              <span>{label}</span>
              <span class="track"></span>
            </div>
          ))}
        </div>
        <p class="lede switch">
          And it’s light on battery. Each beat is one small, fixed-size burst every 2 seconds while the app is open, so
          the cloak costs little power. It never slows down to save more: not in Low Power Mode, not at 5%. A phone that
          went quiet when its battery ran low would stand out, so the rhythm stays exactly the same however low it gets.
        </p>
        <p class="lede switch">
          And the path keeps changing. The relays carrying your messages, calls and streams switch at random while you
          use them, each on its own clock, so no relay and no one watching a few of them ever sees a whole conversation.
        </p>
        <p class="lede switch">
          And it keeps working in the background. Calls use Apple’s VoIP capabilities, PushKit and CallKit, so they ring
          on your lock screen and stay live when you switch apps, like any phone call. The VoIP itself runs on our own
          network, not a phone carrier’s: encrypted end to end over HTTP/3, the faster successor to secure WebSockets,
          and the same goes for live streams you’re in. New messages arrive
          through a wake-up that carries nothing, then one standard-size fetch. With a suñůlink.shield on your phone,
          the rhythm never stops at all: it’s a full node with its own battery.
        </p>
        <p class="footnote">There is no setting to turn this off. Privacy you can switch off is privacy someone can make you switch off.</p>
      </div>
    </section>

    <section class="section relays-sec net-host" data-scene="reveal" aria-labelledby="relays-title">
      <Net closeup nodes={170} class="behind" label="A close-up of the relay network: messages move along links, vanish and reappear on other links as relays switch." />
      <div class="wrap">
        <div class="relays-copy">
          <p class="eyebrow">10 billion → ∞</p>
          <h2 id="relays-title" class="big">Ten billion people a day. <em>And beyond.</em></h2>
          <p class="lede">
            khensu.nu is built to carry 10 billion people a day on about 6 million small computers, or 2 in every 100
            people running a node on ordinary home broadband. There is no central server to outgrow: every node that
            joins adds capacity, so the network keeps scaling past that without limit.
          </p>
          <p class="lede">
            A single <a href="https://www.raspberrypi.com/products/raspberry-pi-5/">Raspberry Pi 5</a> does its share.
            An old or unused phone does it even better, and more profitably: you already own it, so there’s nothing to
            buy and what it earns is yours from day one. Your laptop or desktop can run one too, in the background while you work, using 50% or less of its idle processing power.
          </p>
          <dl class="stats">
            <div><dt>10 billion</dt><dd>people a day, on about 6 million nodes, and it keeps scaling as more join</dd></div>
          </dl>
          <ul class="node-cards" role="list">
            <li>
              <p class="nc-kind">Old phone</p>
              <b class="nc-big">3,400</b><span class="nc-unit">people a day</span>
              <p>An iPhone 11 or later in node mode, plugged in on Wi-Fi. An iPhone 15 Pro sharing half of 2 Gbit fibre over Wi-Fi 6E. Nothing to buy.</p>
            </li>
            <li>
              <p class="nc-kind"><a href="https://www.raspberrypi.com/products/raspberry-pi-5/">Raspberry Pi 5</a></p>
              <b class="nc-big">1,700</b><span class="nc-unit">people a day</span>
              <p>Always on, sharing half of a gigabit fibre line, on about 5 kWh of power a month.</p>
            </li>
            <li>
              <p class="nc-kind">Idle computer</p>
              <b class="nc-big">1,700+</b><span class="nc-unit">people a day</span>
              <p>Your Mac or PC, in the background while you work, using 50% or less of its idle power. More on faster fibre.</p>
            </li>
            <li class="nc-best">
              <p class="nc-kind">suñůlink.shield <small>Best</small></p>
              <b class="nc-big">24/7</b><span class="nc-unit">wherever you go</span>
              <p>A full node on your phone with its own battery and a guard chip, so the rhythm never stops, even in your pocket. Its mesh radio carries the network where there’s no internet.</p>
              <a class="nc-link" href="/shield">Explore suñůlink.shield</a>
            </li>
          </ul>
          <p class="footnote">
            Engineering estimates from the protocol design: 1 hour of app use per person per day, about 2.5 Mbit/s of node
            capacity for each open phone at peak, each node sharing half its connection. Real capacity depends on
            connections and use, and is measured as the network grows. iPhone is a trademark of Apple Inc.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="pay-title">
      <div class="wrap">
        <p class="eyebrow">How it’s paid for</p>
        <h2 id="pay-title" class="big">No ads. No data sold. <em>No mining.</em></h2>
        <p class="lede">
          People who want more pay a small subscription, privately. That pays the people who run the network, in
          proportion to the work they can prove they did. Nobody pays for your attention, because nobody gets it.
        </p>
        <ol class="flow">
          <li>
            <span class="num">01</span>
            <h3>You pay for more, privately</h3>
            <p>Messaging is free. Bigger files and more storage come with a small subscription, through the App Store, the web or the token. What you pay is never linked to what you do.</p>
          </li>
          <li>
            <span class="num">02</span>
            <h3>Subscriptions fund the network</h3>
            <p>A fixed share of every subscription buys and burns the network’s token. The network pays out new tokens only for verified work, so more use means more income for operators.</p>
          </li>
          <li>
            <span class="num">03</span>
            <h3>Operators earn for real work</h3>
            <p>Forwarding, storing and serving, proven by receipts that can’t be linked to anyone. A Pi uses about as much power as a light bulb.</p>
          </li>
        </ol>
        <p class="footnote">Not an offer of securities or a promise of earnings. Pricing and token details are subject to legal review.</p>
      </div>
    </section>

    <Creators />

    <Economics />

    <section class="section space" aria-labelledby="space-title">
      <div class="wrap split rev">
        <Orbit />
        <div>
          <p class="eyebrow">Runs on any link</p>
          <h2 id="space-title" class="big">Works from anywhere. <em>Even an ET base.</em></h2>
          <p class="lede">
            A boat, a castle, a farm estate, the city or the slums, a private lab, a plane, a spaceship or an ET base.
            A node needs a connection and a power socket, nothing more. One on satellite internet, such as Starlink, is
            a full node: it relays, stores and earns like any other. Where there is no internet at all, nodes and suñůlink.shields
            within a kilometre or so reach each other directly and carry messages hop by hop.
          </p>
          <ul class="links">
            <li>Fibre and cable</li>
            <li>5G home internet</li>
            <li>Satellite internet</li>
            <li>Node-to-node mesh, no internet</li>
          </ul>
          <p class="footnote">Starlink is a trademark of SpaceX. Named only as an example of satellite internet; no affiliation or endorsement.</p>
        </div>
      </div>
    </section>

    <Exploded />
    <SideView />

    <Finishes />

    <section class="section">
      <div class="wrap">
        <p class="eyebrow">One suñůlink.shield</p>
        <ul class="styles">
          {specs.map((s) => (
            <li class="card">
              <h3>{s.name}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ul>
        <p class="footnote">One model for iPhone 18 Pro and Pro Max, coming to iPhone 18 when it arrives, in your iPhone’s colour, matte titanium or solid brass. Figures for iPhone 18 Pro from the current CAD model; production figures may change. Battery life at about 1 W of relaying; charge times are targets for a 20 W or larger USB-C PD charger. From your iPhone it takes at most 1 W, roughly 5–8% of the iPhone’s battery an hour. It clears every lens, flash and sensor, and every camera’s field of view.</p>
        <div class="btn-row">
          <a class="btn" href="https://dev.khensu.nu/shell">Full suñůlink.shield specifications</a>
        </div>
        <PatentNotice />
      </div>
    </section>

    <section class="section net-host" id="run-a-node">
      <Net />
      <div class="wrap cta">
        <h2>Run a node. <em>Be part of the network.</em></h2>
        <p class="lede">A Raspberry Pi 5, a Mac, or an old iPhone on Wi-Fi. Tell us you’re in and we’ll get you set up.</p>
        <div class="btn-row">
          <a class="btn primary" href="/buy">Buy suñůlink.shield</a>
          <a class="btn" href="mailto:hello@elliottwave.studio?subject=khensu.nu%20node">hello@elliottwave.studio</a>
          <a class="btn" href="https://dev.khensu.nu/node">Node guide</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/scenes.ts';
</script>

<style>
  /* One sentence per line: the emphasised second sentence always starts its own line. */
  .big {
    font-size: clamp(1.9rem, 3.8vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    max-width: none;
  }
  .big em,
  .cta h2 em {
    display: block;
  }
  .intro .big {
    font-size: clamp(1.8rem, 3.2vw, 3rem);
  }
  .split .big {
    font-size: clamp(1.8rem, 2.9vw, 2.7rem);
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
  }
  .hl {
    background: var(--bg-raised);
    padding: 2rem;
  }
  .hl h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    font-weight: 500;
    white-space: nowrap;
    font-size: clamp(1.05rem, 1.45vw, 1.3rem);
  }
  .hl h3 :global(svg) {
    flex: none;
  }
  .hl p {
    color: var(--text-dim);
    margin: 0;
    font-size: 0.95rem;
  }

  .gallery {
    list-style: none;
    margin: 3rem 0 0;
    padding: 1rem max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter))) 2rem;
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    scrollbar-width: thin;
    --phone-w: clamp(220px, 24vw, 280px);
  }
  .gallery li {
    scroll-snap-align: start;
    width: var(--phone-w);
    flex: none;
  }
  .gallery h3 {
    margin: 1.5rem 0 0.3rem;
    font-weight: 500;
  }
  .gallery p {
    color: var(--text-dim);
    font-size: 0.92rem;
    margin: 0;
  }

  .statement {
    --p: 1;
    padding: clamp(6rem, 16vw, 12rem) 0;
    border-top: 1px solid var(--line);
  }
  .words {
    font-size: clamp(1.9rem, 4.6vw, 3.6rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 500;
    max-width: 24ch;
    margin: 0 0 3rem;
  }
  .words span {
    opacity: clamp(0.14, calc(var(--p) * var(--n) * 1.25 - var(--i)), 1);
  }
  .pulse {
    display: grid;
    gap: 0.9rem;
    max-width: 760px;
    margin-bottom: 2rem;
  }
  .pulse-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .track {
    height: 28px;
    border-radius: 6px;
    background-color: var(--bg-raised);
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 52px,
      rgba(242, 241, 236, 0.85) 52px 55px,
      transparent 55px 58px,
      rgba(242, 241, 236, 0.85) 58px 61px,
      transparent 61px 64px,
      rgba(242, 241, 236, 0.85) 64px 67px,
      transparent 67px 70px,
      rgba(242, 241, 236, 0.85) 70px 73px,
      transparent 73px 120px
    );
    background-size: 120px 100%;
    animation: beat 2s linear infinite;
    border: 1px solid var(--line);
  }
  @keyframes beat {
    to { background-position: -120px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }
  @media (max-width: 560px) {
    .pulse-row { grid-template-columns: 1fr; gap: 0.3rem; }
  }

  .split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
  .stats {
    display: grid;
    gap: 1.4rem;
    margin: 2rem 0;
  }
  .stats dt {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(100deg, #9aa0a9, #ffffff 55%, #c9ccd2);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats dd {
    margin: 0.3rem 0 0;
    color: var(--text-dim);
  }

  .flow {
    list-style: none;
    margin: 3rem 0 2rem;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    counter-reset: f;
  }
  .flow li {
    position: relative;
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--bg-raised);
    border: 1px solid var(--line);
