---
import { APP_STORE_ID, APP_STORE_URL, GOOGLE_PLAY_ID, GOOGLE_PLAY_URL } from '../data/app';
import Base from '../layouts/Base.astro';
import Hero from '../components/khensu/Hero.astro';
import Sections from '../components/khensu/Sections.astro';
---

<Base>
  <Hero
    eyebrow="The first app on webË"
    links={[
      APP_STORE_ID
        ? { href: APP_STORE_URL, label: 'Download on the App Store', badge: '/badges/download-on-the-app-store-black.svg' }
        : { href: APP_STORE_URL, label: 'App Store' },
      ...(GOOGLE_PLAY_ID ? [{ href: GOOGLE_PLAY_URL, label: 'Get it on Google Play', badge: '/badges/get-it-on-google-play.png' }] : []),
      { href: '#run-a-node-section', label: 'Run a node' },
      { href: 'https://dev.khensu.nu', label: 'Developer docs' },
    ]}
  />

  <div class="khensu">
    <Sections show={['intro', 'highlights', 'creators', 'creatorpay', 'pay', 'economics', 'explore', 'numedia', 'perankh', 'cta', 'ringcode', 'design']} />
  </div>
</Base>
