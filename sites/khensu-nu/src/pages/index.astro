---
import { APP_STORE_ID, APP_STORE_URL, GOOGLE_PLAY_ID, GOOGLE_PLAY_URL } from '../data/app';
import Base from '../layouts/Base.astro';
import Hero from '../components/khensu/Hero.astro';
import Sections from '../components/khensu/Sections.astro';
import StatStrip from '../components/khensu/StatStrip.astro';
---

<Base>
  <Hero
    eyebrow="The first app on webË"
    links={[
      APP_STORE_ID
        ? { href: APP_STORE_URL, label: 'Download on the App Store', badge: '/badges/download-on-the-app-store-black.svg' }
        : { href: APP_STORE_URL, label: 'App Store', icon: 'apple' as const },
      ...(GOOGLE_PLAY_ID ? [{ href: GOOGLE_PLAY_URL, label: 'Get it on Google Play', badge: '/badges/get-it-on-google-play.png' }] : []),
      { href: '#run-a-node-section', label: 'Run a node' },
      { href: 'https://dev.khensu.nu', label: 'Developer docs' },
    ]}
  />

  <section class="home-stats" aria-label="khėnsu.ñü in numbers">
    <div class="wrap">
      <StatStrip
        items={[
          { n: 5, label: 'Mix network hops for every message' },
          { n: 0, label: 'Servers that read or process your data' },
          { n: 10, unit: '%', label: 'Flat app fee, the lowest in the industry' },
          { n: 100, unit: '%', label: 'Of every view and tip, gift or payment goes to the person' },
        ]}
      >
        ñü takes no commission on tips, gifts or views: every cent goes to the person. See the <a href="/network#network-economics">network economics</a> and <a href="/nufi">nufi</a>.
      </StatStrip>
    </div>
  </section>

  <div class="khensu">
    <Sections show={['intro', 'highlights', 'creators', 'creatorpay', 'pay', 'economics', 'explore', 'numedia', 'perankh', 'cta', 'ringcode', 'design']} />
  </div>
</Base>

<style>
  .home-stats {
    position: relative;
    z-index: 1;
    padding: clamp(1rem, 3vw, 2rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .home-stats :global(.stat-strip) {
    margin: 0;
  }
</style>
