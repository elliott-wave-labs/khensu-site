---
import Base from '../layouts/Base.astro';
import StatStrip from '../components/khensu/StatStrip.astro';
import { APP_STORE_ID, APP_STORE_URL } from '../data/app';

const GH = 'https://github.com/elliott-wave-labs/khensu-apple';
const INSTALL = `${GH}/blob/main/docs/INSTALL.md`;
const RELEASES = `${GH}/releases`;
---

<Base title="Get the apps" description="Install khėnsu.ñü and nu.waves from the App Store when listed, or build and sideload from GitHub.">
  {APP_STORE_ID && <meta http-equiv="refresh" content={`0; url=${APP_STORE_URL}`} slot="head" />}
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">install</p>
      <h1>khėnsu.ñü and nu.waves.<br />App Store when Apple lists them. GitHub either way.</h1>
      <StatStrip
        items={[
          { n: 2, label: 'Apps in one public repo: messenger and nu.waves' },
          { n: 0, label: 'Servers that process your data' },
          { n: 26, label: 'iOS, iPadOS or macOS version they need' },
        ]}
      />
      <p class="lede">
        Source is public under <a href="https://github.com/elliott-wave-labs">elliott-wave-labs</a>.
        If the App Store is empty or refuses a build, install from GitHub or run nu.waves in Safari.
      </p>
      <div class="btn-row">
        {APP_STORE_ID
          ? <a class="btn primary" href={APP_STORE_URL}>App Store</a>
          : <a class="btn primary" href={INSTALL}>Install from GitHub</a>}
        <a class="btn" href={RELEASES}>Releases / IPA</a>
        <a class="btn" href="https://waves.khensu.nu">nu.waves PWA</a>
        <a class="btn" href="https://dev.khensu.nu/repositories">All repositories</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head .lede {
    margin: clamp(1.6rem, 4vw, 2.4rem) 0 0;
  }
  .btn-row {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
</style>
