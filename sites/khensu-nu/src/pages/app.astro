---
import Base from '../layouts/Base.astro';
import { APP_STORE_ID, APP_STORE_URL } from '../data/app';
---

<Base title="khensu.ñü on the App Store" description="khensu.ñü for iPhone, iPad and Mac, on the App Store.">
  {APP_STORE_ID && <meta http-equiv="refresh" content={`0; url=${APP_STORE_URL}`} slot="head" />}
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">app store</p>
      <h1>khensu.ñü for iPhone, iPad and Mac.</h1>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <p>
        One app for iPhone, iPad and Mac. This page opens khensu.ñü on the App Store the moment Apple lists it, so it
        is safe to share.
      </p>
      <p>
        It needs iOS, iPadOS or macOS 26. Everything runs on your device: no iCloud, no Siri, no server-side
        processing of any kind.
      </p>
      <p><a class="btn primary" href="/webe#run-a-node-section">Run a node</a></p>
    </div>
  </section>
</Base>
