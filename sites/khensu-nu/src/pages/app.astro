---
import Base from '../layouts/Base.astro';
import StatStrip from '../components/khensu/StatStrip.astro';
import { APP_STORE_ID, APP_STORE_URL } from '../data/app';
---

<Base title="khėnsu.ñü on the App Store" description="khėnsu.ñü for iPhone, iPad and Mac, on the App Store.">
  {APP_STORE_ID && <meta http-equiv="refresh" content={`0; url=${APP_STORE_URL}`} slot="head" />}
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">app store</p>
      <h1>khėnsu.ñü for iPhone, iPad and Mac.<br />Everything runs on your device.</h1>
      <StatStrip
        items={[
          { n: 5, label: 'Mix network hops for every message' },
          { n: 2, unit: 's', label: 'One steady burst while the app is open, typing or not' },
          { n: 0, label: 'Servers that process your data: no iCloud, no Siri' },
          { n: 26, label: 'iOS, iPadOS or macOS, the version it needs' },
        ]}
      />
      <p class="lede">This page opens khėnsu.ñü on the App Store the moment Apple lists it, so it is safe to share.</p>
      <div class="btn-row"><a class="btn primary" href="https://webe.khensu.nu#run-a-node-section">Run a node</a></div>
    </div>
  </section>
</Base>

<style>
  .page-head .lede {
    margin: clamp(1.6rem, 4vw, 2.4rem) 0 0;
  }
  .btn-row {
    margin-top: 1.6rem;
  }
</style>
