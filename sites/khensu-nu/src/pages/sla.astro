---
import Base from '../layouts/Base.astro';
import StatStrip from '../components/khensu/StatStrip.astro';

const MAIL =
  'mailto:e@khensu.nu?subject=FounderCheckIn&body=khensu%20dead-man%20check-in%20alive%0A%0Asla.khensu.nu';
const SMS = 'sms:+13103514089&body=FounderCheckIn%20alive';
const SPECS = 'https://github.com/elliott-wave-labs/khensu-specs';
const PUBLIC_MD = `${SPECS}/blob/main/PUBLIC.md`;
const DMS = `${SPECS}/blob/main/DEAD-MANS-SWITCH.md`;
const ORG = 'https://github.com/elliott-wave-labs';
const APPLE = 'https://github.com/elliott-wave-labs/khensu-apple';
const RELEASES = `${APPLE}/releases`;
const INSTALL = `${APPLE}/blob/main/docs/INSTALL.md`;
const WAVES = 'https://waves.khensu.nu';
const APP = 'https://khensu.nu/app';

const ACTIVATED_LOCAL = '14 October 2026 · 2:22 pm PDT';
const ACTIVATED_UTC = '2026-10-14T21:22:00Z';
const PLACE = 'Venice, California';

const REPOS = [
  { name: 'khensu-specs', licence: 'CC BY 4.0', what: 'Plan, protocol, threat model, PUBLIC.md', href: `${ORG}/khensu-specs` },
  { name: 'khensu-core', licence: 'Apache-2.0', what: 'MLS, Outfox, UniFFI', href: `${ORG}/khensu-core` },
  { name: 'khensu-apple', licence: 'AGPL-3.0', what: 'nu.khensu.ptah, nu.khensu.waves', href: APPLE },
  { name: 'khensu-tatenan', licence: 'AGPL-3.0', what: 'Node for Mac and Pi 5', href: `${ORG}/khensu-tatenan` },
  { name: 'khensu-chain', licence: 'AGPL-3.0', what: 'Chain, token, shielded pool', href: `${ORG}/khensu-chain` },
  { name: 'khensu-services', licence: 'AGPL-3.0', what: 'KT log, credentials, push', href: `${ORG}/khensu-services` },
  { name: 'khensu-devnet', licence: 'AGPL-3.0', what: 'One-machine network', href: `${ORG}/khensu-devnet` },
  { name: 'khensu-site', licence: 'AGPL-3.0', what: 'Sites, including this one', href: `${ORG}/khensu-site` },
];
---

<Base
  title="SLA"
  description="khėnsu.ñü service level: 100% uptime. Dead-man's switch on. Public code. Install without Apple or Google stores."
>
  <div class="khensu">
    <section class="page-head" data-hero>
      <div class="wrap">
        <p class="eyebrow">sla.khensu.nu · nu:sla.khensu.nu</p>
        <h1>100% uptime.<br /><span class="dim">Code public. Install without stores.</span></h1>
        <StatStrip
          items={[
            { n: 100, unit: '%', label: 'Uptime — the promise' },
            { n: 7, unit: 'd', label: 'Keep-alive every week' },
            { n: 42, unit: 'd', label: 'Silence before notice fires' },
            { n: 0, label: 'Founder powers left' },
          ]}
        />
        <p class="lede">
          Activated {ACTIVATED_LOCAL} in {PLACE}.
          Dead-man's switch active. Every first-party repo is public.
        </p>
        <div class="btn-row">
          <a class="btn primary" href="#install">Install without stores</a>
          <a class="btn" href={ORG}>Open source on GitHub</a>
          <a class="btn" href="#check-in">Keep alive</a>
        </div>
      </div>
    </section>

    <section class="section band" id="uptime-section">
      <div class="wrap prose">
        <h2>100% uptime</h2>
        <p>
          The public site, the product hosts and the open archive stay up.
          Static pages on the edge, every <code>khensu-*</code> repository public, and a network designed so nobody holds a single off switch for the commons.
        </p>
        <p>
          The network is a gift: freedom, privacy and a basic income, so people everywhere can create, build and live securely.
        </p>
      </div>
    </section>

    <section class="section" id="code">
      <div class="wrap prose">
        <h2>Public code</h2>
        <p>
          All first-party work lives under <a href={ORG}>elliott-wave-labs</a>.
          Spec text: <a href={PUBLIC_MD}>PUBLIC.md</a>.
        </p>
        <ul class="repo-list">
          {REPOS.map((r) => (
            <li>
              <a href={r.href}><code>{r.name}</code></a>
              <span class="lic">{r.licence}</span>
              <span class="what">{r.what}</span>
            </li>
          ))}
        </ul>
        <div class="btn-row">
          <a class="btn primary" href={ORG}>Browse the org</a>
          <a class="btn" href={SPECS}>khensu-specs</a>
          <a class="btn" href={RELEASES}>Apple Releases (IPA)</a>
        </div>
      </div>
    </section>

    <section class="section band" id="install">
      <div class="wrap prose">
        <h2>Install without Apple or Google stores</h2>
        <p>
          The App Store and Play Store are optional. The web app, the IPA and the source stay on GitHub.
          Hub: <a href={APP}>khensu.nu/app</a> (<code>nu:get.apps.khensu.nu</code> once the host has SSL).
        </p>

        <h3>nu.waves in Safari (no install)</h3>
        <ol>
          <li>Open <a href={WAVES}>waves.khensu.nu</a> in Safari on iPhone or iPad.</li>
          <li>Share → <strong>Add to Home Screen</strong>.</li>
          <li>Play; drag sounds in the spacetime bubble. Nothing is processed on servers.</li>
        </ol>

        <h3>Sideload an IPA (iPhone)</h3>
        <ol>
          <li>On a Mac, install <a href="https://sideloadly.io/">Sideloadly</a> or <a href="https://altstore.io/">AltServer</a>.</li>
          <li>Download <code>nu.waves.ipa</code> from <a href={RELEASES}>khensu-apple Releases</a>.</li>
          <li>Plug in the unlocked iPhone and sideload with your Apple ID. Signing stays on your Mac.</li>
          <li>Free Apple IDs need a re-sign about every 7 days; a paid Developer account lasts a year for registered devices.</li>
        </ol>
        <p>
          Current release: <a href={`${RELEASES}/tag/waves-0.1.0`}>waves-0.1.0</a>.
        </p>

        <h3>Build from source (Xcode 26.2+)</h3>
        <pre class="code"><code>{`git clone https://github.com/elliott-wave-labs/khensu-apple.git
git clone https://github.com/elliott-wave-labs/khensu-core.git
cd khensu-apple
xcodegen generate
open Ptah.xcodeproj`}</code></pre>
        <p>
          Select scheme <strong>Waves</strong> (<code>nu.khensu.waves</code>) or <strong>Ptah</strong> (<code>nu.khensu.ptah</code>), your team, a device, Run.
          Full steps: <a href={INSTALL}>docs/INSTALL.md</a>.
        </p>

        <h3>Android / Google Play</h3>
        <p>
          No Play listing is required to listen. Use <a href={WAVES}>waves.khensu.nu</a> in Chrome; Add to Home screen for a PWA icon.
          Native Android builds ship from the same public org when the tree is ready — watch Releases.
        </p>
      </div>
    </section>

    <section class="section" id="deadman-section">
      <div class="wrap prose">
        <h2>Dead-man's switch</h2>
        <p>
          Fired and kept live from Venice. Code already open. Founder powers already ended.
          Weekly keep-alive proves someone is still attending the notice list; forty-two days of silence escalates the archive to the press, friends, Wikimedia and the Internet Archive.
        </p>
        <dl class="meta">
          <div>
            <dt>Activated</dt>
            <dd>{ACTIVATED_LOCAL}</dd>
          </div>
          <div>
            <dt>UTC</dt>
            <dd><code>{ACTIVATED_UTC}</code></dd>
          </div>
          <div>
            <dt>Place</dt>
            <dd>{PLACE}</dd>
          </div>
          <div>
            <dt>Record</dt>
            <dd><a href={DMS}>DEAD-MANS-SWITCH.md</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section band" id="check-in">
      <div class="wrap prose">
        <h2>Keep alive</h2>
        <p>Either channel resets the forty-two day clock. A check-in never restores founder powers.</p>
        <div class="btn-row">
          <a class="btn primary" href={MAIL}>Email → e@khensu.nu</a>
          <a class="btn" href={SMS}>Text → 310-351-4089</a>
        </div>
        <ul>
          <li>Subject <code>FounderCheckIn</code>, body includes <code>alive</code>.</li>
          <li>SMS: <code>FounderCheckIn alive</code>.</li>
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap prose">
        <h2>Live products</h2>
        <ul class="host-list">
          <li><a href="https://khensu.nu">khensu.nu</a> — home</li>
          <li><a href={WAVES}>waves.khensu.nu</a> — nu.waves</li>
          <li><a href="https://sla.khensu.nu">sla.khensu.nu</a> — this page</li>
          <li><a href="https://dev.khensu.nu">dev.khensu.nu</a> — specs</li>
          <li><a href="https://create.khensu.nu">create.khensu.nu</a> — nu.create</li>
          <li><a href="https://fi.khensu.nu">fi.khensu.nu</a> / <a href="https://bi.khensu.nu">bi.khensu.nu</a> — nu.Fi / nu.bi</li>
        </ul>
        <p>
          Address form: <code>nu:</code> plus the host — <code>nu:waves.khensu.nu</code>, <code>nu:sla.khensu.nu</code>.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-head .lede {
    margin: clamp(1.6rem, 4vw, 2.4rem) 0 0;
  }
  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.4rem, 3vw, 2rem);
  }
  .meta {
    display: grid;
    gap: 1rem;
    margin: 1.6rem 0 0;
  }
  @media (width >= 700px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .meta div {
    border-top: 1px solid var(--line-strong, #ffffff29);
    padding-top: 0.75rem;
  }
  .meta dt {
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint, #fff6);
    font-size: 0.7rem;
    margin: 0 0 0.35rem;
  }
  .meta dd {
    margin: 0;
    color: var(--text, #fff);
  }
  .repo-list,
  .host-list {
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 0;
    display: grid;
    gap: 0.85rem;
  }
  .repo-list li {
    display: grid;
    gap: 0.15rem;
    border-top: 1px solid var(--line-strong, #ffffff29);
    padding-top: 0.75rem;
  }
  .repo-list .lic {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint, #fff6);
  }
  .repo-list .what {
    color: var(--text-dim, #fffc);
    font-size: 0.92rem;
  }
  .code {
    overflow-x: auto;
    padding: 1rem 1.1rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font: 0.82rem/1.45 var(--font-mono);
  }
  .code code {
    white-space: pre;
  }
  #install h3 {
    margin-top: 1.75rem;
  }
</style>
