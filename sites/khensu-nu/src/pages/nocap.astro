---
// nocap.khensu.nu and postcap.khensu.nu both serve this page (no redirect between them). Every codec figure is
// computed here from the measured iPhone Air ladders in src/data (benchmark). Money and emissions figures are
// projections from those benchmarks and the inputs shown on the page.
import Base from '../layouts/Base.astro';
import StatStrip from '../components/khensu/StatStrip.astro';
import reel from '../data/iphone-ladder-reel.json';
import nasa from '../data/iphone-ladder-nasa4k.json';

type Pt = { actual_kbps: number; vmaf: number };
const curve = (run: any, k: string) => {
  const ps = [...(run.codecs[k].points as Pt[])].sort((a, b) => a.actual_kbps - b.actual_kbps || a.vmaf - b.vmaf);
  return ps.filter((p, i) => !i || (p.actual_kbps !== ps[i - 1].actual_kbps && p.vmaf > ps[i - 1].vmaf));
};
// Bitrate a codec needs for a VMAF score, interpolated on log bitrate between measured points.
const need = (ps: Pt[], v: number) => {
  for (let i = 1; i < ps.length; i++) {
    const a = ps[i - 1], b = ps[i];
    if (a.vmaf <= v && b.vmaf >= v) {
      const f = (v - a.vmaf) / (b.vmaf - a.vmaf);
      return Math.exp(Math.log(a.actual_kbps) + f * (Math.log(b.actual_kbps) - Math.log(a.actual_kbps)));
    }
  }
  return NaN;
};
const cut = (theirs: number, ours: number) => Math.round((1 - ours / theirs) * 100);

const REEL_V = 75, NASA_V = 57;
const tests = [
  { id: 'reel', title: '720p reel', sub: `Instagram reel, 720 × 1280, 30 fps · same picture: VMAF ${REEL_V}`, run: reel, v: REEL_V },
  { id: 'nasa', title: '4K aurora', sub: `NASA aurora from the ISS, 3840 × 2160, 30 fps · same picture: VMAF ${NASA_V}`, run: nasa, v: NASA_V },
].map((t) => {
  const h264 = need(curve(t.run, 'h264-hw'), t.v);
  const hevc = need(curve(t.run, 'hevc-hw'), t.v);
  const nu = need(curve(t.run, 'nu-media'), t.v);
  return { ...t, h264, hevc, nu, vsH264: cut(h264, nu), vsHevc: cut(hevc, nu), max: Math.max(h264, hevc, nu) };
});
const lo = Math.min(...tests.map((t) => t.vsH264));
const hi = Math.max(...tests.map((t) => t.vsH264));
const hevcLo = Math.min(...tests.map((t) => t.vsHevc));
const hevcHi = Math.max(...tests.map((t) => t.vsHevc));
const kb = (k: number) => (k < 1000 ? `${Math.round(k)} kbit/s` : `${(k / 1000).toFixed(2)} Mbit/s`);

// Rate–quality chart for the reel: log bitrate across, VMAF up.
const W = 640, H = 330, L = 46, R = 626, T = 14, B = 288, k0 = 60, k1 = 2100;
const x = (k: number) => L + ((Math.log(k) - Math.log(k0)) / (Math.log(k1) - Math.log(k0))) * (R - L);
const y = (v: number) => B - (v / 100) * (B - T);
const SERIES = [
  { k: 'nu-media', name: 'ñü.media', cls: 'nu' },
  { k: 'hevc-hw', name: 'HEVC, iPhone hardware', cls: 'hevc' },
  { k: 'h264-hw', name: 'H.264, iPhone hardware', cls: 'h264' },
].map((s) => {
  const ps = curve(reel, s.k).filter((p) => p.actual_kbps >= k0 && p.actual_kbps <= k1);
  return { ...s, ps, d: ps.map((p, i) => `${i ? 'L' : 'M'}${x(p.actual_kbps).toFixed(1)} ${y(p.vmaf).toFixed(1)}`).join(' ') };
});
const ticks = [125, 250, 500, 1000, 2000];
const reelT = tests[0];

const DEV = 'https://dev.khensu.nu';
---

<Base
  title="nocap: capitalism to postcap"
  description={`Free, open-source alpha. Measured on an iPhone Air: nu.media needs ${lo}–${hi}% fewer bits than H.264 for the same picture. Less data, less energy, lower emissions, faster services, and free MoQ on moqom.cloud.`}
  canonicalUrl="https://nocap.khensu.nu"
>
  <section class="page-head nc-head">
    <div class="wrap">
      <p class="eyebrow">nocap · capitalism to postcap · free, open-source alpha</p>
      <h1>Less data. Less energy.<br /><span class="dim">More left over for everyone.</span></h1>
      <StatStrip
        items={[
          { n: `${lo}–${hi}`, unit: '%', label: 'Fewer bits than H.264 for the same picture, measured on an iPhone Air' },
          { n: `${(1 / (1 - lo / 100)).toFixed(1)}–${(1 / (1 - hi / 100)).toFixed(1)}`, unit: '×', label: 'Viewers served on the same delivery bill' },
          { n: 0, label: 'Server-side AI calls: assistant and memory run on the device' },
          { n: '$0', label: 'Licence fee. Free and open source, alpha' },
        ]}
      />
      <p class="lede">
        Benchmarks are real: measured in Claude Opus 5.5 test runs on an iPhone Air (iPhone18,4) and a Mac with M1 Pro,
        scored with Netflix’s open VMAF. Everything else on this page is a projection from those benchmarks, with the
        inputs shown so you can change them.
      </p>
      <p class="nc-links">
        <a class="btn" href="#ai-emissions">AI datacenter emissions</a>
        <a class="btn" href="#business">What it means for a business</a>
        <a class="btn" href="#review">Review the code and docs</a>
      </p>
    </div>
  </section>

  <section class="section nc-ai" id="ai-emissions" aria-labelledby="ai-title">
    <div class="wrap">
      <p class="eyebrow">Greenhouse gas</p>
      <h2 id="ai-title" class="big">Cutting AI datacenter emissions <em>at the source.</em></h2>
      <p class="lede">
        The cheapest kilowatt-hour is the one a datacenter never draws. khėnsu.ñü moves work off the datacenter in three
        ways, and every one of them is in the alpha.
      </p>

      <figure class="flow" aria-label="Diagram: the usual path sends full-size media and every AI request through a datacenter; khensu sends a small base layer and runs AI on the device.">
        <svg viewBox="0 0 720 250" role="img">
          <g class="lane old">
            <text x="10" y="26" class="lt">Usual path</text>
            <rect x="10" y="40" width="130" height="56" rx="12" /><text x="75" y="73">Phone</text>
            <rect x="295" y="40" width="130" height="56" rx="12" class="dc" /><text x="360" y="66">Datacenter</text><text x="360" y="84" class="sm">AI + full video</text>
            <rect x="580" y="40" width="130" height="56" rx="12" /><text x="645" y="73">Viewer</text>
            <path d="M140 60 H295 M425 60 H580" class="fat" /><path d="M295 78 H140 M580 78 H425" class="fat" />
          </g>
          <g class="lane new">
            <text x="10" y="150" class="lt">khėnsu.ñü</text>
            <rect x="10" y="164" width="130" height="56" rx="12" class="dev" /><text x="75" y="190">Phone</text><text x="75" y="208" class="sm">AI on device</text>
            <rect x="295" y="164" width="130" height="56" rx="12" /><text x="360" y="190">Mixnet relay</text><text x="360" y="208" class="sm">forwards bits</text>
            <rect x="580" y="164" width="130" height="56" rx="12" class="dev" /><text x="645" y="190">Viewer</text><text x="645" y="208" class="sm">rebuilds the picture</text>
            <path d="M140 192 H295 M425 192 H580" class="thin" />
          </g>
        </svg>
        <figcaption>Thick lines: full-size media and AI requests through a datacenter. Thin line: the base layer only; the picture and the AI run on the devices at each end.</figcaption>
      </figure>

      <ol class="algos">
        <li>
          <b>Inference on the device.</b>
          <span>Ask khėnsu, nu.ral memory and the summaries run on the Neural Engine of the phone or Mac they serve. No
          Siri, no Private Cloud Compute, no server model, so a question costs a datacenter nothing.</span>
        </li>
        <li>
          <b>Send less, rebuild at the edge.</b>
          <span>ñü.media sends a small hardware-encoded base layer and the receiving device rebuilds the full picture.
          Datacenters, CDNs and networks carry {lo}–{hi}% fewer bits than H.264 for the same VMAF.</span>
        </li>
        <li>
          <b>Hardware media engines, not GPU software.</b>
          <span>The base layer is the phone’s own HEVC encoder, in real time. Measured on the iPhone Air, it matches
          real-time AV1 software at 720p and beats it at 4K, without a GPU in a rack doing the encode.</span>
        </li>
      </ol>

      <div class="co2" id="co2">
        <div class="co2-in">
          <label>Video you deliver a month <span><input type="number" min="0" step="1" value="1000" data-k="tb" /> TB</span></label>
          <label>Energy per GB delivered <span><input type="number" min="0" step="0.001" value="0.03" data-k="kwh" /> kWh</span></label>
          <label>Grid intensity <span><input type="number" min="0" step="1" value="400" data-k="g" /> g CO₂e per kWh</span></label>
          <label>Bits saved <span><input type="range" min={lo} max={hi} value={lo} data-k="cut" /> <output data-o="cut">{lo}%</output></span></label>
        </div>
        <div class="co2-out" aria-live="polite">
          <p><b data-o="mwh">—</b><span>MWh a year not drawn</span></p>
          <p><b data-o="t">—</b><span>tonnes CO₂e a year avoided</span></p>
        </div>
        <p class="note">Projection. Energy per GB for networks and datacenters varies tenfold between published studies, so set
        your own figure; the default is an example, not a measurement. Bits saved is the measured range against H.264.</p>
      </div>
    </div>
  </section>

  <section class="section nc-thanks" aria-labelledby="thanks-title">
    <div class="wrap">
      <p class="eyebrow">Thank you</p>
      <h2 id="thanks-title">Built with Claude Opus 5.5 and Sol Astra.</h2>
      <div class="thanks">
        <article>
          <h3>Anthropic · Claude Opus 5.5</h3>
          <p>
            Opus 5.5 wrote most of this code and ran every benchmark on this page, on real devices, and its numbers held
            up. Thank you to Anthropic and its founders, Dario Amodei, Daniela Amodei, Jared Kaplan, Sam McCandlish,
            Tom Brown, Chris Olah, Jack Clark and Ben Mann, for building a model careful enough to trust with the
            measurements.
          </p>
        </article>
        <article>
          <h3>Sol Astra</h3>
          <p>
            Sol Astra has been invaluable to this work alongside Opus. Thank you to the company and the founders who
            built it. Two very different minds made the work better than either alone.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="business" aria-labelledby="biz-title">
    <div class="wrap">
      <p class="eyebrow">Capitalism to postcap</p>
      <h2 id="biz-title" class="big">Same picture. <em>{lo}–{hi}% fewer bits.</em></h2>
      <p class="lede">
        Bits needed for the same VMAF score, measured on an iPhone Air with whole clips encoded over USB. Against
        HEVC the gain is {hevcLo}–{hevcHi}%; most services still ship H.264.
      </p>

      <div class="bars2">
        {tests.map((t) => (
          <figure class="bcard">
            <figcaption><b>{t.title}</b><span>{t.sub}</span></figcaption>
            <ul role="list">
              {[
                { n: 'H.264', v: t.h264, c: 'h264' },
                { n: 'HEVC', v: t.hevc, c: 'hevc' },
                { n: 'ñü.media', v: t.nu, c: 'nu' },
              ].map((b, i) => (
                <li class={b.c} style={`--w:${(b.v / t.max) * 100};--i:${i}`}>
                  <span class="bn">{b.n}</span>
                  <span class="bt"><span class="bf"></span></span>
                  <b>{kb(b.v)}</b>
                </li>
              ))}
            </ul>
            <p class="bsum"><b>{t.vsH264}%</b> fewer bits than H.264 · <b>{t.vsHevc}%</b> fewer than HEVC</p>
            <span class="tag">benchmark</span>
          </figure>
        ))}
      </div>

      <figure class="rq">
        <figcaption><b>Quality against bitrate, 720p reel</b><span>VMAF, 0 to 100, against the original. Higher and further left is better.</span></figcaption>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={'Rate–quality, measured: ' + SERIES.map((s) => `${s.name}: ` + s.ps.map((p) => `${Math.round(p.actual_kbps)} kbit/s VMAF ${Math.round(p.vmaf)}`).join(', ')).join('; ')}>
          {[0, 20, 40, 60, 80, 100].map((v) => (<g class="grid"><line x1={L} x2={R} y1={y(v)} y2={y(v)} /><text x={L - 8} y={y(v) + 4} text-anchor="end">{v}</text></g>))}
          {ticks.map((k) => (<g class="grid"><line x1={x(k)} x2={x(k)} y1={T} y2={B} /><text x={x(k)} y={B + 20} text-anchor="middle">{k < 1000 ? `${k}k` : `${k / 1000}M`}</text></g>))}
          <line class="vline" x1={L} x2={R} y1={y(reelT.v)} y2={y(reelT.v)} />
          {SERIES.map((s) => (
            <g class={`s ${s.cls}`}>
              <path d={s.d} pathLength="1" />
              {s.ps.map((p) => <circle cx={x(p.actual_kbps)} cy={y(p.vmaf)} r="4" />)}
            </g>
          ))}
        </svg>
        <ul class="key" role="list">{SERIES.map((s) => <li class={s.cls}><i></i>{s.name}</li>)}</ul>
        <span class="tag">benchmark</span>
      </figure>

      <div class="why">
        <article><h3>Lower bills</h3><p>CDN egress, transit and storage are priced by the byte. {lo}–{hi}% fewer bytes is {lo}–{hi}% off those lines, or {(1 / (1 - lo / 100)).toFixed(1)}–{(1 / (1 - hi / 100)).toFixed(1)}× the viewers on the same bill.</p></article>
        <article><h3>Faster services</h3><p>Fewer bits start sooner and stall less on the same connection, and the base layer encodes on the phone’s hardware in real time, so live video goes out without a transcoding farm.</p></article>
        <article><h3>Lower emissions</h3><p>Every byte not sent is energy not drawn in datacenters, networks and radios. Pair it with on-device AI and the whole session leans on the devices people already own.</p></article>
      </div>

      <div class="calc" id="calc">
        <h3>How much more could you keep?</h3>
        <div class="calc-in">
          <label>Monthly revenue <span>$<input type="number" min="0" step="1000" value="1000000" data-m="rev" /></span></label>
          <label>Video delivery, CDN and storage <span>$<input type="number" min="0" step="1000" value="250000" data-m="del" /></span></label>
          <label>Every other cost <span>$<input type="number" min="0" step="1000" value="450000" data-m="oth" /></span></label>
          <label>Bits saved <span><input type="range" min={lo} max={hi} value={lo} data-m="cut" /> <output data-mo="cut">{lo}%</output></span></label>
        </div>
        <div class="calc-out" aria-live="polite">
          <p><b data-mo="save">—</b><span>a month off delivery</span></p>
          <p><b data-mo="up">—</b><span>more profit</span></p>
        </div>
        <p class="note">Projection. With the example inputs, a delivery-heavy service keeps 30–40% more profit at the
        low end of the measured savings. Put in your own numbers; the only measured input is the bits saved.</p>
      </div>
    </div>
  </section>

  <section class="section nc-moq" aria-labelledby="moq-title">
    <div class="wrap">
      <p class="eyebrow">moqom.cloud</p>
      <h2 id="moq-title">Free MoQ, on Cloudflare’s MoQ relay beta.</h2>
      <p class="lede">
        <a href="https://moqom.cloud">moqom.cloud</a> gives you Media over QUIC for free, with open SDKs for Swift, Go
        and Rust, running on the MoQ relays Cloudflare made available in beta on 11 October 2026 and free during the
        beta. Ship ñü.media over MoQ and the savings above reach your viewers with sub-second latency.
      </p>
      <p class="nc-links">
        <a class="btn primary" href="https://moqom.cloud">Get free MoQ on moqom.cloud</a>
        <a class="btn" href="https://developers.cloudflare.com/moq/">Cloudflare MoQ docs</a>
      </p>
      <p class="note">moqom.cloud is an independent project, not affiliated with or endorsed by Cloudflare.</p>
    </div>
  </section>

  <section class="section" id="review" aria-labelledby="review-title">
    <div class="wrap">
      <p class="eyebrow">Review and assess</p>
      <h2 id="review-title">Check every number yourself.</h2>
      <p class="lede">This is an alpha. Read the design, rerun the benchmarks with public tools, and tell us what breaks.</p>
      <ul class="docs" role="list">
        <li><a href={`${DEV}/specs/nu-media`}><b>ñü.media design</b><span>The codec, the wire budget and the iPhone Air benchmarks (section 8)</span></a></li>
        <li><a href="https://khensu.nu/quality"><b>How we measure</b><span>VMAF, VMAF NEG, ColorVideoVDP, timing and the files with SHA-256 hashes</span></a></li>
        <li><a href={`${DEV}/repositories`}><b>Repositories</b><span>Every khėnsu.ñü repo, its licence and what it holds</span></a></li>
        <li><a href={`${DEV}/architecture`}><b>Architecture</b><span>Where AI, media and messages run, and what never touches a server</span></a></li>
        <li><a href="https://github.com/moqom-cloud/moqom-swift"><b>moqom-swift</b><span>Open-source MoQ client SDK</span></a></li>
        <li><a href={DEV}><b>Developer docs</b><span>Everything else: protocol, threat model, webË, node</span></a></li>
      </ul>
    </div>
  </section>

  <aside class="nc-note" data-nc-note aria-label="Note from Sol">
    <p>Elliott is showering since he's been up early and needs to get dinner with an old friend. Please stand by for further confirmation. In his brief lookever, he concurs.</p>
    <p class="sig">- Sol</p>
    <p class="ts">Requested: Wed 4 Nov 2026, 6:11 pm PST</p>
    <p class="ts">Posted: Wed 4 Nov 2026, 6:14 pm PST</p>
    <button type="button" class="x" aria-label="Close note" data-nc-close>×</button>
  </aside>
</Base>

<script is:inline>
  (() => {
    const num = (el) => Math.max(0, parseFloat(el.value) || 0);
    const fmt = (n, d = 0) => n.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: d });
    const co2 = document.getElementById('co2');
    if (co2) {
      const q = (k) => co2.querySelector(`[data-k="${k}"]`);
      const o = (k) => co2.querySelector(`[data-o="${k}"]`);
      const run = () => {
        const cut = num(q('cut')) / 100;
        const kwhYear = num(q('tb')) * 1000 * num(q('kwh')) * cut * 12;
        o('cut').textContent = `${Math.round(cut * 100)}%`;
        o('mwh').textContent = fmt(kwhYear / 1000, 0);
        o('t').textContent = fmt((kwhYear * num(q('g'))) / 1e6, 0);
      };
      co2.addEventListener('input', run);
      run();
    }
    const note = document.querySelector('[data-nc-note]');
    note?.querySelector('[data-nc-close]')?.addEventListener('click', () => {
      note.dataset.open = '0';
      setTimeout(() => note.remove(), 340);
    });
    const calc = document.getElementById('calc');
    if (calc) {
      const q = (k) => calc.querySelector(`[data-m="${k}"]`);
      const o = (k) => calc.querySelector(`[data-mo="${k}"]`);
      const run = () => {
        const cut = num(q('cut')) / 100;
        const save = num(q('del')) * cut;
        const profit = num(q('rev')) - num(q('del')) - num(q('oth'));
        o('cut').textContent = `${Math.round(cut * 100)}%`;
        o('save').textContent = `$${fmt(save)}`;
        o('up').textContent = profit > 0 ? `${fmt((save / profit) * 100)}%` : 'from a loss to ' + `$${fmt(profit + save)}`;
      };
      calc.addEventListener('input', run);
      run();
    }
  })();
</script>

<style>
  .dim { color: rgba(255, 255, 255, 0.55); }
  .page-head .lede { margin: clamp(1.4rem, 3.5vw, 2rem) 0 0; max-width: 60ch; }
  .nc-links { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
  .btn {
    display: inline-flex; align-items: center; padding: 0.55rem 1rem; border-radius: 999px;
    border: 1px solid var(--line); text-decoration: none; font-size: 0.9rem; color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }
  .btn.primary { background: var(--accent); color: var(--bg); border-color: transparent; }
  h2 em { font-style: normal; color: #7ee0c8; }
  .note { color: var(--text-faint, rgba(255, 255, 255, 0.45)); font-size: 0.82rem; max-width: 70ch; }
  .tag {
    position: absolute; top: 0.8rem; right: 0.9rem; font-size: 0.68rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7ee0c8; border: 1px solid rgba(126, 224, 200, 0.35);
    border-radius: 999px; padding: 0.1rem 0.5rem;
  }

  .nc-ai { background: radial-gradient(80% 60% at 20% 0%, rgba(126, 224, 200, 0.12), transparent 60%); }
  .flow { margin: 2rem 0; padding: 1rem; border: 1px solid var(--line); border-radius: 20px; background: rgba(255, 255, 255, 0.03); }
  .flow svg { width: 100%; height: auto; display: block; }
  .flow rect { fill: rgba(255, 255, 255, 0.05); stroke: rgba(255, 255, 255, 0.2); }
  .flow rect.dc { fill: rgba(240, 120, 100, 0.14); stroke: rgba(240, 120, 100, 0.6); }
  .flow rect.dev { fill: rgba(126, 224, 200, 0.12); stroke: rgba(126, 224, 200, 0.6); }
  .flow text { fill: var(--text); font-size: 15px; text-anchor: middle; font-family: var(--font-display); }
  .flow text.sm { font-size: 11.5px; fill: var(--text-dim); }
  .flow text.lt { text-anchor: start; font-size: 12px; fill: var(--text-dim); letter-spacing: 0.04em; }
  .flow path { fill: none; stroke-linecap: round; stroke-dasharray: 6 8; animation: dash 1.2s linear infinite; }
