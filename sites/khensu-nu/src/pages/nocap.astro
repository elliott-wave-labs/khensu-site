  @keyframes dash { to { stroke-dashoffset: -14; } }
  @media (prefers-reduced-motion: reduce) { .flow path { animation: none; } }

  .algos { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; padding: 0; list-style: none; counter-reset: a; }
  .algos li { counter-increment: a; padding: 1.2rem; border: 1px solid var(--line); border-radius: 18px; background: rgba(255, 255, 255, 0.03); }
  .algos li::before { content: counter(a); display: block; font-size: 2rem; font-weight: 300; color: #7ee0c8; }
  .algos b { display: block; margin-bottom: 0.35rem; }
  .algos span { color: var(--text-dim); font-size: 0.92rem; }

  .co2, .calc { margin-top: 2rem; padding: 1.4rem; border-radius: 20px; border: 1px solid rgba(126, 224, 200, 0.3); background: rgba(126, 224, 200, 0.05); display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.2rem 2rem; }
  .calc { border-color: var(--line); background: rgba(255, 255, 255, 0.03); }
