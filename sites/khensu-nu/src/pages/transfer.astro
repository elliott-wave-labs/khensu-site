---
import Base from '../layouts/Base.astro';
import BigFormats from '../components/khensu/BigFormats.astro';
import CodecPair from '../components/khensu/CodecPair.astro';
import formats from '../data/formats.json';
import lad4k from '../data/iphone-ladder-nasa4k.json';
import StatStrip from '../components/khensu/StatStrip.astro';

type Pt = { actual_kbps: number; vmaf: number; dropped: number };
const nu = [...(lad4k.codecs as Record<string, { points: Pt[] }>)['nu-media'].points].filter((p) => p.dropped === 0).sort((a, b) => b.vmaf - a.vmaf)[0];
const hq = formats.formats['prores-hq'];
const STREAM = 50; // Mbit/s, the same constant stream BigFormats assumes
const nuMinutes = (nu.actual_kbps * 3600) / 1000 / STREAM / 60;
---

<Base
  title="Send 4K privately, free"
  description="Send film and video at native resolution, end to end, without a server holding your files. Compared with Dropbox, IBM Aspera, ProRes and DNxHR."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Private transfer</p>
      <h1>Send 4K privately.<br />No server. No fee per gigabyte.</h1>
      <StatStrip
        items={[
          { n: Math.round(hq.kbps / nu.actual_kbps), unit: '×', label: 'Smaller than the ProRes 422 HQ master, as ñü.media', kind: 'benchmark' },
          { n: Math.round(nuMinutes), unit: 'min', label: `To send an hour of 4K at ${STREAM} Mbit/s`, kind: 'projection' },
          { n: 0, pre: '$', label: 'Per gigabyte, at any size' },
          { n: 0, label: 'People who can see who sent what to whom' },
        ]}
      >
        Benchmark on the same 4K NASA clip: nu.media at its best measured point, VMAF {Math.round(nu.vmaf)} on iPhone Air, against ProRes 422 HQ at VMAF {Math.round(hq.vmaf)}. Transfer time is a projection from the stream speed shown.
      </StatStrip>
      <p class="lede">End to end through your own devices and the network’s nodes, at the camera’s native resolution.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cards">
        <BigFormats formats={formats as any} ladder={lad4k as any} />
        <CodecPair run={lad4k as any} dir="ladder-4k" origin="NASA · 3840 × 2160 · 16 Mbit/s"
          srcKbps={16197} srcName="YouTube’s 4K stream" start={4000} title="See it for yourself"
          sub="Whole 4K frames, encoded on an iPhone Air. One side is always the original or nu.media." />
      </div>

      <div class="prose">
        <h2>How it compares</h2>
        <div class="table-scroll">
        <table>
          <thead><tr><th></th><th>khėnsu.ñü</th><th>Dropbox</th><th>IBM Aspera</th></tr></thead>
          <tbody>
            <tr><td>Who can open the file</td><td>Only the people you send it to</td><td>Dropbox holds the keys</td><td>The server operator, unless client-side encryption is set up</td></tr>
            <tr><td>Who sees sender and recipient</td><td>Nobody: it travels through the mix network</td><td>Dropbox</td><td>The server operator</td></tr>
            <tr><td>Where the file waits</td><td>Your own node, or encrypted chunks spread across nodes</td><td>Dropbox’s servers</td><td>Aspera or cloud storage servers</td></tr>
            <tr><td>Video size</td><td>nu.media at native resolution, or the exact original bytes</td><td>The original bytes</td><td>The original bytes</td></tr>
            <tr><td>Cost per gigabyte</td><td>Free</td><td>Plan limits</td><td>Paid</td></tr>
          </tbody>
        </table>
        </div>
        <p>
          Sending the exact same bytes is not faster than Aspera on a fast line; Aspera is built for line rate. khėnsu.ñü is faster
          when the video goes as nu.media instead of the editing master, because there is far less to send. Camera RAW isn’t supported:
          video travels at native resolution in nu.media, or bit-exact as the original file.
        </p>
        <p><a href="https://media.khensu.nu">Every measurement</a> · <a href="https://dev.khensu.nu/nu-media">Technical documentation</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head .lede {
    margin: clamp(1.6rem, 4vw, 2.4rem) 0 0;
  }
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .cards {
    display: grid;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .cards :global(.card) {
    margin: 0;
    padding: 1.6rem;
    display: grid;
    gap: 1.1rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
  }
  .cards :global(figcaption) {
    display: grid;
    gap: 0.2rem;
  }
  .cards :global(figcaption b) {
    font-size: 1.2rem;
    font-weight: 500;
  }
  .cards :global(figcaption span) {
    color: var(--text-dim);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.95rem;
  }
  th, td {
    text-align: left;
    padding: 0.7rem 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    vertical-align: top;
  }
  td:first-child {
    color: var(--text-dim);
  }
  td:nth-child(2) {
    color: #c9c0ff;
  }
</style>
