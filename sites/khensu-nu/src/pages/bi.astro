---
import Base from '../layouts/Base.astro';
import Burst from '../components/creators/Burst.astro';
import AnimatedBars from '../components/khensu/AnimatedBars.astro';

const DEV = 'https://dev.khensu.nu';
const CONTACT = 'mailto:hello@elliottwave.studio?subject=%C3%B1%C3%BC.bi%20%E2%80%94%20government%20enquiry';

const tiers = [
  { name: 'Pro', price: 4.99 },
  { name: 'Ultra', price: 200 },
  { name: 'Akashic', price: 1000 },
].map((t) => {
  const net = Math.round(t.price * 0.85 * 100) / 100;
  const founder = Math.floor((net / 2) * 100) / 100;
  return { ...t, network: Math.round((net - founder) * 100) / 100 };
});
const usd = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: Number.isInteger(n) ? 0 : 2, maximumFractionDigits: 2 })}`;

const stages = [
  {
    k: 'Stage one · at launch',
    t: 'Everyone who runs a node is paid.',
    b: 'A Mac, a Raspberry Pi 5 or a suñůlink.shield on an ordinary home connection becomes a node. It carries encrypted traffic, stores encrypted data and does proved work for the network while its owner gets on with life, and it is paid every epoch for that work in khensu.ñü coin, turned into USDC in Apple Pay the moment it lands.',
  },
  {
    k: 'Stage two · in research',
    t: 'Then every person gets an equal share.',
    b: 'A dividend paid equally to every unique person on the network, whether or not they run a node, funded from the network’s revenue. Each person counts once, proven without a name, a document number or a biometric scan. This is the universal part of ñü.bi, and it is not live yet.',
  },
];

const how = [
  { t: 'People subscribe', b: 'Pro, Ultra or Akashic, through the App Store. After Apple’s 15%, half of every subscription belongs to the network.' },
  { t: 'The network’s half becomes the pay pool', b: 'It funds that epoch’s pay pool, paid out in khensu.ñü coin at its dollar value through the shielded pool.' },
  { t: 'Nodes prove their work', b: 'Every job yields a work receipt: packets mixed, bytes stored and challenged, relay minutes, media delivered. Receipts are checked by the network; forged ones cost the node its pay and part of its stake.' },
  { t: 'The pool is shared by work', b: 'Each node receives the pool multiplied by its share of all verified work in the epoch. One worldwide rate per unit of work, with no cut taken in between.' },
  { t: 'Operators spend it', b: 'The coin turns into USDC in Apple Pay the moment it lands: keep it, send it, spend it or withdraw to a bank. Nobody else can see who was paid or how much.' },
];

const fair = [
  { t: 'One rate for the whole world', b: 'A node in Casablanca earns the same for the same work as a node in Berlin. Those dollars go about two and a half times further where living costs are lower, so the same node supports more of a living where it’s needed most.' },
  { t: 'No location tracking', b: 'Pay never depends on where a node is, so the network never needs to know. That keeps operators safe, and it can’t be gamed with a fake location.' },
  { t: 'Modest hardware', b: 'A Raspberry Pi 5 uses about 5 kWh a month. No mining, no special equipment and no wasted energy: every unit of work is something people actually use.' },
  { t: 'Paid for real work only', b: 'No pay for holding tokens, no pay for doing nothing, and no token sale. Money comes from subscriptions and delivery customers, not from new buyers.' },
];

const sources = [
  { t: 'Subscriptions', b: 'Half of every Pro, Ultra and Akashic subscription after Apple’s share, every month.', live: 'At launch' },
  { t: 'Media and web delivery', b: 'Creators, sites on webË and MOQOM Cloud customers pay for delivery; that money is paid to the nodes that deliver.', live: 'At launch, growing' },
  { t: 'Network fees', b: 'Private payments carry a fee under one cent, paid to the nodes that process them.', live: 'At launch' },
  { t: 'The dividend share', b: 'A fixed share of network revenue set aside for the stage-two dividend. The share is not decided yet.', live: 'In research' },
];

const safeguards = [
  { t: 'No registry of people', b: 'Personhood is proven once through a partner, then turned into an anonymous credential. The network learns that someone is a unique person, never who.' },
  { t: 'No biometrics', b: 'No iris scans, no face templates, no fingerprints held by anyone. Systems that collect them conflict with our threat model.' },
  { t: 'Private by construction', b: 'Payments are shielded and post-quantum. Node traffic looks the same whatever it carries, so nobody can tell who earns, who spends or what a node is doing.' },
  { t: 'It outlives its founder', b: 'If the founder stops checking in for 42 days, every founder power passes to the network’s consensus for good, and all code is released to the public.' },
];

const gov = [
  { t: 'Personhood credentials', b: 'Let a national digital ID or civil registry issue one-time, blind credentials to residents who opt in. The government confirms a real person; khensu.ñü never learns who. This unlocks the stage-two dividend for your residents.' },
  { t: 'Community nodes', b: 'Libraries, schools, clinics and municipal buildings already have fibre. A node there earns for its community, and strengthens private communication in the area at the same time.' },
  { t: 'Clear tax treatment', b: 'Node pay is income for work. Each operator’s app produces an annual earnings statement for their own tax filing, on their device. Guidance on how it is taxed helps operators comply.' },
  { t: 'Regulatory clarity', b: 'Pay arrives in khensu.ñü coin and turns straight into USDC, a regulated dollar stablecoin, redeemable one-for-one. Clear rules on receiving and spending stablecoin pay make it simpler for ordinary people to take part.' },
  { t: 'A measured pilot', b: 'Start with one city or region: subsidised hardware for households that want it, published measurements of earnings, costs and uptime from our test network, and an independent evaluation.' },
];

const status = [
  { what: 'Nodes paid for verified work, at one worldwide rate', s: 'Decided' },
  { what: 'Half of every subscription to the network, paid in khensu.ñü coin and turned into USDC on arrival', s: 'Decided' },
  { what: 'No pay by location; the network never knows where a node is', s: 'Decided' },
  { what: 'No platform cut on node work, hosting, creators’ views, gifts or sales', s: 'Decided' },
  { what: 'Founder powers pass to consensus on the dead-man’s switch', s: 'Decided' },
  { what: 'Stage-two dividend: funded from revenue, equal per unique person', s: 'Proposed' },
  { what: 'How personhood is proven without identity or biometrics', s: 'In research' },
  { what: 'The share of revenue set aside for the dividend', s: 'Open' },
  { what: 'Public income figures, reviewed with counsel', s: 'Open' },
];
const world = [
  { name: 'Living in inadequate housing', note: 'UN-Habitat, 2026', value: 3000, display: '3 billion+' },
  { name: 'Adults with no account', note: 'World Bank Findex, 2025', value: 1300, display: '1.3 billion' },
  { name: 'In slums and informal settlements', note: 'UN-Habitat, 2024', value: 1160, display: '1.16 billion' },
  { name: 'In extreme poverty', note: 'Under $3 a day · World Bank, 2024', value: 824, display: '824 million' },
  { name: 'Facing hunger', note: 'FAO and UN agencies, 2024', value: 673, display: '673 million' },
];
const worldSrc = [
  { name: 'UN-Habitat, SDG 11 Global Report 2026', url: 'https://unhabitat.org/sites/default/files/2026/07/2026_-_sdg11_key_facts_and_messages.pdf' },
  { name: 'World Bank, Global Findex 2025', url: 'https://www.worldbank.org/en/publication/globalfindex' },
  { name: 'World Bank, September 2026 global poverty update', url: 'https://blogs.worldbank.org/en/opendata/september-2026-global-poverty-update-from-the-world-bank--one-in' },
  { name: 'FAO, IFAD, UNICEF, WFP and WHO, SOFI 2025', url: 'https://www.fao.org/newsroom/detail/global-hunger-declines--but-rises-in-africa-and-western-asia--un-report/' },
];

const send = [
  { name: 'Through a bank', value: 29.98, display: '$29.98' },
  { name: 'World average', note: 'All providers', value: 12.72, display: '$12.72' },
  { name: 'Digital services', value: 9.18, display: '$9.18' },
  { name: 'Cheapest three per corridor', value: 6.58, display: '$6.58' },
  { name: 'UN goal for 2030', note: 'SDG target 10.c, under 3%', value: 6, display: 'under $6' },
  { name: 'khensu.ñü', note: 'Network fee, estimate', value: 0.01, display: 'under 1¢', ours: true },
];

const tried = [
  { where: 'Ireland', t: 'Basic Income for the Arts', b: '2,000 artists paid €325 a week in a randomised trial from 2022. Society got back €1.39 for every €1, and in 2026 it became an ongoing scheme.', url: 'https://www.gov.ie/en/department-of-culture-communications-and-sport/press-releases/basic-income-for-the-arts-pilot-produced-over-100-million-in-social-and-economic-benefits/' },
  { where: 'Wales', t: 'Basic income for care leavers', b: '£1,600 a month for two years from age 18. 97% of those eligible, 644 young people, took part; final results are due in 2027.', url: 'https://www.gov.wales/written-statement-basic-income-care-leavers-wales-pilot-evaluation-annual-report-2025-2026' },
  { where: 'Kenya', t: 'GiveDirectly’s 12-year study', b: 'Whole villages receive about $22.50 a month for twelve years, measured against villages that don’t. One of the longest basic income studies ever run.', url: 'https://www.givedirectly.org/ubi-study/' },
  { where: 'Finland', t: 'National experiment, 2017–2018', b: '2,000 unemployed people received €560 a month with no conditions. They were more satisfied with their lives, felt less mental strain, and worked slightly more.', url: 'https://valtioneuvosto.fi/en/-/1271139/perustulokokeilun-tulokset-tyollisyysvaikutukset-vahaisia-toimeentulo-ja-psyykkinen-terveys-koettiin-paremmaksi' },
  { where: 'Alaska', t: 'Permanent Fund Dividend', b: 'Every resident, every year, since 1982, paid from a shared fund. Proof that an equal dividend can last for generations.', url: 'https://pfd.alaska.gov/' },
];

const allies = [
  { who: 'United Nations', what: 'The Secretary-General told the General Assembly in 2018 that governments may eventually have to consider a universal basic income, and in 2020 called for a new generation of social protection, perhaps including one. Sustainable Development Goals 1, 2 and 11 aim to end poverty and hunger and house everyone by 2030.', url: 'https://basicincome.org/news/2018/09/un-secretary-general-endorses-ubi/' },
  { who: 'UNDP', what: 'Proposed a temporary basic income for 2.7 billion people in developing countries in 2020.', url: 'https://www.undp.org/sites/g/files/zskgke326/files/publications/Temporary%20Basic%20Income-V4.pdf' },
  { who: 'European Union', what: 'The European Pillar of Social Rights (2017) gives everyone without enough resources the right to an adequate minimum income, and the Council recommended in January 2023 that every member state provide one.', url: 'https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023H0203(01)' },
  { who: 'African Union, ASEAN, Mercosur, the G20 and others', what: 'Not yet approached. Every regional alliance is invited.', url: '' },
];

const thanks = [
  { y: '1960s', who: 'Paul Baran and Donald Davies', b: 'Packet switching: break messages into pieces and route them any way that works.' },
  { y: '1969', who: 'The ARPANET teams', b: 'The first packet network, from UCLA to Stanford, and the Request for Comments tradition.' },
  { y: '1974', who: 'Vint Cerf and Bob Kahn', b: 'TCP/IP, a network of networks that nobody owns.' },
  { y: '1976', who: 'Whitfield Diffie, Martin Hellman and Ralph Merkle', b: 'Public-key cryptography: strangers can agree a secret in the open.' },
  { y: '1981', who: 'David Chaum', b: 'Mix networks and private digital cash, the roots of how khensu.ñü hides who talks to whom.' },
  { y: '1983', who: 'Richard Stallman, and later Linus Torvalds', b: 'GNU and Linux, and the free software that runs almost every server and node.' },
  { y: '1989', who: 'Tim Berners-Lee and CERN', b: 'The World Wide Web, given to the world free in 1993.' },
  { y: '1991', who: 'Phil Zimmermann', b: 'PGP, private email for everyone, defended at personal risk.' },
  { y: '1996', who: 'Brewster Kahle and the Internet Archive', b: 'A memory for the web, so what we build is never lost.' },
  { y: '2001', who: 'Jimmy Wales, Larry Sanger and every Wikipedian', b: 'The sum of human knowledge, free, written by volunteers.' },
  { y: '2002', who: 'Roger Dingledine, Nick Mathewson and Paul Syverson', b: 'Tor, privacy for millions who need it most.' },
  { y: '2008', who: 'Satoshi Nakamoto', b: 'Money that moves between people with no bank in between.' },
  { y: '2013', who: 'Trevor Perrin and Moxie Marlinspike', b: 'The Signal protocol, end-to-end encryption for billions.' },
  { y: '2023–24', who: 'The IETF MLS group and the CRYSTALS teams with NIST', b: 'Messaging Layer Security, ML-KEM and ML-DSA: group encryption that holds against quantum computers.' },
];
---

<Base
  title="ñü.bi: the ñü basic income"
  description="ñü.bi, the ñü basic income: everyone who runs a khensu.ñü node is paid in khensu.ñü coin, turned into USDC on arrival, for proved work at one worldwide rate, and an equal dividend for every person is in research. No location tracking, no biometrics, no registry of people."
>
  <div class="khensu bi">
    <section class="bi-hero" aria-labelledby="bi-title">
      <div class="wrap">
        <p class="eyebrow">ñü.bi · ñü basic income</p>
        <h1 id="bi-title">A basic income for everyone,<em>paid by the network people run.</em></h1>
        <p class="bi-lede">
          khensu.ñü is a gift to humanity and all beings: freedom and privacy, plus a universal basic income, so people
          everywhere can create, build and live securely. ñü.bi is how the income part works, and it may be the biggest
          good the network can do: at global scale, an income paid straight to people could help end poverty, hunger and
          homelessness, and give everyone the freedom to create and build.
        </p>
        <p class="bi-status">Published 11 October 2026 · in development, not yet live · nothing here is a promise of income</p>
      </div>
    </section>

    <Burst
      id="bi-numbers-section"
      eyebrow="ñü.bi by the numbers"
      title="Paid for the work. Kept in full."
      em="Under a cent to move it."
      items={[
        { g: '<1¢', t: 'Transaction fee', s: 'To send or withdraw, paid to the people running nodes; receiving is free. Estimate' },
        { g: '100%', t: 'Of tips and views, to the artist', s: 'Artists keep every tip and all their view revenue, 1¢ a view' },
        { g: '1', t: 'Rate for the whole world', s: 'A node in Tangier is paid the same per proof as one in Berlin' },
      ]}
    />

    <section class="section bi-scale" id="bi-scale" aria-labelledby="bi-scale-title">
      <div class="wrap">
        <p class="eyebrow">the scale of it</p>
        <h2 id="bi-scale-title">Billions of people<br /><span class="dim">are waiting for this.</span></h2>
        <p class="intro">
          The world has more than enough food, homes and money. What fails is getting them to the people who need them.
          A steady income, paid straight to each person with no one in between, is one of the simplest tools we know of.
          This is a potential, not a promise: how far ñü.bi reaches depends on how many people use and run the network.
        </p>
        <AnimatedBars title="People affected worldwide" unit="latest estimates · millions of people" rows={world} sources={worldSrc} />
        <div class="bi-facts">
          <p class="glass"><b>900 million</b> adults with no account already own a phone, 530 million of them a smartphone. A phone is all ñü.bi needs. <a href="https://thedocs.worldbank.org/en/doc/a4aaae5a017a5bea7922686af0ed3636-0050022025/original/PolicyResearchTalk-GlobalFindex-September2025.pdf" rel="noopener">World Bank, 2025</a></p>
          <p class="glass"><b>1 in 10</b> people on Earth live on less than $3 a day. One worldwide rate means a node pays the most where living costs least. <a href="https://blogs.worldbank.org/en/opendata/september-2026-global-poverty-update-from-the-world-bank--one-in" rel="noopener">World Bank, 2026</a></p>
        </div>
      </div>
    </section>

    <section class="section" id="bi-send" aria-labelledby="bi-send-title">
      <div class="wrap">
        <p class="eyebrow">sending money home</p>
        <h2 id="bi-send-title">$200 home costs $12.72.<br /><span class="dim">On khensu.ñü, under a cent.</span></h2>
        <AnimatedBars
          title="Cost of sending $200 to another country"
          unit="US dollars · Q3 2025"
          rows={send}
          note="Average total cost including exchange-rate margins. The khensu.ñü fee is an estimate for a private payment on the network; cashing out to a bank may carry the bank’s own fee."
          sources={[{ name: 'World Bank, Remittance Prices Worldwide, issue 54', url: 'https://remittanceprices.worldbank.org/' }]}
        />
      </div>
    </section>

    <section class="section" id="bi-tried" aria-labelledby="bi-tried-title">
      <div class="wrap">
        <p class="eyebrow">it has been tried</p>
        <h2 id="bi-tried-title">Governments have tested it.<br /><span class="dim">Lives got better.</span></h2>
        <ul class="bi-tried" role="list">
          {tried.map((t) => (
            <li class="glass"><span class="tag">{t.where}</span><h3>{t.t}</h3><p>{t.b}</p><a href={t.url} rel="noopener">Source</a></li>
          ))}
        </ul>
        <p class="footnote">These programmes are run by governments and charities, not by khensu.ñü; we cite them as evidence, not endorsement.</p>
      </div>
    </section>

    <section class="section bi-allies" id="bi-allies" aria-labelledby="bi-allies-title">
      <div class="wrap">
        <p class="eyebrow">nations and alliances</p>
        <h2 id="bi-allies-title">It will happen without them.<br /><span class="dim">With them, it happens far faster.</span></h2>
        <p class="intro">
          ñü.bi needs no one’s permission or public money: the network pays the people who run it from its own revenue.
          But a government or alliance can bring it to millions at once, with personhood credentials for the equal
          dividend, nodes in libraries and schools, and clear tax rules. Here is where they stand on basic income today.
        </p>
        <figure class="glass bi-table">
          <table>
            <thead><tr><th scope="col">Who</th><th scope="col">Where they stand on basic income</th><th scope="col">ñü.bi partner</th></tr></thead>
            <tbody>
              {allies.map((a) => (
                <tr><th scope="row">{a.who}</th><td>{a.what}{a.url && <> <a href={a.url} rel="noopener">Source</a></>}</td><td><span class="st">Invited</span></td></tr>
              ))}
            </tbody>
          </table>
        </figure>
        <p class="footnote">No country or alliance has adopted ñü.bi yet. This table will show each partner as it joins.</p>
      </div>
    </section>

    <section class="section" aria-label="Two stages">
      <div class="wrap">
        <div class="bi-two">
          {stages.map((s, i) => (
            <article class:list={['glass', 'bi-stage', { on: i === 0 }]}>
              <p class="bi-k">{s.k}</p>
              <h3>{s.t}</h3>
              <p>{s.b}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="bi-how" aria-labelledby="bi-how-title">
      <div class="wrap">
        <p class="eyebrow">how node pay works</p>
        <h2 id="bi-how-title">From a subscription<br /><span class="dim">to an operator’s pocket.</span></h2>
        <ol class="bi-steps" role="list">
          {how.map((h, i) => (
            <li class="glass"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{h.t}</h3><p>{h.b}</p></li>
          ))}
        </ol>
        <figure class="glass bi-formula">
          <figcaption>Each node’s pay for an epoch</figcaption>
          <p class="f">pay = pool × <span>(this node’s verified work ÷ all verified work)</span></p>
          <p class="fn">So pay grows with what people use, and is shared by everyone who runs a node. When more nodes join than the work needs, each earns less; the network’s committee can pace new nodes in a region so pay stays above running costs.</p>
        </figure>
        <figure class="glass bi-table">
          <figcaption>What one month of each subscription puts in the pool</figcaption>
          <table>
            <thead><tr><th scope="col">Plan</th><th scope="col">Price</th><th scope="col">To the network’s pay pool</th></tr></thead>
            <tbody>
              {tiers.map((t) => <tr><th scope="row">{t.name}</th><td>{usd(t.price)}</td><td class="ours">{usd(t.network)}</td></tr>)}
            </tbody>
          </table>
        </figure>
        <p class="footnote">
          After Apple’s 15%, split evenly between the network and Elliott Wave LLC, the founder’s company; that split is
          the only cut. Estimated node earnings at different audience sizes are on the <a href="/network#network-earnings">network page</a>.
          Real earnings depend on usage and are not guaranteed.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="bi-fair-title">
      <div class="wrap">
        <p class="eyebrow">fair everywhere</p>
        <h2 id="bi-fair-title">One rate for the whole world.<br /><span class="dim">Worth the most where it’s needed most.</span></h2>
        <div class="bi-grid">
          {fair.map((f) => <article class="glass"><h3>{f.t}</h3><p>{f.b}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="bi-src-title">
      <div class="wrap">
        <p class="eyebrow">where the money comes from</p>
        <h2 id="bi-src-title">Real customers.<br /><span class="dim">Never ads, data or token sales.</span></h2>
        <ul class="bi-src" role="list">
          {sources.map((s) => <li class="glass"><span class="tag">{s.live}</span><h3>{s.t}</h3><p>{s.b}</p></li>)}
        </ul>
        <p class="footnote">
          The network also mints tokens to operators, falling by half every two years. Their value depends on a market
          price, so they are left out of every figure on this site.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="bi-safe-title">
      <div class="wrap">
        <p class="eyebrow">safeguards</p>
        <h2 id="bi-safe-title">A basic income without surveillance.</h2>
        <div class="bi-grid">
          {safeguards.map((f) => <article class="glass"><h3>{f.t}</h3><p>{f.b}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section bi-gov" id="bi-governments" aria-labelledby="bi-gov-title">
      <div class="wrap">
        <p class="eyebrow">for governments</p>
        <h2 id="bi-gov-title">Five ways to bring ñü.bi<br /><span class="dim">to your residents.</span></h2>
        <p class="intro">
          ñü.bi needs no public money to run: the network pays its operators from its own revenue. What governments can
          add is reach, trust and clarity.
        </p>
        <ol class="bi-steps" role="list">
          {gov.map((h, i) => (
            <li class="glass"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{h.t}</h3><p>{h.b}</p></li>
          ))}
        </ol>
        <div class="btn-row">
          <a class="btn primary" href={CONTACT}>Talk to us</a>
          <a class="btn" href="/network">How the network works</a>
          <a class="btn" href={`${DEV}/specs/work`}>Work specification</a>
        </div>
      </div>
    </section>

    <section class="section bi-thanks" id="bi-thanks" aria-labelledby="bi-thanks-title">
      <div class="wrap">
        <p class="eyebrow">with gratitude</p>
        <h2 id="bi-thanks-title">We stand on their shoulders.<br /><span class="dim">Thank you.</span></h2>
        <p class="intro">
          None of this would be possible without the people who built the internet we have, and gave so much of it away.
          Their ingenuity and tenacity made a network of networks that nobody owns. khensu.ñü is our attempt to carry
          that gift forward.
        </p>
        <ol class="bi-time" role="list">
          {thanks.map((t) => <li><span class="y">{t.y}</span><h3>{t.who}</h3><p>{t.b}</p></li>)}
        </ol>
        <p class="footnote">And to everyone else who wrote a standard, fixed a bug, answered a question or kept a server running for strangers.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="bi-status-title">
      <div class="wrap">
        <p class="eyebrow">where it stands</p>
        <h2 id="bi-status-title">What’s decided,<br /><span class="dim">and what isn’t yet.</span></h2>
        <figure class="glass bi-table">
          <table>
            <thead><tr><th scope="col">Part of ñü.bi</th><th scope="col">Status</th></tr></thead>
            <tbody>
              {status.map((r) => <tr><th scope="row">{r.what}</th><td><span class:list={['st', r.s.toLowerCase().replace(/\s/g, '-')]}>{r.s}</span></td></tr>)}
            </tbody>
          </table>
        </figure>
        <p class="footnote">
          khensu.ñü is built by Elliott Wave LLC. The network, its token and the stage-two dividend are in development and
          not yet offered anywhere. Nothing on this page is an offer of securities, investment advice or a promise of
          income; amounts will be published only as labelled estimates after legal review. USDC is issued by Circle and
          redeemable one-for-one for US dollars. Apple and Apple Pay are trademarks of Apple Inc.
        </p>
      </div>
    </section>
