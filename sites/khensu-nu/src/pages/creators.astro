---
import Base from '../layouts/Base.astro';
import CreatorPay from '../components/khensu/CreatorPay.astro';
import data from '../data/creator-pay.json';

type Src = { name: string; url: string; checked: string };
const film = data.film;
const filmLabel =
  `${film.title}: ` + film.rows.map((r) => `${r.name} ${r.display}`).join('; ') +
  '. The same $100 pledged to a film on ñüFi Back goes to the filmmaker, less a network fee estimated at a fraction of a cent.';

const sourceRows: { figure: string; value: string; kind: string; sources: Src[] }[] = [
  ...data.cut.rows.map((r) => ({ figure: `Taken before the artist is paid: ${r.name}`, value: r.display, kind: r.kind, sources: r.sources })),
  ...data.perThousand.rows.map((r) => ({ figure: `Per 1,000 plays: ${r.name}`, value: r.display, kind: r.id === 'khensu' ? 'example' : r.kind, sources: r.sources })),
  ...film.rows.map((r) => ({ figure: `Film, $100 of tickets: ${r.name}`, value: r.display, kind: r.kind, sources: film.sources as Src[] })),
  { figure: 'Label advance repaid from a 20% royalty', value: '$100,000 needs $500,000 of revenue', kind: data.recoup.kind, sources: data.recoup.sources as Src[] },
];
---

<Base
  title="For artists"
  description="How khensu.ñü lets fans pay artists, musicians and filmmakers directly, with no platform cut, and fund films, albums and tours with ñüFi instead of studio or label advances."
>
  <div class="khensu">
    <section class="page-head">
      <div class="wrap">
        <p class="eyebrow">for artists</p>
        <h1>Art, paid for by the people who love it.<br /><span class="dim">Not by studios, labels or ad markets.</span></h1>
        <p class="lede">
          Today most of what people spend on films, music and video is kept by the companies in between. khensu.ñü lets
          fans pay artists directly, and lets artists raise money for their next work from the people who want to see it.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="wrap prose">
        <h2>Where the money goes today</h2>
        <p>
          <b>Music.</b> Spotify says it pays out about two-thirds of its music revenue to rights holders. It pays them
          from a monthly pool, split by share of streams, not a fixed rate; widely reported estimates come to about
          $3–5 for every 1,000 streams. For an artist signed to a label, that money goes to the label first. A typical
          deal for a new artist pays them 15–20% of it, and nothing at all until the label has earned back the advance,
          recording and marketing costs out of the artist’s share.
        </p>
        <p>
          <b>Film.</b> In a studio deal, the studio pays for the film and owns it. Cinemas keep roughly half of every
          ticket. The distributor then takes its fee, traditionally 30% in the US and Canada, and repays marketing,
          prints, overhead and the cost of the film before anything counts as profit. That is why people with “net
          points” on a hit film are often paid nothing beyond their fee.
        </p>
        <p>
          <b>Video and live streams.</b> YouTube keeps 45% of ad revenue on long videos and 55% on Shorts, Twitch keeps
          half of most subscriptions, and app stores take 15–30% of purchases made inside apps.
        </p>
      </div>

      <div class="wrap">
        <figure class="card film" data-scene="reveal">
          <figcaption><b>{film.title}</b><span>Against the same $100 pledged to a film on ñüFi Back</span></figcaption>
          <div role="img" aria-label={filmLabel}>
            <ul class="stack" role="list" aria-hidden="true">
              <li>
                <span class="label"><b>Studio release</b> <small>estimate</small></span>
                <span class="track">
                  {film.rows.map((r, i) => <span class:list={['seg', `s-${r.id}`]} style={`--w:${r.value};--i:${i}`}><span>${r.value}</span></span>)}
                </span>
              </li>
              <li class="ours">
                <span class="label"><b>ñüFi Back</b> <small>no cut</small></span>
                <span class="track"><span class="seg s-ours" style="--w:100;--i:0"><span>$100 to the film, less a network fee under 1¢</span></span></span>
              </li>
            </ul>
          </div>
          <ul class="key" role="list">
            {film.rows.map((r) => <li><i class={`s-${r.id}`} />{r.name}</li>)}
          </ul>
          <p class="src">
            The studio row is a simplified example of a traditional theatrical deal; fees, costs and splits vary by film
            and contract, and money from streaming, TV and home video follows its own terms.
            Sources: {(film.sources as Src[]).map((s, i) => <>{i ? '; ' : ''}<a href={s.url} rel="noopener">{s.name}</a></>)}.
          </p>
        </figure>
      </div>
    </section>

    <CreatorPay page />

    <section class="section" id="fans-pay-section">
      <div class="wrap prose">
        <h2>How fans pay you</h2>
        <p>
          Payments happen inside the khensu.ñü app, through the network’s shielded payments. Money goes from a fan’s
          wallet to yours as an encrypted message over the network, so there is no public record of who paid whom, and no
          card processor, bank or platform account sits in the middle. Nobody holds your money for you, so nobody can
          freeze it or make you wait for a payout date.
        </p>
        <p>
          khensu.ñü takes no cut. The only charge is a network fee of a fraction of a cent for each payment, which goes to
          the people who run the network’s nodes; that fee is an estimate. For tips, the fan pays the fee on top, so
          you receive 100%.
        </p>
        <ul class="ways">
          <li><b>Subscriptions.</b> Fans pay you monthly for your work, at a price you set.</li>
          <li><b>Tips.</b> From a chat, a post in the Feed or a live room, in any amount.</li>
          <li><b>Pay-per-view.</b> Charge for a film, an episode, an album or a single track.</li>
          <li><b>Live tickets.</b> Sell entry to a live room, a premiere or a concert stream.</li>
        </ul>
        <p>
          A share of khensu.ñü’s own subscriptions also goes to the creators each subscriber actually watches or
          listens to, split by the minute, so none of their money goes to anyone they never played.
        </p>

        <h2>Fund the next film, album or tour with ñüFi</h2>
        <p>
          Instead of asking a studio or a label for an advance, you can ask the people who want the work. ñüFi Back works
          like Kickstarter, with no platform cut:
        </p>
        <ul class="ways">
          <li><b>All or nothing.</b> Pledges are held in escrow on the network. If you reach your goal by the deadline, the money is released to you. If not, every backer is refunded automatically. No company holds the money, khensu.ñü included.</li>
          <li><b>Terms that can’t change.</b> Your goal, deadline and rewards are signed and published before anyone pays, so they can’t be altered afterwards.</li>
          <li><b>Private backers.</b> You see totals and which rewards people chose; who backed you stays private unless they choose to share it.</li>
          <li><b>Your rights stay yours.</b> Backers get the rewards you offer, such as a ticket, a download or a signed copy. They don’t get your film, your masters or a share of your income.</li>
        </ul>
        <p>
          ñüFi Give is for gifts of any size, and ñüFi Back is for funding the work. Lending and investment run through
          licensed partners, whose fees are shown before anyone commits.
        </p>

        <h2>Every collaborator, paid automatically</h2>
        <p>
          Films and records are made by many people. Set a split once (for example, the director, the writer, the
          composer and the cast) and every payment that comes in is shared between their wallets as it arrives. No one
          waits for an accountant’s statement, and no one has to trust the person holding the money.
        </p>

        <h2>Nothing to pay back</h2>
        <p>
          A label advance is repaid out of the artist’s share, not the label’s. With a 20% royalty, a $100,000 advance is
          repaid only after the recording has earned $500,000. On khensu.ñü, nobody advances you money, so there is
          nothing to recoup: the first payment from the first fan is yours.
        </p>

        <h2>Where the network fee goes</h2>
        <p>
          The network fee pays the people who run khensu.ñü’s nodes for carrying your payments and your work. If you run a
          node, or carry a suñůlink.shield, the network also pays it for the relay work it can prove it did, into the same
          wallet. What a node earns depends on the work it does; this is not a promise of earnings.
        </p>

        <h2>What is measured and what isn’t</h2>
        <p>
          khensu.ñü’s 0% cut and $0 minimum cashout are rules of how payments work. Its network fee is an estimate and its per-play figure an example.
          Other platforms’ figures are their published terms, or estimates where they don’t publish one, and each is
          labelled. Payments are offered region by region, following legal review in each, and paid digital content bought inside the
          iPhone app follows Apple’s purchase rules.
        </p>

        <h2>Every number and where it comes from</h2>
      </div>

      <div class="wrap">
        <div class="sources" tabindex="0">
          <table>
            <thead><tr><th scope="col">Figure</th><th scope="col">Value</th><th scope="col">Type</th><th scope="col">Source, checked {data.checked}</th></tr></thead>
            <tbody>
              {sourceRows.map((r) => (
                <tr>
                  <th scope="row">{r.figure}</th>
                  <td>{r.value}</td>
                  <td class="kind">{r.kind}</td>
                  <td>{r.sources.map((s, i) => <>{i ? <br /> : ''}<a href={s.url} rel="noopener">{s.name}</a></>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="footnote">
          Spotify, Apple Music, App Store, YouTube, Twitch, Patreon, OnlyFans and Kickstarter are trademarks of their
          owners; no affiliation or endorsement. Not an offer of securities or a promise of earnings.
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/scenes.ts';
</script>

<style>
  .dim {
    color: rgba(255, 255, 255, 0.55);
  }
  .prose b {
    font-weight: 500;
    color: var(--text);
  }
  .prose p {
    color: var(--text-dim);
  }
  .ways {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    color: var(--text-dim);
  }

  .film {
    margin: 2.5rem 0 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.2rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  figcaption {
    display: grid;
    gap: 0.2rem;
  }
  figcaption b {
    font-size: 1.2rem;
    font-weight: 500;
  }
  figcaption span,
  small {
    color: var(--text-dim);
  }
  small {
    font-size: 0.78rem;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .stack li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .stack .label small {
    display: block;
    text-transform: lowercase;
  }
  .stack .track {
    display: flex;
    gap: 3px;
    height: 2.2rem;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    clip-path: inset(0 calc((1 - clamp(0, var(--e, 1) / 0.7, 1)) * 100%) 0 0 round 12px);
  }
  .stack .seg {
    flex: none;
    width: calc(var(--w) * 1% - 2px);
    display: flex;
    align-items: center;
    padding: 0 0.7rem;
    font-size: 0.8rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .s-cinema {
    background: rgba(255, 255, 255, 0.3);
  }
  .s-fee {
    background: rgba(255, 255, 255, 0.18);
  }
  .s-costs {
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0 6px, rgba(255, 255, 255, 0.08) 6px 12px);
  }
  .s-ours {
    background: linear-gradient(90deg, #8b7bff, #b9b0ff);
    color: #0a0b0d;
    font-weight: 600;
    box-shadow: 0 0 14px rgba(139, 123, 255, 0.45);
  }
  .ours .label b {
    color: #b9b0ff;
  }
  .key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .key li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .key i {
    flex: none;
    width: 18px;
    height: 10px;
    border-radius: 999px;
  }
  .src {
    margin: 0;
    max-width: none;
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--text-faint);
  }
  .src a {
    color: var(--text-dim);
  }

  .sources {
    overflow-x: auto;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }
  table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: 0.84rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.65rem 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  thead th {
    border-top: 0;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--text-faint);
  }
  tbody th {
    font-weight: 400;
  }
  td {
    color: var(--text-dim);
  }
  td.kind {
    text-transform: lowercase;
    white-space: nowrap;
  }
  td a {
    color: var(--text-dim);
  }
  .footnote {
    margin-top: 1.5rem;
    max-width: none;
  }

  @media (max-width: 760px) {
    .stack li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .stack .seg {
      font-size: 0.7rem;
      padding: 0 0.45rem;
    }
  }
</style>
