---
import Base from '../layouts/Base.astro';
import CreatorPay from '../components/khensu/CreatorPay.astro';
import Economics from '../components/khensu/Economics.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import RevealText from '../components/khensu/RevealText.astro';
import CrHero from '../components/creators/CrHero.astro';
import Burst from '../components/creators/Burst.astro';
import Payouts from '../components/creators/Payouts.astro';
import FansSee from '../components/creators/FansSee.astro';
import DataSaving from '../components/creators/DataSaving.astro';
import OwnIt from '../components/creators/OwnIt.astro';
import { APP_STORE_ID, APP_STORE_URL } from '../data/app';
import data from '../data/creator-pay.json';

type Src = { name: string; url: string; checked: string };
const film = data.film;
const filmLabel =
  `${film.title}: ` + film.rows.map((r) => `${r.name} ${r.display}`).join('; ') +
  '. The same $100 pledged to a film on ñüFi Back goes to the filmmaker, less a network fee estimated at a fraction of a cent.';

const sourceRows: { figure: string; value: string; kind: string; sources: Src[] }[] = [
  ...data.cut.rows.map((r) => ({ figure: `Taken before the artist is paid: ${r.name}`, value: r.display, kind: r.kind, sources: r.sources })),
  ...data.perThousand.rows.map((r) => ({ figure: `Per 1,000 plays: ${r.name}`, value: r.display, kind: r.id === 'khensu' ? 'example' : r.kind, sources: r.sources })),
  ...film.rows.map((r) => ({ figure: `Film, $100 of tickets: ${r.name}`, value: r.display, kind: r.kind, sources: film.sources as Src[] })),
  { figure: 'Label advance repaid from a 20% royalty', value: '$100,000 needs $500,000 of revenue', kind: data.recoup.kind, sources: data.recoup.sources as Src[] },
];

const old = [
  { k: 'Music', big: '15–20%', s: 'of a label’s share reaches a new artist', b: 'Spotify pays about two-thirds of its music revenue to rights holders, from a monthly pool; widely reported estimates come to $3–5 per 1,000 streams. A typical new-artist deal pays the artist 15–20% of the label’s share, and nothing until the advance, recording and marketing are earned back.' },
  { k: 'Film', big: '~50%', s: 'of every ticket kept by the cinema', b: 'The distributor then takes its fee, traditionally 30% in the US and Canada, and repays marketing, prints, overhead and the cost of the film before anything counts as profit. That’s why “net points” on a hit often pay nothing.' },
  { k: 'Video and live', big: '45–55%', s: 'of ad revenue kept by YouTube', b: 'YouTube keeps 45% on long videos and 55% on Shorts, Twitch keeps half of most subscriptions, and app stores take 15–30% of purchases made inside apps.' },
];
const fund = [
  { t: 'All or nothing.', b: 'Pledges are held in escrow on the network. Reach your goal by the deadline and the money is released to you; if not, every backer is refunded automatically. No company holds the money, khensu.ñü included.' },
  { t: 'Terms that can’t change.', b: 'Your goal, deadline and rewards are signed and published before anyone pays, so they can’t be altered afterwards.' },
  { t: 'Private backers.', b: 'You see totals and which rewards people chose; who backed you stays private unless they choose to share it.' },
  { t: 'Your rights stay yours.', b: 'Backers get the rewards you offer, such as a ticket, a download or a signed copy. They don’t get your film, your masters or a share of your income.' },
];
const appLabel = APP_STORE_ID ? 'Download on the App Store' : 'Get the app';
---

<Base
  title="For creators"
  description="Creators on khensu.ñü keep everything: no platform cut on views, gifts, tickets or sales, tips 100% to you, a 42¢ minimum payout, instant payouts, and every right to your work. Plus Sounds, ñü.media video at less data, and ñüFi funding."
>
  <div class="khensu cr">
    <CrHero />
    <ProductBar name="khensu.ñü for creators" action={appLabel} href={APP_STORE_URL} />

    <section class="intro" aria-label="Introduction">
      <div class="wrap">
        <RevealText
          parts={[
            ['Today most of what people spend on films, music and video is kept by the companies in between. '],
            ['On khensu.ñü, fans pay the people who made it.', true],
            [' Directly, instantly and privately, with '],
            ['no platform cut', true],
            [' and '],
            ['every right left with you.', true],
          ]}
        />
      </div>
    </section>

    <Burst />

    <OwnIt />

    <CreatorPay page />

    <Payouts />

    <FansSee />

    <DataSaving />

    <section class="sounds-link" id="sounds-section" aria-labelledby="sl-title">
      <div class="wrap">
        <p class="eyebrow">ñü.sounds</p>
        <h2 id="sl-title">Music and healing, in spatial audio.</h2>
        <p>Artists upload their own music and every play pays 1¢ with no cut. Put on AirPods and hear a song placed all around you.</p>
        <a class="btn primary" href="/sounds">Listen on ñü.sounds</a>
      </div>
    </section>

    <section class="section old" id="old-deal-section" aria-labelledby="old-title">
      <div class="wrap">
        <p class="eyebrow">where the money goes today</p>
        <h2 id="old-title" class="cr-h">The old deal.<br /><span class="dim">Most of it never reaches you.</span></h2>
        <ul class="old-cards" role="list" data-scene="reveal">
          {old.map((o, i) => (
            <li style={`--i:${i}`}>
              <small>{o.k}</small>
              <b>{o.big}</b>
              <span class="old-s">{o.s}</span>
              <p>{o.b}</p>
            </li>
          ))}
        </ul>

        <figure class="card film" data-scene="reveal">
          <figcaption><b>{film.title}</b><span>Against the same $100 pledged to a film on ñüFi Back</span></figcaption>
          <div role="img" aria-label={filmLabel}>
            <ul class="stack" role="list" aria-hidden="true">
              <li>
                <span class="label"><b>Studio release</b> <small>estimate</small></span>
                <span class="track">
                  {film.rows.map((r, i) => <span class:list={['seg', `s-${r.id}`]} style={`--w:${r.value};--i:${i}`}><span>${r.value}</span></span>)}
                </span>
              </li>
              <li class="ours">
                <span class="label"><b>ñüFi Back</b> <small>no cut</small></span>
                <span class="track"><span class="seg s-ours" style="--w:100;--i:0"><span>$100 to the film, less a network fee under 1¢</span></span></span>
              </li>
            </ul>
          </div>
          <ul class="key" role="list">
            {film.rows.map((r) => <li><i class={`s-${r.id}`} />{r.name}</li>)}
          </ul>
          <p class="src">
            The studio row is a simplified example of a traditional theatrical deal; fees, costs and splits vary by film
            and contract, and money from streaming, TV and home video follows its own terms.
            Sources: {(film.sources as Src[]).map((s, i) => <>{i ? '; ' : ''}<a href={s.url} rel="noopener">{s.name}</a></>)}.
          </p>
        </figure>
      </div>
    </section>

    <section class="section fund" id="nufi-back-section" data-par aria-labelledby="fund-title">
      <div class="wrap">
        <p class="eyebrow">ñüFi back</p>
        <h2 id="fund-title" class="cr-h">Fund the next film, album or tour.<br /><span class="dim">From the people who want it.</span></h2>
        <p class="cr-lede">
          Instead of asking a studio or a label for an advance, ask your fans. <strong>ñüFi Back works like Kickstarter,
          with no platform cut.</strong> ñüFi Give is for gifts of any size; lending and investment run through licensed
          partners, whose fees are shown before anyone commits.
        </p>
        <ul class="fund-cards" role="list">
          {fund.map((f, i) => (
            <li style={`--i:${i}`}><b>{f.t}</b><span>{f.b}</span></li>
          ))}
        </ul>

        <div class="duo">
          <div class="duo-card">
            <p class="duo-k">Every collaborator, paid automatically</p>
            <p class="duo-big">One split.<br />Paid as it arrives.</p>
            <p>
              Set a split once (the director, the writer, the composer and the cast) and every payment is shared between
              their wallets as it comes in. No one waits for an accountant’s statement, and no one has to trust the person
              holding the money.
            </p>
          </div>
          <div class="duo-card">
            <p class="duo-k">Nothing to pay back</p>
            <p class="duo-big"><span data-count data-to="500000" data-pre="$">$500,000</span><br /><small>to repay a $100,000 advance</small></p>
            <p>
              A label advance is repaid out of the artist’s share. At a 20% royalty, a $100,000 advance is repaid only
              after the recording earns $500,000. On khensu.ñü nobody advances you money, so there’s nothing to recoup:
              the first payment from the first fan is yours.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Economics />

    <section class="section close" id="get-started-section" data-par aria-labelledby="close-title">
      <video class="close-vid" src="/khensu/creators/hero.mp4" poster="/khensu/creators/hero.webp" muted loop playsinline preload="none" data-loop aria-hidden="true" width="540" height="960"></video>
      <div class="wrap close-in">
        <h2 id="close-title" class="cr-h">Make the thing.<em>Keep the money. Keep the rights.</em></h2>
        <div class="close-cta">
          <a class="btn primary" href={APP_STORE_URL}>{appLabel}</a>
          <a class="btn" href="/media">See ñü.media</a>
        </div>
        <p class="close-credit">Video: @deemsterhotline on Instagram, used with thanks.</p>
      </div>
    </section>

    <section class="section fine" id="the-fine-print-section" aria-labelledby="fine-title">
      <div class="wrap prose">
        <h2 id="fine-title">Where the network fee goes</h2>
        <p>
          The network fee pays the people who run khensu.ñü’s nodes for carrying your payments and your work. If you run a
          node, or carry a suñůlink.shield, the network also pays it for the relay work it can prove it did, into the same
          wallet. What a node earns depends on the work it does; this is not a promise of earnings.
        </p>
        <p>
          Every play pays you 1¢, $10 per 1,000 plays, and khensu.ñü takes no cut of it. A fan’s money only ever goes to
          what they actually watched or played.
        </p>

        <h2>What is measured and what isn’t</h2>
        <p>
          khensu.ñü’s 0% cut and 42¢ minimum payout are rules of how payments work. Its network fee is an estimate and its
          per-play figure an example. ñü.media figures are benchmarks, measured on the reel shown on this page. Other
          platforms’ figures are their published terms, or estimates where they don’t publish one, and each is labelled.
          Payments are offered region by region, following legal review in each, and paid digital content bought inside
          the iPhone app follows Apple’s purchase rules.
        </p>

        <h2>Every number and where it comes from</h2>
      </div>

      <div class="wrap">
        <div class="sources" tabindex="0">
          <table>
            <thead><tr><th scope="col">Figure</th><th scope="col">Value</th><th scope="col">Type</th><th scope="col">Source, checked {data.checked}</th></tr></thead>
            <tbody>
              {sourceRows.map((r) => (
                <tr>
                  <th scope="row">{r.figure}</th>
                  <td>{r.value}</td>
                  <td class="kind">{r.kind}</td>
                  <td>{r.sources.map((s, i) => <>{i ? <br /> : ''}<a href={s.url} rel="noopener">{s.name}</a></>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="footnote">
          Spotify, Apple Music, App Store, YouTube, Twitch, Patreon, OnlyFans, Instagram, TikTok and Kickstarter are
          trademarks of their owners; no affiliation or endorsement. Not an offer of securities or a promise of earnings.
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/scenes.ts';
  import '../scripts/creators.ts';
</script>

<style>
  .sounds-link {
    padding: clamp(5rem, 10vw, 8rem) 0;
    text-align: center;
    background: radial-gradient(50rem 24rem at 50% 50%, rgba(79, 176, 255, 0.12), transparent 70%), #000;
  }
  .sounds-link h2 {
    font-size: clamp(2rem, 5vw, 3.6rem);
    letter-spacing: -0.03em;
    margin: 0.4rem 0 1rem;
  }
  .sounds-link p:not(.eyebrow) {
    color: var(--muted, #9aa0a6);
    max-width: 36rem;
    margin: 0 auto 1.8rem;
    line-height: 1.55;
  }
  .cr {
    background: #000;
  }
  .cr :global(.section) {
    background: #000;
  }
  .intro {
    padding: clamp(5rem, 12vw, 10rem) 0;
    background: #000;
  }
  .intro :global(.reveal-text) {
    font-size: clamp(1.5rem, 3.2vw, 2.6rem);
    max-width: 56rem;
    line-height: 1.25;
  }
  .cr-h {
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    font-weight: 600;
  }
  .cr-h em {
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
  }
  .dim {
    color: rgba(255, 255, 255, 0.5);
  }
  .cr-lede {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: rgba(255, 255, 255, 0.56);
    max-width: 44rem;
  }
  .cr-lede strong {
    color: #fff;
    font-weight: 500;
  }

  .old-cards {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .old-cards li {
    --k: clamp(0, calc((var(--e, 1) - var(--i) * 0.12) / 0.4), 1);
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 1.6rem;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    opacity: var(--k);
    translate: 0 calc((1 - var(--k)) * 30px);
  }
  .old-cards small {
    font-size: 0.78rem;
    color: var(--text-faint);
    letter-spacing: 0.06em;
  }
  .old-cards b {
    font-size: clamp(2.6rem, 5vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .old-s {
    font-weight: 500;
  }
  .old-cards p {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .fund {
    --v: 0;
    overflow: hidden;
    background: radial-gradient(50% 40% at 80% 20%, rgba(24, 224, 200, 0.1), transparent 70%), #000 !important;
  }
  .fund-cards {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .fund-cards li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.5rem;
    border-radius: 22px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    translate: 0 calc(var(--v) * (var(--i) - 1.5) * -14px);
  }
  .fund-cards b {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .fund-cards span {
    color: var(--text-dim);
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  .duo-card {
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border-radius: 26px;
    background: radial-gradient(120% 90% at 0% 0%, rgba(139, 123, 255, 0.2), transparent 60%), rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .duo-card p {
    color: var(--text-dim);
  }
  .duo-k {
    font-size: 0.85rem;
    margin: 0;
  }
  .duo-big {
    margin: 0.4rem 0 1rem;
    color: #fff !important;
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .duo-big small {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-dim);
  }

  .close {
    --v: 0;
    position: relative;
    overflow: hidden;
    min-height: min(90svh, 820px);
    display: grid;
    align-items: center;
  }
  .close-vid {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100%, 56svh);
    height: 130%;
    object-fit: cover;
    translate: -50% calc(-50% + var(--v) * 8%);
    opacity: 0.4;
    mask-image: radial-gradient(closest-side, #000 40%, transparent);
  }
  .close-in {
    position: relative;
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .close .cr-h {
    font-size: clamp(2.8rem, 7vw, 6rem);
  }
  .close-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }
  .close-credit {
    margin-top: 1.5rem;
    font-size: 0.74rem;
    color: var(--text-faint);
  }

  .prose p {
    color: var(--text-dim);
  }
  .fine h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-top: 2rem;
  }

  .film {
    margin: 1rem 0 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.2rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  figcaption {
    display: grid;
    gap: 0.2rem;
  }
  figcaption b {
    font-size: 1.2rem;
    font-weight: 500;
  }
  figcaption span,
  small {
    color: var(--text-dim);
  }
  .stack small {
    font-size: 0.78rem;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .stack li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .stack .label small {
    display: block;
    text-transform: lowercase;
  }
  .stack .track {
    display: flex;
    gap: 3px;
    height: 2.2rem;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    clip-path: inset(0 calc((1 - clamp(0, var(--e, 1) / 0.7, 1)) * 100%) 0 0 round 12px);
  }
  .stack .seg {
    flex: none;
    width: calc(var(--w) * 1% - 2px);
    display: flex;
    align-items: center;
    padding: 0 0.7rem;
    font-size: 0.8rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .s-cinema {
    background: rgba(255, 255, 255, 0.3);
  }
  .s-fee {
    background: rgba(255, 255, 255, 0.18);
  }
  .s-costs {
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0 6px, rgba(255, 255, 255, 0.08) 6px 12px);
  }
  .s-ours {
    background: linear-gradient(90deg, #8b7bff, #b9b0ff);
    color: #0a0b0d;
    font-weight: 600;
    box-shadow: 0 0 14px rgba(139, 123, 255, 0.45);
  }
  .ours .label b {
    color: #b9b0ff;
  }
  .key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .key li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .key i {
    flex: none;
    width: 18px;
    height: 10px;
    border-radius: 999px;
  }
  .src {
    margin: 0;
    max-width: none;
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--text-faint);
  }
  .src a {
    color: var(--text-dim);
  }

  .sources {
    overflow-x: auto;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }
  table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: 0.84rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.65rem 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  thead th {
    border-top: 0;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--text-faint);
  }
  tbody th {
    font-weight: 400;
  }
  td {
    color: var(--text-dim);
  }
  td.kind {
    text-transform: lowercase;
    white-space: nowrap;
  }
  td a {
    color: var(--text-dim);
  }
  .footnote {
    margin-top: 1.5rem;
    max-width: none;
  }

  @media (max-width: 960px) {
    .old-cards { grid-template-columns: 1fr; }
    .fund-cards { grid-template-columns: 1fr 1fr; }
    .duo { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .fund-cards { grid-template-columns: 1fr; }
    .fund-cards li { translate: none; }
    .stack li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .stack .seg {
      font-size: 0.7rem;
      padding: 0 0.45rem;
    }
  }
</style>
