---
// Memory (Per-Ankh) and the private on-device algorithms. Sources: khensu-specs PLAN.md (Local search and memory,
// Public square, Stealth, iOS limits), WEBE.md 5, 8 and 10, PROTOCOL.md 8.8 and 9, design/mesh.md 3,
// hardware/sunu/SPEC.md, COMPLIANCE.md. Algorithm charts are in MemAlgos; the shield comparison is in MemShield.
import Base from '../layouts/Base.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import RevealText from '../components/khensu/RevealText.astro';
import ShieldViewer from '../components/khensu/ShieldViewer.astro';
import MemPhone from '../components/khensu/MemPhone.astro';
import MemAlgos from '../components/khensu/MemAlgos.astro';
import MemShield from '../components/khensu/MemShield.astro';

const stats = [
  { n: '0', t: 'servers in the loop' },
  { n: '0 bytes', t: 'of your taste sent anywhere' },
  { n: '4', t: 'algorithms, all on device' },
  { n: '2 s', t: 'tick, same size every time' },
];
const remembers = [
  { t: 'Your conversations', b: 'Messages, voice notes, photos and the links people send you, so you can search them and ask about them.' },
  { t: 'What matters in them', b: 'Plans, dates, decisions, places and the things people asked you, each linked to the message it came from.' },
  { t: 'Who and where', b: 'The people, groups and places that come up, so “what did Sam say about Naxos?” just works.' },
  { t: 'What you watch and read', b: 'Posts, videos, live streams, forums and places, if you switch on your personal feed.' },
];
const memoryRules = [
  { t: 'Encrypted on your device', b: 'AES-256 with a key the Secure Enclave never releases. Unreadable while your phone is locked; opened only after Face ID.' },
  { t: 'Never backed up or synced', b: 'Each of your devices builds its own memory from your messages. The memory itself never leaves the device.' },
  { t: 'Deleted with its source', b: 'Delete a message, or let it disappear, and every fact and vector learned from it goes too.' },
  { t: 'Leave any chat out', b: 'One switch keeps a chat out of your memory on your device.' },
];
const controls = [
  { t: 'See what it knows', b: 'One screen lists every interest it has learned, with the plain reason it learned it.' },
  { t: 'Remove or add', b: 'Remove an interest and it’s gone from your feed at once, and never relearned unless you add it back.' },
  { t: 'Choose the signals', b: 'Stop it learning from any habit: time spent, replays, saves, live streams or places.' },
  { t: 'Pause or reset', b: 'Freeze everything where it is, or wipe everything it learned in one tap.' },
];
const diff = [
  { row: 'Works fully', plain: 'Yes', shield: 'Yes' },
  { row: 'Cover while the app is open', plain: 'A burst every 2 s', shield: 'A burst every 2 s' },
  { row: 'Cover while the app is closed', plain: 'Paused; iOS suspends the app', shield: 'Continues from the shield' },
  { row: 'Who talks to whom', plain: 'Hidden by the mixnet', shield: 'Hidden by the mixnet' },
  { row: 'When you use the app', plain: 'Visible to someone watching your connection', shield: 'Hidden: the pattern never changes' },
  { row: 'New messages while closed', plain: 'Push wake-up through Apple', shield: 'Bluetooth wake from the shield, no Apple push' },
  { row: 'Your feed when you open the app', plain: 'Fills in over the first ticks', shield: 'Already current' },
  { row: 'Relays for people nearby', plain: 'Only in node mode', shield: 'Yes, and earns as a node' },
];
const specs = [
  { k: 'Devices', v: 'iPhone, iPad and Mac with iOS, iPadOS or macOS 26. Search on every device; answers and summaries need Apple Intelligence (iPhone 15 Pro or later, iPad and Mac with M1 or later).' },
  { k: 'AI model', v: 'Apple Foundation Models, on device, with the Neural Engine. Private Cloud Compute is never requested. No Siri, no Writing Tools, no iCloud, no AI servers.' },
  { k: 'Words', v: 'SQLite FTS5 full-text index with BM25 ranking, offline, on every device.' },
  { k: 'Meaning', v: 'NLContextualEmbedding (multilingual, on device), stored as int8 vectors in the same encrypted database.' },
  { k: 'Facts and connections', v: 'Typed facts and entities extracted on device, each linked to its source messages; graph search up to two hops.' },
  { k: 'Voice notes and photos', v: 'SpeechTranscriber transcripts and Vision text and labels, searchable like messages.' },
  { k: 'Recall', v: 'Four searches in parallel, fused by reciprocal rank (k = 60), cut to a token budget for the 4,096-token on-device context.' },
  { k: 'Answers', v: 'Tool-calling session over recall, a few rounds of evidence, citations to the exact messages.' },
  { k: 'Storage', v: 'Encrypted SQLite with Complete Protection; key in the Secure Enclave; opened after Face ID. Never backed up or synced.' },
  { k: 'Feed ranking', v: 'On device: 0.45 interest, 0.25 people, 0.15 freshness, 0.15 anonymous counts; your rules and label lists last; at most two in a row from one person or topic. Chronological by default.' },
  { k: 'Interests', v: 'Half-life 14 days (60 days for saves and follows). Remove sets an interest to zero and blocks relearning.' },
  { k: 'Network', v: 'One burst every 2 s while open: 4 sealed packets of 10,248 bytes up and 4 down, about 72 MB per open hour each way. Directory lookups by PIR; objects up to 8 KiB in the ticks; larger ones through two relays, padded to power-of-two sizes from 4 KiB.' },
  { k: 'Public counts', v: 'Anonymous tallies: one rate-limited proof per person per post, counted by nodes, published per epoch.' },
  { k: 'Labels', v: 'Subscribable label lists; consensus labels shown only when raters who usually disagree agree, computed the same way on every device.' },
  { k: 'Battery', v: 'Estimate: 2–7% per open hour on cellular, about 0.5% on Wi-Fi.' },
  { k: 'With suñůlink.shield', v: 'Cover continues while the app is closed: about 11 hours on the shield’s own 14.0 Wh battery, longer on the cable from the box or a charger. Wakes the app over Bluetooth.' },
];
const sees = [
  { who: 'The first relay', what: 'Knows it’s you connecting. Can’t read what you asked for: the request is sealed for the second relay.' },
  { who: 'The second relay or cache', what: 'Knows which public post or stream was asked for. Has no idea who asked.' },
  { who: 'Someone watching your connection', what: 'Sees the same-size bursts every 2 seconds while the app is open, and with suñůlink.shield, all the time.' },
  { who: 'Us', what: 'Nothing. There is no khensu.ñü server in the path, no account history and no profile to look at.' },
];
const wellbeing = [
  { t: 'Chronological by default', b: 'Newest first from the people and forums you follow. The personal feed is something you choose.' },
  { t: 'An end to the feed', b: 'Turn off endless scrolling and the feed stops when you’ve caught up.' },
  { t: 'Time limits', b: 'A daily limit for the Feed and live streams. When it’s reached, the Feed rests until tomorrow. Chats keep working.' },
  { t: 'Why am I seeing this', b: 'Every recommended post shows which of your own habits led to it, and you can remove that reason.' },
];
---

<Base
  title="Memory: your private AI"
  description="khensu.ñü’s private AI remembers what you’ve been told and finds what you’re looking for, entirely on your iPhone, iPad or Mac. No tracking, no profile, no servers: here is how the algorithms work."
>
  <meta slot="head" name="color-scheme" content="dark" />

  <div class="khensu mem">
    <section class="mhero" id="memory-hero-section" data-hero aria-labelledby="mhero-title">
      <div class="wrap mhero-grid">
        <div class="mhero-phone">
          <MemPhone screen="foryou" video label="The For you feed in khensu.ñü: a trending aurora video from the ISS, a 360° live stream from the Hercules Caves in Tangier, and a night sail to Naxos, each with the reason it was recommended." />
        </div>
        <div class="mhero-copy">
          <p class="mhero-name">khensu.ñü Memory</p>
          <h1 id="mhero-title" class="mhero-h">Your private AI.<br /><em>It finds what you love, and tells no one.</em></h1>
          <ul class="stats" role="list">
            {stats.map((s) => <li><b>{s.n}</b><span>{s.t}</span></li>)}
          </ul>
          <p class="mhero-lede">
            It remembers what you’ve been told and finds what you love.<br />
            Everything runs on your iPhone, iPad or Mac.
          </p>
          <div class="btn-row">
            <a class="btn primary" href="#memory-recall-section">See how it works</a>
            <a class="btn" href="/app">Get the app</a>
          </div>
        </div>
      </div>
    </section>

    <ProductBar name="Memory" action="Get the app" href="/app" explore="#memory-recall-section" />

    <section class="section intro" id="memory-intro-section" aria-label="In short">
      <div class="wrap">
        <RevealText
          parts={[
            ['Most apps send what you watch to their servers and rank your feed there. '],
            ['khensu.ñü does the opposite. ', true],
            ['Your device brings public posts, streams and places home anonymously, inside traffic that never changes, and '],
            ['decides on its own what fits you. ', true],
            ['What you like never leaves your phone, because there’s nowhere for it to go.'],
          ]}
        />
      </div>
    </section>

    <section class="section" id="memory-per-ankh-section" aria-labelledby="ankh-title">
      <div class="wrap split">
        <div class="phone-col">
          <MemPhone screen="ask" label="Ask khensu answers “When do we sail to Naxos?” with the date, the plan and three sources: Sam’s chat message, the charter PDF and the skipper’s voice note." />
        </div>
        <div>
          <p class="eyebrow">per-ankh, your memory</p>
          <h2 id="ankh-title" class="big">Ask anything you’ve been told.<br /><em>Every answer shows its sources.</em></h2>
          <p class="lede">
            In ancient Egypt the Per-Ankh, the House of Life, kept the records. Yours lives on your phone: what you’ve
            said, heard and shared, searchable by words, meaning, people, places and time, and askable in plain language.
            Type <code>~catch-up</code> in a busy group or <code>~summarize</code> on a long thread.
          </p>
          <ul class="mini" role="list">
            {remembers.map((r) => <li><b>{r.t}</b><span>{r.b}</span></li>)}
          </ul>
        </div>
      </div>
      <div class="wrap">
        <ul class="cards" role="list">
          {memoryRules.map((r) => <li class="glass"><b>{r.t}</b><span>{r.b}</span></li>)}
        </ul>
      </div>
    </section>

    <MemAlgos />

    <section class="section story" id="memory-found-section" aria-labelledby="found-title">
      <div class="wrap">
        <div class="story-card">
          <video class="story-video" muted loop playsinline preload="none" poster="/khensu/codec/glowkey/iss-aurora.jpg" data-autoplay aria-label="Aurora over the Pacific, filmed from the International Space Station">
            <source src="/khensu/codec/glowkey/iss-aurora.mp4" type="video/mp4" />
          </video>
          <div class="story-copy">
            <p class="eyebrow">found for you</p>
            <h2 id="found-title" class="big">Found for you.<br /><em>Fetched for no one.</em></h2>
            <p>
              The aurora from the ISS is trending by anonymous counts. Your device fetched it in its ticks, ranked it, and
              had it ready before you scrolled to it. Nobody learned that you watched it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="memory-knows-section" aria-labelledby="knows-title">
      <div class="wrap split rev">
        <div>
          <p class="eyebrow">what it knows about me</p>
          <h2 id="knows-title" class="big">You can see it.<br /><em>Edit it, pause it, or wipe it.</em></h2>
          <p class="lede">
            Everything your device has learned is on one screen, each interest with the plain reason it was learned:
            sailing videos you watch to the end, posts about Naxos you saved, Ibiza opened on the map four times this
            week, live streams from the Caves of Hercules in Tangier. Remove anything, and your feed changes at once.
          </p>
          <ul class="mini" role="list">
            {controls.map((c) => <li><b>{c.t}</b><span>{c.b}</span></li>)}
          </ul>
        </div>
        <div class="phone-col">
          <MemPhone screen="knows" label="What it knows about me, only on this iPhone: Sailing, Live jazz, Naxos, Ibiza, Hercules Caves in Tangier and Climate organising, each with its reason and a Remove button; switches for time spent, live streams and places; Pause learning and Reset everything." />
        </div>
      </div>
    </section>

    <section class="section shield" id="memory-shield-section" aria-labelledby="shield-title">
      <div class="wrap">
        <p class="eyebrow">with or without suñůlink.shield</p>
        <h2 id="shield-title" class="big">Works without the shield.<br /><em>Never goes quiet with it.</em></h2>
        <p class="lede">
          khensu.ñü works fully on its own. While the app is open, your phone sends the same-size burst every 2 seconds,
          so nobody can tell when you’re active. What changes is what happens when you leave the app.
        </p>

        <MemShield />

        <div class="two">
          <div>
            <h3>Without the shield</h3>
            <p>
              iOS suspends an app within seconds of it leaving the screen and stops its network activity. Only push
              wake-ups through the Notification Service Extension, short background tasks and transfers the system
              schedules can run. So the constant cover stops while the app is closed, and starts again when you open it.
            </p>
            <p>
              Messages still arrive through push wake-ups, and the mixnet still hides who talks to whom. But someone
              watching your connection can see when the app is in use.
            </p>
          </div>
          <div>
            <h3>With suñůlink.shield</h3>
            <p>
              The shield is a node with its own battery, radios and processor on the back of your iPhone. It keeps the
              2-second tick going while the app is closed and receives your messages in its own slots, then wakes the
              app over Bluetooth instead of Apple’s push service.
            </p>
            <p>
              It carries your followed feeds so they’re current the moment you open the app, and relays for people
              nearby. Your traffic pattern never changes.
            </p>
          </div>
        </div>

        <div class="table-wrap">
          <table class="diff">
            <thead>
              <tr><th scope="col"></th><th scope="col">iPhone on its own</th><th scope="col">With suñůlink.shield</th></tr>
            </thead>
            <tbody>
              {diff.map((d) => (
                <tr><th scope="row">{d.row}</th><td>{d.plain}</td><td class="sh">{d.shield}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section viewer-sec" id="memory-viewer-section" aria-labelledby="viewer-title">
      <div class="wrap split">
        <div class="viewer-col">
          <ShieldViewer />
        </div>
        <div>
          <p class="eyebrow">suñůlink.shield</p>
          <h2 id="viewer-title" class="big">A node on the back of your iPhone.<br /><em>Cover that never sleeps.</em></h2>
          <p class="lede">
            Titanium or solid brass, flush with the camera, with its own 14.0 Wh battery and a guard chip that holds the
            2-second tick in hardware. Drag to turn it; on iPhone, view it in your space.
          </p>
          <div class="btn-row">
            <a class="btn primary" href="/buy">Buy suñůlink.shield</a>
            <a class="btn" href="/shield">Learn more</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="memory-who-section" aria-labelledby="who-title">
      <div class="wrap">
        <p class="eyebrow">who sees what</p>
        <h2 id="who-title" class="big">No one sees both.<br /><em>And we see nothing.</em></h2>
        <ul class="sees" role="list">
          {sees.map((s) => <li><b>{s.who}</b><span>{s.what}</span></li>)}
        </ul>
        <p class="footnote">
          An honest limit: someone able to watch a large part of the internet for a long time could still estimate
          roughly how much you use the network. They can’t see what you read, watch or like.
        </p>
      </div>
    </section>

    <section class="section specs-sec" id="memory-specs-section" aria-labelledby="specs-title">
      <div class="wrap">
        <p class="eyebrow">tech specs</p>
        <h2 id="specs-title" class="big">Tech specs.</h2>
        <dl class="specs">
          {specs.map((s) => (
            <div><dt>{s.k}</dt><dd>{s.v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section" id="memory-compare-section" aria-labelledby="vs-title">
      <div class="wrap">
        <p class="eyebrow">compared with server-side feeds</p>
        <h2 id="vs-title" class="big">Same goal: show you what you’ll love.<br /><em>Opposite place to do it.</em></h2>
        <div class="vs">
          <div class="vs-col them">
            <p class="vs-label">A typical server-side feed</p>
            <ol role="list">
              <li>What you watch, like and skip is sent to the company</li>
              <li>A profile of you is built and kept on its servers</li>
              <li>Your feed is ranked there, for time spent and for ads</li>
              <li>The profile stays with the company</li>
            </ol>
          </div>
          <div class="vs-col us">
            <p class="vs-label">khensu.ñü</p>
            <ol role="list">
              <li>Public content is fetched anonymously, inside constant traffic</li>
              <li>What you like is learned and kept on your device</li>
              <li>Your feed is ranked there, by your rules</li>
              <li>You can see it, edit it, or reset it</li>
            </ol>
          </div>
        </div>
        <p class="footnote">
          There is no advertising, no profiling and no data sale (<a href="/compliance">compliance</a>). TikTok,
          Instagram and YouTube rank feeds on their own servers using activity they collect; they are trademarks of their
          respective owners, named only for comparison.
        </p>
      </div>
    </section>

    <section class="section" id="memory-wellbeing-section" aria-labelledby="well-title">
      <div class="wrap">
        <p class="eyebrow">wellbeing</p>
        <h2 id="well-title" class="big">Built to be put down.<br /><em>Nobody earns from your attention.</em></h2>
        <ul class="cards" role="list">
          {wellbeing.map((w) => <li class="glass"><b>{w.t}</b><span>{w.b}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="section close" id="memory-start-section" aria-labelledby="start-title">
      <div class="wrap close-in">
        <h2 id="start-title" class="big">Your memory. Your feed.<br /><em>Only on your device.</em></h2>
        <div class="btn-row">
          <a class="btn primary" href="/app">Get the app</a>
          <a class="btn" href="/buy">Add suñůlink.shield</a>
        </div>
        <p class="footnote">
          Feed scores, interest weights and recall scores on this page are computed from the formulas shown. Battery
          figures are estimates; suñůlink.shield runs about 11 hours on its own battery while relaying and keeps going on
          the cable from the box or a charger; battery life varies with use and settings. Wire rules in the
          <a href="https://dev.khensu.nu/specs">specifications</a>: PROTOCOL 8.8 (ticks) and 9 (PIR), webË 5 (fetch), 8
          (feeds) and 10 (labels). Apple Intelligence is a trademark of Apple Inc.
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/viewer-scroll.ts';
</script>

<style>
  .mem {
    color-scheme: dark;
    --glass-bg: linear-gradient(160deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.02));
    --glass-line: rgba(255, 255, 255, 0.12);
  }
  .big {
    font-size: clamp(1.9rem, 4vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    max-width: none;
  }
  h2[id] {
    scroll-margin-top: 8rem;
  }
  h2 > br:has(+ :global(.sec-link)) {
    display: none;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  /* Hero: phone left, header right, side by side from 700 px */
  .mhero {
    padding: clamp(6rem, 10vw, 8rem) 0 clamp(3rem, 6vw, 5rem);
    background: radial-gradient(55% 60% at 25% 45%, rgba(139, 123, 255, 0.18), transparent 70%), #000;
    overflow: hidden;
  }
  .mhero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .mhero-phone {
    display: flex;
    justify-content: center;
    --phone-w: min(78vw, 330px);
  }
  @media (max-width: 699px) {
    .mhero-copy {
      order: -1;
    }
  }
  .mhero-name {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.92);
  }
  .mhero-h {
    margin: 0;
    font-size: clamp(2.6rem, 6.4vw, 5.6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: none;
  }
  .mhero-h :global(em) {
    display: block;
    font-style: normal;
    color: #b9adff;
  }
  .mhero-h > br:has(+ :global(.sec-link)) {
    display: none;
  }
  .stats {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 1.2rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .stats li {
    display: grid;
    align-content: start;
    gap: 0.2rem;
  }
  .stats b {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .stats span {
    font-size: 0.82rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.6);
  }
  @media (max-width: 1000px) and (min-width: 700px), (max-width: 460px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.3rem;
    }
  }
  .mhero-lede {
    margin: 1.4rem 0 0;
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: rgba(255, 255, 255, 0.62);
  }
  @media (min-width: 700px) {
    .mhero-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
    .mhero-phone {
      --phone-w: min(34vw, 360px);
    }
  }

  .intro {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 880px) {
    .split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .split.rev {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }
  .phone-col {
    display: flex;
    justify-content: center;
    --phone-w: min(78vw, 320px);
  }
  .mini {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.2rem 1.6rem;
  }
  .mini li {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }
  .mini b {
    font-weight: 500;
  }
  .mini span {
    color: var(--text-dim);
    font-size: 0.94rem;
  }

  .glass {
    background: var(--glass-bg);
    border: 1px solid var(--glass-line);
    border-radius: 22px;
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 24px 60px rgba(0, 0, 0, 0.28);
  }
  .cards {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .cards li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.5rem 1.4rem;
  }
  .cards b {
    font-size: 1.08rem;
    font-weight: 500;
  }
  .cards span {
    color: var(--text-dim);
