---
import Base from '../layouts/Base.astro';
import ShieldViewer from '../components/khensu/ShieldViewer.astro';
import Turntable from '../components/khensu/Turntable.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import Highlights from '../components/khensu/Highlights.astro';
import RevealText from '../components/khensu/RevealText.astro';

// No card processor: reservations are free and go by email, so no server handles them. Payment opens in the
// khensu.nu app over the network's own shielded payments, and every reservation is invited to pay there first.
const SHIPS = 'Q1 2027';
const RESERVE_TO = 'hello@elliottwave.studio';
const reserveHref = (edition: string, finish: string, price: number) =>
  `mailto:${RESERVE_TO}?subject=${encodeURIComponent(`Reserve suñůlink.shield: ${edition}, ${finish}`)}&body=${encodeURIComponent(
    `Please reserve one suñůlink.shield.\n\nEdition: ${edition} ($${price})\nFinish: ${finish}\niPhone: 18 Pro or 18 Pro Max\n\nNo payment now. Invite me to pay in the khensu.nu app when it opens.`,
  )}`;

const titanium = [
  { id: 'maroon', name: 'Maroon', hex: '#5e1a24' },
  { id: 'gold', name: 'Gold', hex: '#b8955a' },
  { id: 'black', name: 'Black', hex: '#232427' },
];
const editions = [
  {
    id: 'titanium',
    tier: 'standard',
    name: 'Titanium',
    price: 299,
    body: 'Ceramic-coated titanium in your iPhone’s colour. The stone inlay, with a platinum line.',
    finishes: titanium,
  },
  {
    id: 'brass',
    tier: 'standard',
    name: 'Solid brass',
    price: 269,
    body: 'Solid brass that darkens to a patina as you carry it. The same stone inlay and platinum line.',
    finishes: [{ id: 'brass', name: 'Brass', hex: '#b8914a' }],
  },
  {
    id: 'moldavite',
    tier: 'moldavite',
    name: 'Titanium with moldavite',
    price: 389,
    body: 'Adds a moldavite node point and Paraíba tourmaline markers to the inlay. Priced for the stones, not for rarity.',
    finishes: titanium,
  },
  {
    id: 'brass-moldavite',
    tier: 'moldavite',
    name: 'Brass with moldavite',
    price: 359,
    body: 'Solid brass with the full inlay: a moldavite node point and Paraíba tourmaline markers.',
    finishes: [{ id: 'brass', name: 'Brass', hex: '#b8914a' }],
  },
];

// Expected cost per shield at the first production run, in US dollars. Prices sit a few percent above it.
const parts = [
  ['Electronics and battery', 78, 78, 78, 78],
  ['Machined housing', 87, 62, 87, 62],
  ['Stone inlay, cut and set', 45, 45, 125, 125],
  ['Platinum line, laid by hand', 15, 15, 15, 15],
  ['Assembly and testing', 12, 12, 12, 12],
  ['Packaging and USB-C cable', 8, 8, 8, 8],
  ['Certification, per unit', 5, 5, 5, 5],
] as const;
const costs = editions.map((e, i) => {
  const unit = parts.reduce((s, p) => s + (p[i + 1] as number), 0);
  const shipping = 15;
  const warranty = unit * 0.05;
  const total = unit + shipping + warranty;
  return { unit, shipping, warranty, total, profit: e.price - total };
});
const usd = (n: number) => `$${n.toFixed(2).replace(/\.00$/, '')}`;

const stones = [
  { name: 'Lapis lazuli', img: 'lapis', where: 'The crescent', note: 'Deep blue with flecks of pyrite. From Chile.', chakra: 'Third eye and throat', meaning: 'Wisdom and truth. Worn by Egyptian royalty, and inlaid in Tutankhamun’s golden mask.' },
  { name: 'Labradorite', img: 'labradorite', where: 'The disc', note: 'Grey that flashes blue and gold as it turns. From Madagascar.', chakra: 'Third eye and crown', meaning: 'Intuition and protection. Called a stone of transformation, for the light hidden inside it.' },
  { name: 'Black onyx', img: 'onyx', where: 'A node point in the disc', note: 'Deep, polished black. From Brazil.', chakra: 'Root', meaning: 'Strength and grounding. A shield that keeps what is yours, yours.' },
  { name: 'Bloodstone', img: 'bloodstone', where: 'The ring', note: 'Green with red flecks, in every shield. From India.', chakra: 'Root and heart', meaning: 'Courage and vitality. Carried by warriors for endurance.' },
  { name: 'Blue kyanite', img: 'kyanite', where: 'A node point in the disc', note: 'Bladed blue that shifts with the light, in every shield. From Brazil.', chakra: 'Throat', meaning: 'Clear communication and alignment. Said never to hold on to negative energy.' },
  { name: 'Tourmaline', img: 'tourmaline', where: 'Twelve markers in the ring', note: 'Pink, green, blue, canary and watermelon, with neon Paraíba in the moldavite tiers. From Brazil and Mozambique.', chakra: 'All seven, by colour; Paraíba for throat and heart', meaning: 'Balance and protection. Watermelon tourmaline joins the heart’s pink and green.' },
  { name: 'Moldavite', img: 'moldavite', where: 'A second node point in the disc', note: 'Green glass from a meteorite strike, found only in Czechia. In the moldavite tiers.', chakra: 'Heart and crown', meaning: 'Rapid change and awakening. Born of a meteorite strike 15 million years ago.' },
];
---

<Base title="Reserve suñůlink.shield" description="Reserve suñůlink.shield: a post-quantum node in titanium or brass, made in Morocco, with the khensu.nu mark inlaid flush in bloodstone, lapis, labradorite, onyx, kyanite and tourmaline, with platinum.">
  <Turntable frames={48} base="/khensu/renders/turn/" name="suñůlink.shield" alt="suñůlink.shield in solid brass, turning to show the khensu.nu mark inlaid in stone and platinum on the back">
    Made in Morocco.<br /><em>Inlaid with stone.</em>
  </Turntable>

  <ProductBar name="suñůlink.shield" action="Reserve" href="#order" explore="/shield" />

  <section class="price-band">
    <div class="wrap price-in" data-reveal>
      <p>
        A post-quantum node for your iPhone in titanium or brass, with the khensu.nu mark set flush into the back
        in natural stone and platinum.
      </p>
      <div class="price-cta">
        <span><b>From ${Math.min(...editions.map((e) => e.price))}</b> · Expected to ship {SHIPS}</span>
        <a class="btn primary" href="#order">Reserve</a>
      </div>
    </div>
  </section>

  <Highlights
    title="Get the highlights."
    cards={[
      { img: '/khensu/renders/macro.webp', alt: 'Macro of the inlay: labradorite, a lapis crescent, a bloodstone ring with tourmaline markers, kyanite and onyx points, set into brushed brass', text: 'The khensu.nu mark in natural stone, lapped flush with the metal.', fit: 'cover' },
      { img: '/khensu/renders/hero.webp', alt: 'suñůlink.shield in maroon ceramic-coated titanium, angled', text: 'Ceramic-coated titanium in maroon, gold or black.' },
      { img: '/khensu/renders/lineup.webp', alt: 'Four shields side by side: maroon, gold and black titanium, and solid brass', text: 'Four finishes. One inlay, cut from its own stones.' },
      { img: '/khensu/renders/phone.webp', alt: 'suñůlink.shield in maroon on the back of an iPhone 18 Pro', text: 'Made for iPhone 18 Pro and Pro Max.' },
    ]}
  />

  <section class="section buy" id="order">
    <div class="wrap order-head" data-reveal>
      <h2 class="big">Choose yours.</h2>
    </div>
    <div class="wrap buy-grid">
      <ShieldViewer />

      <div class="order">
        <ul class="editions" role="list">
          {editions.map((e, i) => (
            <li>
              <button class:list={['edition', { on: i === 0 }]} data-edition={e.id} data-tier={e.tier} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="ed-top"><b>{e.name}</b><span class="price">${e.price}</span></span>
                <span class="ed-body">{e.body}</span>
              </button>
            </li>
          ))}
        </ul>

        {editions.map((e, i) => (
          <div class="options" data-for={e.id} hidden={i !== 0}>
            <p class="opt-label">Finish</p>
            <div class="swatches">
              {e.finishes.map((f, j) => (
                <button class:list={['swatch', { on: j === 0 }]} data-finish={f.id} aria-label={f.name} title={f.name}>
                  <span style={`background:${f.hex}`}></span>
                </button>
              ))}
            </div>
            <p class="opt-note">Platinum crescent line</p>
            <a class="btn primary reserve" data-edition-name={e.name} data-price={e.price} href={reserveHref(e.name, e.finishes[0].name, e.price)}>Reserve · ${e.price}</a>
            <p class="ships">Expected to ship {SHIPS}</p>
          </div>
        ))}

        <p class="fine">
          Reserving is free and takes nothing but an email. When payment opens in the khensu.nu app, over our own
          network with no card processor, reservations are invited to pay first, in the order they came in. Your shield
          is expected to ship in {SHIPS}; you can cancel for a full refund at any time before it ships.
        </p>
        <p class="more-phones">
          This first shield fits iPhone 18 Pro and Pro Max. More shields follow in {SHIPS}: every iPhone back to
          iPhone X, and the equivalent Pixel and Galaxy S phones.
        </p>
      </div>
    </div>
  </section>

  <section class="story">
    <div class="wrap story-head" data-reveal>
      <p class="story-eyebrow">The inlay</p>
      <h2 class="story-title">The mark, in stone.<br />Flush to the metal.</h2>
    </div>
    <img class="story-render" src="/khensu/renders/macro.webp" width="1600" height="1200" loading="lazy" decoding="async" alt="Macro of the inlay: a labradorite disc, a lapis crescent with its platinum line, a bloodstone ring with tourmaline markers, and kyanite and onyx points, set flush into brushed brass." />
    <div class="wrap">
      <RevealText
        parts={[
          ['Each stone is '],
          ['cut by machine to the shape of its part of the mark', true],
          [', set into a pocket milled in the back and lapped down with the metal until '],
          ['the surface is one smooth plane you can’t feel with a fingernail', true],
          ['. The platinum line is laid in by hand, '],
          ['the way Meknes craftspeople have inlaid silver into steel for centuries', true],
          ['.'],
        ]}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="stones" role="list">
        {stones.map((s) => (
          <li>
            <div class="stone-head">
              <img src={`/khensu/stones/${s.img}.jpg`} alt="" width="120" height="120" loading="lazy" decoding="async" />
              <div><b>{s.name}</b><small>{s.where}</small></div>
            </div>
            <span class="note">{s.note}</span>
            <span class="chakra"><em>Chakra</em> {s.chakra}</span>
            <span class="meaning">{s.meaning}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Made in Morocco</p>
        <h2 class="big">Aerospace machining. <em>Finished by hand.</em></h2>
        <p class="lede">
          The titanium and brass are machined on five-axis CNC by Morocco’s aerospace suppliers, then inlaid, lapped
          and finished by hand by Moroccan craftspeople. Built where it’s made well, priced so more people can carry
          one.
        </p>
      </div>
      <dl class="specs">
        <div><dt>14 hours</dt><dd>relaying on a full charge (estimate), then a sip of your iPhone’s battery</dd></div>
        <div><dt>25 min</dt><dd>to 50% over USB-C from a wall charger or power bank, full in about 75 (design targets)</dd></div>
        <div><dt>+3 mm</dt><dd>above your iPhone’s lenses, clear of every field of view</dd></div>
        <div><dt>121 g</dt><dd>in titanium; about 148 g in brass</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Cost and profit</p>
      <h2 class="big">Priced close to cost. <em>On purpose.</em></h2>
      <p class="lede narrow">
        Each price sits a few percent above what we expect a shield to cost to make, ship and back with its warranty.
        The money goes into the shield, not into margin. These are expected costs for the first production run; we’ll
        publish the actual costs after it ships.
      </p>
      <div class="cost-wrap">
        <table class="cost">
          <thead>
            <tr><th scope="col">Expected cost per shield</th>{editions.map((e) => <th scope="col">{e.name}</th>)}</tr>
          </thead>
          <tbody>
            {parts.map((p) => (
              <tr><th scope="row">{p[0]}</th>{editions.map((_, i) => <td>{usd(p[i + 1] as number)}</td>)}</tr>
            ))}
            <tr class="sub"><th scope="row">Cost to make</th>{costs.map((c) => <td>{usd(c.unit)}</td>)}</tr>
            <tr><th scope="row">Shipping to you</th>{costs.map((c) => <td>{usd(c.shipping)}</td>)}</tr>
            <tr><th scope="row">Warranty reserve (5%)</th>{costs.map((c) => <td>{usd(c.warranty)}</td>)}</tr>
            <tr><th scope="row">Payment processing</th>{costs.map(() => <td>$0</td>)}</tr>
            <tr class="sub"><th scope="row">Total expected cost</th>{costs.map((c) => <td>{usd(c.total)}</td>)}</tr>
            <tr><th scope="row">Price</th>{editions.map((e) => <td>{usd(e.price)}</td>)}</tr>
            <tr class="profit">
              <th scope="row">Expected profit</th>
              {costs.map((c, i) => <td>{usd(c.profit)} <small>({((c.profit / editions[i].price) * 100).toFixed(1)}%)</small></td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="fine cost-note">
        Prices include shipping. Payment goes over khensu.nu’s own network: no card fee, only a network fee of a fraction
        of a cent (design target), paid to the people who run the nodes. Sales tax and import duty, where they apply, are
        shown before you pay.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <p class="footnote">
        For iPhone 18 Pro and Pro Max first; more models follow in {SHIPS}. Stones are natural, so colour and pattern vary, and
        they are softer than the metal around them: sealed, but they may show fine wear over years, like a watch dial.
        Stone photographs are illustrative; every inlay is cut from its own stones. Chakras and meanings are traditional beliefs, shared for their history, not as claims. Moldavite is certified genuine. Sources are traceable, and our lapis does not come from Afghanistan. Battery
        and charge times are targets; production figures may change. The 3D view and AR use the current CAD model, and
        the inlay is composed from stone photographs to show the design, not a specific shield. iPhone is a trademark of Apple Inc.
      </p>
      <p><a href="/shield">Full suñůlink.shield details</a></p>
    </div>
  </section>
</Base>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    items.forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) io.observe(el); else el.classList.add('in'); });
    document.documentElement.classList.add('reveal-ready');
  }
  const state = { finish: 'maroon', tier: 'standard' };
  const closeup = document.querySelector<HTMLImageElement>('.inlay-closeup');
  const send = () => {
    dispatchEvent(new CustomEvent('shield:finish', { detail: { ...state } }));
    if (closeup) closeup.src = `/khensu/stones/inlay-${state.tier}.png`;
  };
  const pick = (group: Element, el: Element) => {
    group.querySelectorAll('.on').forEach((b) => b.classList.remove('on'));
    el.classList.add('on');
  };
  const sync = (opts: HTMLElement) => {
    const sw = opts.querySelector<HTMLElement>('.swatch.on')!;
    state.finish = sw.dataset.finish!;
    const a = opts.querySelector<HTMLAnchorElement>('.reserve');
    if (a) {
      const subject = `Reserve suñůlink.shield: ${a.dataset.editionName}, ${sw.title}`;
      const url = new URL(a.href);
      const body = (url.searchParams.get('body') ?? '').replace(/Finish: .*/, `Finish: ${sw.title}`);
      a.href = `mailto:${url.pathname}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }
    send();
  };
  for (const b of document.querySelectorAll<HTMLElement>('.edition')) {
    b.addEventListener('click', () => {
      document.querySelectorAll('.edition').forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-pressed', 'false'); });
      b.classList.add('on');
      b.setAttribute('aria-pressed', 'true');
      state.tier = b.dataset.tier!;
      let shown: HTMLElement | null = null;
      for (const o of document.querySelectorAll<HTMLElement>('.options')) {
        o.hidden = o.dataset.for !== b.dataset.edition;
        if (!o.hidden) shown = o;
      }
      if (shown) sync(shown);
    });
  }
  for (const o of document.querySelectorAll<HTMLElement>('.options')) {
    o.querySelectorAll('.swatch').forEach((s) => s.addEventListener('click', () => { pick(o.querySelector('.swatches')!, s); sync(o); }));
  }
</script>

<style>
  .narrow { max-width: 46rem; }
  .price-band { background: #000; padding: clamp(2.5rem, 6vw, 4rem) 0; border-bottom: 1px solid var(--line); }
  .price-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem 3rem; }
  .price-in p { margin: 0; max-width: 40rem; color: var(--text-dim); font-size: clamp(1.05rem, 1.6vw, 1.25rem); }
  .price-cta { display: flex; align-items: center; gap: 1.2rem; }
  .price-cta b { color: var(--text); font-weight: 600; }
  .order-head { margin-bottom: 2rem; }
  .story { background: #000; padding: clamp(5rem, 12vw, 10rem) 0; }
  .story-head { text-align: center; }
  .story-eyebrow { margin: 0 0 0.8rem; color: var(--text-dim); font-size: clamp(1.05rem, 1.8vw, 1.4rem); font-weight: 500; }
  .story-title { margin: 0; font-size: clamp(2.6rem, 6.5vw, 5.5rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.04; }
  .story-render {
    display: block;
    width: min(100%, 1400px);
    height: auto;
    margin: clamp(2rem, 6vw, 4rem) auto;
    -webkit-mask-image: radial-gradient(75% 70% at 50% 50%, #000 55%, transparent 100%);
    mask-image: radial-gradient(75% 70% at 50% 50%, #000 55%, transparent 100%);
  }
  [data-reveal] { transition: opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), translate 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  :global(.reveal-ready) [data-reveal]:not(.in) { opacity: 0; translate: 0 40px; }
  @media (prefers-reduced-motion: reduce) { [data-reveal] { transition: none; } }
  .inlay-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .inlay-closeup { width: min(420px, 80vw); height: auto; aspect-ratio: 1; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6)); }
  @media (max-width: 900px) { .inlay-head { grid-template-columns: 1fr; justify-items: center; } }
  .buy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .order { display: grid; gap: 1rem; }
  .editions { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .edition {
    width: 100%;
    display: grid;
    gap: 0.3rem;
    text-align: left;
    padding: 1rem 1.1rem;
    border-radius: 18px;
    color: var(--text);
    font: inherit;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
  }
  .edition.on {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03));
    border-color: rgba(185, 173, 255, 0.6);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  .ed-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .price { font-size: 1.15rem; font-weight: 500; }
  .ed-body { color: var(--text-dim); font-size: 0.9rem; }
  .options { display: grid; gap: 0.6rem; }
  .options[hidden] { display: none; }
  .opt-label { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--text-dim); }
  .opt-note { margin: 0.4rem 0 0; font-size: 0.9rem; }
  .swatches, .accents { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .swatch {
    width: 2.2rem;
    height: 2.2rem;
    padding: 3px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: none;
    cursor: pointer;
  }
  .swatch span { display: block; width: 100%; height: 100%; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2); }
  .swatch.on { border-color: #fff; }
  .accent {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.85rem;
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    cursor: pointer;
  }
  .accent.on { border-color: #fff; background: rgba(255, 255, 255, 0.12); }
  .reserve { margin-top: 0.6rem; justify-self: start; }
  .reserve[aria-disabled] { opacity: 0.6; cursor: default; }
  .ships { margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--text-dim); }
  .fine { margin: 0; font-size: 0.8rem; color: var(--text-dim); }
  .more-phones { margin: 0; font-size: 0.85rem; padding: 0.8rem 1rem; border-radius: 14px; background: rgba(185, 173, 255, 0.08); border: 1px solid rgba(185, 173, 255, 0.2); }
  .cost-wrap { margin-top: 2rem; overflow-x: auto; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.03); }
  .cost { width: 100%; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .cost th, .cost td { padding: 0.65rem 1rem; text-align: right; border-bottom: 1px solid rgba(255, 255, 255, 0.06); white-space: nowrap; }
  .cost th[scope='row'], .cost thead th:first-child { text-align: left; font-weight: 400; color: var(--text-dim); }
  .cost thead th { font-weight: 600; color: var(--text); }
  .cost .sub th, .cost .sub td { color: var(--text); font-weight: 600; }
  .cost .profit th, .cost .profit td { color: #b9adff; font-weight: 600; border-bottom: 0; }
  .cost small { font-weight: 400; color: var(--text-dim); }
  .cost-note { margin-top: 0.8rem; }
  .stones {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .stones li {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .stones li { gap: 0.55rem; }
  .stone-head { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 0.2rem; }
  .stone-head img { width: 3.6rem; height: 3.6rem; flex: none; border-radius: 50%; object-fit: cover; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08); }
