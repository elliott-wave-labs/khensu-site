---
import Base from '../layouts/Base.astro';
import ShieldViewer from '../components/khensu/ShieldViewer.astro';

// Stripe Payment Links for the refundable deposit, one per edition (Stripe Dashboard > Payment Links).
// Until a link is set, that edition's button reserves by email instead.
const DEPOSIT = 49;
const links = {
  titanium: import.meta.env.PUBLIC_STRIPE_TITANIUM ?? '',
  brass: import.meta.env.PUBLIC_STRIPE_BRASS ?? '',
  limited: import.meta.env.PUBLIC_STRIPE_LIMITED ?? '',
};
const mail = (e: string) => `mailto:hello@elliottwave.studio?subject=${encodeURIComponent(`Reserve suñůlink.shield, ${e}`)}`;

const editions = [
  {
    id: 'titanium',
    name: 'Titanium',
    price: 399,
    body: 'Ceramic-coated titanium in your iPhone’s colour. The stone inlay, with a platinum line.',
    finishes: [
      { name: 'Burgundy', hex: '#5e1a24' },
      { name: 'Glacier', hex: '#b9c8d4' },
      { name: 'Silver', hex: '#cfd0cf' },
      { name: 'Black', hex: '#232427' },
    ],
  },
  {
    id: 'brass',
    name: 'Solid brass',
    price: 349,
    body: 'Solid brass that darkens to a patina as you carry it. The same stone inlay and platinum line.',
    finishes: [{ name: 'Brass', hex: '#b8914a' }],
  },
  {
    id: 'limited',
    name: 'Limited edition',
    price: 999,
    body: 'Adds moldavite and Paraíba tourmaline to the inlay. 500 made, each numbered.',
    finishes: [
      { name: 'Black titanium', hex: '#232427' },
      { name: 'Burgundy titanium', hex: '#5e1a24' },
      { name: 'Brass', hex: '#b8914a' },
    ],
  },
];

const stones = [
  { name: 'Lapis lazuli', img: 'lapis', where: 'The crescent', note: 'Deep blue with flecks of pyrite. From Chile.', chakra: 'Third eye and throat', meaning: 'Wisdom and truth. Worn by Egyptian royalty, and inlaid in Tutankhamun’s golden mask.' },
  { name: 'Labradorite', img: 'labradorite', where: 'The disc', note: 'Grey that flashes blue and gold as it turns. From Madagascar.', chakra: 'Third eye and crown', meaning: 'Intuition and protection. Called a stone of transformation, for the light hidden inside it.' },
  { name: 'Black onyx', img: 'onyx', where: 'A node point in the disc', note: 'Deep, polished black. From Brazil.', chakra: 'Root', meaning: 'Strength and grounding. A shield that keeps what is yours, yours.' },
  { name: 'Bloodstone', img: 'bloodstone', where: 'The ring', note: 'Green with red flecks, in every edition. From India.', chakra: 'Root and heart', meaning: 'Courage and vitality. Carried by warriors for endurance.' },
  { name: 'Blue kyanite', img: 'kyanite', where: 'A node point in the disc', note: 'Bladed blue that shifts with the light, in every edition. From Brazil.', chakra: 'Throat', meaning: 'Clear communication and alignment. Said never to hold on to negative energy.' },
  { name: 'Tourmaline', img: 'tourmaline', where: 'Twelve markers in the ring', note: 'Pink, green, blue, canary and watermelon, with neon Paraíba in the limited edition. From Brazil and Mozambique.', chakra: 'All seven, by colour; Paraíba for throat and heart', meaning: 'Balance and protection. Watermelon tourmaline joins the heart’s pink and green.' },
  { name: 'Moldavite', img: 'moldavite', where: 'A second node point in the disc', note: 'Green glass from a meteorite strike, found only in Czechia. Limited edition.', chakra: 'Heart and crown', meaning: 'Rapid change and awakening. Born of a meteorite strike 15 million years ago.' },
];
---

<Base title="Pre-order suñůlink.shield" description="Pre-order suñůlink.shield: a post-quantum node in titanium or brass, made in Morocco, with the khensu.nu mark inlaid flush in bloodstone, lapis, labradorite, onyx, kyanite and tourmaline, with platinum.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">suñůlink.shield · pre-order</p>
      <h1>Made in Morocco. <em>Inlaid with stone.</em></h1>
      <p class="lede">
        A post-quantum node for your iPhone, machined from titanium or brass, with the khensu.nu mark set flush into
        the back in natural stone with a line of platinum. Every inlay is cut from its own stones, so no two are
        the same.
      </p>
    </div>
  </section>

  <section class="section buy">
    <div class="wrap buy-grid">
      <ShieldViewer />

      <div class="order">
        <ul class="editions" role="list">
          {editions.map((e, i) => (
            <li>
              <button class:list={['edition', { on: i === 0 }]} data-edition={e.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="ed-top"><b>{e.name}</b><span class="price">${e.price}</span></span>
                <span class="ed-body">{e.body}</span>
              </button>
            </li>
          ))}
        </ul>

        {editions.map((e, i) => (
          <div class="options" data-for={e.id} hidden={i !== 0}>
            <p class="opt-label">Finish</p>
            <div class="swatches">
              {e.finishes.map((f, j) => (
                <button class:list={['swatch', { on: j === 0 }]} data-hex={f.hex} data-brass={f.name.includes('Brass') ? '1' : ''} aria-label={f.name} title={f.name}>
                  <span style={`background:${f.hex}`}></span>
                </button>
              ))}
            </div>
            <p class="opt-note">Platinum crescent line</p>
            <a class="btn primary reserve" href={links[e.id as keyof typeof links] || mail(e.name)}>
              {links[e.id as keyof typeof links] ? `Reserve with a $${DEPOSIT} deposit` : 'Reserve by email'}
            </a>
          </div>
        ))}

        <p class="fine">
          Prices are targets and are confirmed before anything more is charged. The ${DEPOSIT} deposit holds your place in
          line, comes off the price, and is refunded in full whenever you ask before your shield ships.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="inlay-head">
        <div>
      <p class="eyebrow">The inlay</p>
      <h2 class="big">The mark, in stone. <em>Flush to the metal.</em></h2>
      <p class="lede narrow">
        Each stone is cut by machine to the shape of its part of the mark, set into a pocket milled in the back and
        lapped down with the metal until the surface is one smooth plane you can’t feel with a fingernail. The platinum
        line is laid in by hand, in the way Meknes craftspeople have inlaid silver into steel for centuries.
      </p>
        </div>
        <canvas class="inlay-closeup" width="1024" height="1024" role="img" aria-label="Close-up of the inlay: the khensu.nu mark with a bloodstone ring, a lapis crescent and a labradorite disc, in tourmaline markers in the ring and kyanite and onyx points in the disc."></canvas>
      </div>
      <ul class="stones" role="list">
        {stones.map((s) => (
          <li>
            <div class="stone-head">
              <img src={`/khensu/stones/${s.img}.jpg`} alt="" width="120" height="120" loading="lazy" decoding="async" />
              <div><b>{s.name}</b><small>{s.where}</small></div>
            </div>
            <span class="note">{s.note}</span>
            <span class="chakra"><em>Chakra</em> {s.chakra}</span>
            <span class="meaning">{s.meaning}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Made in Morocco</p>
        <h2 class="big">Aerospace machining. <em>Finished by hand.</em></h2>
        <p class="lede">
          The titanium and brass are machined on five-axis CNC by Morocco’s aerospace suppliers, then inlaid, lapped
          and finished by hand by Moroccan craftspeople. Built where it’s made well, priced so more people can carry
          one.
        </p>
      </div>
      <dl class="specs">
        <div><dt>5 hours</dt><dd>on a full charge, then a sip of your iPhone’s battery</dd></div>
        <div><dt>15 min</dt><dd>to 50% over its own USB-C, full in about 45</dd></div>
        <div><dt>+0 mm</dt><dd>level with your iPhone’s lenses</dd></div>
        <div><dt>93 g</dt><dd>in titanium; about 136 g in brass</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <p class="footnote">
        For iPhone 18 Pro and Pro Max first, then more models. Stones are natural, so colour and pattern vary, and
        they are softer than the metal around them: sealed, but they may show fine wear over years, like a watch dial.
        Stone photographs are illustrative; every inlay is cut from its own stones. Chakras and meanings are traditional beliefs, shared for their history, not as claims. Moldavite is certified genuine. Sources are traceable, and our lapis does not come from Afghanistan. Battery
        and charge times are targets; production figures may change. The 3D view uses the current CAD model, and the
        inlay is drawn to show the design, not a specific shield. iPhone is a trademark of Apple Inc. Payments are
        handled by Stripe.
      </p>
      <p><a href="/shield">Full suñůlink.shield details</a></p>
    </div>
  </section>
</Base>

<script>
  const state = { edition: 'titanium', hex: '#5e1a24', brass: false };
  const send = () =>
    dispatchEvent(
      new CustomEvent('shield:finish', {
        detail: { housing: state.hex, brass: state.brass, moldavite: state.edition === 'limited' },
      }),
    );
  const pick = (group: Element, el: Element) => {
    group.querySelectorAll('.on').forEach((b) => b.classList.remove('on'));
    el.classList.add('on');
  };
  const sync = (opts: HTMLElement) => {
    const sw = opts.querySelector<HTMLElement>('.swatch.on')!;
    state.hex = sw.dataset.hex!;
    state.brass = !!sw.dataset.brass;
    send();
  };
  for (const b of document.querySelectorAll<HTMLElement>('.edition')) {
    b.addEventListener('click', () => {
      document.querySelectorAll('.edition').forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-pressed', 'false'); });
      b.classList.add('on');
      b.setAttribute('aria-pressed', 'true');
      state.edition = b.dataset.edition!;
      let shown: HTMLElement | null = null;
      for (const o of document.querySelectorAll<HTMLElement>('.options')) {
        o.hidden = o.dataset.for !== state.edition;
        if (!o.hidden) shown = o;
      }
      if (shown) sync(shown);
    });
  }
  for (const o of document.querySelectorAll<HTMLElement>('.options')) {
    o.querySelectorAll('.swatch').forEach((s) => s.addEventListener('click', () => { pick(o.querySelector('.swatches')!, s); sync(o); }));
  }
</script>

<style>
  .narrow { max-width: 46rem; }
  .inlay-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .inlay-closeup { width: min(420px, 80vw); height: auto; aspect-ratio: 1; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6)); }
  @media (max-width: 900px) { .inlay-head { grid-template-columns: 1fr; justify-items: center; } }
  .buy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .order { display: grid; gap: 1rem; }
  .editions { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .edition {
    width: 100%;
    display: grid;
    gap: 0.3rem;
    text-align: left;
    padding: 1rem 1.1rem;
    border-radius: 18px;
    color: var(--text);
    font: inherit;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
  }
  .edition.on {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03));
    border-color: rgba(185, 173, 255, 0.6);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  .ed-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .price { font-size: 1.15rem; font-weight: 500; }
  .ed-body { color: var(--text-dim); font-size: 0.9rem; }
  .options { display: grid; gap: 0.6rem; }
  .options[hidden] { display: none; }
  .opt-label { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--text-dim); }
  .opt-note { margin: 0.4rem 0 0; font-size: 0.9rem; }
  .swatches, .accents { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .swatch {
    width: 2.2rem;
    height: 2.2rem;
    padding: 3px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: none;
    cursor: pointer;
  }
  .swatch span { display: block; width: 100%; height: 100%; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2); }
  .swatch.on { border-color: #fff; }
  .accent {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.85rem;
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    cursor: pointer;
  }
  .accent.on { border-color: #fff; background: rgba(255, 255, 255, 0.12); }
  .reserve { margin-top: 0.6rem; justify-self: start; }
  .fine { margin: 0; font-size: 0.8rem; color: var(--text-dim); }
  .stones {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .stones li {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .stones li { gap: 0.55rem; }
  .stone-head { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 0.2rem; }
  .stone-head img { width: 3.6rem; height: 3.6rem; flex: none; border-radius: 50%; object-fit: cover; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08); }
  .stone-head div { display: grid; gap: 0.15rem; }
  .stone-head b { font-size: 1.05rem; }
  .stones small { color: #b9adff; font-size: 0.78rem; }
  .stones .note { color: var(--text-dim); font-size: 0.9rem; }
  .stones .chakra { font-size: 0.82rem; color: rgba(255, 255, 255, 0.82); }
  .stones .chakra em { font-style: normal; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: #b9adff; margin-right: 0.35rem; }
  .stones .meaning { font-size: 0.85rem; color: var(--text-dim); font-style: italic; }
  .two { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .specs { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin: 0; }
  .specs dt { font-size: 1.7rem; font-weight: 500; letter-spacing: -0.02em; }
  .specs dd { margin: 0; color: var(--text-dim); font-size: 0.9rem; }
  @media (max-width: 900px) {
    .buy-grid, .two { grid-template-columns: 1fr; }
  }
</style>
