---
import Base from '../layouts/Base.astro';
import ShieldViewer from '../components/khensu/ShieldViewer.astro';
import ArHero from '../components/khensu/ArHero.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import Highlights from '../components/khensu/Highlights.astro';
import RevealText from '../components/khensu/RevealText.astro';
import StatStrip from '../components/khensu/StatStrip.astro';

// Pre-order by email (decided 13 Oct 2026). No charge at reserve; pay later with ñü.wallet (no Stripe / card
// processor). Sell at cost (hardware + warranty, tax included) plus a flat $42 activation. Network fee only (estimate).
const SHIPS = 'Q1 2027';
// The only shipping option: overnight priority with Saturday delivery (FedEx Priority Overnight in the US; International
// Priority elsewhere, 1–3 business days). Charged at cost on top of the price. Estimate at contract rates for a 1 kg box;
// list rates are higher; final rate set at launch.
const SHIPPING = 42;
// Flat activation fee on every shield (tax included). Profit comes from this line after the network fee.
const ACTIVATION = 42;
// Prices include sales tax or VAT. The cost table assumes this blended rate to show what is left after tax.
const TAX = 0.08;
// Shielded-pool network fee to node operators (estimate; a fraction of a cent on small spends, shown as 1¢ ceiling).
const NETWORK_FEE = 0.01;
const ORDER_TO = 'hello@elliottwave.studio';

const colours = [
  { id: 'maroon', name: 'Burgundy', hex: '#70222e' },
  { id: 'glacier', name: 'Glacier', hex: '#c4d4df' },
  { id: 'silver', name: 'Silver', hex: '#d4d5d8' },
  { id: 'black', name: 'Black', hex: '#2e2f33' },
];
const models = [
  { id: 'pro', name: 'iPhone 18 Pro' },
  { id: 'max', name: 'iPhone 18 Pro Max' },
];
type Model = 'pro' | 'max';

// Expected cost per shield at the first production run, in US dollars:
// [Core Pro, Core Max, Ti Pro, Ti Max, brass Pro, brass Pro Max].
// Core drops Qi charging and the neural chips; Titanium and brass keep the full board.
const parts = [
  ['Machined housing', 87, 96, 87, 96, 62, 70],
  ['Electronics and battery', 48, 48, 78, 78, 78, 78],
  ['ñü.isheru, cut and set', 125, 125, 125, 125, 125, 125],
  ['Platinum line, laid by hand', 15, 15, 15, 15, 15, 15],
  ['Assembly and testing', 12, 12, 12, 12, 12, 12],
  ['Packaging and USB-C cable', 8, 8, 8, 8, 8, 8],
  ['Certification, per unit', 5, 5, 5, 5, 5, 5],
] as const;

const atCost = (unit: number) => Math.round((unit + unit * 0.05) * (1 + TAX));

const editions = [
  {
    id: 'core',
    tier: 'moldavite',
    name: 'Core',
    body: 'Ceramic powder-coated titanium in your iPhone’s colour. No Qi charging, no neural chips. Every stone, moldavite and Paraíba included, with a platinum line.',
  },
  {
    id: 'titanium',
    tier: 'moldavite',
    name: 'Titanium',
    body: 'Ceramic powder-coated titanium in your iPhone’s colour. Full board with Qi and neural chips. Every stone, moldavite and Paraíba included, with a platinum line.',
  },
  {
    id: 'brass',
    tier: 'moldavite',
    name: 'Solid brass',
    body: 'Solid brass that darkens to a patina as you carry it, on an iPhone of any colour. Full board with Qi and neural chips. The same full ñü.isheru and platinum line.',
  },
].map((e, ei) => {
  const pro = atCost(parts.reduce((s, p) => s + (p[ei * 2 + 1] as number), 0));
  const max = atCost(parts.reduce((s, p) => s + (p[ei * 2 + 2] as number), 0));
  return { ...e, price: { pro, max } };
});

const orderHref = (edition: string, model: string, colour: string, hardware: number) => {
  const total = hardware + ACTIVATION + SHIPPING;
  return `mailto:${ORDER_TO}?subject=${encodeURIComponent(`Pre-order suñůlink.shield: ${edition}, ${model}, ${colour}`)}&body=${encodeURIComponent(
    `I’d like to pre-order one sunulink.shield. No payment yet — reserve my place in the queue.\n\nEdition: ${edition}\niPhone: ${model}\nFinish: ${colour}\nShield at cost: $${hardware} including tax\nActivation: $${ACTIVATION}\nOvernight shipping: $${SHIPPING}\nTotal when I pay: $${total}\n\nPlease confirm the pre-order. I’ll pay with ñü.wallet on the network when you invoice me.`,
  )}`;
};

const columns = editions.flatMap((e) => models.map((m) => ({ edition: e, model: m, price: e.price[m.id as Model] })));
const costs = columns.map((c, i) => {
  const unit = parts.reduce((s, p) => s + (p[i + 1] as number), 0);
  const warranty = unit * 0.05;
  const hardwareTax = c.price - c.price / (1 + TAX);
  const activationTax = ACTIVATION - ACTIVATION / (1 + TAX);
  const tax = hardwareTax + activationTax;
  const fee = NETWORK_FEE;
  const profit = c.price + ACTIVATION - tax - unit - warranty - fee;
  return { unit, warranty, tax, fee, profit, net: c.price + ACTIVATION - tax };
});
const fromTotal = Math.min(...columns.map((c) => c.price)) + ACTIVATION;
const usd = (n: number) => `$${n.toFixed(2).replace(/\.00$/, '')}`;

const stones = [
  { name: 'moldavite', img: 'moldavite', where: 'A second node point in the disc', rare: 'Rarer than diamond', note: 'All the moldavite on Earth is estimated at about 275 tonnes, from a single asteroid strike 15 million years ago. Diamond mines bring up about 22 tonnes every year. Found only in Czechia, and running out.', chakra: 'Heart and crown', meaning: 'The stone of manifestation: believers say it brings whatever you set your heart on, fast. Forged when an asteroid hit Earth, flung into the sky in the fireball and rained back down as green glass.' },
  { name: 'tourmaline', img: 'tourmaline', where: 'Twelve markers in the ring', note: 'Pink, green, blue, canary and watermelon, with neon Paraíba. From Brazil and Mozambique.', chakra: 'All seven, by colour; Paraíba for throat and heart', meaning: 'Balance and protection. Watermelon tourmaline joins the heart’s pink and green.' },
  { name: 'white labradorite', img: 'labradorite', where: 'The disc, light half', note: 'Milky white with a blue glow, also sold as rainbow moonstone. From India and Madagascar.', chakra: 'Crown and third eye', meaning: 'Calm and new beginnings. Long carried by travellers at night.' },
  { name: 'black labradorite', img: 'labradorite', where: 'The disc, dark half', note: 'Near-black, with flashes of blue, green and gold. From Madagascar and Finland, where it’s called spectrolite.', chakra: 'Third eye and crown', meaning: 'Intuition and protection. Called a stone of transformation, for the light hidden inside it.' },
  { name: 'blue kyanite', img: 'kyanite', where: 'A node point in the disc', note: 'Bladed blue that shifts with the light, in every shield. From Brazil.', chakra: 'Throat', meaning: 'Clear communication and alignment. Said never to hold on to negative energy.' },
  { name: 'bloodstone', img: 'bloodstone', where: 'The ring', note: 'Green with red flecks, in every shield. From India.', chakra: 'Root and heart', meaning: 'Courage and vitality. Carried by warriors for endurance.' },
  { name: 'lapis lazuli', img: 'lapis', where: 'The crescent', note: 'Deep blue with flecks of pyrite. From Chile.', chakra: 'Third eye and throat', meaning: 'Wisdom and truth. Worn by Egyptian royalty, and inlaid in Tutankhamun’s golden mask.' },
  { name: 'pyrite', img: 'pyrite', where: 'The centre, the Triangulum triangle', note: 'Brassy gold, and cubic as it grows: from Navajún, Spain, where it forms in natural cubes. One filled triangle, the shape of α, β and γ, with α, β, γ, δ and ε laser-etched inside. Those are their Bayer letters. Every other star is its own stone, with no name. M33 is red tourmaline. The yellow disc above the triangle is the cluster NGC 752, in pyrite, and it is the one stone with a name.', chakra: 'Solar plexus', meaning: 'Willpower and abundance. Called fool’s gold, and long carried as a shield against negative energy.' },
  { name: 'black onyx', img: 'onyx', wide: true, where: 'The base every stone is set into, and a node point in the disc', note: 'Deep, polished black, framing the ring as a protective rim. From Brazil.', chakra: 'Root', meaning: 'Strength, grounding and protection: the base the whole mark stands on. A shield that keeps what is yours, yours.' },
];

// The seven chakras, crown to root, with each lotus's traditional petal count, colour and inner shape.
const chakras = [
  { key: 'crown', name: 'Crown', skt: 'Sahasrara', petals: 1000, hex: '#b07cff', shape: 'dot' },
  { key: 'third eye', name: 'Third eye', skt: 'Ajna', petals: 2, hex: '#6c6cff', shape: 'tri-down' },
  { key: 'throat', name: 'Throat', skt: 'Vishuddha', petals: 16, hex: '#38a8ff', shape: 'circle-tri' },
  { key: 'heart', name: 'Heart', skt: 'Anahata', petals: 12, hex: '#3ccf7a', shape: 'hexagram' },
  { key: 'solar', name: 'Solar plexus', skt: 'Manipura', petals: 10, hex: '#ffd23c', shape: 'tri-down' },
  { key: 'sacral', name: 'Sacral', skt: 'Svadhisthana', petals: 6, hex: '#ff8a3c', shape: 'crescent' },
  { key: 'root', name: 'Root', skt: 'Muladhara', petals: 4, hex: '#ff4b4b', shape: 'square' },
].map((c) => ({
  ...c,
  stones: stones
    .filter((st) => st.chakra.toLowerCase().includes(c.key) || st.chakra.startsWith('All seven'))
    .map((st) => st.name),
  petalPaths: Array.from({ length: Math.min(c.petals, 24) }, (_, i) => (360 / Math.min(c.petals, 24)) * i),
}));

---

<Base title="Buy suñůlink.shield" description="Buy sunulink.shield: a post-quantum node in titanium or brass, made in Morocco, with the ñü.isheru set flush in bloodstone, lapis, labradorite, onyx, kyanite and tourmaline, with platinum.">
  <ArHero src="/khensu/shell/3d/glb/brass-moldavite-phone.glb" name="suñůlink.shield" alt="suñůlink.shield in solid brass on an iPhone 18 Pro, at real size, turning to show the ñü.isheru in stone and platinum on the back">
    Made in Morocco.<br /><em>Set with the ñü.isheru.</em>
  </ArHero>

  <ProductBar name="suñůlink.shield" action="Pre-order" href="#order" explore="https://shield.khensu.nu" />

  <section class="price-band">
    <div class="wrap price-in" data-reveal>
      <p>A post-quantum node for your iPhone, set with the ñü.isheru. Pre-order now; pay later.</p>
      <div class="price-cta">
        <span><b>From ${fromTotal}</b> at cost + activation · Ships {SHIPS}</span>
        <a class="btn primary" href="#order">Pre-order</a>
      </div>
    </div>
    <div class="wrap">
      <StatStrip
        items={[
          { n: 0, unit: 'mm', label: 'Above the lenses: your iPhone gets no thicker' },
          { n: 95, unit: 'g', label: 'In titanium, or 136 g in solid brass' },
          { n: 7.5, dec: 1, unit: 'Wh', label: 'Its own battery, about 6 hours relaying' },
          { n: 50, unit: '%', label: 'Charged in 15 minutes from a 20 W USB-C charger' },
        ]}
      >
        Figures for iPhone 18 Pro. Battery life and charge time vary with use and settings.
      </StatStrip>
      <div class="made-of" data-reveal>
        <p class="made-of-line">Post-quantum E2EE stealth transceiver shield.<sup>2</sup> Ceramic powder-coated titanium or anti-microbial pure brass.<sup>1</sup> Set with the ñü.isheru gemstone, platinum, and a laser-etched pyrite hexagon, the mirror of the Triangulum constellation.</p>
        <ol class="made-of-notes">
          <li>Both rust-proof, for immunity on bluewater sails, weekend-warrior ready, and for the power hacker user.</li>
          <li>CNC’d to add 0 mm to your actual phone thickness, based on the camera bump.</li>
        </ol>
      </div>
    </div>
  </section>

  <Highlights
    title="Get the highlights."
    cards={[
      { img: '/khensu/renders/macro.webp', alt: 'Macro of the ñü.isheru: black and white labradorite, a lapis crescent, a bloodstone ring with tourmaline markers, kyanite and onyx points, set into brushed brass', text: 'The khėnsu.ñü mark in natural stone, lapped flush with the metal.', fit: 'cover' },
      { img: '/khensu/renders/hero.webp', alt: 'suñůlink.shield in Burgundy ceramic-coated titanium, angled', text: 'Ceramic-coated titanium in your iPhone’s colour: Burgundy, Glacier, Silver or Black.' },
      { img: '/khensu/renders/lineup.webp', alt: 'Four shields side by side: maroon, gold and black titanium, and solid brass', text: 'Four finishes. One ñü.isheru, each cut from its own stones.' },
      { img: '/khensu/renders/phone.webp', alt: 'suñůlink.shield in maroon on the back of an iPhone 18 Pro', text: 'Made for iPhone 18 Pro and Pro Max.' },
    ]}
  />

  <section class="section buy" id="order">
    <div class="wrap order-head" data-reveal>
      <h2 class="big">Choose yours.</h2>
    </div>
    <div class="wrap buy-grid">
      <ShieldViewer />

      <div class="order">
        <p class="opt-label">Model</p>
        <div class="seg" role="group" aria-label="iPhone model">
          {models.map((m, i) => (
            <button type="button" class:list={['model', { on: i === 0 }]} data-model={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>{m.name}</button>
          ))}
        </div>

        <p class="opt-label">Finish <span>· your iPhone’s colour</span></p>
        <div class="swatches" role="group" aria-label="Finish">
          {colours.map((f, j) => (
            <button type="button" class:list={['swatch', { on: j === 0 }]} data-finish={f.id} data-name={f.name} aria-pressed={j === 0 ? 'true' : 'false'} title={f.name}>
              <span class="dot" style={`background:${f.hex}`}></span>
              <span class="sw-name">{f.name}</span>
            </button>
          ))}
        </div>

        <p class="opt-label">Material</p>
        <ul class="editions" role="list">
          {editions.map((e, i) => (
            <li>
              <button type="button" class:list={['edition', { on: i === 0 }]} data-edition={e.id} data-name={e.name} data-tier={e.tier} data-pro={e.price.pro} data-max={e.price.max} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="ed-top"><b>{e.name}</b><span class="price">${e.price.pro}</span></span>
                <span class="ed-body">{e.body}</span>
              </button>
            </li>
          ))}
        </ul>

        <dl class="total" aria-live="polite">
          <div><dt>suñůlink.shield at cost, tax included</dt><dd data-out="price">${editions[0].price.pro}</dd></div>
          <div><dt>Activation</dt><dd>${ACTIVATION}</dd></div>
          <div><dt>Overnight priority shipping, Saturday delivery</dt><dd>${SHIPPING}</dd></div>
          <div class="sum"><dt>Total</dt><dd data-out="total">${editions[0].price.pro + ACTIVATION + SHIPPING}</dd></div>
        </dl>
        <p class="opt-note">Sold at cost to make and warranty. Every shield pays the same ${ACTIVATION} activation. Platinum crescent line, every stone, moldavite and Paraíba included.</p>
        <a class="btn primary reserve" data-shipping={SHIPPING} data-activation={ACTIVATION} href={orderHref(editions[0].name, models[0].name, colours[0].name, editions[0].price.pro)}>Pre-order · ${editions[0].price.pro + ACTIVATION + SHIPPING} when you pay</a>
        <p class="ships">Ships {SHIPS} · No charge to reserve</p>

        <p class="fine">
          Pre-order locks your configuration in the queue. Nothing is charged today. When payment opens, you pay with
          ñü.wallet on the network (shield at cost including tax, plus ${ACTIVATION} activation, plus overnight shipping).
          No card processor. Tap Pre-order to email your configuration; we confirm your place. Cancel any time before
          you pay. Ships in {SHIPS}.
        </p>
        <p class="more-phones">
          The 3D view shows iPhone 18 Pro; the Pro Max shield is the same design, sized to the larger phone. Shields for every iPhone back to iPhone X, and the equivalent Pixel
          and Galaxy S phones, ship in {SHIPS}.
        </p>
      </div>
    </div>
  </section>

  <section class="story" id="isheru">
    <div class="wrap story-head" data-reveal>
      <p class="story-eyebrow">ñü.isheru</p>
      <h2 class="story-title">The mark, in stone.<br />Flush to the metal.</h2>
      <p class="story-lede">The ñü.isheru is the khėnsu.ñü mark as a stone inlay: each stone cut to its part of the mark, set into the shield with a platinum line and lapped flush.</p>
    </div>
    <img class="story-render" src="/khensu/renders/macro.webp" width="1600" height="1200" loading="lazy" decoding="async" alt="Macro of the ñü.isheru: black and white labradorite disc, a lapis crescent with its platinum line, a bloodstone ring with tourmaline markers, and kyanite and onyx points, set flush into brushed brass." />
    <div class="wrap">
      <RevealText
        parts={[
          ['Each stone is '],
          ['cut by machine to the shape of its part of the mark', true],
          [', set into a pocket milled in the back and lapped down with the metal until '],
          ['the surface is one smooth plane you can’t feel with a fingernail', true],
          ['. The platinum line is laid in by hand, '],
          ['the way Meknes craftspeople have inlaid silver into steel for centuries', true],
          ['.'],
        ]}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="stone-layout">
      <ul class="stones" role="list">
        {stones.map((s) => (
          <li class:list={{ wide: 'wide' in s }}>
            <div class="stone-head">
              <img src={`/khensu/stones/${s.img}.jpg`} alt="" width="120" height="120" loading="lazy" decoding="async" />
              <div><b>{s.name}</b>{'rare' in s && <em class="rare">{(s as { rare: string }).rare}</em>}<small>{s.where}</small></div>
            </div>
            <span class="note">{s.note}</span>
            <span class="chakra"><em>Chakra</em> {s.chakra}</span>
            <span class="meaning">{s.meaning}</span>
          </li>
        ))}
      </ul>
      <aside class="chakras" aria-label="The seven chakras and the stones linked to each">
        <p class="chakras-title">the seven chakras</p>
        <ol role="list">
          {chakras.map((c) => (
            <li style={`--c:${c.hex}`}>
              <svg viewBox="-50 -50 100 100" aria-hidden="true" class="lotus">
                {c.petalPaths.map((a) => (
                  <ellipse cx="0" cy={c.petals === 2 ? -30 : -34} rx={c.petals === 2 ? 16 : c.petals > 16 ? 4 : 9} ry={c.petals === 2 ? 12 : 13} transform={`rotate(${c.petals === 2 ? a + 90 : a})`} />
                ))}
                <circle r="22" class="core" />
                {c.shape === 'square' && <rect x="-12" y="-12" width="24" height="24" />}
                {c.shape === 'crescent' && <path d="M-12 -4 A13 13 0 0 0 12 -4 A10 10 0 0 1 -12 -4 Z" />}
                {c.shape === 'tri-down' && <path d="M-14 -8 L14 -8 L0 15 Z" />}
                {c.shape === 'hexagram' && <path d="M0 -15 L13 7.5 L-13 7.5 Z M0 15 L13 -7.5 L-13 -7.5 Z" />}
                {c.shape === 'circle-tri' && <><circle r="13" /><path d="M-10 -5 L10 -5 L0 11 Z" /></>}
                {c.shape === 'dot' && <circle r="6" />}
              </svg>
              <div>
                <b>{c.name}</b> <small>{c.skt}</small>
                <span>{c.stones.join(', ')}</span>
              </div>
            </li>
          ))}
        </ol>
      </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Made in Morocco</p>
        <h2 class="big">Aerospace machining. <em>Finished by hand.</em></h2>
        <p class="lede">
          The titanium and brass are machined on five-axis CNC by Morocco’s aerospace suppliers, then inlaid, lapped
          and finished by hand by Moroccan craftspeople. Built where it’s made well, priced so more people can carry
          one.
        </p>
      </div>
      <dl class="specs">
        <div><dt>6 hours</dt><dd>relaying on a full charge, then a sip of your iPhone’s battery</dd></div>
        <div><dt>15 min</dt><dd>to 50% over USB-C from a wall charger or power bank, full in about 45</dd></div>
        <div><dt>0 mm</dt><dd>added above your iPhone’s lenses: level with the lens tops, clear of every field of view</dd></div>
        <div><dt>95 g</dt><dd>in titanium; about 136 g in brass</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Cost and profit</p>
      <h2 class="big">Every cost, in the open.</h2>
      <p class="lede narrow">
        Shields sell at the cost to make and back with the warranty. Everyone pays the same ${ACTIVATION} activation.
        You pay with ñü.wallet on the network. What is left after tax and the network fee is the expected profit. These
        are the expected costs of the first production run; the actual costs are published when it ships.
      </p>
      <div class="cost-wrap">
        <table class="cost">
          <thead>
            <tr><th scope="col">Expected, per shield</th>{columns.map((c) => <th scope="col">{c.edition.name}<small>{c.model.name.replace('iPhone 18 ', '')}</small></th>)}</tr>
          </thead>
          <tbody>
            {parts.map((p) => (
              <tr><th scope="row">{p[0]}</th>{columns.map((_, i) => <td>{usd(p[i + 1] as number)}</td>)}</tr>
            ))}
            <tr class="sub"><th scope="row">Cost to make</th>{costs.map((c) => <td>{usd(c.unit)}</td>)}</tr>
            <tr><th scope="row">Warranty reserve (5%)</th>{costs.map((c) => <td>{usd(c.warranty)}</td>)}</tr>
            <tr class="sub"><th scope="row">Shield at cost, tax included</th>{columns.map((c) => <td>{usd(c.price)}</td>)}</tr>
            <tr><th scope="row">Activation, tax included</th>{columns.map(() => <td>{usd(ACTIVATION)}</td>)}</tr>
            <tr><th scope="row">Network fee (estimate, ≤{usd(NETWORK_FEE)})</th>{costs.map((c) => <td>{usd(c.fee)}</td>)}</tr>
            <tr><th scope="row">Sales tax or VAT inside shield + activation (estimate, {Math.round(TAX * 100)}%)</th>{costs.map((c) => <td>{usd(Math.round(c.tax * 100) / 100)}</td>)}</tr>
            <tr class="profit">
              <th scope="row">Expected profit</th>
              {costs.map((c) => <td>{usd(Math.round(c.profit * 100) / 100)}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="fine cost-note">
        The shield price is the cost to make plus the warranty reserve, with sales tax or VAT included; Core drops Qi
        charging and the neural chips, so its board costs less. The ${ACTIVATION} activation is the same on every
        edition. Tax rates depend on where you live, so the tax line and the profit shift a little by country and state.
        Shipping is extra and charged at cost: overnight priority with Saturday delivery, the only option (FedEx
        Priority Overnight in the US; International Priority elsewhere, 1–3 business days), ${SHIPPING} (estimate). There
        is no card processor: you pay with ñü.wallet over the shielded pool. The only fee is the network fee to the
        people who run the nodes (estimate: a fraction of a cent, shown here as {usd(NETWORK_FEE)}). Import duty, where
        it applies, is shown before you pay.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <p class="footnote">
        For iPhone 18 Pro and Pro Max, with more models in {SHIPS}. Stones are natural, so colour and pattern vary, and
        they are softer than the metal around them: sealed, but they may show fine wear over years, like a watch dial.
        Every ñü.isheru is cut from its own stones, so yours has its own pattern. Chakras and meanings are traditional beliefs, shared for their history, not as claims. Moldavite is certified genuine; its total is an estimate (<a href="https://en.wikipedia.org/wiki/Moldavite">Moldavite</a>), and diamond output is from the <a href="https://kimberleyprocessstatistics.org/">Kimberley Process statistics</a>, about 111 million carats in 2023. Sources are traceable, and our lapis does not come from Afghanistan. Battery
        life and charge time vary with use and settings. The 3D view and AR use the CAD model, and
        the ñü.isheru is composed from stone photographs to show the design, not a specific shield. iPhone is a trademark of Apple Inc.
      </p>
      <p><a href="https://shield.khensu.nu">Full sunulink.shield details</a></p>
    </div>
  </section>
</Base>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    items.forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) io.observe(el); else el.classList.add('in'); });
    document.documentElement.classList.add('reveal-ready');
  }
  const state = { finish: 'maroon', tier: 'moldavite', edition: 'core', model: 'pro' };
  const closeup = document.querySelector<HTMLImageElement>('.inlay-closeup');
  const on = (sel: string) => document.querySelector<HTMLElement>(`${sel}.on`)!;
  const choose = (sel: string, el: Element) => {
    for (const x of document.querySelectorAll(sel)) {
      x.classList.toggle('on', x === el);
      x.setAttribute('aria-pressed', String(x === el));
    }
  };
  const update = () => {
    const ed = on('.edition');
    const model = on('.model');
    const colour = on('.swatch').dataset.name!;
    const price = Number(ed.dataset[state.model]);
    for (const e of document.querySelectorAll<HTMLElement>('.edition')) e.querySelector('.price')!.textContent = `$${e.dataset[state.model]}`;
    const a = document.querySelector<HTMLAnchorElement>('.reserve')!;
    const ship = Number(a.dataset.shipping);
    const activation = Number(a.dataset.activation);
    const total = price + activation + ship;
    document.querySelector('[data-out="price"]')!.textContent = `$${price}`;
    document.querySelector('[data-out="total"]')!.textContent = `$${total}`;
    a.textContent = `Pre-order · $${total} when you pay`;
    const subject = `Pre-order suñůlink.shield: ${ed.dataset.name}, ${model.textContent}, ${colour}`;
    const body = `I’d like to pre-order one sunulink.shield. No payment yet — reserve my place in the queue.\n\nEdition: ${ed.dataset.name}\niPhone: ${model.textContent}\nFinish: ${colour}\nShield at cost: $${price} including tax\nActivation: $${activation}\nOvernight shipping: $${ship}\nTotal when I pay: $${total}\n\nPlease confirm the pre-order. I’ll pay with ñü.wallet on the network when you invoice me.`;
    a.href = `mailto:hello@elliottwave.studio?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    const finish = state.edition === 'brass' ? 'brass' : state.finish;
    dispatchEvent(new CustomEvent('shield:finish', { detail: { finish, tier: state.tier, phone: state.finish } }));
    if (closeup) closeup.src = `/khensu/stones/inlay-${state.tier}.png`;
  };
  for (const b of document.querySelectorAll<HTMLElement>('.edition')) {
    b.addEventListener('click', () => { choose('.edition', b); state.edition = b.dataset.edition!; state.tier = b.dataset.tier!; update(); });
  }
  for (const b of document.querySelectorAll<HTMLElement>('.model')) {
    b.addEventListener('click', () => { choose('.model', b); state.model = b.dataset.model!; update(); });
  }
  for (const b of document.querySelectorAll<HTMLElement>('.swatch')) {
    b.addEventListener('click', () => { choose('.swatch', b); state.finish = b.dataset.finish!; update(); });
  }
</script>

