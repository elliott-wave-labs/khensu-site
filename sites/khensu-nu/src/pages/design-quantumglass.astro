---
import Base from '../layouts/Base.astro';
import Name from '../components/khensu/Name.astro';
import { PRODUCTS } from '../data/hosts';
import '../styles/nu-glass.css';

const SPEC = 'https://dev.khensu.nu/specs/nu-glass/';
const MENU_DOC = 'https://developer.apple.com/documentation/swiftui/menu';
const MENU_ESSAY =
  'https://levelup.gitconnected.com/swiftui-menu-a-little-more-than-just-a-list-of-buttons-dd143ba9f6cf';
---

<Base
  title="nu.glass"
  description="nu.glass — Quantum × Liquid Glass. iOS Liquid Glass materials collab with khėnsu.ñü styling, heavy on nu.aura. design.quantumGlass.khensu.nu."
>
  <div class="qg nu-glass khensu">
    <section class="qg-hero" data-hero>
      <div class="qg-hero-bg" aria-hidden="true">
        <i class="qg-orb a"></i>
        <i class="qg-orb b"></i>
        <i class="qg-orb c"></i>
        <i class="qg-grid"></i>
      </div>
      <div class="wrap qg-hero-in">
        <p class="eyebrow">nu.glass · design.quantumGlass.khensu.nu</p>
        <p class="qg-brand"><Name /></p>
        <h1>
          Quantum × Liquid Glass
          <em class="nu-glass-aura-text">nu.glass</em>
        </h1>
        <p class="qg-lede">
          Apple Liquid Glass × khėnsu.ñü — but the material is the
          <strong>clear number-light bubble explosion</strong>, not a solid sheet.
          That light language is <strong>nu.aura</strong>: fashion and design styles.
        </p>
        <div class="qg-cta">
          <a class="btn primary qg-btn-aura" href={PRODUCTS.waves}>See it on nu.waves</a>
          <a class="btn qg-btn-glass" href={SPEC}>Spec</a>
          <a class="btn qg-btn-glass" href={MENU_DOC} rel="noopener noreferrer" target="_blank">SwiftUI Menu</a>
          <a class="btn qg-btn-glass" href={MENU_ESSAY} rel="noopener noreferrer" target="_blank">Menu deep-dive</a>
        </div>
      </div>
    </section>

    <section class="qg-stage wrap" aria-label="Live materials">
      <article class="qg-card nu-glass-panel">
        <p class="qg-k">01 · clear bubble</p>
        <h2>Floating mini player</h2>
        <p>Clear aura bubble — see-through film, soft rim light. Not a milky slab.</p>
        <div class="qg-demo-player nu-glass-bubble" aria-hidden="true">
          <span class="qg-demo-art nu-glass-aura"></span>
          <div>
            <b>Nocturne Op. 48</b>
            <small>khėnsu.ñü radio · live</small>
            <div class="qg-demo-ctl">
              <i></i><i class="play nu-glass-aura"></i><i></i>
            </div>
          </div>
          <span class="qg-demo-prog"><i class="nu-glass-aura"></i></span>
        </div>
      </article>

      <article class="qg-card nu-glass-panel">
        <p class="qg-k">02 · menu</p>
        <h2>Native glass Menu</h2>
        <p>SwiftUI Menu shape: summary chip, elevated panel, aura check on the pick.</p>
        <details class="qg-menu" open>
          <summary class="nu-glass-panel">
            <span>Room</span>
            <b>Concert hall</b>
          </summary>
          <div class="qg-menu-panel nu-glass-panel" role="menu">
            <button type="button">Private room</button>
            <button type="button">Club</button>
            <button type="button" class="on" aria-checked="true">Concert hall</button>
            <button type="button">Stadium</button>
            <button type="button">Festival</button>
          </div>
        </details>
      </article>

      <article class="qg-card nu-glass-panel">
        <p class="qg-k">03 · nu.aura</p>
        <h2>Fashion + design styles</h2>
        <p>
          nu.aura is the light wardrobe: Burst particle cores, flowing spectrum,
          First Attempt control, clear bubble chrome. Same family as the number explosion.
        </p>
        <div class="qg-bubbles" aria-hidden="true">
          <i class="g"></i><i class="b"></i><i class="p"></i>
          <i class="g d2"></i><i class="b d2"></i><i class="p d2"></i>
        </div>
        <p class="qg-aura-sample nu-glass-aura-text">clear burst · spacetime bubble™ · nu.aura</p>
      </article>
    </section>

    <section class="qg-rules wrap">
      <h2>Rules</h2>
      <ul>
        <li><b>Clear bubbles, not sheets</b> — same light as the number Burst, quieter.</li>
        <li><b>nu.aura = fashion + design styles</b> — particles, spectrum, chrome dress.</li>
        <li><b>Menu over segmented lists</b> when the set is rooms, scenes, or long picks.</li>
        <li><b>Desktop stays; mobile media only</b> when the desktop composition is already right.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .qg {
    color: #fff;
    background: #000;
  }
  .qg-hero {
    position: relative;
    min-height: min(92vh, 54rem);
    display: grid;
    align-items: end;
    padding: clamp(4rem, 12vh, 7rem) 0 clamp(3rem, 8vh, 5rem);
    overflow: hidden;
  }
  .qg-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 15% 20%, rgba(79, 176, 255, 0.22), transparent 55%),
      radial-gradient(ellipse 60% 50% at 85% 30%, rgba(24, 224, 200, 0.16), transparent 50%),
      radial-gradient(ellipse 55% 45% at 60% 90%, rgba(139, 92, 255, 0.2), transparent 55%),
      linear-gradient(180deg, #04050a 0%, #0a0c12 50%, #05060a 100%);
  }
  .qg-orb {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: qg-float 8s ease-in-out infinite;
  }
  .qg-orb.a {
    width: min(48vw, 22rem);
    height: min(48vw, 22rem);
    left: 8%;
    top: 18%;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 80px rgba(79, 176, 255, 0.15);
  }
  .qg-orb.b {
    width: min(32vw, 14rem);
    height: min(32vw, 14rem);
    right: 12%;
    top: 28%;
    animation-delay: -2s;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 60px rgba(24, 224, 200, 0.12);
  }
  .qg-orb.c {
    width: min(24vw, 10rem);
    height: min(24vw, 10rem);
    left: 48%;
    top: 52%;
    animation-delay: -4s;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 50px rgba(139, 92, 255, 0.14);
  }
  .qg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 15%, transparent 75%);
  }
  @keyframes qg-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-12px) scale(1.02); }
  }
  .qg-hero-in { position: relative; z-index: 1; max-width: 44rem; }
  .qg-brand { margin: 0 0 0.5rem; opacity: 0.85; }
  .qg-hero h1 {
    margin: 0 0 0.9rem;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }
  .qg-hero h1 em {
    display: block;
    margin-top: 0.25rem;
    font-style: normal;
    font-size: 0.72em;
  }
  .qg-lede {
    margin: 0 0 1.4rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.78);
    max-width: 34rem;
  }
  .qg-lede strong { color: #fff; }
  .qg-cta { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .qg-btn-glass {
    border: 1px solid var(--nu-glass-edge) !important;
    background: var(--nu-glass) !important;
    backdrop-filter: var(--nu-glass-blur);
    -webkit-backdrop-filter: var(--nu-glass-blur);
    box-shadow: var(--nu-glass-inset);
  }
  .qg-btn-aura {
    border: 0 !important;
    color: #fff !important;
    background: var(--aura) !important;
    background-size: 300% 100% !important;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
  }

  .qg-stage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 2rem 0 3rem;
  }
  @media (max-width: 900px) {
    .qg-stage { grid-template-columns: 1fr; }
  }
  .qg-card {
    border-radius: 1.25rem;
    padding: 1.25rem 1.3rem 1.4rem;
  }
  .qg-k {
    margin: 0 0 0.45rem;
    font: 650 0.68rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .qg-card h2 {
    margin: 0 0 0.45rem;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .qg-card > p {
    margin: 0 0 1.1rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: none;
  }

  .qg-demo-player {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.55rem;
    align-items: center;
    padding: 0.55rem 0.55rem 0.75rem;
    border-radius: 1.1rem;
  }
  .qg-demo-art {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 0.65rem;
  }
  .qg-demo-player b {
    display: block;
    font-size: 0.82rem;
  }
  .qg-demo-player small {
    display: block;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .qg-demo-ctl {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }
  .qg-demo-ctl i {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
  }
  .qg-demo-ctl i.play {
    width: 1.7rem;
    height: 1.7rem;
  }
  .qg-demo-prog {
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.35rem;
    height: 2px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .qg-demo-prog i {
    display: block;
    width: 62%;
    height: 100%;
  }

  .qg-menu { position: relative; }
  .qg-menu > summary {
    list-style: none;
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.85rem;
    border-radius: 14px;
    cursor: default;
  }
  .qg-menu > summary::-webkit-details-marker { display: none; }
  .qg-menu > summary span {
    font: 650 0.62rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .qg-menu > summary b { font-size: 0.95rem; }
  .qg-menu-panel {
    margin-top: 0.4rem;
    padding: 0.35rem;
    border-radius: 16px;
    display: grid;
    backdrop-filter: var(--nu-glass-blur-max) !important;
    -webkit-backdrop-filter: var(--nu-glass-blur-max) !important;
  }
  .qg-menu-panel button {
    text-align: left;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.9);
    font: 600 0.9rem/1.2 var(--font-sans);
    padding: 0.7rem 0.75rem;
    border-radius: 10px;
    cursor: default;
  }
  .qg-menu-panel button.on {
    background: rgba(255, 255, 255, 0.14);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .qg-menu-panel button.on::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #4fb0ff;
    box-shadow: 0 0 0 3px rgba(79, 176, 255, 0.25);
  }

  .qg-bubbles {
    position: relative;
    height: 4.5rem;
    margin-bottom: 0.9rem;
  }
  .qg-bubbles i {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.55), transparent 45%),
      radial-gradient(circle at 50% 50%, var(--c), transparent 70%);
    box-shadow: 0 0 20px var(--c);
    animation: qg-bob 3.2s ease-in-out infinite;
  }
  .qg-bubbles i.g { --c: rgba(34, 245, 154, 0.55); width: 2.4rem; height: 2.4rem; left: 8%; top: 20%; }
  .qg-bubbles i.b { --c: rgba(30, 143, 255, 0.55); width: 3.1rem; height: 3.1rem; left: 38%; top: 5%; animation-delay: -0.8s; }
  .qg-bubbles i.p { --c: rgba(139, 92, 255, 0.55); width: 2rem; height: 2rem; left: 72%; top: 28%; animation-delay: -1.4s; }
  .qg-bubbles i.d2 { opacity: 0.45; filter: blur(0.5px); }
  .qg-bubbles i.g.d2 { width: 1.2rem; height: 1.2rem; left: 28%; top: 55%; animation-delay: -0.3s; }
  .qg-bubbles i.b.d2 { width: 1.5rem; height: 1.5rem; left: 58%; top: 50%; animation-delay: -1.1s; }
  .qg-bubbles i.p.d2 { width: 1rem; height: 1rem; left: 85%; top: 12%; animation-delay: -1.9s; }
  @keyframes qg-bob {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-6px) scale(1.04); }
  }
  .qg-aura-sample {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: none;
  }

  .qg-rules {
    padding: 1rem 0 4.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .qg-rules h2 {
    margin: 1.5rem 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .qg-rules ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
  }
  .qg-rules li {
    padding: 0.95rem 1.1rem;
    border-radius: 1rem;
    border: 1px solid var(--nu-glass-edge);
    background: var(--nu-glass);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.45;
  }
  .qg-rules b { color: #fff; }
</style>
