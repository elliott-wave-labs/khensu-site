---
import Base from '../layouts/Base.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import Name from '../components/khensu/Name.astro';
import { PRODUCTS } from '../data/hosts';

const SPEC = 'https://dev.khensu.nu/specs/nu-aura/';
const BUY = 'https://khensu.nu/buy#isheru';

const lines = [
  {
    tone: 'set',
    k: 'Set · ñü.isheru',
    title: 'Non–gem cut',
    price: '444',
    unit: '',
    body: 'Every non–gem-cut set wears the standard ñü.isheru: bloodstone ring, lapis crescent, labradorite disc, onyx base, platinum line — flush in the metal.',
    inlay: 'standard',
  },
  {
    tone: 'emerald',
    k: 'Gem cut · ñü.isheru',
    title: 'Emerald · or peer',
    price: '44k',
    unit: '',
    body: '$44,000. Gem-cut emerald (or peer stone) takes the node points of the mark — same Triangulum geometry, elevated cut.',
    inlay: 'standard',
  },
  {
    tone: 'diamond',
    k: 'Diamond · ñü.isheru',
    title: 'The clear one',
    price: '4.4m',
    unit: '',
    body: '$4,400,000. One diamond line. The mark in quiet fire — platinum crescent, clear nodes, same mirror hexagon.',
    inlay: 'standard',
  },
  {
    tone: 'moldavite',
    k: 'Moldavite · only 3',
    title: 'Sky glass ñü.isheru',
    price: '44m',
    unit: '',
    body: '$44,000,000. Three moldavite ñü.isheru pieces: Elliott display, museum, public sale. The rarest cut of the house mark.',
    inlay: 'moldavite',
  },
] as const;

const stones = [
  { name: 'lapis', img: 'lapis', role: 'Crescent' },
  { name: 'bloodstone', img: 'bloodstone', role: 'Ring' },
  { name: 'labradorite', img: 'labradorite', role: 'Disc' },
  { name: 'onyx', img: 'onyx', role: 'Base' },
  { name: 'kyanite', img: 'kyanite', role: 'Points' },
  { name: 'tourmaline', img: 'tourmaline', role: 'Markers' },
  { name: 'pyrite', img: 'pyrite', role: 'Hexagon' },
  { name: 'moldavite', img: 'moldavite', role: 'Rare tier' },
] as const;
---

<Base
  title="ñü.åůřâ"
  description="ñü.åůřâ (nu.aura): Elliott’s first fashion show — sets dressed in the ñü.isheru. $444, $44k gem cuts, diamond $4.4m, moldavite $44m (three only). Quiet sensing as jewelry."
>
  <div class="khensu aura-page">
    <ProductBar name="ñü.åůřâ" action="The collection" href="#collection" explore="#isheru" />

    <section class="aura-hero" data-hero>
      <div class="aura-hero-media" aria-hidden="true">
        <video
          class="aura-reel"
          src="/khensu/aura/legacy.aura.mp4"
          poster="/khensu/aura/legacy.aura.jpg"
          autoplay
          muted
          loop
          playsinline
        ></video>
        <div class="aura-hero-veil"></div>
      </div>
      <div class="wrap aura-hero-in">
        <p class="eyebrow">ñü.åůřâ · first show · Venice Beach</p>
        <p class="aura-mark" aria-hidden="true">ÑÜ.ÅŮŘÂ</p>
        <h1>
          I’m the designer.<br />
          <em>It’s my first show.</em>
        </h1>
        <p class="lede">
          Legacy Aura was the beach house. This is <strong>nu.aura</strong> — fashion and design styles for the age of N/U.
          Every set carries the <strong>ñü.isheru</strong>: the house mark in stone and platinum. Jewelry that doesn’t look like tech.
          <Name tld={false} /> holds the desk.
        </p>
        <div class="btn-row">
          <a class="btn primary" href="#collection">See the collection</a>
          <a class="btn" href="#isheru">ñü.isheru</a>
          <a class="btn" href="#sensing">Quiet sensing</a>
        </div>
      </div>
    </section>

    <section class="section aura-legacy wrap" id="legacy">
      <p class="aura-k">00 · legacy</p>
      <h2>From Aura to nu.aura</h2>
      <p class="body">
        Happy to announce the brand from California — that was the old profile. Ibiza Swim Week energy, Venice Beach pin.
        The beads on the string were the tell. Now the stones are the product: the same ñü.isheru that seals suñůlink.shield
        dresses every fashion set.
      </p>
    </section>

    <section class="section band aura-isheru" id="isheru">
      <div class="wrap">
        <p class="aura-k">01 · house mark</p>
        <div class="isheru-head">
          <div class="isheru-copy">
            <h2>ñü.isheru.<br /><em>the seal of ñü.isheru.</em></h2>
            <p class="body aura-lede">
              Triangulum and its complete mirror — where the triangle meets itself, a hexagon. Lapis crescent, bloodstone ring,
              labradorite disc, onyx base, platinum line. Cut for the shield; set for the collection. One mark across hardware and fashion.
            </p>
            <div class="isheru-switch" role="group" aria-label="ñü.isheru tier">
              <button type="button" class="isheru-chip is-on" data-inlay="standard" aria-pressed="true">Standard</button>
              <button type="button" class="isheru-chip" data-inlay="moldavite" aria-pressed="false">Moldavite</button>
            </div>
            <div class="btn-row">
              <a class="btn primary" href={BUY}>On the shield</a>
              <a class="btn" href={PRODUCTS.shield}>suñůlink.shield</a>
              <a class="btn" href={SPEC}>ñü.åůřâ spec</a>
            </div>
          </div>
          <figure class="isheru-fig">
            <img
              class="isheru-inlay"
              src="/khensu/stones/inlay-standard.png"
              width="1024"
              height="1024"
              alt="ñü.isheru inlay: the khėnsu.ñü mark in stone and platinum, Triangulum mirrored into a hexagon"
              decoding="async"
              fetchpriority="high"
            />
            <figcaption>ñü.isheru · house mark</figcaption>
          </figure>
        </div>
        <figure class="isheru-macro">
          <img
            src="/khensu/renders/macro.webp"
            width="1600"
            height="1200"
            loading="lazy"
            decoding="async"
            alt="Macro of the ñü.isheru set flush in brushed brass: labradorite disc, lapis crescent with platinum, bloodstone ring"
          />
          <figcaption>Flush to the metal — fashion cuts use the same stone grammar.</figcaption>
        </figure>
        <ul class="isheru-stones" role="list">
          {stones.map((s) => (
            <li>
              <img src={`/khensu/stones/${s.img}.jpg`} alt="" width="96" height="96" loading="lazy" decoding="async" />
              <b>{s.name}</b>
              <span>{s.role}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="collection">
      <div class="wrap">
        <p class="aura-k">02 · collection</p>
        <h2>The first show — dressed in ñü.isheru</h2>
        <p class="body aura-lede">
          Four lines. One mark. Prices fixed — no scaling up or down for drama. Each set is a fashion cut of the ñü.isheru.
        </p>
        <div class="aura-tiers" role="list">
          {lines.map((line) => (
            <article class={`aura-tier${line.tone === 'moldavite' ? ' aura-tier-rare' : ''}`} role="listitem" data-tone={line.tone}>
              <div class="aura-tier-mark" aria-hidden="true">
                <img src={`/khensu/stones/inlay-${line.inlay}.png`} alt="" width="160" height="160" loading="lazy" decoding="async" />
              </div>
              <p class="aura-tier-k">{line.k}</p>
              <h3>{line.title}</h3>
              <p class="aura-price"><span>$</span>{line.price}</p>
              <p>{line.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section band" id="sensing">
      <div class="wrap">
        <p class="aura-k">03 · quiet sensing</p>
        <h2>Think it. Wear it. The stone is the face.</h2>
        <p class="body aura-lede">
          Non-invasive EEG, EKG-class pulse, and optical dim — as a ring, sunglasses, necklace, bracelet.
          The ñü.isheru sits where the sensing lives: jewelry first, never a chip badge. Lasers stay skin-surface.
          Signals stay on your device.
        </p>
        <ul class="aura-wear" role="list">
          <li>
            <img class="wear-seal" src="/khensu/stones/inlay-standard.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
            <b>Ring</b>
            <span>ñü.isheru as the stone. Dry contacts in the band. Pulse + intention cues on device.</span>
          </li>
          <li>
            <img class="wear-seal" src="/khensu/stones/inlay-standard.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
            <b>Sunglasses</b>
            <span>Dim shift — daylight softens without a gadget face. Temple tips carry a micro seal.</span>
          </li>
          <li>
            <img class="wear-seal" src="/khensu/stones/inlay-standard.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
            <b>Necklace</b>
            <span>Links that read heart and throat quietly. The pendant is the ñü.isheru, flush set.</span>
          </li>
          <li>
            <img class="wear-seal" src="/khensu/stones/inlay-moldavite.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
            <b>Bracelet</b>
            <span>Wrist cuff. Motion + pulse. Same stone family — moldavite only on the three rare sets.</span>
          </li>
        </ul>
        <p class="body">
          Runtime lane when the desk is ready: <strong>Qwen 3.8 MoE</strong> on your iron — never a cloud that owns your head.
          Until disk says yes for heavier brains, Kronos stays on the harness you already run.
        </p>
        <div class="btn-row">
          <a class="btn primary" href={PRODUCTS.kronos}>Kronos desk</a>
          <a class="btn" href={PRODUCTS.eyes}>ñü.êýêš</a>
          <a class="btn" href={PRODUCTS.nuGlass}>nu.glass</a>
          <a class="btn" href={PRODUCTS.waves}>nu.waves</a>
        </div>
      </div>
    </section>

    <section class="section aura-close" id="age">
      <div class="wrap prose">
        <p class="aura-k">04 · age of N/U</p>
        <h2>Love was never the problem.</h2>
        <p>
          People have been suppressed for eons. That time is over. The network is a gift — freedom, privacy, basic income —
          so everyone can create, build and live. Fashion is how light meets the body. The ñü.isheru is how that light
          signs every piece. nu.aura is how it dresses the age.
        </p>
        <p>
          SLA stays at <a href={PRODUCTS.sla}>100% uptime</a>. The gift that carries it is
          <a href={PRODUCTS.network}>nu.network</a>.
        </p>
      </div>
    </section>
  </div>

  <script>
    const img = document.querySelector<HTMLImageElement>('.isheru-inlay');
    const chips = document.querySelectorAll<HTMLButtonElement>('.isheru-chip');
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const tier = chip.dataset.inlay ?? 'standard';
        for (const c of chips) {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        }
        if (img) {
          img.src = `/khensu/stones/inlay-${tier}.png`;
          img.alt =
            tier === 'moldavite'
              ? 'ñü.isheru moldavite inlay: the house mark in sky glass and platinum'
              : 'ñü.isheru inlay: the khėnsu.ñü mark in stone and platinum, Triangulum mirrored into a hexagon';
        }
      });
    }
  </script>
</Base>

<style>
  .aura-page {
    color: #f4f0ea;
    background: #0a0b0d;
  }
  .aura-hero {
    position: relative;
    min-height: min(94vh, 58rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    padding: clamp(4rem, 12vh, 7rem) 0 clamp(3rem, 8vh, 5rem);
  }
  .aura-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .aura-reel {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    filter: saturate(0.92) contrast(1.05);
  }
  .aura-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 11, 13, 0.25) 0%, rgba(10, 11, 13, 0.55) 45%, rgba(10, 11, 13, 0.92) 100%),
      radial-gradient(ellipse 80% 50% at 70% 20%, rgba(34, 245, 154, 0.12), transparent 55%),
      radial-gradient(ellipse 60% 40% at 20% 80%, rgba(139, 92, 255, 0.1), transparent 50%);
  }
  .aura-hero-in {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }
  .aura-mark {
    margin: 0.4rem 0 0.6rem;
    font-family: var(--font-display), Georgia, serif;
    font-weight: 300;
    font-size: clamp(2.4rem, 8vw, 4.6rem);
    letter-spacing: 0.18em;
    line-height: 1;
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur, 8s) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .aura-hero h1 {
    font-weight: 500;
    letter-spacing: -0.03em;
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    line-height: 1.08;
    margin: 0 0 1rem;
  }
  .aura-hero h1 em {
    font-style: normal;
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur, 8s) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .aura-hero .lede {
    color: rgba(244, 240, 234, 0.88);
    max-width: 36rem;
  }
  .aura-k {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(244, 240, 234, 0.55);
    margin: 0 0 0.75rem;
  }
  .aura-legacy h2,
  .aura-page .section h2 {
    letter-spacing: -0.025em;
  }
  .aura-lede {
    max-width: 36rem;
    margin-bottom: 1.75rem;
  }

  /* ñü.isheru */
  .aura-isheru h2 em {
    font-style: normal;
    color: rgba(34, 245, 154, 0.95);
  }
  .isheru-head {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 900px) {
    .isheru-head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
    }
  }
  .isheru-fig {
    margin: 0;
    text-align: center;
  }
  .isheru-inlay {
    width: min(420px, 88vw);
    height: auto;
    aspect-ratio: 1;
    filter: drop-shadow(0 28px 48px rgba(0, 0, 0, 0.55));
  }
  .isheru-fig figcaption,
  .isheru-macro figcaption {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    color: rgba(244, 240, 234, 0.55);
  }
  .isheru-switch {
    display: inline-flex;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .isheru-chip {
    appearance: none;
    border: 0;
    background: transparent;
    color: rgba(244, 240, 234, 0.7);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .isheru-chip.is-on {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .isheru-macro {
    margin: 0 0 2rem;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .isheru-macro img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .isheru-macro figcaption {
    padding: 0 0.25rem;
  }
  .isheru-stones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 720px) {
    .isheru-stones {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }
  .isheru-stones li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    font-size: 0.72rem;
  }
  .isheru-stones img {
    width: 100%;
    max-width: 72px;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .isheru-stones b {
    font-weight: 550;
    text-transform: capitalize;
  }
  .isheru-stones span {
    color: rgba(244, 240, 234, 0.5);
  }

  .aura-tiers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 960px) {
    .aura-tiers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .aura-tier {
    position: relative;
    padding: 1.35rem 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    min-height: 16rem;
  }
  .aura-tier::before {
    content: '';
    position: absolute;
    inset: auto -20% -40% -20%;
    height: 70%;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.55;
    pointer-events: none;
  }
  .aura-tier[data-tone='set']::before {
    background: #1e8fff;
  }
  .aura-tier[data-tone='emerald']::before {
    background: #22f59a;
  }
  .aura-tier[data-tone='diamond']::before {
    background: #e8f4ff;
  }
  .aura-tier[data-tone='moldavite']::before {
    background: #6bff4a;
  }
  .aura-tier-rare {
    border-color: rgba(107, 255, 74, 0.35);
    box-shadow: 0 0 0 1px rgba(107, 255, 74, 0.12), 0 20px 60px rgba(0, 0, 0, 0.35);
  }
  .aura-tier-mark {
    position: relative;
    width: 3.4rem;
    height: 3.4rem;
    margin: 0 0 0.85rem;
  }
  .aura-tier-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.45));
  }
  .aura-tier-k {
    position: relative;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244, 240, 234, 0.55);
    margin: 0 0 0.5rem;
  }
  .aura-tier h3 {
    position: relative;
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 550;
  }
  .aura-price {
    position: relative;
    margin: 0 0 0.85rem;
    font-family: var(--font-display), Inter, sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .aura-price span {
    font-size: 0.55em;
    opacity: 0.7;
    margin-right: 0.08em;
  }
  .aura-tier p:last-child {
    position: relative;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: rgba(244, 240, 234, 0.78);
  }
  .aura-wear {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 720px) {
    .aura-wear {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .aura-wear li {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    row-gap: 0.25rem;
    padding: 1.1rem 1.15rem;
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .wear-seal {
    grid-row: 1 / span 2;
    width: 3.2rem;
    height: 3.2rem;
    object-fit: contain;
    align-self: center;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.4));
  }
  .aura-wear b {
    font-size: 1.02rem;
  }
  .aura-wear span {
    color: rgba(244, 240, 234, 0.75);
    font-size: 0.94rem;
    line-height: 1.45;
  }
  .aura-close p a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  @media (max-width: 719px) {
    .aura-hero {
      min-height: min(88vh, 44rem);
    }
    .aura-mark {
      letter-spacing: 0.12em;
    }
    .isheru-stones {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aura-mark,
    .aura-hero h1 em {
      animation: none;
      background: none;
      color: #22f59a;
      -webkit-background-clip: unset;
      background-clip: unset;
    }
    .aura-reel {
      display: none;
    }
    .aura-hero-media {
      background: #12141a url('/khensu/aura/legacy.aura.jpg') center / cover no-repeat;
    }
  }
</style>
