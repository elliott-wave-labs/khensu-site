---
const title = 'Help yourself. Read a book.';
const docs = 'https://dev.khensu.nu';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={title} />
    <style>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #0a0b0d;
        color: #e8eaed;
        font-family:
          Inter, system-ui, -apple-system, 'Segoe UI', 'Noto Sans', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      main {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        padding: 2rem;
        text-align: center;
      }
      p {
        margin: 0;
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 300;
        letter-spacing: -0.03em;
        line-height: 1.25;
      }
      a {
        color: #18e0c8;
        text-decoration-color: color-mix(in srgb, #18e0c8 40%, transparent);
        text-underline-offset: 0.2em;
      }
      a:hover {
        text-decoration-color: currentColor;
      }
      :focus-visible {
        outline: 2px solid #18e0c8;
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <main>
      <p>Help yourself. Read a book.</p>
      <a href={docs}>Developer docs</a>
    </main>
  </body>
</html>
