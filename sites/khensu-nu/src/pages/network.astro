---
import Base from '../layouts/Base.astro';
import RevealText from '../components/khensu/RevealText.astro';
import StatStrip from '../components/khensu/StatStrip.astro';

const DEV = 'https://dev.khensu.nu';

const ballot = [
  { step: 'Roll', text: 'The organiser publishes the member list as a single root. Each member gets one credential, issued blind, so the organiser can’t tell whose is whose.' },
  { step: 'Seal', text: 'The ballot key is split 3-of-5 among independent nodes. Every ballot is sealed to it with ML-KEM-1024.' },
  { step: 'Cast', text: 'Each member proves membership without saying who they are. One credential, one ballot, sent over the mixnet.' },
  { step: 'Close', text: 'At the deadline the key holders release their shares to the contract. A proof opens every ballot and outputs only the tally.' },
];

const standard = [
  { name: 'ballot', what: 'Anonymous votes and polls' },
  { name: 'work-order', what: 'Commission work from people or nodes' },
  { name: 'escrow', what: 'Milestones released by both sides or a chosen arbiter' },
  { name: 'pledge', what: 'Pays only if hidden pledges reach a goal by a deadline; refunds otherwise' },
  { name: 'split', what: 'Pays every collaborator their share of each payment a post, song or film earns' },
  { name: 'ticket', what: 'Anonymous, unlinkable tickets and memberships' },
  { name: 'bounty', what: 'Pays the first submission that passes the check' },
  { name: 'timelock', what: 'Opens a file, key or message on a date, or when its owner stops checking in' },
];

const jobs = [
  { n: '01', job: 'Proof aggregation', text: 'Folds every payment and contract proof in an epoch into one, so a phone checks a single small proof instead of thousands.', unit: 'proof folded', hw: 'Apple silicon Mac or recent desktop, 16 GB' },
  { n: '02', job: 'Encrypted storage', text: 'Holds erasure-coded ciphertext shards for sites, media, backups and the network archive. Random challenges prove the bytes are there.', unit: 'byte-day', hw: 'Disk with 99% monthly availability' },
  { n: '03', job: 'Public media renditions', text: 'Encodes media a creator published openly into every ñü.media size, checked by spot re-encodes. Private media never leaves the sender’s device to be encoded.', unit: 'rendition-second', hw: 'Apple silicon Mac or hardware encoder' },
  { n: '04', job: 'Private lookups', text: 'Answers name and key lookups with private information retrieval, so the node never learns what was asked.', unit: 'query', hw: '8 GB memory per shard' },
  { n: '05', job: 'Randomness and timestamps', text: 'A 14-of-21 post-quantum beacon for lotteries, raffles and ballots, and timestamps that prove a file existed at a moment.', unit: 'round, stamp', hw: 'Always on for the whole era' },
  { n: '06', job: 'Mesh and satellite bridging', text: 'Carries sealed packets between places with no internet and the rest of the network, over Wi-Fi HaLow, Bluetooth and satellite links. Phones alone reach about 100 m; suñůlink.shield reaches 600 m, or 2 km to a rooftop node.', unit: 'packet', hw: 'suñůlink.shield, Raspberry Pi 5 with HaLow, or a satellite link' },
];

const fees = [
  { name: 'khensu.ñü', fee: 10, label: '10%', keeps: '$90', ours: true },
  { name: 'Epic Games Store', fee: 12, label: '12%', keeps: '$88' },
  { name: 'Apple App Store, Google Play', fee: 30, from: 15, label: '15–30%', keeps: '$70–85' },
];

const usd = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: Number.isInteger(n) ? 0 : 2, maximumFractionDigits: 2 })}`;
const tiers = [
  { name: 'Pro', price: 4.99 },
  { name: 'Ultra', price: 200 },
  { name: 'Akashic', price: 1000 },
].map((t) => {
  const net = Math.round(t.price * 0.85 * 100) / 100;
  const half = Math.floor((net / 2) * 100) / 100;
  return { ...t, apple: Math.round((t.price - net) * 100) / 100, net, network: Math.round((net - half) * 100) / 100, founder: half };
});
const perPayer = 0.989 * tiers[0].network + 0.01 * tiers[1].network + 0.001 * tiers[2].network;
const scale = [
  { users: 1e6, nodes: 5000 },
  { users: 10e6, nodes: 20000 },
  { users: 100e6, nodes: 60000 },
  { users: 250e6, nodes: 90000 },
  { users: 1e9, nodes: 150000 },
].map((r) => {
  const pool = r.users * 0.05 * perPayer;
  const avg = pool / r.nodes;
  return { ...r, pool, avg, big: avg * 10, bigWeek: (avg * 10 * 12) / 52 };
});
const people = (n: number) => (n >= 1e9 ? `${n / 1e9} billion` : `${n / 1e6} million`);
const whole = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const money = (n: number) => (n >= 1e6 ? `$${(n / 1e6).toFixed(n >= 1e8 ? 0 : 1)} million` : whole(n));
const pipeline = [
  { t: 'You subscribe in the App Store', text: 'Pro, Ultra or Akashic, paid with Apple Pay. Apple keeps its 15% and pays the rest to Elliott Wave LLC each month.' },
  { t: 'Half goes to the network as USDC', text: 'The network’s 50% is converted 1:1 to USDC, a fully reserved dollar stablecoin, and paid into the shielded pool as that epoch’s pay pool.' },
  { t: 'Nodes are paid for proved work', text: 'Each node is paid in khensu.ñü coin for its verified work receipts, at one worldwide rate, and the coin turns into USDC the moment it lands in the wallet. Nobody sees who was paid or how much.' },
  { t: 'Operators spend it with Apple Pay', text: 'Keep it, send it, or spend it anywhere with a USDC debit card in Apple Pay, or withdraw to a bank.' },
  { t: 'The other half is the founder’s', text: 'Elliott Wave LLC’s 50% pays for building and running khensu.ñü. It is the only cut, and it comes only from these subscriptions.' },
];
const succession = [
  { t: 'On every change', text: 'Every code push, private or public, every release and every network upgrade is archived on the network automatically, within one epoch. A release that isn’t archived won’t install.' },
  { t: 'Every week', text: 'The founder signs a check-in on chain, confirming the archive and the sealed escrow of private code cover everything up to now.' },
  { t: '42 days without a check-in', text: 'Six missed weeks, or a signed handover, and the switch fires by itself. No signature, vote or server is needed to fire it.' },
  { t: 'The trusted committee opens it', text: 'The 21 committee nodes of that epoch jointly hold the keys. Any 14 open every sealed repository, patented code included, and take over signing releases.' },
  { t: 'Then everyone gets it', text: 'The full archive goes to every node, the founder’s list of friends, The Wall Street Journal and Forbes, Wikimedia Commons and the Internet Archive, with a royalty-free licence to every patent. Founder powers pass to consensus for good.' },
];
---

<Base
  title="ñü.ñetwork: contracts, paid node work and a gift to everyone"
  description="webË contracts for any work, from escrow to anonymous ballots. Six jobs node operators are paid for. A flat 10% app fee, the lowest in the industry. And a network that belongs to everyone, the founder’s powers included."
>
  <div class="khensu">
    <section class="page-head">
      <div class="wrap">
        <p class="eyebrow"><span class="name-case">ñü.ñetwork</span> · the network under webË</p>
        <h1>Private contracts.<br /><span class="dim">Owned by everyone.</span></h1>
        <StatStrip
          items={[
            { n: 10, unit: '%', label: 'Flat app fee, on the first dollar and the billionth' },
            { n: jobs.length, label: 'Kinds of node work, each paid by proof' },
            { n: 14, unit: 'of 21', label: 'Committee keys sign every release after the switch' },
            { n: 42, unit: 'days', label: 'Of founder silence, then every power and every line of code passes to the network' },
          ]}
        />
        <p class="lede">Agreements that keep themselves, node work that pays, and a network that belongs to all of us, so people everywhere can create, earn and live securely.</p>
        <p class="lede nun">The name comes from Nun, the dark, formless waters that Egyptian creation stories begin with. Here those waters are tamed: every node runs the same open code and is checked the same way, so the whole network takes one shape, calm and alike, like Isheru, the crescent sacred lake at Karnak that the ñü.isheru is named for.</p>
        <nav class="chips" aria-label="On this page">
          <a href="#network-contracts">Contracts</a>
          <a href="#network-ballots">Ballots</a>
          <a href="#network-standard">Standard contracts</a>
          <a href="#network-work">Node work</a>
          <a href="#network-economics">Economics</a>
          <a href="#network-earnings">Node earnings</a>
          <a href="#network-commerce">10% app fee</a>
          <a href="#network-gift">A gift to everyone</a>
        </nav>
      </div>
    </section>

    <section class="section band">
      <div class="wrap">
        <RevealText
          parts={[
            ['On most chains, a contract is a public record of who paid whom and why. '],
            ['On webË, the code is public and everything else is private.', true],
            [' Each step is proved on the device of the person who takes it, and the chain keeps only the proof. '],
            ['Nothing for an observer to read, and nothing for a quantum computer to break later.', true],
          ]}
        />
      </div>
    </section>

    <section class="section" id="network-contracts">
      <div class="wrap">
        <p class="eyebrow">contracts</p>
        <h2>Contracts for any work.<br /><span class="dim">Not just money.</span></h2>
        <div class="grid three">
          <article class="glass">
            <h3>Public code, private terms</h3>
            <p>Contract code is signed, published and readable by anyone before they agree to it. The terms, the parties and the state stay between the parties.</p>
          </article>
          <article class="glass">
            <h3>Proved, not trusted</h3>
            <p>Every step runs on a party’s own device and produces a STARK, a hash-based proof that is post-quantum by construction. The chain checks the proof and stores only commitments.</p>
          </article>
          <article class="glass">
            <h3>Any reward</h3>
            <p>A contract can pay in private money, issue an anonymous credential, award a reputation point, admit someone to a group, or pay nothing at all.</p>
          </article>
          <article class="glass">
            <h3>Work by people</h3>
            <p>A translation, a design, a review or a report is delivered encrypted and accepted by the requester, an agreed reviewer or an automatic check.</p>
          </article>
          <article class="glass">
            <h3>Work by nodes</h3>
            <p>A site owner pays for extra storage, a creator pays for renditions of a film, a community pays to keep its mesh connected. Payment and proof settle together.</p>
          </article>
          <article class="glass">
            <h3>Trigger any app</h3>
            <p>A vote closes and the co-op’s booking app orders the roof. Contracts send signed, encrypted intents to other apps on the network.</p>
          </article>
          <article class="glass">
            <h3>Reach the legacy internet</h3>
            <p>Call an API or a webhook through a gateway node, with a transcript proof that the answer came from that server, unaltered.</p>
          </article>
          <article class="glass">
            <h3>Science in the background</h3>
            <p>Idle nodes donate time to Einstein@Home’s search for gravitational waves and new pulsars, paid when the project validates each work unit.</p>
          </article>
          <article class="glass">
            <h3>Nothing kept forever</h3>
            <p>Party keys are fresh for every contract and linked to nothing. A closed contract is deleted with its era. Nothing sits on the chain forever.</p>
          </article>
        </div>
        <div class="btn-row">
          <a class="btn" href={`${DEV}/contracts`}>Build a contract</a>
          <a class="btn" href={`${DEV}/specs/webe#14-contracts`}>Contracts specification</a>
        </div>
      </div>
    </section>

    <section class="section" id="network-ballots">
      <div class="wrap">
        <p class="eyebrow">ballots</p>
        <h2>A co-op votes on a new roof.<br /><span class="dim">Nobody learns who voted, or how.</span></h2>
        <p class="intro">
          A housing co-op, a football club, a neighbourhood association, a union branch. The ballot contract counts every
          vote and reveals nothing but the result. Not to the organiser, not to the key holders, not to the network.
        </p>
        <ol class="steps" role="list">
          {ballot.map((b, i) => (
            <li class="glass" style={`--i:${i}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{b.step}</h3>
              <p>{b.text}</p>
            </li>
          ))}
        </ol>
        <p class="footnote">Ranked choice, weighted votes and quorum rules are ordinary contract code. Raffles and lotteries draw on the network’s randomness beacon, from a round nobody can know in advance.</p>
      </div>
    </section>

    <section class="section" id="network-standard">
      <div class="wrap">
        <p class="eyebrow">standard contracts</p>
        <h2>Audited and ready.<br /><a class="dim" href={`${DEV}/contracts#standard`}>At contracts.khensu.nu.</a></h2>
        <ul class="std" role="list">
          {standard.map((s) => (
            <li class="glass"><a href={`${DEV}/contracts#standard`}><code>{s.name}</code><span>{s.what}</span></a></li>
          ))}
        </ul>
        <p class="footnote">Before anyone signs, the wallet shows the contract’s code ID, its author and any audit labels.</p>
      </div>
    </section>

    <section class="section" id="network-work">
      <div class="wrap">
        <p class="eyebrow">node work</p>
        <h2>Six jobs the network pays for.<br /><span class="dim">None of them sees your data.</span></h2>
        <p class="intro">
          Nodes earn for more than relaying. Every job works only on ciphertext, public proofs or content its owner chose to
          publish, and each one is proved before it’s paid. A job that would need anyone’s private data can’t be added,
          not even by governance.
        </p>
        <ol class="jobs" role="list">
          {jobs.map((j) => (
            <li class="glass">
              <span class="num">{j.n}</span>
              <h3>{j.job}</h3>
              <p>{j.text}</p>
              <dl>
                <div><dt>paid per</dt><dd>{j.unit}</dd></div>
                <div><dt>hardware</dt><dd>{j.hw}</dd></div>
              </dl>
            </li>
          ))}
        </ol>
        <div class="term" aria-label="Node terminal">
          <pre><code><span class="p">~node work</span>                       <span class="c">roles, earnings and challenges this epoch</span>
<span class="p">~node work enable storage --gb 500 --class durable</span>
<span class="p">~node work enable render</span>
<span class="p">~node work orders</span>                <span class="c">contract work this node can take</span></code></pre>
        </div>
        <p class="footnote">
          Pay comes from the network’s reward pool in proportion to verified work, plus whatever contracts offer for specific
          jobs. A failed challenge or a forged receipt costs that epoch’s pay and part of the node’s stake. What a node earns
          depends on the work it does; this is not a promise of earnings.
        </p>
        <div class="btn-row">
          <a class="btn primary" href="/webe#run-a-node-section">Run a node</a>
          <a class="btn" href={`${DEV}/work`}>Node work guide</a>
          <a class="btn" href={`${DEV}/specs/work`}>Work specification</a>
        </div>
      </div>
    </section>

    <section class="section" id="network-economics">
      <div class="wrap">
        <p class="eyebrow">network economics</p>
        <h2>Half to the network.<br /><span class="dim">Half to the founder. Nothing from you.</span></h2>
        <p class="intro">
          khensu.ñü earns only from its own subscriptions. After Apple’s cut, every dollar splits evenly: half pays the
          people who run the network, half goes to the founder’s company.
        </p>
        <figure class="glass econ">
          <figcaption>A month of each subscription, in US dollars</figcaption>
          <div class="econ-scroll" tabindex="0">
            <table>
              <thead>
                <tr><th scope="col">Plan</th><th scope="col">You pay</th><th scope="col">Apple’s 15%</th><th scope="col">After Apple</th><th scope="col">To the network, 50%</th><th scope="col">To the founder, 50%</th></tr>
              </thead>
              <tbody>
                {tiers.map((t) => (
                  <tr>
                    <th scope="row">{t.name}</th>
                    <td>{usd(t.price)}</td>
                    <td class="dim">−{usd(t.apple)}</td>
                    <td>{usd(t.net)}</td>
                    <td class="ours">{usd(t.network)}</td>
                    <td>{usd(t.founder)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </figure>
        <ol class="steps" role="list">
          {pipeline.map((p, i) => (
            <li class="glass" style={`--i:${i}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{p.t}</h3><p>{p.text}</p></li>
          ))}
        </ol>
        <div class="grid three">
          <article class="glass"><h3>No cut on views or engagement</h3><p>Every play pays the creator 1¢, $10 per 1,000, all of it to them.</p></article>
          <article class="glass"><h3>No cut on gifts or sales</h3><p>Tips, gifts and a creator’s own sales reach them in full.</p></article>
          <article class="glass"><h3>No cut on hosting or network work</h3><p>Storage, delivery, relays and every job a node does are paid to the node in full.</p></article>
        </div>
        <p class="footnote">
          Apple keeps 15% under its Small Business Program and on subscriptions after their first year; 30% applies in a
          subscription’s first year once a developer earns over $1 million a year, which makes Pro $3.49 after Apple
          ($1.75 to the network, $1.74 to the founder), Ultra $140 ($70 each) and Akashic $700 ($350 each). USDC is issued by
          Circle and redeemable 1:1 for US dollars. Apple and Apple Pay are trademarks of Apple Inc.
        </p>
      </div>
    </section>

    <section class="section" id="network-earnings">
      <div class="wrap">
        <p class="eyebrow">node earnings</p>
        <h2>Over $1,000 a week.<br /><span class="dim">Once the audience is there.</span></h2>
        <p class="intro">
          What a node earns depends on how many people use khensu.ñü and how much work the node does. Here is a month at each
          audience size, paid from the network’s half of subscriptions alone.
        </p>
        <figure class="glass econ">
          <figcaption>Estimated monthly earnings per node, in US dollars</figcaption>
          <div class="econ-scroll" tabindex="0">
            <table>
              <thead>
                <tr><th scope="col">People on khensu.ñü</th><th scope="col">Network pool a month</th><th scope="col">Nodes</th><th scope="col">Average node</th><th scope="col">High-capacity node</th><th scope="col">Per week</th></tr>
              </thead>
              <tbody>
                {scale.map((r) => (
                  <tr class={r.bigWeek >= 1000 ? 'over' : undefined}>
                    <th scope="row">{people(r.users)}</th>
                    <td>{money(r.pool)}</td>
                    <td class="dim">{r.nodes.toLocaleString('en-US')}</td>
                    <td>{whole(r.avg)}</td>
                    <td class="ours">{whole(r.big)}</td>
                    <td class="ours">{whole(r.bigWeek)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </figure>
        <div class="grid three">
          <article class="glass"><h3>Average node</h3><p>A Mac or Raspberry Pi 5 on home broadband, online all day, doing its share of mixing, mail and relays.</p></article>
          <article class="glass"><h3>High-capacity node</h3><p>Fast fibre, plenty of storage and a Mac with a Neural Engine. It proves ten times the work of an average node, so it earns ten times as much.</p></article>
          <article class="glass"><h3>Paid for proof, not hype</h3><p>Every dollar comes from a verified work receipt, paid in shielded USDC at one worldwide rate. No token sale, and no pay for doing nothing.</p></article>
        </div>
        <p class="footnote">
          Estimates. They assume 5% of people subscribe (98.9% Pro, 1% Ultra, 0.1% Akashic, about $3.37 a month to the network
          per subscriber after Apple’s 15%), node counts growing more slowly than the audience, and a high-capacity node
          proving ten times the average work. Before electricity and bandwidth costs, and before tax. Earnings from webË apps,
          contracts, media delivery and the <a href="/bi">ñü.bi</a> dividend are not included. Real earnings depend on usage and are not guaranteed.
        </p>
      </div>
    </section>

    <section class="section" id="network-commerce">
      <div class="wrap">
        <p class="eyebrow">app commerce</p>
        <h2>A flat 10%.<br /><span class="dim">The lowest fee in the industry.</span></h2>
        <p class="intro">
          Apps, Mini Apps and webË sites sell purchases and subscriptions over the network. khensu.ñü keeps 10%, on the
          first dollar and the billionth. It never scales up or down. There is no tier, no programme to apply for, no minimum
          payout and no payout date: each payment reaches the developer’s wallet as it’s made.
        </p>
        <figure class="glass fees">
          <figcaption>Store fee on $100 of sales, and what the developer keeps</figcaption>
          <ul role="list">
            {fees.map((f) => (
              <li class:list={{ ours: f.ours }}>
                <span class="name">{f.name}</span>
                <span class="track" aria-hidden="true">
                  {f.from && <span class="bar from" style={`--w:${(f.from / 30) * 100}`} />}
                  <span class="bar" style={`--w:${(f.fee / 30) * 100}`} />
                </span>
                <span class="fee">{f.label}</span>
                <span class="keeps">keeps {f.keeps}</span>
              </li>
            ))}
          </ul>
        </figure>
        <div class="grid three">
          <article class="glass"><h3>Buyers stay anonymous</h3><p>The developer learns that item X sold at price P and gets paid. No name, email, device or purchase history, and two purchases by one person can’t be linked.</p></article>
          <article class="glass"><h3>Tips stay 100%</h3><p>A tip is a gift to a person, not a purchase. khensu.ñü takes nothing from it, and views, gifts and a creator’s own sales carry no platform cut (<a href="/creators">for artists</a>).</p></article>
          <article class="glass"><h3>Fee included</h3><p>The network fee that pays node operators for carrying a payment comes out of khensu.ñü’s 10%, never on top.</p></article>
        </div>
        <p class="footnote">
          Other stores at their published standard rates, checked 11 October 2026: Epic Games Store 12%; Apple App Store and
          Google Play 15% for small businesses, subscriptions after a year or the first $1 million, 30% otherwise. Purchases
          paid through Apple’s or Google’s own billing also pay that store’s share. Trademarks belong to their owners; no affiliation or endorsement.
        </p>
        <div class="btn-row">
          <a class="btn" href={`${DEV}/specs/app-commerce`}>App commerce specification</a>
        </div>
      </div>
    </section>

    <section class="section earth" id="network-gift">
      <img class="globe" src="/khensu/hero/earth.jpg" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
      <div class="wrap">
        <p class="eyebrow">succession</p>
        <h2>It belongs to everyone.<br /><span class="dim">Even after its founder.</span></h2>
        <p class="intro">
          A dead-man’s switch is written into the protocol. If the founder disappears, or chooses to step away, every founder
          power passes to the network’s consensus, permanently. There is no path back to a founder key.
        </p>
        <ol class="timeline" role="list">
          {succession.map((s, i) => (
            <li style={`--i:${i}`}>
              <span class="dot" aria-hidden="true" />
              <h3>{s.t}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
        <div class="grid two">
          <article class="glass">
            <h3>Releases, signed by the network</h3>
            <p>After the switch, every app and node release is signed by a 14-of-21 key held by the epoch’s committee and re-shared every epoch. A release is valid only if its reproducible build matches the archive.</p>
          </article>
          <article class="glass">
            <h3>Private code opens too, patents included</h3>
            <p>Every private repository, patented algorithm, model and patent filing is sealed on the network to a 14-of-21 key held by the trusted committee nodes, updated on every push. When the switch fires the committee opens it, and everyone gets a royalty-free licence to every patent.</p>
          </article>
          <article class="glass">
            <h3>Everything, archived on the network</h3>
            <p>Every repository with all its history, every spec, every signed release and build recipe, the whole chain and every node’s history live on the network itself at <code>archive.khensu.nu</code>. Anyone can rebuild every release and replay the network from genesis, without GitHub, Apple or the founder.</p>
          </article>
        </div>
        <p class="gift">A gift to humanity and all beings.<br />Freedom and privacy, plus a <a href="/bi">universal basic income</a>.</p>
        <p class="gift-sub">Made so everyone, everywhere, can create, build and live securely.</p>
        <div class="btn-row center">
          <a class="btn" href={`${DEV}/specs/protocol#125-founder-succession`}>Founder succession specification</a>
          <a class="btn" href="/compliance">Compliance</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .dim {
    color: rgba(255, 255, 255, 0.5);
  }
  .band {
    background: #000;
  }
  h2 {
    margin-bottom: 1.2rem;
  }
  .intro {
    color: var(--text-dim);
    max-width: 52rem;
    margin-bottom: 2rem;
