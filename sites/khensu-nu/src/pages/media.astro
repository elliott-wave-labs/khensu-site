---
import Base from '../layouts/Base.astro';
import NuMedia from '../components/khensu/NuMedia.astro';
import StatStrip from '../components/khensu/StatStrip.astro';
import proReel from '../data/pro-reel.json';
import i720 from '../data/iphone-720p.json';
import ladReel from '../data/iphone-ladder-reel.json';

const kbit = (s: string) => Number(s.match(/([\d.]+) kbit\/s with sound/)?.[1]);
const low = proReel.tiles.find((t) => t.id === 'low')!;
const ultra = proReel.tiles.find((t) => t.id === 'ultra')!;
type Tile = { actual_kbps: number; vmaf: number };
const r500 = (ladReel.tiles.rates as Record<string, Record<string, Tile>>)['500'];
const srcKbps = Number(ladReel.source.match(/([\d.]+) Mbit\/s/)?.[1]) * 1000;
const smaller = Math.round(srcKbps / r500['nu-media'].actual_kbps);
const speed = i720.iphone_fps['nu-base'] / i720.iphone_fps['hevc-hw'];
const fps = Number(ultra.note.match(/at (\d+) fps/)?.[1]);
---

<Base
  title="ñü.media: measurements"
  description="How nu.media photos and video compare with JPEG, HEIC, H.264, HEVC and AV1, what each one measures, and how we test."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">ñü.media · measurements</p>
      <h1>Less data.<br />The full picture.</h1>
      <StatStrip
        items={[
          { n: smaller, unit: '×', label: `Less data than Instagram’s own file, at VMAF ${Math.round(r500['nu-media'].vmaf)} to HEVC’s ${Math.round(r500['hevc-hw'].vmaf)} at the same rate`, kind: 'benchmark' },
          { n: kbit(low.note), unit: 'kbit/s', label: 'Full 720p video with sound, least-data mode', kind: 'benchmark' },
          { n: speed, dec: 1, unit: '×', label: 'Faster to encode than full-size HEVC on iPhone', kind: 'benchmark' },
          { n: fps, unit: 'fps', label: 'Ultra, rebuilt to 4K on the host’s own Mac', kind: 'benchmark' },
        ]}
      >
        Benchmarks: the 720p reel encoded on iPhone Air with iOS {i720.os.match(/[\d.]+/)?.[0]}; least data and Ultra on a Mac
        with M1 Pro, 11 October 2026. Raw results sit beside each chart below.
      </StatStrip>
      <p class="lede">
        nu.media sends a smaller picture, and the receiving iPhone’s Neural Engine rebuilds the full one.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>How it works</h2>
      <p class="body">
        nu.media sends video in two layers. The base layer is the video at half size, encoded by your iPhone’s hardware
        HEVC encoder; it is what crosses the network. The receiving iPhone’s Neural Engine then rebuilds the full picture.
        The measurements here show the base layer alone, and the full picture rebuilt with Apple’s built-in super
        resolution on the Neural Engine.
      </p>

      <h2>What the scores say</h2>
      <ul class="facts">
        <li><b>The base layer alone</b> scores below full-size HEVC, as expected: it is HEVC at a quarter of the pixels.</li>
        <li><b>With Apple’s super resolution</b> it looks sharper to the eye, but VMAF scores it lower, because Apple’s model adds texture the original doesn’t have and VMAF counts that as error.</li>
        <li><b>ñü.media’s own network</b> is trained to restore the original rather than invent detail. Every line on the charts is a benchmark except the dashed ones, which are other codecs’ published estimates.</li>
      </ul>

      <h2>How we test</h2>
      <ul class="facts">
        <li><b>The picture you see:</b> every codec is scored on the decoded frames shown on the receiving phone, so nu.media is scored with its enhancement on, never the base layer alone.</li>
        <li><b>Two scores, side by side:</b> Netflix’s <a href="https://github.com/Netflix/vmaf">VMAF</a> as published, unmodified, and a viewer test to <a href="https://www.itu.int/rec/T-REC-P.910">ITU-T P.910</a>, where people rate clips without knowing the codec. VMAF is known to under-rate generated detail, so the viewer test is the deciding score when they disagree.</li>
        <li><b>Same conditions for everyone:</b> the same clips, bitrates and phones, hardware encoders at live-call settings, and the raw results published as JSON beside each chart.</li>
      </ul>
    </div>
  </section>

  <NuMedia full />
</Base>

<style>
  .lede {
    margin: clamp(1.6rem, 4vw, 2.4rem) 0 0;
  }
  .body {
    color: var(--text-dim);
    margin: 0 0 2rem;
  }
  .facts {
    display: grid;
    gap: 0.8rem;
    padding-left: 1.1rem;
    margin: 0 0 2rem;
    color: var(--text-dim);
  }
  .facts b {
    color: var(--text);
    font-weight: 500;
  }
</style>
