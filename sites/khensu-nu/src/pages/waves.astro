---
import Base from '../layouts/Base.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import Sounds from '../components/creators/Sounds.astro';
import { APP_STORE_ID, APP_STORE_URL } from '../data/app';

const S = '/khensu/sounds';
const appLabel = APP_STORE_ID ? 'Download on the App Store' : 'Get the app';
const instruments = [
  { id: 'drums', label: 'Drums' },
  { id: 'piano', label: 'Piano' },
  { id: 'synths', label: 'Winds & strings' },
  { id: 'guitar', label: 'Strings' },
  { id: 'bass', label: 'Bass' },
];
const venues = [
  { id: 'room', label: 'Private room' },
  { id: 'club', label: 'Club' },
  { id: 'hall', label: 'Concert hall' },
  { id: 'stadium', label: 'Stadium' },
  { id: 'festival', label: 'Festival' },
];
// Bottom to top, same symbols and names as the shield page.
const chakras = [
  { id: 'root', name: 'Muladhara', en: 'Root', hex: '#ff4b4b', petals: 4, shape: 'square' },
  { id: 'sacral', name: 'Svadhisthana', en: 'Sacral', hex: '#ff8a3c', petals: 6, shape: 'crescent' },
  { id: 'solar', name: 'Manipura', en: 'Solar plexus', hex: '#ffd23c', petals: 10, shape: 'tri-down' },
  { id: 'heart', name: 'Anahata', en: 'Heart', hex: '#3ccf7a', petals: 12, shape: 'hexagram' },
  { id: 'throat', name: 'Vishuddha', en: 'Throat', hex: '#38a8ff', petals: 16, shape: 'circle-tri' },
  { id: 'eye', name: 'Ajna', en: 'Third eye', hex: '#6c6cff', petals: 2, shape: 'tri-down' },
  { id: 'crown', name: 'Sahasrara', en: 'Crown', hex: '#b07cff', petals: 24, shape: 'dot' },
].map((c) => ({
  ...c,
  petalPaths: Array.from({ length: c.petals }, (_, i) => (360 / c.petals) * i),
}));
// Measured 12 October 2026 on the files the page plays; FLAC is the original at 16-bit, compression level 12.
const sizes = [
  { name: 'ñü.ŵævẽš', mb: 9.1, kbps: 174, us: true },
  { name: 'Original 2008', mb: 9.6, kbps: 191, us: false },
  { name: 'Opus 5.1', mb: 13.0, kbps: 258, us: false },
  { name: 'Lossless FLAC', mb: 28.6, kbps: 571, us: false },
];
const split = [
  { name: 'Winds & strings', kbps: 48 },
  { name: 'Drums', kbps: 45 },
  { name: 'Piano', kbps: 39 },
  { name: 'Strings', kbps: 21 },
  { name: 'Bass', kbps: 20 },
];
// ñü.ŵævẽš, stereo, Opus 5.1, Dolby Atmos: 1 yes, 0.5 partly, 0 no.
const abilities = [
  { what: 'Every instrument its own sound', has: [1, 0, 0, 0.5] },
  { what: 'Move any instrument while it plays', has: [1, 0, 0, 0] },
  { what: 'Sounds above and below you', has: [1, 0, 0, 1] },
  { what: 'Distance: near or far, up to 4 m', has: [1, 0, 0, 0.5] },
  { what: 'Pick the room as you listen', has: [1, 0, 0, 0] },
  { what: 'ñü.ÊQ: gain, reverb, echo duration, delay and bounces', has: [1, 0, 0, 0] },
  { what: 'Plays on any headphones, in any browser', has: [1, 1, 0.5, 0.5] },
  { what: 'Switch to the untouched original at any moment', has: [1, 1, 0, 0] },
  { what: 'Smaller than the original stereo file', has: [1, 0, 0, 0] },
  { what: 'Duplicate a track and shift it in space and time', has: [1, 0, 0, 0], soon: true },
  { what: 'Artist-locked sound per song', has: [1, 0, 0, 0], soon: true },
];
---

<Base
  title="ñü.ŵævẽš"
  description="A 2008 demo saved as a small stereo file, split into its instruments and placed around you in spatial audio by nu.waves. Switch to the original, pick the room, and drag every instrument where you want it."
>
  <div class="khensu sp">
    <section class="sp-hero" data-scene="stage" aria-labelledby="sp-title">
      <div class="sp-stage">
      <div class="wrap sp-head">
        <p class="eyebrow">ñü.ŵævẽš</p>
        <h1 id="sp-title">Every instrument, <em>where it belongs.</em></h1>
      </div>

      <div class="wrap sp-player" data-spatial data-mode="wave" data-track="attempt">
        <div class="sp-glass">
          <img class="sp-bloom" src={`${S}/first-attempt.webp`} alt="" aria-hidden="true" width="273" height="466" />
          <div class="sp-card">
            <div class="sp-cover">
              <img class="sp-art" data-art src={`${S}/first-attempt.webp`} alt="Cover of More Of The Same by khėnsu.ñü" width="273" height="466" />
              <div class="sp-mark" data-mark>
                <b data-mark-name>First Attempt</b>
                <span data-mark-hz></span>
              </div>
            </div>
            <div class="sp-meta">
              <p class="sp-k" data-label aria-live="polite">Next up</p>
              <p class="sp-t" data-title>First Attempt (Demo)</p>
              <p class="sp-by" data-by>khėnsu.ñü · More Of The Same · 2008</p>
              <p class="sp-line" data-spec>5 instruments in 3D · 48 kHz · 9.1 MB · 6:40</p>
              <div class="sp-ctl">
                <button class="sp-play" type="button" data-play data-state="play" aria-label="Play">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path class="i-play" d="M8 5.5v13l10.5-6.5z" />
                    <path class="i-pause" d="M7.5 5h3v14h-3zM13.5 5h3v14h-3z" />
                    <path class="i-replay" d="M12 5V2L7.5 6 12 10V7a5.5 5.5 0 1 1-5.5 5.5H4.5A7.5 7.5 0 1 0 12 5z" />
                  </svg>
                </button>
                <div class="sp-time">
                  <label class="sr" for="sp-seek">Position in the song</label>
                  <input id="sp-seek" type="range" min="0" max="400" step="0.1" value="0" data-seek style="--p:0%" />
                  <span><span data-cur>0:00</span><span data-dur>6:40</span></span>
                </div>
                <button class="sp-loop" type="button" data-loop aria-pressed="false" aria-label="Loop">
                  <i aria-hidden="true"></i>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 3l3 3-3 3M4 11V9a3 3 0 0 1 3-3h13M7 21l-3-3 3-3M20 13v2a3 3 0 0 1-3 3H4" /></svg>
                </button>
              </div>
              <div class="sp-mode" data-song-modes role="group" aria-label="What to play">
                <button type="button" data-mode="orig" aria-pressed="false">original</button>
                <button type="button" data-mode="wave" aria-pressed="true">ñü.ŵævẽš</button>
              </div>
            </div>
            <audio preload="none" crossorigin="anonymous" data-orig src={`${S}/first-attempt-original.m4a`}></audio>
            {instruments.map((i) => <audio preload="none" crossorigin="anonymous" data-stem={i.id} src={`${S}/stems/${i.id}.mp4`} />)}
          </div>
        </div>

        <figure class="sp-room">
          <p class="sp-orb-brand" id="sp-orb-name">spacetime bubble™</p>
          <div class="sp-ring" data-ring aria-labelledby="sp-orb-name">
            <canvas data-orb aria-hidden="true"></canvas>
            <span class="sp-dir" data-dir="ahead">ahead</span>
            <span class="sp-dir" data-dir="behind">behind</span>
            <span class="sp-dir" data-dir="above">above</span>
            <span class="sp-dir" data-dir="below">below</span>
            {instruments.map((i) => (
              <div class="sp-bubble">
                <button type="button" class="sp-node" data-node={i.id} data-label={i.label} data-kind="stem" aria-pressed="false">
                  <i aria-hidden="true"></i>
                  <span>{i.label}</span>
                </button>
                <span class="sp-tools">
                  <button type="button" data-clone>Clone</button>
                  <button type="button" data-remove>Remove</button>
                </span>
              </div>
            ))}
            <template data-node-template>
              <div class="sp-bubble">
                <button type="button" class="sp-node" aria-pressed="false"><i aria-hidden="true"></i><span></span></button>
                <span class="sp-tools">
                  <button type="button" data-clone>Clone</button>
                  <button type="button" data-remove>Remove</button>
                </span>
              </div>
            </template>
          </div>
          <div class="sp-venues-pick" role="group" aria-label="Room">
            {venues.map((v) => (
              <button type="button" data-venue={v.id} aria-pressed={String(v.id === 'hall')}>{v.label}</button>
            ))}
          </div>
          <p class="sp-picked" data-picked>Concert hall. Strings, winds and piano, written as a film score.</p>
          <div class="sp-tracks" role="group" aria-label="Track">
            <button type="button" data-track="attempt" aria-pressed="true">nu.aura</button>
            <button type="button" data-track="creek" aria-pressed="false">Stair Creek</button>
            <button type="button" data-track="scream" aria-pressed="false">Wilhelm Scream</button>
            <div class="sp-chakra">
              <button type="button" data-chakra-open aria-expanded="false" aria-pressed="false" aria-haspopup="true">Chakras</button>
              <div class="sp-chakra-menu" data-chakra-menu hidden>
                <button type="button" data-cycle aria-pressed="false">Auto-cycle · bottom to top</button>
                {chakras.map((c) => (
                  <button type="button" data-track={c.id} aria-pressed="false">
                    <svg viewBox="-50 -50 100 100" aria-hidden="true" class="lotus" style={`--c:${c.hex}`}>
                      {c.petalPaths.map((a) => (
                        <ellipse cx="0" cy={c.petals === 2 ? -30 : -34} rx={c.petals === 2 ? 16 : c.petals > 16 ? 4 : 9} ry={c.petals === 2 ? 12 : 13} transform={`rotate(${c.petals === 2 ? a + 90 : a})`} />
                      ))}
                      <circle r="22" class="core" />
                      {c.shape === 'square' && <rect x="-12" y="-12" width="24" height="24" />}
                      {c.shape === 'crescent' && <path d="M-12 -4 A13 13 0 0 0 12 -4 A10 10 0 0 1 -12 -4 Z" />}
                      {c.shape === 'tri-down' && <path d="M-14 -8 L14 -8 L0 15 Z" />}
                      {c.shape === 'hexagram' && <path d="M0 -15 L13 7.5 L-13 7.5 Z M0 15 L13 -7.5 L-13 -7.5 Z" />}
                      {c.shape === 'circle-tri' && <><circle r="13" /><path d="M-10 -5 L10 -5 L0 11 Z" /></>}
                      {c.shape === 'dot' && <circle r="6" />}
                    </svg>
                    <span><b>{c.name}</b><small>{c.en}</small></span>
                  </button>
                ))}
              </div>
            </div>
          </div>
          <fieldset class="sp-tone" data-tone>
            <legend>Chakra tone</legend>
            <label>Hold <input type="range" min="1" max="20" step="0.5" value="8" data-tone-hold /><output data-tone-out="hold">8.0 s</output></label>
            <label>Fade <input type="range" min="0.5" max="12" step="0.5" value="4" data-tone-fade /><output data-tone-out="fade">4.0 s</output></label>
            <label>Crossfade <input type="range" min="0" max="8" step="0.1" value="2" data-tone-cross /><output data-tone-out="cross">2.0 s</output></label>
          </fieldset>
          <div class="sp-height">
            <label for="sp-height">Height</label>
            <input id="sp-height" type="range" min="-3" max="3" step="0.1" value="0" data-height />
            <output for="sp-height" data-height-out>Drums · +0.0 m</output>
          </div>
          <fieldset class="sp-fx" data-fx>
            <legend>ñü.ÊQ</legend>
            <div class="sp-fx-presets" role="group" aria-label="ñü.ÊQ presets">
              <button type="button" data-preset="original" aria-pressed="false">Match original</button>
              <button type="button" data-preset="clean" aria-pressed="false">Clean</button>
            </div>
            <label>Gain <input type="range" min="-12" max="12" step="0.5" value="0" data-fx-gain /><output data-fx-out="gain">0 dB</output></label>
            <label>Reverb <input type="range" min="0" max="100" step="1" value="40" data-fx-wet /><output data-fx-out="wet">40%</output></label>
            <label>Echo duration <input type="range" min="0.2" max="6" step="0.1" value="2.1" data-fx-rt /><output data-fx-out="rt">2.1 s</output></label>
            <label>Echo delay <input type="range" min="0" max="400" step="1" value="25" data-fx-pre /><output data-fx-out="pre">25 ms</output></label>
            <label>Echo bounces <input type="range" min="0" max="8" step="1" value="0" data-fx-bounces /><output data-fx-out="bounces">0</output></label>
          </fieldset>
          <figcaption>Drag a sound. Drag the spacetime bubble to look around.</figcaption>
        </figure>
      </div>
      </div>
    </section>

    <section class="section sp-file" id="file-section" aria-labelledby="sp-file-title">
      <div class="wrap">
        <p class="eyebrow">A 2008 demo</p>
        <h2 id="sp-file-title">Rebuilt in space.</h2>
        <p class="sp-lede">
          First Attempt was made in GarageBand in 2008 and all that survived is a small stereo AAC file.
          <strong> nu.waves picked out each instrument, split it from the others and set them in a concert hall.</strong> Put on headphones, press play, switch to the original to hear where it started, then drag the
          instruments anywhere around you.
        </p>
        <dl class="sp-spec">
          <div>
            <dt>Original 2008</dt>
            <dd>AAC-LC · stereo · 44.1 kHz · 191 kbit/s · 9.6 MB · 6:40</dd>
          </div>
          <div>
            <dt>ñü.ŵævẽš</dt>
            <dd>5 instruments in 3D · 48 kHz · 174 kbit/s · 9.1 MB · 6:40</dd>
            <dd class="sp-each">winds & strings 48 · drums 45 · piano 39 · strings 21 · bass 20 kbit/s</dd>
          </div>
          <div>
            <dt>Opus 5.1</dt>
            <dd>6 channels · 48 kHz · 258 kbit/s · 13.0 MB</dd>
          </div>
          <div>
            <dt>Lossless FLAC of the original</dt>
            <dd>stereo · 44.1 kHz · 16-bit · bit-exact · 28.6 MB</dd>
          </div>
        </dl>
        <p class="sp-vs">
          The nu.waves file on this page is 9.1 MB, 9% smaller than the 2008 stereo file and 33% smaller than the Opus 5.1
          file. Those are file sizes. Listening quality is nu.fidelity, scored by ear. nu.waves is the one you can move,
          to any angle, distance and height. 5.1 fixes six speakers on one flat ring, with the instruments mixed together
          inside them.
        </p>
      </div>
      <div class="wrap sp-how">
        <div>
          <b>What we did to the 2008 file</b>
          <p>
            The source is a 6:40 stereo AAC from 2008. Demucs, an open-source separation model, ran on a Mac and found
            five parts in it: drums, piano, strings (violin, viola and cello, many takes of each), winds with strings, and
            bass. It stands in for the on-device model. Nothing was re-recorded and nothing was added: each instrument became its
            own sound, set in the room and stored as a nu.waves object.
          </p>
        </div>
        <div>
          <b>Fewer bits</b>
          <p>
            Five instruments you can move anywhere take 9.1 MB, less than the 9.6 MB original stereo file and 30% less
            than the fixed 5.1 mix this page used to play. Each instrument is one sound at one point, so it needs one
            channel, not six.
          </p>
        </div>
        <div>
          <b>How to hear it</b>
          <p>
            Any headphones. This page renders the room for your two ears in the browser, with no head tracking. In the
            khėnsu.ñü app, nu.waves hands the same objects to Apple’s spatial audio on AirPods, so they stay put when you
            turn your head.
          </p>
        </div>
      </div>
      <div class="wrap sp-room-copy" id="codec-section">
          <h2 id="sp-codec-title">One sound, then where it sits.</h2>
          <p>
            nu.waves stores each instrument once. Where it sits, how high, how far, and the room around it, is a list of
            numbers beside the sound. Moving it, or scheduling a move, does not encode the audio again and does not add
            channels.
          </p>
          <p>
            Opus 5.1 on this page is the same song folded into six fixed speakers: 258 kbit/s, 13.0 MB, measured. Opus at
            48 kbit/s is a stereo rate used when a song should still sound whole. A 5.1 mix packed into that same 48
            kbit/s has about 8 kbit/s for each speaker. nu.waves on this page is 174 kbit/s, measured, because each
            instrument here is still an Opus stem. The listening score is nu.fidelity, scored by ear, and it is separate
            from that rate.
          </p>
          <p>
            The aim is a much lower packing rate at the same listening score. That aim is an estimate until the listening
            test is run. What is already true: a path through the room is lossless next to the samples. An artist can
            schedule the move. A listener can schedule their own. The person stays put, the sound moves, and the samples
            do not change, so the path costs a few numbers, not another mix.
          </p>
          <h2 id="sp-ears-title">In the ear.</h2>
          <p>
            nu.ears are in-ear. No camera. Voice access stays on the device. A call goes out through two relays run by
            different operators, the same rule as every khėnsu.ñü call, and those relays carry voice and audio.
          </p>
          <p>
            They play a nu.waves object in each ear, so height and distance are rendered there instead of folded into a
            stereo mix first. The spec is louder than AirPods Pro 2, and a longer charge than its 6 hours of listening
            with noise control on.
          </p>
          <p>
            AirPods Pro 2 listening time is Apple’s published figure. Loudness and hours for nu.ears are the product
            spec; measured figures replace them when a pair is tested. AirPods is a trademark of Apple Inc.
          </p>
          <h2>In the room.</h2>
          <p>
            Every sound has its own height, above or below your ears as well as all the way round. Pick a track and
            the player follows it. Stair Creek sits beside you. Wilhelm Scream is the 1951 yell from Wikimedia Commons (CC0).
            The chakra tones run from the root, below you, up to the crown: Muladhara 194.18 Hz, Svadhisthana 210.42 Hz,
            Manipura 126.22 Hz, Anahata 136.10 Hz, Vishuddha 141.27 Hz, Ajna 221.23 Hz just in front of your forehead,
            Sahasrara 172.06 Hz. Each tone holds, fades, then ends, or hands off to the next with a crossfade. Auto-cycle
            walks them from the root to the crown. Clone and remove sit on the sound you have selected in the spacetime bubble.
          </p>
          <p>
            Drag a sound to move it anywhere in the spacetime bubble, up to 4 m away, above or below you; drag the bubble
            itself to look around it. The height slider sets the selected sound’s height. With a keyboard, use the arrow
            keys, and Page Up and Page Down for height. Each sound sends its own waves across the bubble as it plays.
          </p>
          <p>
            Gain 0 dB keeps nu.waves as loud as the original 2008 file, measured as you listen. Reverb is the room.
            Echo duration is how long it lasts, echo delay is the gap between repeats, and echo bounces is how many you hear.
            Clean takes the room off. These five controls are nu.eq.
          </p>
        </div>
    </section>

    <section class="sp-story">
      <div class="wrap sp-cmp" aria-labelledby="sp-cmp-title">
        <p class="eyebrow">ñü.ŵævẽš · compared</p>
        <h2 id="sp-cmp-title">Smaller than the original. <em>And it moves.</em></h2>
        <p class="sp-cmp-lede">
          The same 6:40 song, four ways. nu.waves carries every instrument as its own sound in 3D, in less space than the
          2008 stereo file, and it’s the only one here you can rearrange while it plays.
        </p>

        <div class="sp-charts">
          <figure class="sp-chart">
            <figcaption><b>File size</b><span>for 6:40</span></figcaption>
            <ul role="list">
              {sizes.map((r) => (
                <li class:list={{ us: r.us }}>
                  <span class="k">{r.name}</span>
                  <span class="bar"><i style={`--w:${(r.mb / 28.6) * 100}%`} /></span>
                  <span class="v">{r.mb.toFixed(1)} MB</span>
                </li>
              ))}
            </ul>
          </figure>
          <figure class="sp-chart">
            <figcaption><b>Bits stored each second</b><span>how the file is packed</span></figcaption>
            <ul role="list">
              {sizes.map((r) => (
                <li class:list={{ us: r.us }}>
                  <span class="k">{r.name}</span>
                  <span class="bar"><i style={`--w:${(r.kbps / 571) * 100}%`} /></span>
                  <span class="v">{r.kbps}</span>
                </li>
              ))}
            </ul>
          </figure>
        </div>

        <figure class="sp-chart sp-stack">
          <figcaption><b>Where the stored bits go</b><span>each instrument’s share of the 174 kbit/s file rate</span></figcaption>
          <div class="stack" role="img" aria-label={split.map((p) => `${p.name} ${p.kbps} kbit/s`).join(', ')}>
            {split.map((p, i) => <i style={`--w:${(p.kbps / 174) * 100}%;--c:${i}`} title={`${p.name} · ${p.kbps} kbit/s`} />)}
          </div>
          <ul class="legend" role="list">
            {split.map((p, i) => <li style={`--c:${i}`}><i />{p.name} <span>{p.kbps}</span></li>)}
          </ul>
        </figure>

        <div class="sp-matrix" role="region" aria-label="What each format can do" tabindex="0">
          <table>
            <thead>
              <tr>
                <th scope="col">What you can do</th>
                <th scope="col" class="us">ñü.ŵævẽš</th>
                <th scope="col">Stereo<small>AAC, FLAC</small></th>
                <th scope="col">Opus 5.1</th>
                <th scope="col">Dolby Atmos</th>
              </tr>
            </thead>
            <tbody>
              {abilities.map((a) => (
                <tr>
                  <th scope="row">{a.what}{a.soon && <small>coming</small>}</th>
                  {a.has.map((h, i) => (
                    <td class:list={{ us: i === 0 }}>
                      {h === 1 ? <span class="yes" aria-label="Yes">●</span> : h === 0.5 ? <span class="part" aria-label="Partly">◐</span> : <span class="no" aria-label="No">–</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="sp-cmp-note">
          Sizes and rates measured on the files this page plays, 12 October 2026. FLAC is the original losslessly
          compressed, 16-bit, and bit-exact. Each nu.waves instrument on this page is Opus at 48 kHz inside the format.
          The charts count bytes. nu.fidelity is the listening score, scored by ear, and it is separate from kbit/s.
          Dolby Atmos places sounds in height too; its mix is set by the engineer. Dolby and Dolby Atmos
          are trademarks of Dolby Laboratories; no affiliation.
        </p>
      </div>

      <div class="wrap sp-auto" aria-labelledby="sp-auto-title">
        <p class="eyebrow">ñü.ÊQ · Akashic</p>
        <h2 id="sp-auto-title">All audio, placed in the room it was meant for.</h2>
        <p class="sp-auto-lede">
          What you just heard, done for every song, talk and film without a spatial mix of its own. nu.waves listens,
          picks out every instrument and voice, works out the room, and places each one there, on your own iPhone, iPad
          or Mac. Nothing is sent anywhere. For Akashic members.
        </p>
        <ul class="sp-venues" role="list">
          <li><b>Concert hall</b><span>Strings and choir across the stage, two seconds of hall around you</span></li>
          <li><b>Stadium</b><span>The band far ahead and high, the crowd and the echo all the way round</span></li>
          <li><b>Festival</b><span>Kick and bass dead centre, synths wrapping around and above you</span></li>
          <li><b>Club</b><span>Drums a few steps away, keys and guitar either side</span></li>
          <li><b>Private room</b><span>A voice and a guitar an arm’s length away</span></li>
          <li><b>Book reading</b><span>One voice across a quiet table, the room barely there</span></li>
