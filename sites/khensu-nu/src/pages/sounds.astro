---
import Base from '../layouts/Base.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import Sounds from '../components/creators/Sounds.astro';
import { APP_STORE_ID, APP_STORE_URL } from '../data/app';

const S = '/khensu/sounds';
const appLabel = APP_STORE_ID ? 'Download on the App Store' : 'Get the app';
const instruments = [
  { id: 'drums', label: 'Drums' },
  { id: 'piano', label: 'Piano' },
  { id: 'synths', label: 'Synths' },
  { id: 'guitar', label: 'Guitar' },
  { id: 'bass', label: 'Bass' },
];
const venues = [
  { id: 'room', label: 'Private room' },
  { id: 'club', label: 'Club' },
  { id: 'hall', label: 'Concert hall' },
  { id: 'stadium', label: 'Stadium' },
  { id: 'festival', label: 'Festival' },
];
---

<Base
  title="ñü.sounds"
  description="A 2008 demo saved as a small stereo file, split into its instruments and placed around you in spatial audio by ñü.wæve. Switch to the original, pick the room, and drag every instrument where you want it."
>
  <div class="khensu sp">
    <section class="sp-hero" aria-labelledby="sp-title">
      <div class="wrap sp-head">
        <p class="eyebrow">ñü.sounds · ñü.wæve</p>
        <h1 id="sp-title">A 2008 demo, rebuilt in space.<em>Every instrument, where it belongs.</em></h1>
        <p class="sp-lede">
          First Attempt was made in GarageBand in 2008 and all that survived is a small stereo AAC file.
          <strong>ñü.wæve picked out each instrument, split it from the others and set it in the room the song was made
          for.</strong> Put on headphones, press play, switch to the original to hear where it started, then drag the
          instruments anywhere around you.
        </p>
      </div>

      <div class="wrap sp-player" data-spatial data-mode="wave">
        <div class="sp-glass">
          <img class="sp-bloom" src={`${S}/first-attempt.webp`} alt="" aria-hidden="true" width="273" height="466" />
          <div class="sp-card">
            <img class="sp-art" src={`${S}/first-attempt.webp`} alt="Cover of More Of The Same by khensu.ñü" width="273" height="466" />
            <div class="sp-meta">
              <p class="sp-k" data-label aria-live="polite">Next up</p>
              <p class="sp-t">First Attempt (Demo)</p>
              <p class="sp-by">khensu.ñü · More Of The Same · 2008</p>
              <div class="sp-ctl">
                <button class="sp-play" type="button" data-play data-state="play" aria-label="Play">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path class="i-play" d="M8 5.5v13l10.5-6.5z" />
                    <path class="i-pause" d="M7.5 5h3v14h-3zM13.5 5h3v14h-3z" />
                    <path class="i-replay" d="M12 5V2L7.5 6 12 10V7a5.5 5.5 0 1 1-5.5 5.5H4.5A7.5 7.5 0 1 0 12 5z" />
                  </svg>
                </button>
                <div class="sp-time">
                  <label class="sr" for="sp-seek">Position in the song</label>
                  <input id="sp-seek" type="range" min="0" max="400" step="0.1" value="0" data-seek style="--p:0%" />
                  <span><span data-cur>0:00</span><span data-dur>6:40</span></span>
                </div>
                <button class="sp-loop" type="button" data-loop aria-pressed="false" aria-label="Loop">
                  <i aria-hidden="true"></i>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 3l3 3-3 3M4 11V9a3 3 0 0 1 3-3h13M7 21l-3-3 3-3M20 13v2a3 3 0 0 1-3 3H4" /></svg>
                </button>
              </div>
              <div class="sp-mode" role="group" aria-label="What to play">
                <button type="button" data-mode="orig" aria-pressed="false">Original 2008</button>
                <button type="button" data-mode="wave" aria-pressed="true">ñü.wæve</button>
              </div>
              <dl class="sp-spec">
                <div data-for="orig">
                  <dt>Original 2008</dt>
                  <dd>AAC-LC · stereo · 44.1 kHz · 191 kbit/s · 9.6 MB</dd>
                </div>
                <div data-for="wave">
                  <dt>ñü.wæve</dt>
                  <dd>Opus objects · 5 × mono · 48 kHz · 174 kbit/s · 9.1 MB</dd>
                  <dd class="sp-each">synths 48 · drums 45 · piano 39 · guitar 21 · bass 20 kbit/s</dd>
                </div>
                <div class="ref">
                  <dt>Opus 5.1</dt>
                  <dd>6 channels · 48 kHz · 258 kbit/s · 13.0 MB</dd>
                </div>
              </dl>
              <p class="sp-vs">
                ñü.wæve uses 33% fewer bits than Opus 5.1 and 9% fewer than the original, and it does what 5.1 can’t:
                every instrument moves, to any angle, distance and height. 5.1 fixes six speakers on one flat ring, with
                the instruments mixed together inside them.
              </p>
            </div>
            <audio preload="none" crossorigin="anonymous" data-orig src={`${S}/first-attempt-original.m4a`}></audio>
            {instruments.map((i) => <audio preload="none" crossorigin="anonymous" data-stem={i.id} src={`${S}/stems/${i.id}.mp4`} />)}
          </div>
        </div>

        <figure class="sp-room">
          <div class="sp-venues-pick" role="group" aria-label="Room">
            {venues.map((v) => (
              <button type="button" data-venue={v.id} aria-pressed={String(v.id === 'club')}>{v.label}</button>
            ))}
          </div>
          <p class="sp-picked" data-picked>Picked for this song: a club, the room a 2008 demo like this was made for.</p>
          <div class="sp-ring" data-ring>
            <svg viewBox="0 0 400 400" aria-hidden="true">
              <defs>
                <radialGradient id="sp-floor">
                  <stop offset="0" stop-color="#4fb0ff" stop-opacity="0.16" />
                  <stop offset="0.7" stop-color="#8b5cff" stop-opacity="0.06" />
                  <stop offset="1" stop-color="#000" stop-opacity="0" />
                </radialGradient>
              </defs>
              <circle cx="200" cy="200" r="190" fill="url(#sp-floor)" />
              <circle class="ring" cx="200" cy="200" r="190" />
              <circle class="ring std" cx="200" cy="200" r="95" />
              <circle class="ring in" cx="200" cy="200" r="47.5" />
              <text class="ring-k" x="200" y="248">1 m</text>
              <text class="ring-k" x="200" y="306">2 m</text>
              <text class="ring-k" x="200" y="402">4 m</text>
              <text class="ring-k ahead" x="200" y="-8">ahead</text>
              <g class="head" transform="translate(200 200)">
                <ellipse rx="15" ry="18" />
                <path d="M-5 -17 0 -25 5 -17" />
                <rect x="-20" y="-6" width="6" height="12" rx="3" />
                <rect x="14" y="-6" width="6" height="12" rx="3" />
              </g>
            </svg>
            {instruments.map((i) => (
              <button type="button" class="sp-node" data-node={i.id} data-label={i.label} aria-pressed="false">
                <i aria-hidden="true"></i>
                <span>{i.label}</span>
              </button>
            ))}
          </div>
          <div class="sp-height">
            <label for="sp-height">Height</label>
            <input id="sp-height" type="range" min="-1.5" max="3" step="0.1" value="0" data-height />
            <output for="sp-height" data-height-out>Drums · +0.0 m</output>
          </div>
          <fieldset class="sp-fx" data-fx>
            <legend>ñü.wæve sound</legend>
            <div class="sp-fx-presets" role="group" aria-label="Sound presets">
              <button type="button" data-preset="original" aria-pressed="true">Match original</button>
              <button type="button" data-preset="clean" aria-pressed="false">Clean</button>
            </div>
            <label>Gain <input type="range" min="-12" max="12" step="0.5" value="0" data-fx-gain /><output data-fx-out="gain">0 dB</output></label>
            <label>Reverb <input type="range" min="0" max="100" step="1" value="45" data-fx-wet /><output data-fx-out="wet">45%</output></label>
            <label>Echo length <input type="range" min="0.2" max="6" step="0.1" value="1.8" data-fx-rt /><output data-fx-out="rt">1.8 s</output></label>
            <label>Delay <input type="range" min="0" max="250" step="1" value="25" data-fx-pre /><output data-fx-out="pre">25 ms</output></label>
            <p class="sp-fx-note">
              Gain 0 dB keeps ñü.wæve as loud as the original 2008 file, measured as you listen. The reverb is added on top
              of the clean instruments and tuned by ear to the original’s room. Clean takes it off.
            </p>
          </fieldset>
          <figcaption>
            Drag an instrument round the ring to move it, towards you or away up to 4 m, and set its height below. With a
            keyboard, use the arrow keys, and Page Up and Page Down for height. Each glows with its own level.
          </figcaption>
        </figure>
      </div>

      <div class="wrap sp-how">
        <div>
          <b>What we did to the 2008 file</b>
          <p>
            The source is a 6:40 stereo AAC from 2008. Demucs, an open-source separation model, ran on a Mac and found
            five instruments in it: drums, piano, synths, guitar and bass. It stands in for ñü.wæve’s own on-device
            model, which is still being built. Nothing was re-recorded and nothing was added: each instrument became its
            own sound, set in the room and stored as a ñü.wæve object.
          </p>
        </div>
        <div>
          <b>Fewer bits</b>
          <p>
            Five instruments you can move anywhere take 9.1 MB, less than the 9.6 MB original stereo file and 30% less
            than the fixed 5.1 mix this page used to play. Each instrument is one sound at one point, so it needs one
            channel, not six.
          </p>
        </div>
        <div>
          <b>How to hear it</b>
          <p>
            Any headphones. This page renders the room for your two ears in the browser, with no head tracking. In the
            khensu.ñü app, ñü.wæve hands the same objects to Apple’s spatial audio on AirPods, so they stay put when you
            turn your head.
          </p>
        </div>
      </div>

      <div class="wrap sp-auto" aria-labelledby="sp-auto-title">
        <p class="eyebrow">auto spatial · Akashic</p>
        <h2 id="sp-auto-title">All audio, placed in the room it was meant for.</h2>
        <p class="sp-auto-lede">
          What you just heard, done for every song, talk and film without a spatial mix of its own. ñü.wæve listens,
          picks out every instrument and voice, works out the room, and places each one there, on your own iPhone, iPad
          or Mac. Nothing is sent anywhere. For Akashic members; in development, with the design published.
        </p>
        <ul class="sp-venues" role="list">
          <li><b>Concert hall</b><span>Strings and choir across the stage, two seconds of hall around you</span></li>
          <li><b>Stadium</b><span>The band far ahead and high, the crowd and the echo all the way round</span></li>
          <li><b>Festival</b><span>Kick and bass dead centre, synths wrapping around and above you</span></li>
          <li><b>Club</b><span>Drums a few steps away, keys and guitar either side</span></li>
          <li><b>Private room</b><span>A voice and a guitar an arm’s length away</span></li>
          <li><b>Book reading</b><span>One voice across a quiet table, the room barely there</span></li>
          <li><b>Interview</b><span>Two voices facing each other, the host on one side, the guest on the other</span></li>
          <li><b>Film</b><span>Dialogue on the screen, music around you, effects where they happen</span></li>
        </ul>
        <div class="sp-auto-grid">
          <div>
            <b>It listens first</b>
            <p>Sound recognition on the Neural Engine hears what is playing: which instruments, which voices, music or speech, and how big the room was. That decides the venue, and it tells you why. Never Private Cloud Compute.</p>
          </div>
          <div>
            <b>Every instrument, every frequency</b>
            <p>Each instrument and voice becomes its own object you can move, like the ring above. Bass stays close and centred, and the air above 6 kHz opens up and rises, the way your ears expect.</p>
          </div>
          <div>
            <b>Nothing added, nothing lost</b>
            <p>The parts always add back up to the original, so folding it to stereo gives you the artist’s master. One tap plays the original, and artists can switch auto spatial off for their work.</p>
          </div>
          <div>
            <b>Locked to khensu.ñü</b>
            <p>ñü.wæve files use the .nu container: the header saying what is inside is encrypted along with the sound, so a file looks like random bytes to anything except the app. Video works the same way.</p>
          </div>
        </div>
        <a class="btn" href="https://github.com/elliott-wave-labs/khensu-specs/blob/main/design/nu-spatial.md">Read the design</a>
      </div>
    </section>

    <ProductBar name="ñü.sounds" action={appLabel} href={APP_STORE_URL} />
    <Sounds />

    <section class="sp-close">
      <div class="wrap">
        <p>
          Every play pays the artist 1¢ with no cut, and what you buy is yours to keep offline.
          <a href="/creators">See what creators keep</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  import '../scripts/creators.ts';
  import '../scripts/spatial.ts';
</script>

<style>
  .sp {
    background: #000;
  }
  .sp-hero {
    padding: clamp(8rem, 16vw, 11rem) 0 clamp(4rem, 8vw, 6rem);
    background:
      radial-gradient(60rem 30rem at 50% 30%, rgba(79, 176, 255, 0.12), transparent 70%),
      radial-gradient(40rem 24rem at 80% 70%, rgba(139, 92, 255, 0.1), transparent 70%),
      #000;
  }
  .sp-head {
    text-align: center;
    max-width: 52rem;
  }
  .sp-head h1 {
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0.4rem 0 1.4rem;
  }
  .sp-head h1 em {
    display: block;
    font-style: normal;
    background: linear-gradient(90deg, #22f59a, #1e8fff 50%, #8b5cff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sp-lede {
    color: var(--muted, #9aa0a6);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    max-width: 40rem;
    margin: 0 auto;
  }
  .sp-lede strong {
    color: #fff;
  }
  .sp-player {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .sp-glass {
    position: relative;
    isolation: isolate;
  }
  .sp-bloom {
    position: absolute;
    inset: 8% 4% 8% 10%;
    width: 86%;
    height: 84%;
    object-fit: cover;
    border-radius: 50%;
    filter: blur(48px) saturate(1.6);
    opacity: 0.55;
    z-index: -1;
  }
  .sp-glass::before {
    content: '';
    position: absolute;
    inset: 20% -6% -8% 40%;
    border-radius: 50%;
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    filter: blur(60px);
    opacity: 0.35;
    z-index: -1;
  }
  .sp-card {
    position: relative;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.4rem;
    align-items: center;
    padding: 1.4rem;
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03) 42%, rgba(255, 255, 255, 0.07)),
      rgba(30, 32, 40, 0.18);
    backdrop-filter: blur(28px) saturate(1.9) brightness(1.08);
    -webkit-backdrop-filter: blur(28px) saturate(1.9) brightness(1.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.38),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      inset 0 0 40px rgba(255, 255, 255, 0.05),
      0 30px 80px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }
  .sp-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(120% 60% at 20% 0%, rgba(255, 255, 255, 0.14), transparent 55%);
    pointer-events: none;
  }
  .sp-art {
    width: 100%;
    aspect-ratio: 273 / 466;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .sp-k {
    font-size: 0.78rem;
    margin: 0;
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sp-t {
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin: 0.25rem 0 0.2rem;
  }
  .sp-by {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.92rem;
    margin: 0;
  }
  .sp-ctl {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.3rem 0 0.9rem;
  }
  .sp-play,
  .sp-loop {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    cursor: pointer;
    color: #fff;
    -webkit-tap-highlight-color: transparent;
  }
  .sp-play {
    width: 3.6rem;
    height: 3.6rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: var(--aura);
    background-size: 300% 100%;
    animation: aura-flow var(--aura-flow-dur) linear infinite;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -8px 16px rgba(0, 0, 0, 0.18),
      0 10px 30px rgba(30, 143, 255, 0.45),
      0 0 40px rgba(139, 92, 255, 0.3);
    transition: transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1), box-shadow 0.3s, background-color 0.3s;
  }
  .sp-play[data-state='pause'],
  .sp-play[data-state='replay'] {
    animation: none;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.04) 55%, rgba(255, 255, 255, 0.1));
    backdrop-filter: blur(16px) saturate(1.8);
    -webkit-backdrop-filter: blur(16px) saturate(1.8);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(255, 255, 255, 0.12),
      inset 0 0 18px rgba(255, 255, 255, 0.08),
      0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .sp-play:hover {
    transform: scale(1.06);
  }
  .sp-play:active {
    transform: scale(0.94);
  }
  .sp-play:focus-visible,
  .sp-loop:focus-visible {
    outline: 2px solid #4fb0ff;
    outline-offset: 3px;
  }
  .sp-play svg {
    width: 1.45rem;
    height: 1.45rem;
    fill: currentColor;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }
  .sp-play path {
    display: none;
  }
  .sp-play[data-state='play'] .i-play,
  .sp-play[data-state='pause'] .i-pause,
  .sp-play[data-state='replay'] .i-replay {
    display: inline;
  }
  .sp-loop {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.02));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.2s;
  }
  .sp-loop svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sp-loop i {
    position: absolute;
    top: 0.3rem;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--aura-blue);
    box-shadow: 0 0 6px var(--aura-blue);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.2s, transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .sp-loop[aria-pressed='true'] {
    color: #fff;
  }
  .sp-loop[aria-pressed='true'] i {
    opacity: 1;
    transform: scale(1);
  }
  .sp-time {
    flex: 1;
    min-width: 0;
  }
  .sp-time input {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    margin: 0;
    border-radius: 999px;
    background:
      linear-gradient(90deg, var(--aura-green), var(--aura-blue) 50%, var(--aura-purple)) 0 / var(--p) 100% no-repeat,
      rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35);
    cursor: pointer;
  }
  .sp-time input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.4), inset 0 -1px 2px rgba(0, 0, 0, 0.15);
  }
  .sp-time input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 50%;
    background: #fff;
  }
  .sp-time > span {
    display: flex;
    justify-content: space-between;
    font: 500 0.78rem/1 var(--font-mono);
    color: rgba(255, 255, 255, 0.55);
    margin-top: 0.5rem;
  }
  .sp-spec {
    margin: 0;
    display: grid;
    gap: 0.45rem;
    font: 500 0.72rem/1.45 var(--font-mono);
  }
  .sp-spec > div {
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.25s;
  }
  .sp-spec dt {
    font-weight: 650;
  }
  .sp-spec dd {
    margin: 0;
  }
  .sp-spec .sp-each {
    font-size: 0.66rem;
  }
  [data-mode='orig'] .sp-spec [data-for='orig'],
  [data-mode='wave'] .sp-spec [data-for='wave'] {
    color: #fff;
  }
  [data-mode='wave'] .sp-spec [data-for='wave'] dt {
    background: var(--aura);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sp-spec .ref {
    padding-top: 0.45rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.38);
  }
  .sp-vs {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.7);
  }
  @media (prefers-reduced-motion: reduce) {
    .sp-play,
    .sp-k,
