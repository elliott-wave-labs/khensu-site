---
// ñüFi: giving, crowdfunding, lending and investing on khensu.ñü. Sources: khensu-specs design/nufi.md (products,
// network use, economics, regulation by product), design/app-commerce.md (flat 10% on in-app purchases, tips at 100%),
// WEBE.md 14 (contracts: pledge, escrow, split, ticket, bounty; shielded settlement), PROTOCOL.md 13 and COMPLIANCE.md 9.
// Lend and Invest are regulated: always "where licensed", never a promised return. Every amount is an example.
import Base from '../layouts/Base.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import RevealText from '../components/khensu/RevealText.astro';
import NufiHero from '../components/khensu/NufiHero.astro';
import NufiPhone from '../components/khensu/NufiPhone.astro';
import NufiPledgeGraph from '../components/khensu/NufiPledgeGraph.astro';
import NufiBurst from '../components/khensu/NufiBurst.astro';
import { BACKERS, DAILY_MET, total, usd } from '../data/nufi-campaign';

const products = [
  {
    id: 'give',
    name: 'Give',
    line: 'Gifts to people, causes and communities, from a few cents up.',
    body: 'No cut. A gift reaches the person whole; the only charge is the network fee, under 1¢ to send or withdraw.',
    licensed: false,
  },
  {
    id: 'back',
    name: 'Back',
    line: 'Fund a film, an album, a tour or a product for a reward or a pre-order.',
    body: 'Pledges pay out only if the goal is met by the deadline. Otherwise every backer is refunded, automatically.',
    licensed: false,
  },
  {
    id: 'invest',
    name: 'Invest',
    line: 'Shares, revenue shares or notes in creators’ companies, startups and local businesses.',
    body: 'Offered through a registered funding portal or its local equivalent, with the issuer’s disclosures up front.',
    licensed: true,
  },
  {
    id: 'lend',
    name: 'Lend',
    line: 'Small loans between people and to small businesses, repaid in instalments.',
    body: 'Interest-free between people. Loans with interest come through licensed lending partners.',
    licensed: true,
  },
];

const platform = [
  { t: 'ñü.bi, the basic income', b: 'First, and the reason the network exists. Everyone who runs a node is paid in dollar stablecoin for verified work, at one worldwide rate. An equal share for every person is in research.', href: '/bi', link: 'How ñü.bi works' },
  { t: 'Creators keep it all', b: 'Every view or play pays the creator 1¢, $10 per 1,000, with no cut. Tips, subscriptions and sales of albums, downloads and tickets reach them whole.', href: '/creators', link: 'What creators keep' },
  { t: 'Node contributors', b: 'A Mac or a Raspberry Pi 5 on an ordinary connection is a node, and a suñůlink.shield joins the mesh. Each is paid every epoch for the work it proves, never by where it is.', href: '/network', link: 'Run a node' },
  { t: 'Subscriptions fund the network', b: 'After Apple’s share, half of every Pro, Ultra and Akashic subscription goes to the network and half to the founder’s company. No shareholders. The network is paid more than it costs, and that surplus is what funds ñü.bi.', href: '/bi#bi-how', link: 'Follow the money' },
  { t: 'Payments and tickets', b: 'Pay anyone privately, tap to pay at the till, and buy tickets for festivals, shows and retreats that nobody can link to you. Scan them at the door with ñü.code.', href: '#nufi-contracts-section', link: 'Tickets and contracts' },
  { t: 'Fund each other', b: 'Give, back a project, invest where licensed, and, last, lend. Person to person, with no platform cut on giving and pledges.', href: '#nufi-products-section', link: 'Four ways to fund' },
];

const steps = [
  { t: 'Publish the terms', b: 'Your goal, deadline and rewards are signed with your key and logged in public before anyone pays, so they can’t change afterwards. Updates are new signed versions, with the history in the open.' },
  { t: 'Pledges wait in escrow', b: 'Each pledge is locked into a pledge contract on the network. No company holds it, khensu.ñü included.' },
  { t: 'The deadline decides', b: 'Goal met: the escrow releases to your wallet. Goal missed: every pledge goes back to the backer who made it.' },
];

const privacy = [
  { t: 'Shielded amounts and parties', b: 'Every payment moves through the network’s shielded pool. The chain records proofs and commitments, never amounts, senders or recipients.' },
  { t: 'Anonymous backers', b: 'Creators see totals and which rewards were chosen. Who backed them stays private unless a backer chooses to share it.' },
  { t: 'Nothing processed on servers', b: 'Campaigns, pledges and receipts are built on your device and travel as sealed messages over the mixnet. Nodes check proofs; they never see what’s inside.' },
  { t: 'Self-custody', b: 'Money stays in your own wallet, under keys only your devices hold. Nobody can freeze it, and nobody makes you wait for a payout date.' },
  { t: 'Repayments in the rhythm', b: 'Loan instalments and investor payouts are scheduled transfers sent on the network’s steady tick, so their timing doesn’t reveal who owes whom.' },
  { t: 'Reputation without a bureau', b: 'Creators and borrowers can prove facts, such as campaigns delivered or loans repaid on time, as zero-knowledge credentials, without a public history of everyone they dealt with.' },
];

const walletSpec = [
  { n: 'keys', b: '24-word recovery phrase, Argon2id seed, spend and viewing keys wrapped by the Secure Enclave. Face ID for every spend.' },
  { n: 'notes', b: 'USDC and the khensu token in 1-2-5 denominations, committed with Poseidon2. Nullifiers only your key can make.' },
  { n: 'spends', b: 'Always 4 notes in, 4 out, padded to the same size, so 1¢ and $10,000 look identical. Sent through the mixnet.' },
  { n: 'proof', b: 'A hash-based STARK proves ownership, membership and that value balances. It is also the spend authorisation.' },
  { n: 'delivery', b: 'Each new note is sealed to the recipient with ML-KEM-1024 and AES-256-GCM, and arrives in your chat.' },
  { n: 'eras', b: '30-day eras. Old trees and nullifier lists are deleted after a 14-day grace; your wallet refreshes notes on its own.' },
  { n: 'receipts', b: 'The committee signs each spend within seconds, so tap to pay works at the till.' },
  { n: 'fees', b: 'Under 1¢ to send or withdraw, nothing to receive, with a protocol ceiling of 1¢. ñü takes no commission.' },
];

const walletTests = [
  { t: 'Test vectors', b: 'Keys, notes, trees, ciphertexts and 250 full spends that must pass or fail, each with every intermediate value.' },
  { t: 'Open reference code', b: 'khensu-wallet in khensu-core, Apache-2.0: prover, verifier and a CLI that checks spends and vectors.' },
  { t: 'Formal models', b: 'Tamarin for delivery and replay, and a second, independent verifier in Lean 4 that must agree with the first.' },
  { t: 'Fuzzing and mutation', b: 'Every constraint in the proof is removed in turn, and a search tries to inflate value or steal a note.' },
  { t: 'A public test network', b: 'Valueless test USDC, so anyone can make, intercept and replay real spends from TestFlight builds.' },
  { t: 'Bounties and audits', b: 'Safe harbour for good-faith research, bounties highest for soundness and privacy breaks, two audits published in full.' },
];

const contracts = [
  { n: 'pledge', b: 'Pays only if a threshold of hidden pledges is met by a deadline; refunds otherwise.' },
  { n: 'escrow', b: 'Releases milestone payments when both sides agree, or when an arbiter they chose does.' },
  { n: 'split', b: 'Pays every collaborator their share of each payment a film, song or post earns, as it arrives.' },
  { n: 'ticket', b: 'Anonymous, unlinkable tickets and memberships: premieres, live rooms, early access.' },
  { n: 'bounty', b: 'Pays the first submission that passes the check.' },
];

const sum = total(DAILY_MET);
const feeCap = Math.ceil(BACKERS / 100);
---

<Base
  title="ñüFi"
  description="ñüFi, the khensu.ñü finance platform: a basic income first, creators paid 1¢ a view, nodes paid for their work, subscriptions that fund the network with no shareholders, private payments and tickets, and give, back, invest and lend person to person."
>
  <meta slot="head" name="color-scheme" content="dark" />

  <div class="khensu nufi">
    <NufiHero />
    <ProductBar name="ñüFi" action="Get the app" href="/app" explore="#nufi-platform-section" />

    <section class="nf-intro" id="nufi-intro-section" aria-label="What ñüFi is">
      <div class="wrap">
        <RevealText
          parts={[
            ['ñüFi is all the money on khensu.ñü. '],
            ['First, a basic income', true],
            [' for the people who run the network. Then '],
            ['creators paid for every view, nodes paid for every job,', true],
            [' and subscriptions that fund it all, with no shareholders. Then private payments, tickets, and ways to fund each other, '],
            ['with nobody taking a cut.', true],
          ]}
        />
      </div>
    </section>

    <section class="section nf-band" id="nufi-platform-section" aria-labelledby="nufi-platform-title">
      <div class="wrap">
        <p class="eyebrow">the whole platform</p>
        <h2 id="nufi-platform-title" class="big">A basic income first.<br /><em>Then everything else that pays.</em></h2>
        <ul class="nf-cards nf-platform" role="list">
          {platform.map((c, i) => (
            <li class="nf-glass" data-reveal style={`--i:${i % 3}`}>
              <b>{c.t}</b>
              <span>{c.b}</span>
              <a href={c.href}>{c.link}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section nf-band" id="nufi-products-section" aria-labelledby="nufi-products-title">
      <div class="wrap">
        <p class="eyebrow">fund each other</p>
        <h2 id="nufi-products-title" class="big">Give. Back. Invest. Lend.<br /><em>One wallet, person to person.</em></h2>
        <ul class="nf-products" role="list">
          {products.map((p, i) => (
            <li class:list={['nf-product', `p-${p.id}`]} data-reveal style={`--i:${i}`}>
              <svg class="nf-glyph" viewBox="0 0 96 96" aria-hidden="true">
                {p.id === 'give' && <path d="M48 78C30 64 16 53 16 37a15 15 0 0 1 32-7 15 15 0 0 1 32 7c0 16-14 27-32 41z" />}
                {p.id === 'back' && (
                  <>
                    <circle class="dim" cx="48" cy="48" r="32" />
                    <circle class="ring" cx="48" cy="48" r="32" pathLength="100" />
                    <path d="M37 49l8 8 15-17" />
                  </>
                )}
                {p.id === 'lend' && (
                  <>
                    <path d="M18 36h52l-10-10M78 60H26l10 10" />
                    <circle class="fill" cx="30" cy="48" r="3" />
                    <circle class="fill" cx="48" cy="48" r="3" />
                    <circle class="fill" cx="66" cy="48" r="3" />
                  </>
                )}
                {p.id === 'invest' && (
                  <>
                    <path d="M16 80h64" />
                    <rect x="22" y="58" width="10" height="22" rx="2" />
                    <rect x="43" y="44" width="10" height="36" rx="2" />
                    <rect x="64" y="26" width="10" height="54" rx="2" />
                  </>
                )}
              </svg>
              <p class="nf-pname">
                ñüFi {p.name}
                {p.licensed && <a class="nf-tag" href="#nufi-notes">where licensed<sup>1</sup></a>}
              </p>
              <p class="nf-pline">{p.line}</p>
              <p class="nf-pbody">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section nf-back" id="nufi-back-section" aria-labelledby="nufi-back-title">
      <div class="wrap nf-split">
        <div data-reveal>
          <p class="eyebrow"><span class="name-case">ñüFi</span> back</p>
          <h2 id="nufi-back-title" class="big">Fund the film before it’s made.<br /><em>Backers pay only if the goal is met.</em></h2>
          <p class="lede">
            Ask the people who want the work, not a studio or a label. Set a goal, a deadline and the rewards. Backers
            pledge from their own wallets, and every pledge waits in escrow on the network until the deadline.
          </p>
          <ol class="nf-steps" role="list">
            {steps.map((s, i) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <b>{s.t}</b>
                <span>{s.b}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="nf-phone-wrap" data-reveal>
          <NufiPhone />
        </div>
      </div>
    </section>

    <section class="section nf-pledge" id="nufi-pledge-section" aria-labelledby="nufi-pledge-title">
      <div class="wrap">
        <div class="nf-head" data-reveal>
          <p class="eyebrow">all or nothing</p>
          <h2 id="nufi-pledge-title" class="big">The goal is the switch.<br /><em>Met, it pays. Missed, it refunds.</em></h2>
          <p class="lede">
            At the deadline the network checks one thing: whether the pledges reached the goal. Nobody can take the money
            before then, keep it after a miss, or move the deadline.
          </p>
        </div>
        <div data-reveal>
          <NufiPledgeGraph />
        </div>
      </div>
    </section>

    <NufiBurst id="nufi-private-section" />

    <section class="section nf-band" id="nufi-privacy-section" aria-labelledby="nufi-privacy-title">
      <div class="wrap">
        <p class="eyebrow">privacy</p>
        <h2 id="nufi-privacy-title" class="big">Your money is your business.<br /><em>Shielded from end to end.</em></h2>
        <ul class="nf-cards" role="list">
          {privacy.map((c, i) => (
            <li class="nf-glass" data-reveal style={`--i:${i % 3}`}>
              <b>{c.t}</b>
              <span>{c.b}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="nufi-wallet-section" aria-labelledby="nufi-wallet-title">
      <div class="wrap">
        <div class="nf-head" data-reveal>
          <p class="eyebrow"><span class="name-case">ñü.wallet</span></p>
          <h2 id="nufi-wallet-title" class="big">Money that stays private.<br /><em>Post-quantum from the key up.</em></h2>
          <p class="lede">
            ñü.wallet holds USDC and the khensu token in a shielded pool. It never touches elliptic curves or RSA:
            notes are hash commitments, spends are STARK proofs and every secret is sealed with ML-KEM-1024. Only you hold
            the keys, and nobody can freeze a note.
          </p>
        </div>
        <ul class="nf-contracts" role="list">
          {walletSpec.map((c, i) => (
            <li data-reveal style={`--i:${i}`}>
              <code>{c.n}</code>
              <span>{c.b}</span>
            </li>
          ))}
        </ul>
        <p class="nf-fine">
          Public at the edges only: deposits and withdrawals show an amount and a public account, as the law requires of
          the bridge and the card partner. Inside the pool, amounts, senders and recipients are hidden.
        </p>
      </div>
    </section>

    <section class="section nf-band" id="nufi-verify-section" aria-labelledby="nufi-verify-title">
      <div class="wrap">
        <div class="nf-head" data-reveal>
          <p class="eyebrow">verification</p>
          <h2 id="nufi-verify-title" class="big">Check every byte.<br /><em>Then try to break it.</em></h2>
          <p class="lede">
            The full specification is public, like the ñü.media codecs: wire formats, the exact proof statement, error
            codes and registries, so anyone can build a wallet that interoperates or attack the one we ship.
          </p>
        </div>
        <ul class="nf-cards" role="list">
          {walletTests.map((c, i) => (
            <li class="nf-glass" data-reveal style={`--i:${i % 3}`}>
              <b>{c.t}</b>
              <span>{c.b}</span>
            </li>
          ))}
        </ul>
        <div class="btn-row nf-close-cta">
          <a class="btn primary" href="https://dev.khensu.nu/specs/payments">Read the ñü.wallet spec</a>
          <a class="btn" href="https://dev.khensu.nu/specs/payments#18-verification-and-penetration-testing">Pen-testing programme</a>
        </div>
      </div>
    </section>

    <section class="section" id="nufi-contracts-section" aria-labelledby="nufi-contracts-title">
      <div class="wrap">
        <div class="nf-head" data-reveal>
          <p class="eyebrow"><span class="name-case">webË</span> contracts</p>
          <h2 id="nufi-contracts-title" class="big">Terms that enforce themselves.<br /><em>Code anyone can read.</em></h2>
          <p class="lede">
            Every campaign runs on a standard, audited webË contract. Its code is public and signed; its inputs stay
            private to the people in it. Each step is proved on the device that takes it, and the chain keeps only the
            proof.
          </p>
        </div>
        <ul class="nf-contracts" role="list">
          {contracts.map((c, i) => (
            <li data-reveal style={`--i:${i}`}>
              <code>{c.n}</code>
              <span>{c.b}</span>
            </li>
          ))}
        </ul>
        <p class="nf-fine">
          Signed with ML-DSA-87 and proved with hash-based STARKs, so nothing in a contract is left for a quantum computer
          to break later. Before you sign, your wallet shows the contract’s code, its author and any audit labels.
        </p>
      </div>
    </section>

    <section class="section nf-band" id="nufi-fees-section" aria-labelledby="nufi-fees-title">
      <div class="wrap">
        <div class="nf-head" data-reveal>
          <p class="eyebrow">fees</p>
          <h2 id="nufi-fees-title" class="big">No platform cut.<br /><em>The network fee is the only charge.</em></h2>
        </div>
        <ul class="nf-nums" role="list">
          <li data-reveal style="--i:0"><b>0%</b><span>Platform cut on ñüFi Give and ñüFi Back.</span></li>
          <li data-reveal style="--i:1"><b>100%</b><span>Of every view and tip, gift or payment reaches the person.</span></li>
          <li data-reveal style="--i:2"><b>&lt;1¢</b><span>Network fee per transfer, paid to the people who run the nodes. Estimate.</span></li>
          <li data-reveal style="--i:3"><b>0</b><span>Spread on loans or carry on investments for khensu.ñü. Licensed partners’ fees are shown before you commit.</span></li>
        </ul>
        <div class="nf-example nf-glass" data-reveal>
          <p class="nf-ex-k">example</p>
          <p>
            A film raises <b>{usd(sum)}</b> from <b>{BACKERS.toLocaleString('en-US')} backers</b>. The filmmaker receives all
            of it, less network fees that come to <b>under ${feeCap}</b> in total (estimate).
          </p>
        </div>
        <p class="nf-fine">
          Apps and sites that sell things on khensu.ñü pay a flat 10% of in-app purchases and subscriptions, never scaled up
          or down. ñüFi isn’t a store: giving and pledging carry no cut.
        </p>
      </div>
    </section>

    <section class="section" id="nufi-rights-section" aria-labelledby="nufi-rights-title">
      <div class="wrap">
        <div class="nf-head" data-reveal>
          <p class="eyebrow">your rights</p>
          <h2 id="nufi-rights-title" class="big">Backers fund the work.<br /><em>You keep the work.</em></h2>
        </div>
        <ul class="nf-cards three" role="list">
          <li class="nf-glass" data-reveal style="--i:0">
            <b>Rewards, not equity</b>
            <span>A pledge buys a reward or a pre-order: a ticket, a download, a signed copy. Never a share, interest or a return.</span>
          </li>
          <li class="nf-glass" data-reveal style="--i:1">
            <b>Your rights and IP stay yours</b>
            <span>Backers don’t get your film, your masters or a share of your income, and neither does khensu.ñü.</span>
          </li>
          <li class="nf-glass" data-reveal style="--i:2">
            <b>Investing, on your terms</b>
            <span>If you choose to offer shares or a revenue share through ñüFi Invest, investors get exactly what the filed offering says, and nothing more.</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section nf-band" id="nufi-licensed-section" aria-labelledby="nufi-licensed-title">
      <div class="wrap">
        <div class="nf-head" data-reveal>
          <p class="eyebrow">lending and investing</p>
          <h2 id="nufi-licensed-title" class="big">Regulated products.<br /><em>Offered where licensed.</em></h2>
          <p class="lede">
            Lending and investing are regulated activities, so ñüFi Lend and ñüFi Invest run through licensed partners,
            and only in countries where those partners are licensed or the law permits them.
          </p>
        </div>
        <dl class="nf-rules">
          <div data-reveal>
            <dt>Investing</dt>
            <dd>
              In the United States, offerings run under Regulation Crowdfunding through a registered funding portal or a
              broker-dealer that is a FINRA member, with the issuer’s Form C disclosures, investor limits and annual reports.
              In the European Union they run through crowdfunding service providers licensed under the ECSP Regulation, and
              in the United Kingdom under FCA rules.
            </dd>
          </div>
          <div data-reveal>
            <dt>Lending</dt>
            <dd>
              Interest-free loans between people, and to borrowers abroad through local microfinance partners. Loans with
              interest come through a licensed lending partner, with the disclosures local law requires.
            </dd>
          </div>
          <div data-reveal>
            <dt>Identity</dt>
            <dd>
              Where the law requires identity checks, the licensed partner does them and holds the records. khensu.ñü
              doesn’t, and the network never links them to your messages.
            </dd>
          </div>
          <div data-reveal>
            <dt>No conflicts</dt>
            <dd>
              A funding portal can’t host offerings it has a financial interest in, so raises by khensu.ñü or Elliott Wave
              never run on ñüFi Invest.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section nf-close" id="nufi-start-section" aria-labelledby="nufi-start-title">
      <div class="wrap">
        <h2 id="nufi-start-title" class="big">Fund the next thing you love.<br /><em>Straight to the people making it.</em></h2>
        <div class="btn-row nf-close-cta">
          <a class="btn primary" href="/app">Get the app</a>
          <a class="btn" href="/creators">For artists</a>
          <a class="btn" href="https://dev.khensu.nu/webe">webË contracts</a>
        </div>

        <ol class="nf-notes" id="nufi-notes" role="list">
          <li>
            <sup>1</sup> ñüFi Lend and ñüFi Invest are offered only through licensed partners, in countries where they are
            licensed or the law permits. Investing involves risk, including loss of principal. Not investment advice.
            Availability varies by country. Loans can go unrepaid, and lenders can lose what they lend. khensu.ñü never
            promises a return.
          </li>
          <li>ñüFi Back pledges aren’t investments: backers receive the rewards or pre-orders a campaign offers, not equity, interest or a return.</li>
          <li>Gifts through ñüFi Give are tax-deductible only where the recipient is a registered charity or uses a fiscal sponsor, and only as local tax law allows.</li>
          <li>Payments are self-custodied: khensu.ñü never holds your funds or keys. See <a href="/compliance">Compliance</a>.</li>
          <li>Amounts on this page are examples. Network fees are estimates.</li>
        </ol>
      </div>
    </section>
  </div>
</Base>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = document.querySelectorAll<HTMLElement>('.nufi [data-reveal]');
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((el) => { if (el.getBoundingClientRect().top > innerHeight) io.observe(el); else el.classList.add('in'); });
    document.documentElement.classList.add('nf-reveal');
  }
</script>

<style>
  .nufi {
    color-scheme: dark;
    background: #000;
    --mint: #bff5e4;
    --mint-deep: #5ee6c0;
  }
  .nufi :global(h2[id]) {
    scroll-margin-top: 6rem;
  }
  /* section-links.ts puts its button before the <em>; the <em> is a block, so the <br /> isn't needed then. */
  .nufi :global(h2 > br:has(+ .sec-link)) {
    display: none;
  }
  .big {
    font-size: clamp(2.1rem, 4.8vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    max-width: none;
  }
  .nf-band {
