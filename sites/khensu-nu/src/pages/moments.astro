---
import Base from '../layouts/Base.astro';
import ProductBar from '../components/khensu/ProductBar.astro';
import MomentsPage from '../components/khensu/MomentsPage.astro';
import MomentsStudio from '../components/khensu/MomentsStudio.astro';
import Ecosystem from '../components/khensu/Ecosystem.astro';
import { allowFeed } from '../data/feed';
import { APP_STORE_ID, APP_STORE_URL } from '../data/app';
allowFeed(Astro);

const appLabel = APP_STORE_ID ? 'Download on the App Store' : 'Get the app';
---

<Base
  title="ñü.mømëntš"
  description="nu.moments: templates, beat sync, captions and a full video and photo editor on your device. Nobody else sees your clips."
>
  <ProductBar name="ñü.mømëntš" explore="#templates-section" action={appLabel} href={APP_STORE_URL} />
  <MomentsPage>
    <MomentsStudio slot="studio" />
    <Ecosystem slot="feed" mode="create" title="ñü.mømëntš studio — cut it, post it" />
  </MomentsPage>
</Base>
