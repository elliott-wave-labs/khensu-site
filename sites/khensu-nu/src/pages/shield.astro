---
import Base from '../layouts/Base.astro';
import Sections from '../components/khensu/Sections.astro';
import StatStrip from '../components/khensu/StatStrip.astro';
import { PHONES, RESULTS, LEGEND, SHIELD, backView, sectionView } from '../lib/shield';
---

<Base
  title="suñůlink.shield, to scale"
  description="sunulink.shield drawn to scale from the parametric CAD: battery, thickness, weight and a section through the magnet centre, on iPhone 18 Pro and on a phone with a camera island."
>
  <section class="page-head">
    <div class="wrap">
      <div class="head-grid">
        <div class="head-model">
          <ew-viewer
            src="/khensu/shell/3d/glb/black-moldavite-phone.glb"
            alt="sunulink.shield in Black titanium on an iPhone 18 Pro in Black, turning to show the ñü.isheru in stone and platinum"
            ar
            ar-modes="webxr scene-viewer quick-look"
            ar-scale="fixed"
            ar-label="View in your space"
            camera-controls
            auto-rotate
            rotation-per-second="18deg"
            shadow-intensity="1.2"
            exposure="1.1"
            camera-orbit="25deg 78deg auto"
            background="transparent"
            loading="eager"
            height="100%"
          ></ew-viewer>
        </div>
        <div class="head-copy">
          <p class="eyebrow">suñůlink.shield · to scale</p>
          <h1>One shield.<br />Drawn to scale.</h1>
          <p class="lede">A mesh node on the back of your phone, drawn from the same CAD that machines it.</p>
          <p class="hint">Drag to turn. On iPhone or Android, tap “View in your space” to see it at real size.</p>
          <p class="cta"><a class="btn primary" href="/buy">Buy</a> <a class="btn" href="https://dev.khensu.nu/shell">Full specifications</a></p>
        </div>
      </div>
      <StatStrip
        items={[
          { n: 0, unit: 'mm', label: 'Above the lenses: your iPhone gets no thicker' },
          { n: 4.7, dec: 1, unit: 'mm', label: 'On the back, level with the lens tops' },
          { n: 7.5, dec: 1, unit: 'Wh', label: 'Its own battery, about 6 hours relaying' },
          { n: 600, unit: 'm', label: 'Shield to shield, or 2 km to a rooftop node' },
        ]}
      >
        Figures for iPhone 18 Pro. Battery life varies with use and settings. Ranges are calculated from the HaLow link budget on open ground; see the <a href="https://dev.khensu.nu/shell">full specifications</a>.
      </StatStrip>
    </div>
  </section>
  <script is:inline type="module" src="/vendor/ew-viewer/ew-viewer.min.js"></script>

  <div class="khensu">
    <Sections show={['exploded', 'sideview', 'finishes', 'specs']} />
  </div>

  <section class="section explorer">
    <div class="wrap">
      <p class="fits">
        Fits every iPhone back to iPhone X, and Google Pixel and Samsung Galaxy phones, flagship and everyday, with a case
        made for each model. Drawn here on the two reference shapes: iPhone 18 Pro’s full-width camera plateau, and a camera
        island like most other phones. HaLow radio for the neighbourhood mesh, Wi-Fi and Bluetooth to the phone, charged
        over USB-C from a wall charger or power bank.
      </p>
      <form class="pick" aria-label="Choose a phone and whether to show the internals">
        <fieldset>
          <legend>Phone</legend>
          {PHONES.map((p, i) => (
            <label><input type="radio" name="phone" value={p.id} checked={i === 0} /> <span>{p.short}</span></label>
          ))}
        </fieldset>
        <fieldset>
          <legend>View</legend>
          <label><input type="checkbox" name="internals" checked /> <span>Show internals</span></label>
        </fieldset>
      </form>

      <div class="views">
        {PHONES.map((p) => {
          const r = RESULTS[p.id][SHIELD];
          return (
            <article class="view" data-phone={p.id}>
              <div class="draw">
                <div class="back" set:html={backView(p, SHIELD, 2.4, true)} />
              </div>
              <div class="info">
                <h2>suñůlink.shield <small>on the {p.short}</small></h2>
                <p class="line">
                  {p.id === 'iphone-18-pro'
                    ? 'The whole back, a flat plate over the camera plateau level with the lens tops, with an opening for every lens, the flash and the sensors.'
                    : 'The whole back, a flat plate over the camera island level with the lens tops, with an opening for every lens, the flash and the sensors.'}
                </p>
                <dl class="stats">
                  <div><dt>{r.wh} Wh</dt><dd>battery, {r.cm3} cm³ of cells</dd></div>
                  <div><dt>{r.t} mm</dt><dd>thick, {r.proud} mm above the lens tops</dd></div>
                  <div><dt>{r.tiG} g</dt><dd>in titanium</dd></div>
                  <div><dt>about {Math.round(r.wh * 0.85)} h</dt><dd>relaying on its own cells</dd></div>
                </dl>
                <p class="small">
                  Footprint {r.footprint[0]} × {r.footprint[1]} mm. Magnet ring {r.ring} mm. Charges over its USB-C from a wall
                  charger or power bank. When its cells run out it takes a little from the phone over a short USB-C cable.
                </p>
                <h3>Section through the magnet centre</h3>
                <div class="section-draw" set:html={sectionView(p, SHIELD)} />
                <ul class="legend" role="list">
                  {LEGEND.map((l) => (
                    <li><i class:list={[{ dashed: l.dashed }]} style={`--c:${l.color}`} />{l.label}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })}
      </div>

      <p class="small note">
        From the parametric CAD that also exports STEP and STL for CNC and tooling. Cells at 0.45 Wh/cm³ (thin pouch). Relay time at about 1 W for the board and radios; battery life and
        charge time vary with use and settings. The build fails if the shield covers a lens, the flash, the depth sensor or the microphone, or
        clips a field of view. iPhone 18 Pro dimensions are measured from Apple’s published model; the makers’ accessory
        drawings take precedence when available.
      </p>

      <div class="btn-row">
        <a class="btn primary" href="/buy">Buy one</a>
        <a class="btn" href="https://dev.khensu.nu/shell">Full specifications</a>
        <a class="btn" href="#shell-title">Back to the top</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 4vw, 4rem); margin-bottom: clamp(1.5rem, 4vw, 3rem); }
  .head-model { height: min(78vh, 680px); }
  .head-model ew-viewer { display: block; width: 100%; height: 100%; }
  .head-copy h1 { margin-top: 0.4rem; }
  .head-copy .hint { color: var(--text-dim); font-size: 0.85rem; }
  .head-copy .cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.4rem; }
  @media (max-width: 860px) {
    .head-grid { grid-template-columns: 1fr; }
    .head-model { height: 62vh; order: 1; }
    .head-copy { order: 0; }
  }

  .lede,
  .fits {
    max-width: 46rem;
    color: var(--text-dim);
  }
  .page-head .lede {
    margin: clamp(1.6rem, 4vw, 2.4rem) 0 0;
  }
  .fits {
    margin: 0 0 1.6rem;
  }
  .pick {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 1.6rem;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  legend {
    float: left;
    margin-right: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-faint);
    text-transform: lowercase;
    letter-spacing: 0.08em;
  }
  label {
    cursor: pointer;
  }
  label input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  label span {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  label input:checked + span {
    background: rgba(139, 123, 255, 0.18);
    border-color: #8b7bff;
    color: var(--text);
  }
  label input:focus-visible + span {
    outline: 2px solid #8b7bff;
    outline-offset: 2px;
  }

  .view {
    display: none;
  }
  .view {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.035);
  }
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked) .view[data-phone='iphone-18-pro'],
  .explorer:has(input[name='phone'][value='island']:checked) .view[data-phone='island'] {
    display: grid;
  }
  .note {
    margin-top: 1.4rem;
  }
  .explorer:has(input[name='internals']:not(:checked)) :global(.internals) {
    display: none;
  }

  .draw {
    padding: 0.5rem;
    border-radius: 14px;
    background: #0b0b0e;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .draw :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .info h2 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 500;
  }
  .info h2 small {
    font-size: 0.95rem;
    color: var(--text-dim);
    font-weight: 400;
  }
  .line {
    color: var(--text-dim);
    margin: 0.3rem 0 1rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.2rem;
    margin: 0 0 0.8rem;
  }
  .stats dt {
    font-size: 1.6rem;
    font-weight: 500;
    color: #b9b0ff;
  }
  .stats dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .small {
    font-size: 0.85rem;
    color: var(--text-faint);
    max-width: 52rem;
  }
  h3 {
    font-size: 1rem;
    font-weight: 500;
    margin: 1.2rem 0 0.5rem;
  }
  .section-draw {
    overflow-x: auto;
  }
  .section-draw :global(svg) {
    display: block;
    max-width: none;
  }
  .legend {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .legend i {
    width: 20px;
    height: 8px;
    border-radius: 2px;
    background: var(--c);
    opacity: 0.85;
  }
  .legend i.dashed {
    height: 0;
    background: none;
    border-top: 2px dashed var(--c);
  }

  .btn-row {
    margin-top: 2rem;
  }

  @media (max-width: 820px) {
    .view {
      grid-template-columns: 1fr;
    }
    .draw {
      justify-self: center;
      max-width: 240px;
    }
  }
</style>
