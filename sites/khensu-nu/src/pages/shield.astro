---
import Base from '../layouts/Base.astro';
import { PHONES, STYLES, RESULTS, LEGEND, backView, sectionView } from '../lib/shield';

const slim = STYLES.filter((s) => s.id !== 'case');
---

<Base
  title="suñůlink.shield: every style, to scale"
  description="suñůlink.shield attachment styles drawn to scale from the parametric CAD: Card, Fill, Wrap, Wrap XL and the shock case, with battery, thickness, weight and a section through each."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">suñůlink.shield · attachment styles</p>
      <h1>Every style, to scale.</h1>
      <p class="lede">
        A mesh node on the back of the phone: HaLow radio for the neighbourhood mesh, Wi-Fi and Bluetooth to the phone, its
        own battery, and power from the phone over USB-C when its cells run out. Every drawing here is to scale and comes
        from the same parametric CAD that exports STEP and STL for CNC and tooling.
      </p>
      <p class="fits">
        Fits every iPhone back to iPhone X, and Google Pixel and Samsung Galaxy phones, flagship and everyday, with a case
        made for each model. Drawn here on the two reference shapes: iPhone 18 Pro’s full-width camera plateau, and a camera
        island like most other phones.
      </p>
    </div>
  </section>

  <section class="section explorer">
    <div class="wrap">
      <form class="pick" aria-label="Choose a phone, a style and whether to show the internals">
        <fieldset>
          <legend>Phone</legend>
          {PHONES.map((p, i) => (
            <label><input type="radio" name="phone" value={p.id} checked={i === 0} /> <span>{p.short}</span></label>
          ))}
        </fieldset>
        <fieldset>
          <legend>Style</legend>
          {STYLES.map((s) => (
            <label><input type="radio" name="style" value={s.id} checked={s.id === 'wrap'} /> <span>{s.name}</span></label>
          ))}
        </fieldset>
        <fieldset>
          <legend>View</legend>
          <label><input type="checkbox" name="internals" checked /> <span>Show internals</span></label>
        </fieldset>
      </form>

      <div class="views">
        {PHONES.map((p) =>
          STYLES.map((s) => {
            const r = s.id === 'case' ? null : RESULTS[p.id][s.id];
            return (
              <article class="view" data-phone={p.id} data-style={s.id}>
                <div class="draw">
                  <div class="back" set:html={backView(p, s.id, 2.4, true)} />
                </div>
                <div class="info">
                  <h2>{s.name} <small>on the {p.short}</small></h2>
                  <p class="line">{s.line}.</p>
                  {r ? (
                    <>
                      <dl class="stats">
                        <div><dt>{r.wh} Wh</dt><dd>battery, {r.cm3} cm³ of cells</dd></div>
                        <div><dt>{r.t} mm</dt><dd>{r.proud > 0 ? `thick, ${r.proud} mm above the lenses` : 'thick, level with the lenses'}</dd></div>
                        <div><dt>{r.tiG} g</dt><dd>in titanium</dd></div>
                      </dl>
                      <p class="small">
                        Footprint {r.footprint[0]} × {r.footprint[1]} mm. Magnet ring {r.ring} mm.{' '}
                        {r.usb
                          ? 'A USB-C plug powers it from the phone when its own cells run out.'
                          : 'No plug: it runs on its own cells and covers the phone’s wireless charging coil, so take it off to charge the phone wirelessly.'}
                      </p>
                      <h3>Section through the magnet centre</h3>
                      <div class="section-draw" set:html={sectionView(p, s.id as 'card')} />
                    </>
                  ) : (
                    <>
                      <dl class="stats">
                        <div><dt>1.6 mm</dt><dd>walls, raised corners</dd></div>
                        <div><dt>about 17 g</dt><dd>liquid silicone, Shore 50–60A</dd></div>
                      </dl>
                      <p class="small">
                        Holds the phone with a Wrap module inside, with the camera opening cut through. Every supported
                        phone gets its own case, including models without built-in magnets, where the case carries the
                        magnet ring.
                      </p>
                    </>
                  )}
                  <ul class="legend" role="list">
                    {LEGEND.map((l) => (
                      <li><i class:list={[{ dashed: l.dashed }]} style={`--c:${l.color}`} />{l.label}</li>
                    ))}
                  </ul>
                </div>
              </article>
            );
          }),
        )}
      </div>

      <h2 class="h2">All styles side by side</h2>
      {PHONES.map((p) => (
        <div class="all" data-phone={p.id}>
          {STYLES.map((s) => (
            <figure>
              <div set:html={backView(p, s.id, 1.1, false)} />
              <figcaption>
                <b>{s.name}</b>
                <small>{s.id === 'case' ? 'holds a Wrap' : `${RESULTS[p.id][s.id].wh} Wh · ${RESULTS[p.id][s.id].t} mm`}</small>
              </figcaption>
            </figure>
          ))}
        </div>
      ))}

      <h2 class="h2">Battery and weight</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Style</th><th>Phone</th><th>Footprint (mm)</th><th>Thickness (mm)</th><th>Battery (Wh)</th><th>Relays alone</th><th>Titanium (g)</th></tr>
          </thead>
          <tbody>
            {PHONES.flatMap((p) =>
              slim.map((s) => {
                const r = RESULTS[p.id][s.id as 'card'];
                return (
                  <tr>
                    <td>{s.name}</td>
                    <td>{p.short}</td>
                    <td>{r.footprint[0]} × {r.footprint[1]}</td>
                    <td>{r.proud > 0 ? `${r.t} (+${r.proud})` : `${r.t} (level)`}</td>
                    <td>{r.wh.toFixed(1)}</td>
                    <td>about {r.wh.toFixed(0)} h</td>
                    <td>{r.tiG}</td>
                  </tr>
                );
              }),
            )}
          </tbody>
        </table>
      </div>
      <p class="small">
        From the CAD. Cells at 0.45 Wh/cm³ (thin pouch). “+” is height above the lens rings; “level” means a flat back with no
        camera bump. The build fails if any style covers a lens, the flash, the depth sensor or the microphone, or clips a
        field of view. Relay time assumes about 1 W for the board and radios, an estimate until the board exists. Phone
        dimensions are placeholders until the makers’ accessory drawings replace them.
      </p>

      <div class="btn-row">
        <a class="btn primary" href="/buy">Reserve one</a>
        <a class="btn" href="https://dev.khensu.nu/shell">Full specifications</a>
        <a class="btn" href="/#shell-title">Back to the overview</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lede,
  .fits {
    max-width: 46rem;
    color: var(--text-dim);
  }
  .fits {
    margin-top: 0.8rem;
  }
  .pick {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 1.6rem;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  legend {
    float: left;
    margin-right: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  label {
    cursor: pointer;
  }
  label input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  label span {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  label input:checked + span {
    background: rgba(139, 123, 255, 0.18);
    border-color: #8b7bff;
    color: var(--text);
  }
  label input:focus-visible + span {
    outline: 2px solid #8b7bff;
    outline-offset: 2px;
  }

  .view,
  .all {
    display: none;
  }
  .view {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.035);
  }
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked) .view[data-phone='iphone-18-pro'],
  .explorer:has(input[name='phone'][value='island']:checked) .view[data-phone='island'] {
    --phone-on: 1;
  }
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked) .all[data-phone='iphone-18-pro'],
  .explorer:has(input[name='phone'][value='island']:checked) .all[data-phone='island'] {
    display: flex;
  }
  .explorer:has(input[name='style'][value='card']:checked) .view[data-style='card'],
  .explorer:has(input[name='style'][value='fill']:checked) .view[data-style='fill'],
  .explorer:has(input[name='style'][value='wrap']:checked) .view[data-style='wrap'],
  .explorer:has(input[name='style'][value='wrap-xl']:checked) .view[data-style='wrap-xl'],
  .explorer:has(input[name='style'][value='case']:checked) .view[data-style='case'] {
    --style-on: 1;
  }
  .view {
    --phone-on: 0;
    --style-on: 0;
  }
  @container style(--phone-on: 1) {
    .x {
      display: block;
    }
  }
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked):has(input[name='style'][value='card']:checked) .view[data-phone='iphone-18-pro'][data-style='card'],
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked):has(input[name='style'][value='fill']:checked) .view[data-phone='iphone-18-pro'][data-style='fill'],
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked):has(input[name='style'][value='wrap']:checked) .view[data-phone='iphone-18-pro'][data-style='wrap'],
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked):has(input[name='style'][value='wrap-xl']:checked) .view[data-phone='iphone-18-pro'][data-style='wrap-xl'],
  .explorer:has(input[name='phone'][value='iphone-18-pro']:checked):has(input[name='style'][value='case']:checked) .view[data-phone='iphone-18-pro'][data-style='case'],
  .explorer:has(input[name='phone'][value='island']:checked):has(input[name='style'][value='card']:checked) .view[data-phone='island'][data-style='card'],
  .explorer:has(input[name='phone'][value='island']:checked):has(input[name='style'][value='fill']:checked) .view[data-phone='island'][data-style='fill'],
  .explorer:has(input[name='phone'][value='island']:checked):has(input[name='style'][value='wrap']:checked) .view[data-phone='island'][data-style='wrap'],
  .explorer:has(input[name='phone'][value='island']:checked):has(input[name='style'][value='wrap-xl']:checked) .view[data-phone='island'][data-style='wrap-xl'],
  .explorer:has(input[name='phone'][value='island']:checked):has(input[name='style'][value='case']:checked) .view[data-phone='island'][data-style='case'] {
    display: grid;
  }
  .explorer:has(input[name='internals']:not(:checked)) :global(.internals) {
    display: none;
  }

  .draw {
    padding: 0.5rem;
    border-radius: 14px;
    background: #0b0b0e;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .draw :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .info h2 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 500;
  }
  .info h2 small {
    font-size: 0.95rem;
    color: var(--text-dim);
    font-weight: 400;
  }
  .line {
    color: var(--text-dim);
    margin: 0.3rem 0 1rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.2rem;
    margin: 0 0 0.8rem;
  }
  .stats dt {
    font-size: 1.6rem;
    font-weight: 500;
    color: #b9b0ff;
  }
  .stats dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .small {
    font-size: 0.85rem;
    color: var(--text-faint);
    max-width: 52rem;
  }
  h3 {
    font-size: 1rem;
    font-weight: 500;
    margin: 1.2rem 0 0.5rem;
  }
  .section-draw {
    overflow-x: auto;
  }
  .section-draw :global(svg) {
    display: block;
    max-width: none;
  }
  .legend {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .legend i {
    width: 20px;
    height: 8px;
    border-radius: 2px;
    background: var(--c);
    opacity: 0.85;
  }
  .legend i.dashed {
    height: 0;
    background: none;
    border-top: 2px dashed var(--c);
  }

  .h2 {
    margin: 2.6rem 0 1rem;
    font-size: 1.4rem;
    font-weight: 500;
  }
  .all {
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .all figure {
    margin: 0;
    padding: 0.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }
  .all figcaption {
    display: grid;
    font-size: 0.85rem;
  }
  .all small {
    color: var(--text-faint);
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }
  th,
  td {
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: right;
    white-space: nowrap;
  }
  th:nth-child(-n + 2),
  td:nth-child(-n + 2) {
    text-align: left;
  }
  th {
    color: var(--text-faint);
    font-weight: 500;
  }
  .btn-row {
    margin-top: 2rem;
  }

  @media (max-width: 820px) {
    .view {
      grid-template-columns: 1fr;
    }
    .draw {
      justify-self: center;
      max-width: 240px;
    }
  }
</style>
