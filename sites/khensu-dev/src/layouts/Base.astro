---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Name from '../components/khensu/Name.astro';
import Crescent from '../components/khensu/Crescent.astro';
import { CARDS, PREVIEWS, cardFor, previewFor } from '../../../khensu-nu/src/data/og';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const SITE_NAME = 'khėnsu.ñü developers';
const DEFAULT_DESC =
  'Developer documentation for khėnsu.ñü, the post-quantum private messenger on a network run by people: architecture, running a node, repositories, licences and security.';

const { title, description = DEFAULT_DESC, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const card = cardFor(Astro.url.pathname, 'dev-');
const ogImage = `https://khensu.nu/og/${card}.jpg`;
const preview = previewFor(card);
const previewUrl = preview ? `https://khensu.nu/og/${preview}-square.mp4` : undefined;
const ogAlt = CARDS[card].alt;

const DOCS = [
  { href: '/', label: 'Overview' },
  { href: '/architecture', label: 'Architecture' },
  { href: 'https://security.khensu.nu', label: 'Security design' },
  { href: '/webe', label: 'webË' },
  { href: '/contracts', label: 'Contracts' },
  { href: '/work', label: 'Earn with your node' },
  { href: '/node', label: 'Run a node' },
  { href: '/shell', label: 'suñůlink.shield' },
  { href: '/auth', label: 'How auth works' },
  { href: '/keys', label: 'Auth key update' },
  { href: '/specs/protocol', label: 'Protocol' },
  { href: '/specs/webe', label: 'webË specification' },
  { href: '/specs/threat-model', label: 'Threat model' },
  { href: '/specs/work', label: 'Network work' },
  { href: '/specs/app-commerce', label: 'App commerce' },
  { href: '/specs/nu-media', label: 'ñü.media design' },
  { href: '/specs/nu-mirrora', label: 'mîřrørå' },
  { href: '/specs/post-release', label: 'After release' },
  { href: '/repositories', label: 'Repositories and licences' },
  { href: '/contribute', label: 'Contribute' },
  { href: 'https://help.khensu.nu', label: 'Help us' },
  { href: '/security', label: 'Report a vulnerability' },
  { href: '/specs/compliance', label: 'Compliance' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0A0B0D" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {preview && previewUrl && (
      <>
        <meta property="og:video" content={previewUrl} />
        <meta property="og:video:secure_url" content={previewUrl} />
        <meta property="og:video:type" content="video/mp4" />
        <meta property="og:video:width" content="1080" />
        <meta property="og:video:height" content="1080" />
        <meta property="nu:preview" content={previewUrl} />
        <meta property="nu:preview:type" content="video/mp4; codecs=hvc1" />
        <meta property="nu:preview:duration" content="3" />
        <meta property="nu:preview:size" content="1080x1080" />
        <meta property="nu:preview:bytes" content={String(PREVIEWS[preview].bytes)} />
        <meta property="nu:preview:hash" content={PREVIEWS[preview].hash} />
        <meta property="nu:preview:effect" content="ripple" />
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <p class="alpha-bar">
      <b>Free, open-source alpha.</b> Benchmarks are real, measured in Claude Opus 5.5 test runs.{' '}
      <a href="https://nocap.khensu.nu">Less data, less energy: nocap →</a>
    </p>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="khėnsu.ñü developers, home">
          <img class="seal" src="/seal-128.webp" alt="" width="26" height="26" />
          <span><Name /> <small>developers</small></span>
        </a>
        <form class="doc-search" role="search" action="/" method="get">
          <label class="sr" for="doc-q">search the docs</label>
          <svg class="doc-search-icon" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="7" cy="7" r="4.25" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
            <path d="M10.2 10.2 L13.2 13.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
          <input
            id="doc-q"
            name="q"
            type="search"
            placeholder="search"
            autocomplete="off"
            enterkeyhint="search"
            aria-autocomplete="list"
            aria-controls="doc-search-results"
            aria-expanded="false"
          />
          <div id="doc-search-results" class="doc-search-panel" role="listbox" hidden></div>
        </form>
        <nav aria-label="Primary">
          <ul>
            <li><a href="/node">Run a node</a></li>
            <li><a href="https://security.khensu.nu">Security</a></li>
            <li><a href="https://khensu.nu">khėnsu.ñü</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap docs">
      <aside class="side" aria-label="Documentation">
        <ul>
          {DOCS.map((d) => (
            <li>
              <a href={d.href} aria-current={path === d.href ? 'page' : undefined}>{d.label}</a>
            </li>
          ))}
        </ul>
      </aside>
      <article class="doc prose">
        <slot />
      </article>
    </main>

    <footer class="site-footer">
      <div class="wrap legal">
        <p>
          © 2026 Elliott Wave LLC. Docs licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          khėnsu.ñü™ is a trademark of Elliott Wave LLC. Patents pending.
        </p>
      </div>
    </footer>
    <script>
      import '../../../_shared/aura-buttons.ts';
    </script>
    <script>
      const form = document.querySelector('.doc-search');
      const input = document.getElementById('doc-q');
      const panel = document.getElementById('doc-search-results');
      if (form && input && panel && input instanceof HTMLInputElement) {
        let index = null;
        let loading = null;
        let active = 0;
        let shown = [];

        const fold = (s) =>
          s
            .toLowerCase()
            .normalize('NFD')
            .replace(/\p{M}/gu, '')
            .replace(/[-_/]+/g, ' ');

        const tokensOf = (q) =>
          fold(q.replace(/\bmixnets?\b/gi, 'mixnet').replace(/\bpost[-\s]?quantum\b/gi, 'post quantum').replace(/\bpq\b/gi, 'post quantum'))
            .split(/\s+/)
            .filter((t) => t.length > 1);

        const load = () => {
          if (index) return Promise.resolve(index);
          if (!loading) {
            loading = fetch('/search-index.json')
              .then((r) => r.json())
              .then((data) => {
                index = data;
                return data;
              });
          }
          return loading;
        };

        const score = (hit, tokens) => {
          const section = fold(hit.section || '');
          const title = fold(hit.title || '');
          const text = fold(hit.text || '');
          const hay = `${section} ${title} ${text}`;
          const has = (blob, t) => blob.includes(t) || (t === 'mixnet' && blob.includes('mix') && blob.includes('network'));
          let s = 0;
          for (const t of tokens) {
            if (!has(hay, t)) return -1;
            if (has(section, t)) s += 6;
            else if (has(title, t)) s += 3;
            else s += 1;
            if (section.startsWith(t)) s += 2;
          }
          if (tokens.every((t) => has(section, t))) s += 4;
          const path = (hit.href || '').split('#')[0];
          if (['/', '/architecture', '/auth', '/keys', '/webe', '/security', '/specs/protocol', '/specs/threat-model'].includes(path)) s += 2;
          return s;
        };

        const close = () => {
          panel.hidden = true;
          panel.replaceChildren();
          input.setAttribute('aria-expanded', 'false');
          input.removeAttribute('aria-activedescendant');
          shown = [];
        };

        const render = (hits) => {
          shown = hits;
          active = 0;
          panel.replaceChildren();
          if (!hits.length) {
            const empty = document.createElement('p');
            empty.textContent = 'nothing matches';
            panel.append(empty);
          } else {
            hits.forEach((hit, i) => {
              const a = document.createElement('a');
              a.href = hit.href;
              a.id = `doc-hit-${i}`;
              a.setAttribute('role', 'option');
              const strong = document.createElement('strong');
              strong.textContent = hit.section;
              const small = document.createElement('small');
              small.textContent = hit.title === hit.section ? hit.href : `${hit.title} · ${hit.href.split('#')[0]}`;
              a.append(strong, small);
              if (hit.text) {
                const snip = document.createElement('span');
                snip.textContent = hit.text.slice(0, 140);
                a.append(snip);
              }
              panel.append(a);
            });
          }
          mark();
          panel.hidden = false;
          input.setAttribute('aria-expanded', 'true');
        };

        const mark = () => {
          const options = panel.querySelectorAll('[role="option"]');
          options.forEach((el, i) => {
            if (i === active) el.setAttribute('aria-selected', 'true');
            else el.removeAttribute('aria-selected');
          });
          const current = options[active];
          if (current) input.setAttribute('aria-activedescendant', current.id);
          else input.removeAttribute('aria-activedescendant');
        };

        const run = async () => {
          const tokens = tokensOf(input.value);
          if (!tokens.length) {
            close();
            return;
          }
          const hits = await load();
          const ranked = hits
            .map((hit) => ({ hit, s: score(hit, tokens) }))
            .filter((row) => row.s >= 0)
            .sort((a, b) => b.s - a.s || a.hit.section.localeCompare(b.hit.section))
            .slice(0, 8)
            .map((row) => row.hit);
          render(ranked);
        };

        input.addEventListener('input', () => {
          run();
        });
        input.addEventListener('focus', () => {
          if (input.value.trim()) run();
        });
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            close();
            input.blur();
            return;
          }
          if (panel.hidden || !shown.length) return;
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            active = (active + 1) % shown.length;
            mark();
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            active = (active - 1 + shown.length) % shown.length;
            mark();
          } else if (event.key === 'Enter') {
            event.preventDefault();
            const href = shown[active]?.href;
            if (href) location.href = href;
          }
        });
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const href = shown[0]?.href;
          if (href) location.href = href;
        });
        document.addEventListener('click', (event) => {
          if (!form.contains(event.target)) close();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
          const tag = document.activeElement?.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || document.activeElement?.isContentEditable) return;
          event.preventDefault();
          input.focus();
        });
        const q = new URLSearchParams(location.search).get('q');
        if (q) {
          input.value = q;
          run();
        }
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--accent);
    color: var(--bg);
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }
  .alpha-bar { position: relative; z-index: 6; margin: 0; max-width: none; padding: 0.4rem 1rem; text-align: center; font-size: 0.8rem; color: var(--text-dim); background: linear-gradient(90deg, rgba(126, 224, 200, 0.12), rgba(240, 168, 200, 0.12)); border-bottom: 1px solid var(--line); }
  .alpha-bar b { color: var(--text); font-weight: 500; }
  .alpha-bar a { color: #7ee0c8; text-decoration: none; white-space: nowrap; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 0.85rem;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .doc-search {
    position: relative;
    flex: 1 1 11rem;
    max-width: 16rem;
    min-width: 7.5rem;
  }
  .doc-search-icon {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    width: 0.9rem;
    height: 0.9rem;
    transform: translateY(-50%);
    color: var(--text-faint);
    pointer-events: none;
  }
  .doc-search input {
    width: 100%;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    padding: 0 0.85rem 0 2rem;
  }
  .doc-search input::placeholder {
    color: var(--text-faint);
  }
  .doc-search input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .doc-search-panel {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    width: min(26rem, calc(100vw - 2rem));
    max-height: min(70vh, 28rem);
    overflow: auto;
    padding: 0.35rem;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    z-index: 8;
  }
  .doc-search-panel a {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
  }
  .doc-search-panel a[aria-selected='true'],
  .doc-search-panel a:hover {
    background: var(--accent-soft);
    color: var(--text);
  }
  .doc-search-panel strong {
    font-weight: 500;
    font-size: 0.92rem;
  }
  .doc-search-panel small,
  .doc-search-panel span,
  .doc-search-panel p {
    color: var(--text-faint);
    font-size: 0.75rem;
    line-height: 1.35;
  }
  .doc-search-panel p {
    margin: 0.35rem 0.7rem 0.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .brand small {
    color: var(--text-dim);
    font-weight: 400;
    font-size: 0.9em;
  }
  nav ul {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-dim);
  }
  .docs {
    display: grid;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  @media (min-width: 860px) {
    .docs {
      grid-template-columns: 210px 1fr;
    }
    .side {
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }
  .side a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-dim);
    font-size: 0.92rem;
  }
  .side a[aria-current='page'] {
    color: var(--text);
    background: var(--accent-soft);
  }
  .doc :global(h1) {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: 0;
  }
  .doc :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
    margin: 1.5rem 0;
  }
  .doc :global(th),
  .doc :global(td) {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .doc :global(th) {
    color: var(--text-dim);
    font-weight: 500;
  }
  .doc :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2rem 0;
    background: var(--bg-sunk);
  }
  .legal p {
    font-size: 0.8rem;
    color: var(--text-faint);
    max-width: none;
    margin: 0;
  }
  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      height: auto;
      min-height: 64px;
      padding: 0.65rem 0;
    }
    .doc-search {
      order: 3;
      flex: 1 1 100%;
      max-width: none;
    }
    nav {
      margin-left: auto;
    }
  }
  @media (max-width: 560px) {
    .brand small {
      display: none;
    }
  }
</style>
