---
// khensu.ñü mark: a ring with the crescent's inner edge drawn as an unfilled line of the same weight.
interface Props {
  size?: number | string;
  class?: string;
}
const { size = 24, class: cls } = Astro.props;
const c = 50;
const ring = 5;
const a = c - ring / 2;
const r = Math.sqrt(a * a + 14 * 14);
const inner = `M ${c} ${c - a} A ${r} ${r} 0 0 0 ${c} ${c + a}`;
---

<svg class={cls} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <circle cx={c} cy={c} r={a} fill="none" stroke="currentColor" stroke-width={ring}></circle>
  <path d={inner} fill="none" stroke="currentColor" stroke-width={ring} stroke-linecap="round"></path>
</svg>
