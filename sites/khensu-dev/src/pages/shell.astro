---
import Base from '../layouts/Base.astro';

// "Patent pending" may only appear once an application is on file (35 U.S.C. 292). Fill in from the USPTO filing
// receipt; keep in step with khensu-nu/src/components/khensu/PatentNotice.astro.
const APPLICATION = '';
const FILED = '';

// Drop physics, from first principles (see the table below for the inputs).
const g = 9.81;
const h = 1.5;
const v = Math.sqrt(2 * g * h);
const phone = 0.2;
const shell = 0.093;
const rigid = 0.1e-3;
const stroke = 0.3e-3;
const decel = (d: number) => (v * v) / (2 * d) / g;
const fmt = (n: number, digits = 0) => n.toLocaleString('en-US', { maximumFractionDigits: digits, minimumFractionDigits: digits });
---

<Base title="NuLink" description="Specifications for NuLink for iPhone 18 Pro: a post-quantum mesh transceiver in a ceramic-coated titanium shell that finishes level with the lenses, paired to your iPhone's Secure Enclave.">
  <p class="eyebrow">NuLink · post-quantum mesh transceiver</p>
  <h1>NuLink makes your phone a stealth, encrypted node that powers the network</h1>
  <p class="lede">
    It earns you khensu.nu coin for the work it does, and talks to nearby NuLinks and home nodes over NuMesh, our
    long-range mesh, so it keeps working without a carrier. In an emergency your iPhone’s own Emergency SOS via
    satellite still works, and satellite links through home stations are planned, so the network can bypass today’s
    telecom networks completely.
  </p>
  <p class="lede">
    NuLink is one model for iPhone 18 Pro and iPhone 18 Pro Max, coming to iPhone 18 when it arrives. Ceramic-coated titanium in
    your iPhone’s colour, or solid brass. It turns the phone into a node with its own battery, finishes level with the
    lenses so your iPhone is no thicker at its thickest point, and leaves the iPhone’s own USB-C port open.
  </p>

